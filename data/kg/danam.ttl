<https://data.cair-nepal.org/heritagegraph/id/danam/a53d02a0-6fe5-4ba1-aae2-305aed7f00c9> a hg:Stupa ;
    rdfs:label "Kirtipur (कीर्तिपुर)" ;
    dct:identifier "https://data.cair-nepal.org/heritagegraph/id/danam/a53d02a0-6fe5-4ba1-aae2-305aed7f00c9"^^xsd:anyURI ;
    crm:P3_has_note "Kirtipur, an old Newar settlement of the Kathmandu Valley is believed to be founded by King Sadāśivadeva (ca. 1099-1126 CE). The citizens of this ancient Newar city have engaged in preserving the rich tangible and intangible heritage sites that have been included in the &lsquo;World Heritage List Nominations&rsquo; by UNESCO. The city, with its numerous temples, stūpas, caityas or arcaded platforms, dynamised by several impressive processions, festivals and other cultural activities, is a remarkable repository of cultural heritage from Nepal. Kirtipur hosts the unique Bāghabhairava temple, Cilincva Caitya and Umāmaheśvara temple." ;
    crm:P55_has_current_location <https://data.cair-nepal.org/heritagegraph/id/place/danam/a53d02a0-6fe5-4ba1-aae2-305aed7f00c9> ;
    prov:wasInfluencedBy hgsrc:danam ;
    hg:existence_status hg:Extant ;
    hg:has_architectural_style hg:StupaStyle ;
    hg:has_provenance_assertion <https://data.cair-nepal.org/heritagegraph/id/assertion/danam/a53d02a0-6fe5-4ba1-aae2-305aed7f00c9> .

