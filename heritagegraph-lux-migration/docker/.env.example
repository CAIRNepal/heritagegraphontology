# =============================================================================
# LUX → HeritageGraph migration — runtime configuration
# Copy to ".env" before running `docker compose up -d`.
# =============================================================================

# ---- Ring -------------------------------------------------------------------
# pilot   = 10 K records (Hindu/Buddhist religious objects subset). ~30 min.
# domain  = 50–100 K records (South+East Asian religious heritage).  ~3 hours.
# full    = entire LUX dataset (~16 M records).                       ~12 hours
#                                                                     (REQUIRES a bulk dump from Yale —
#                                                                      see LUX_DATA_DOWNLOAD.md).
# crawl   = REST-API fallback when no bulk dump is available.
#                                                                     ~2-4 days for full.
RING_MODE=crawl
# ⚠️ IMPORTANT: there is no public Yale-hosted N-Quads dump as of May 2026.
#               Default RING_MODE is therefore `crawl`. To request a dump:
#               see LUX_DATA_DOWNLOAD.md → option (A).

# Cap each transformation query at this many records (0 = unlimited).
# In pilot mode we recommend 10000; for full ring leave at 0.
LIMIT_PER_QUERY=10000

# Batch size for the SPARQL INSERT WHERE pagination.
# Drop to 10000 if Oxigraph reports OOM during transform.
BATCH_SIZE=50000

# ---- LUX source -------------------------------------------------------------
# OPTIONAL: a bulk N-Quads dump URL. Leave EMPTY to fall through to crawl
# (the realistic default — Yale does not publish such a URL publicly).
# If Yale ITS sends you a dump location, paste it here:
#   LUX_DUMP_URL=https://<provided-by-yale>/lux.nq.gz
LUX_DUMP_URL=

# OPTIONAL: path inside the container to a locally-mounted dump file.
# If you've downloaded a dump via Yale's provided S3 link or any other
# means, mount it into the container at /work/lux/lux.nq and uncomment:
#   LUX_DUMP_PATH=/work/lux/lux.nq

# Free-text filter for RING_MODE=crawl (the LUX Search API q= parameter).
# Examples:
#   religious heritage
#   buddhist OR hindu
#   nepal AND temple
LUX_FILTER=religious heritage

# Polite-crawl rate limit (req/s). Yale's own pipeline defaults to ~10.
# Going above 20 will probably get you throttled.
CRAWL_RPS=10

# Diff endpoint for the weekly delta-syncer (also speculative; verify with
# discover_lux_endpoints.sh — if it 404s, comment DELTA_URL out entirely).
# DELTA_URL=https://lux.collections.yale.edu/data/activity-stream

# Cron schedule for delta-syncer (UTC). Default = Mondays 04:00 UTC.
DELTA_CRON=0 4 * * MON

# ---- Validation -------------------------------------------------------------
# strict  = fail the migration if any V1 / V2 hard-gate violation occurs.
# lenient = log violations and continue (NOT recommended for production).
VALIDATION_MODE=strict

# ---- Networking -------------------------------------------------------------
OXIGRAPH_PORT=7878

# ---- Resources --------------------------------------------------------------
OXIGRAPH_MEM_LIMIT=64g
MIGRATOR_MEM_LIMIT=8g
