@prefix rdf:           <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:          <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:           <http://www.w3.org/2002/07/owl#> .
@prefix skos:          <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:           <http://purl.org/dc/terms/> .
@prefix la:            <https://linked.art/ns/terms/> .
@prefix crm:           <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dig:           <http://www.ics.forth.gr/isl/CRMdig/> .
@prefix sci:           <http://www.ics.forth.gr/isl/CRMsci/> .
@prefix crminf:        <http://www.cidoc-crm.org/crminf/> .
@prefix aat:           <http://vocab.getty.edu/aat/> .
@prefix wikidata:      <http://www.wikidata.org/entity/> .
@prefix prov:          <http://www.w3.org/ns/prov#> .
@prefix time:          <http://www.w3.org/2006/time#> .
@prefix heritageGraph: <https://w3id.org/heritagegraph/> .

#####################################################################
# HeritageGraph  ↔  LUX (Linked Art / CIDOC-CRM)  alignment ontology
#
# Companion to HeritageGraph.ttl  (CAIRNepal/heritagegraphontology@HeritageGraph)
# Author      : Semih Yumuşak, May 2026
# Contributor : Niraj Karki (CAIR Nepal) — orphan fix (§4) + OWL/DL cleanup,
#               June 2026 (see the official copy at
#               ontology/lux/heritagegraph-lux-alignment.ttl on the
#               HeritageGraph branch, v1.0.0)
# Goal   : LUX → HG migration. LUX records are JSON-LD whose @context
#          maps short names ('HumanMadeObject', 'Person', …) to
#          *crm:* / *dig:* / *sci:* URIs (the real URIs that appear in
#          the data after parsing). Only a handful of classes are
#          genuinely under the la: namespace — namely la:Set,
#          la:Transfer, la:Payment, la:Addition, la:Removal,
#          la:RightAcquisition, la:DigitalService.
#
# Therefore this alignment binds HG classes to the actual URIs LUX uses
# (mostly crm:Enn) and only uses la: for the seven genuine la:-only
# classes. Each comment shows the LUX JSON-LD alias for traceability.
#
# July 2026 (alpha5 regeneration, HeritageGraph branch, commit 2286a6e /
# generated 2026-07-22): the core ontology stopped minting separate
# heritageGraph: URIs for 12 classes that map 1:1 onto an external term
# (class_uri in HeritageGraph.yaml now points directly at the crm: URI).
# heritageGraph:Person, heritageGraph:HumanMadeObject, heritageGraph:Actor,
# heritageGraph:Place, heritageGraph:TimeSpan, heritageGraph:Material,
# heritageGraph:Production, heritageGraph:DestructionEvent,
# heritageGraph:TransferOfCustody, heritageGraph:ConditionAssessment,
# heritageGraph:ConditionState and heritageGraph:Technique NO LONGER EXIST
# as distinct resources — the crm: URI itself IS the HG class now. This
# file (and the migration templates in ../queries/ and ../scripts/) were
# updated to reference those crm: URIs directly instead of the retired
# heritageGraph: wrapper. See §6 below for the full note.
#
# Apply with:  owl:imports  or  cat alignment.ttl >> HeritageGraph.ttl
#####################################################################

<https://w3id.org/heritagegraph/alignment/lux> a owl:Ontology ;
    rdfs:label "HeritageGraph–LUX alignment (Linked Art / CIDOC-CRM)"@en ;
    dct:description "Class- and property-level mapping from CAIR Nepal HeritageGraph to LUX, the Yale Linked Art / CIDOC-CRM dataset, validated against the official Linked Art JSON-LD context. Updated July 2026 to track the alpha5 core-ontology regeneration (12 classes now identity-mapped to external CRM/PROV URIs instead of separate heritageGraph: wrappers)."@en ;
    owl:imports <https://w3id.org/heritagegraph/> .

#####################################################################
# 1. CLASS-LEVEL ALIGNMENT
#    Pattern:  <hg:Class> owl:equivalentClass | rdfs:subClassOf <crm:Class> .
#    Comment column shows the LUX JSON-LD alias.
#####################################################################

# ---- Direct equivalents (semantically identical) ----------------------------

heritageGraph:HistoricalEvent       owl:equivalentClass crm:E5_Event .                # LUX alias: "Event"

heritageGraph:Deity                 owl:equivalentClass crm:E28_Conceptual_Object .   # LUX alias: "ConceptualObject"

# ---- Architectural / object hierarchy ---------------------------------------
# In LUX every building is crm:E22 classified_as a Type. We keep HG subclasses
# but assert subClassOf crm:E22 so a LUX consumer sees them as objects.

heritageGraph:ArchitecturalStructure rdfs:subClassOf crm:E22_Human-Made_Object .

heritageGraph:ArchitecturalElement   rdfs:subClassOf crm:E25_Human-Made_Feature ;     # LUX alias: "HumanMadeFeature"
                                     skos:closeMatch crm:E22_Human-Made_Object .

heritageGraph:Temple                 rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Stupa                  rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Chaitya                rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:BuddhistMonument       rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Pati                   rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Sattal                 rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Dharmashala            rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:RestHouse              rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:DhungeDhara            rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Pokhari                rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:WaterStructure         rdfs:subClassOf crm:E22_Human-Made_Object .

heritageGraph:IconographicObject     rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Murti                  rdfs:subClassOf crm:E22_Human-Made_Object .
heritageGraph:Paubha                 rdfs:subClassOf crm:E22_Human-Made_Object .

# Union class — closeMatch (LUX has no union analogue)
heritageGraph:PhysicalHeritageThing  skos:closeMatch crm:E22_Human-Made_Object .

# ---- Group / actor ----------------------------------------------------------

heritageGraph:Guthi                  rdfs:subClassOf crm:E74_Group .                 # LUX alias: "Group"
heritageGraph:CasteGroup             rdfs:subClassOf crm:E74_Group .
heritageGraph:DataCustodian          rdfs:subClassOf crm:E39_Actor .

# ---- Activities / events ----------------------------------------------------

heritageGraph:RitualEvent            rdfs:subClassOf crm:E7_Activity .               # LUX alias: "Activity"

heritageGraph:Festival               rdfs:subClassOf crm:E7_Activity .
heritageGraph:ChariotFestival        rdfs:subClassOf crm:E7_Activity .
heritageGraph:MaskedDance            rdfs:subClassOf crm:E7_Activity .

heritageGraph:Consecration           rdfs:subClassOf crm:E7_Activity .
heritageGraph:Enshrinement           rdfs:subClassOf crm:E7_Activity .
heritageGraph:LivingGoddessSelection rdfs:subClassOf crm:E7_Activity .
heritageGraph:LivingGoddessRetirement rdfs:subClassOf crm:E7_Activity .

heritageGraph:LivingGoddessTenure    rdfs:subClassOf crm:E4_Period .                 # LUX alias: "Period"

# ---- Documentation / source -------------------------------------------------

heritageGraph:DocumentationActivity  rdfs:subClassOf crm:E7_Activity .

heritageGraph:FieldSurveyActivity    rdfs:subClassOf sci:S4_Observation .

heritageGraph:OralHistoryInterview   rdfs:subClassOf crm:E65_Creation .              # LUX alias: "Creation"

heritageGraph:Verification           rdfs:subClassOf crm:E13_Attribute_Assignment .  # LUX alias: "AttributeAssignment"

heritageGraph:DataSource             rdfs:subClassOf crm:E73_Information_Object .    # LUX alias: "InformationObject"
heritageGraph:InformationObject      rdfs:subClassOf crm:E73_Information_Object .

heritageGraph:FieldSurveyDataset     rdfs:subClassOf crm:E31_Document .              # LUX alias: "Document"
heritageGraph:OralHistoryRecording   rdfs:subClassOf crm:E33_Linguistic_Object .     # LUX alias: "LinguisticObject"
heritageGraph:ArchivalRecord         rdfs:subClassOf crm:E31_Document .

# ---- Provenance / assertion -------------------------------------------------

heritageGraph:HeritageAssertion      rdfs:subClassOf crm:E13_Attribute_Assignment .
heritageGraph:SyncreticRelationship  rdfs:subClassOf crm:E13_Attribute_Assignment .
heritageGraph:AssertableEntity       skos:broadMatch crm:E1_CRM_Entity .   # fixed June 2026 (Niraj) — E1 is crm:, not crminf:

# ---- Concepts / types -------------------------------------------------------

heritageGraph:ReligiousTradition     rdfs:subClassOf crm:E55_Type .                  # LUX alias: "Type"
heritageGraph:CalendarSystem         skos:broadMatch crm:E29_Designated_Reference_System .

heritageGraph:DatePrecisionEnum      rdfs:subClassOf crm:E55_Type .
heritageGraph:ConditionTypeEnum      rdfs:subClassOf crm:E55_Type .
heritageGraph:ExistenceStatusEnum    rdfs:subClassOf crm:E55_Type .
heritageGraph:GuthiTypeEnum          rdfs:subClassOf crm:E55_Type .
heritageGraph:RitualTypeEnum         rdfs:subClassOf crm:E55_Type .
heritageGraph:SyncreticTypeEnum      rdfs:subClassOf crm:E55_Type .

# ---- Container / metadata ---------------------------------------------------
# heritageGraph:Container has no LUX equivalent (LinkML construct).
heritageGraph:Metadata               rdfs:subClassOf crm:E73_Information_Object .

#####################################################################
# 2. PROPERTY-LEVEL ALIGNMENT
#    Aligned to the crm: URIs LUX expands its short names to.
#####################################################################

# ---- Agent / participation --------------------------------------------------

heritageGraph:carried_out_by         owl:equivalentProperty crm:P14_carried_out_by .       # LUX alias: "carried_out_by"
heritageGraph:carried_out_activity   owl:equivalentProperty crm:P14i_performed .           # LUX alias: "carried_out"
heritageGraph:performed_by_group     rdfs:subPropertyOf     crm:P14_carried_out_by .
heritageGraph:performs_ritual        rdfs:subPropertyOf     crm:P14i_performed .
heritageGraph:had_participant        owl:equivalentProperty crm:P11_had_participant .      # LUX alias: "participant"
heritageGraph:invokes_deity          rdfs:subPropertyOf     crm:P12_occurred_in_the_presence_of .
heritageGraph:is_invoked_in_ritual   rdfs:subPropertyOf     crm:P12i_was_present_at .
heritageGraph:assertion_author       rdfs:subPropertyOf     crm:P14_carried_out_by .
heritageGraph:was_attributed_to_agent rdfs:subPropertyOf    crm:P14_carried_out_by .

# ---- Place / time -----------------------------------------------------------

heritageGraph:took_place_at          owl:equivalentProperty crm:P7_took_place_at .         # LUX alias: "took_place_at"
heritageGraph:has_timespan           owl:equivalentProperty crm:P4_has_time-span .         # LUX alias: "timespan"
heritageGraph:has_current_location   owl:equivalentProperty crm:P55_has_current_location . # LUX alias: "current_location"
heritageGraph:hypothesized_location  rdfs:subPropertyOf     crm:P55_has_current_location .
heritageGraph:place_coordinates      rdfs:subPropertyOf     crm:P168_place_is_defined_by . # LUX alias: "defined_by"

# ---- Composition / parts ----------------------------------------------------

heritageGraph:has_component          rdfs:subPropertyOf     crm:P46_is_composed_of .       # LUX alias for physical: "part"
heritageGraph:is_component_of        rdfs:subPropertyOf     crm:P46i_forms_part_of .       # LUX alias for physical: "part_of"
heritageGraph:contains_structure     rdfs:subPropertyOf     crm:P59i_is_located_on_or_within .
heritageGraph:is_part_of_festival    rdfs:subPropertyOf     crm:P9i_forms_part_of .        # LUX event 'part_of'
heritageGraph:includes_ritual_event  rdfs:subPropertyOf     crm:P9_consists_of .           # LUX event 'part'

# ---- Material / technique / type --------------------------------------------

heritageGraph:used_materials         rdfs:subPropertyOf     crm:P45_consists_of .          # LUX alias: "made_of"
heritageGraph:used_technique         rdfs:subPropertyOf     crm:P32_used_general_technique . # LUX alias: "technique"
heritageGraph:has_architectural_style rdfs:subPropertyOf    crm:P2_has_type .              # LUX alias: "classified_as"
heritageGraph:has_condition_type     rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:has_religious_tradition rdfs:subPropertyOf    crm:P2_has_type .
heritageGraph:guthi_type             rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:ritual_type            rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:place_type             rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:custodian_type         rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:syncretic_type         rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:date_precision         rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:source_type            rdfs:subPropertyOf     crm:P2_has_type .
heritageGraph:existence_status       rdfs:subPropertyOf     crm:P2_has_type .

# ---- Production / destruction / custody / title -----------------------------

heritageGraph:was_produced_by_event  owl:equivalentProperty crm:P108i_was_produced_by .    # LUX alias: "produced_by"
heritageGraph:produced_object        owl:equivalentProperty crm:P108_has_produced .        # LUX alias: "produced"
heritageGraph:destruction_event      owl:equivalentProperty crm:P13i_was_destroyed_by .    # LUX alias: "destroyed_by"
heritageGraph:transferred_to_actor   owl:equivalentProperty crm:P29_custody_received_by .  # LUX alias: "transferred_custody_to"
heritageGraph:transferred_from_actor owl:equivalentProperty crm:P28_custody_surrendered_by . # LUX alias: "transferred_custody_from"
heritageGraph:transferred_to_guthi   rdfs:subPropertyOf     crm:P29_custody_received_by .
heritageGraph:transferred_object     owl:equivalentProperty crm:P30_transferred_custody_of . # LUX alias: "transferred_custody_of"
heritageGraph:holds_custody_of       rdfs:subPropertyOf     crm:P49i_is_former_or_current_keeper_of .

# ---- Membership -------------------------------------------------------------

heritageGraph:has_membership         owl:equivalentProperty crm:P107_has_current_or_former_member .
heritageGraph:member_of_group        owl:equivalentProperty crm:P107i_is_current_or_former_member_of .
heritageGraph:managed_by_guthi       rdfs:subPropertyOf     crm:P49_has_former_or_current_keeper . # LUX alias: "current_keeper"

# ---- Aboutness / depiction --------------------------------------------------

heritageGraph:is_about_entity        owl:equivalentProperty crm:P129_is_about .            # LUX alias: "about"
heritageGraph:is_about_event         owl:equivalentProperty crm:P129_is_about .
heritageGraph:subject_entity         rdfs:subPropertyOf     crm:P140_assigned_attribute_to .
heritageGraph:subject_event          rdfs:subPropertyOf     crm:P141_assigned .

heritageGraph:depicts_deity          rdfs:subPropertyOf     crm:P138_represents .          # LUX alias: "represents"
heritageGraph:is_about_deity         rdfs:subPropertyOf     crm:P138_represents .
heritageGraph:is_depicted_in         rdfs:subPropertyOf     crm:P138i_has_representation . # LUX alias: "representation"

# ---- Sequencing -------------------------------------------------------------

heritageGraph:occurred_after         rdfs:subPropertyOf     crm:P183i_starts_after_the_end_of .
heritageGraph:occurs_before          rdfs:subPropertyOf     crm:P183_ends_before_the_start_of .

# ---- Documentation linkage --------------------------------------------------

heritageGraph:documented_in_source   owl:equivalentProperty crm:P67i_is_referred_to_by .   # LUX alias: "referred_to_by"
heritageGraph:was_documented_by      rdfs:subPropertyOf     crm:P94i_was_created_by .
heritageGraph:produced_information_object rdfs:subPropertyOf crm:P94_has_created .
heritageGraph:created_by_documentation owl:equivalentProperty crm:P94i_was_created_by .

# ---- Person life events (better expressed as Birth/Death events) ------------

heritageGraph:birth_timespan         rdfs:subPropertyOf     crm:P4_has_time-span ;
                                     rdfs:comment "Better modeled via crm:P98i_was_born (LUX alias 'born') -> crm:P4_has_time-span."@en .

heritageGraph:death_timespan         rdfs:subPropertyOf     crm:P4_has_time-span ;
                                     rdfs:comment "Better modeled via crm:P100i_died_in / crm:P93i_was_taken_out_of_existence_by + timespan."@en .

heritageGraph:publication_timespan   rdfs:subPropertyOf     crm:P4_has_time-span .

# ---- Identification / labelling --------------------------------------------

heritageGraph:name                   rdfs:subPropertyOf     crm:P1_is_identified_by .      # LUX alias: "identified_by"
heritageGraph:id                     rdfs:subPropertyOf     crm:P1_is_identified_by .
heritageGraph:note                   rdfs:subPropertyOf     crm:P3_has_note .
heritageGraph:source_citation        rdfs:subPropertyOf     crm:P67i_is_referred_to_by .

#####################################################################
# 3. NEW HERITAGEGRAPH CLASSES PROPOSED FOR INTEROPERABILITY
#    Each is rooted in the actual URI LUX uses (mostly crm:; only la:Set
#    and friends are genuine la: classes per Linked Art's JSON-LD context).
#####################################################################

heritageGraph:Group a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:comment "Generic group of actors. Super-class of Guthi and CasteGroup."@en ;
    rdfs:subClassOf crm:E74_Group .

heritageGraph:Guthi      rdfs:subClassOf heritageGraph:Group .
heritageGraph:CasteGroup rdfs:subClassOf heritageGraph:Group .

heritageGraph:Birth a owl:Class ;
    rdfs:label "Birth"@en ;
    rdfs:comment "Birth event of a Person; carries timespan, place, and parent attributions. LUX alias: 'Birth'."@en ;
    rdfs:subClassOf crm:E67_Birth .

heritageGraph:Death a owl:Class ;
    rdfs:label "Death"@en ;
    rdfs:comment "Death event of a Person. LUX alias: 'Death'."@en ;
    rdfs:subClassOf crm:E69_Death .

heritageGraph:Formation a owl:Class ;
    rdfs:label "Formation"@en ;
    rdfs:comment "Founding event of a Guthi/Group. LUX alias: 'Formation'."@en ;
    rdfs:subClassOf crm:E66_Formation .

heritageGraph:Dissolution a owl:Class ;
    rdfs:label "Dissolution"@en ;
    rdfs:comment "Termination event of a Guthi/Group. LUX alias: 'Dissolution'."@en ;
    rdfs:subClassOf crm:E68_Dissolution .

heritageGraph:Acquisition a owl:Class ;
    rdfs:label "Acquisition"@en ;
    rdfs:comment "Title transfer (vs. custody only). LUX alias: 'Acquisition'."@en ;
    rdfs:subClassOf crm:E8_Acquisition .

heritageGraph:Move a owl:Class ;
    rdfs:label "Move"@en ;
    rdfs:comment "Physical movement of an object — distinct from custody change. LUX alias: 'Move'."@en ;
    rdfs:subClassOf crm:E9_Move .

heritageGraph:VisualItem a owl:Class ;
    rdfs:label "Visual Item"@en ;
    rdfs:comment "Iconographic content separate from the physical Murti/Paubha. LUX alias: 'VisualItem'."@en ;
    rdfs:subClassOf crm:E36_Visual_Item .

heritageGraph:LinguisticObject a owl:Class ;
    rdfs:label "Linguistic Object"@en ;
    rdfs:comment "Textual content — inscriptions, manuscripts, transcribed oral history. LUX alias: 'LinguisticObject'."@en ;
    rdfs:subClassOf crm:E33_Linguistic_Object .

heritageGraph:DigitalObject a owl:Class ;
    rdfs:label "Digital Object"@en ;
    rdfs:comment "Photographs, 3D scans, audio recordings. LUX alias: 'DigitalObject' (note: LUX uses CRMdig dig:D1, not crmdig:)."@en ;
    rdfs:subClassOf dig:D1_Digital_Object .

heritageGraph:Set a owl:Class ;
    rdfs:label "Set"@en ;
    rdfs:comment "Curated grouping. LUX alias: 'Set' — this is one of the genuine la: classes (la:Set), not a CRM class. Linked Art deliberately mints la:Set distinct from crm:E78_Curated_Holding to allow ad-hoc groupings."@en ;
    rdfs:subClassOf la:Set ;
    skos:closeMatch crm:E78_Curated_Holding .

heritageGraph:CuratedHolding a owl:Class ;
    rdfs:label "Curated Holding"@en ;
    rdfs:comment "Formally curated holding (museum collection, library set). LUX alias: 'CuratedHolding'."@en ;
    rdfs:subClassOf crm:E78_Curated_Holding .

heritageGraph:Identifier a owl:Class ;
    rdfs:label "Identifier"@en ;
    rdfs:comment "Catalogue numbers, DANAM IDs, DOIs. LUX alias: 'Identifier'."@en ;
    rdfs:subClassOf crm:E42_Identifier .

heritageGraph:Name a owl:Class ;
    rdfs:label "Name"@en ;
    rdfs:comment "Multilingual name. LUX alias: 'Name' → crm:E33_E41_Linguistic_Appellation (multi-instantiated)."@en ;
    rdfs:subClassOf crm:E33_E41_Linguistic_Appellation .

heritageGraph:MeasurementUnit a owl:Class ;
    rdfs:label "Measurement Unit"@en ;
    rdfs:subClassOf crm:E58_Measurement_Unit .

heritageGraph:Dimension a owl:Class ;
    rdfs:label "Dimension"@en ;
    rdfs:comment "Height/width/depth/weight values. LUX alias: 'Dimension'."@en ;
    rdfs:subClassOf crm:E54_Dimension .

heritageGraph:Right a owl:Class ;
    rdfs:label "Right"@en ;
    rdfs:comment "Access/IP rights on photographs and datasets. LUX alias: 'Right'."@en ;
    rdfs:subClassOf crm:E30_Right .

heritageGraph:LegalObject a owl:Class ;
    rdfs:label "Legal Object"@en ;
    rdfs:comment "Things subject to legal frameworks — e.g. 'Ancient Monument' under Nepal heritage law. LUX alias: 'LegalObject'. (HG previously called this 'LegalConcept' which is not a Linked Art class; renamed for compatibility.)"@en ;
    rdfs:subClassOf crm:E72_Legal_Object .

heritageGraph:AttributeAssignment a owl:Class ;
    rdfs:label "Attribute Assignment"@en ;
    rdfs:comment "Generic super-class above HeritageAssertion / Verification / SyncreticRelationship. LUX alias: 'AttributeAssignment'."@en ;
    rdfs:subClassOf crm:E13_Attribute_Assignment .

heritageGraph:HeritageAssertion     rdfs:subClassOf heritageGraph:AttributeAssignment .
heritageGraph:Verification          rdfs:subClassOf heritageGraph:AttributeAssignment .
heritageGraph:SyncreticRelationship rdfs:subClassOf heritageGraph:AttributeAssignment .

heritageGraph:Period a owl:Class ;
    rdfs:label "Period"@en ;
    rdfs:comment "Generic historical period (Lichhavi, Malla, Shah, Rana). LUX alias: 'Period'."@en ;
    rdfs:subClassOf crm:E4_Period .

heritageGraph:LivingGoddessTenure rdfs:subClassOf heritageGraph:Period .

heritageGraph:Encounter a owl:Class ;
    rdfs:label "Encounter Event"@en ;
    rdfs:comment "Field encounter / rediscovery of a heritage object. LUX alias: 'Encounter' → CRMsci sci:S19_Encounter_Event (NOT crm:E87 Curation Activity)."@en ;
    rdfs:subClassOf sci:S19_Encounter_Event .

heritageGraph:CurationActivity a owl:Class ;
    rdfs:label "Curation Activity"@en ;
    rdfs:comment "Conservation / inventory / accession activities by a museum or Guthi. LUX alias: 'CurationActivity' → crm:E87."@en ;
    rdfs:subClassOf crm:E87_Curation_Activity .

heritageGraph:ProvenanceActivity a owl:Class ;
    rdfs:label "Provenance Activity"@en ;
    rdfs:comment "Wrapper for chains of custody / ownership / movement events. LUX models this as crm:E7_Activity classified_as a 'provenance' Type — NOT a separate la: class. Migration: LUX provenance activities land here as crm:E7_Activity instances."@en ;
    rdfs:subClassOf crm:E7_Activity .

# ---- Additions for full LUX → HG migration coverage ------------------------

heritageGraph:Modification a owl:Class ;
    rdfs:label "Modification"@en ;
    rdfs:comment "Restoration or alteration of a Murti/Temple/artifact. LUX alias: 'Modification'."@en ;
    rdfs:subClassOf crm:E11_Modification .

heritageGraph:Language a owl:Class ;
    rdfs:label "Language"@en ;
    rdfs:comment "Language of a Name or LinguisticObject (Devanagari, Nepali, Newari, Sanskrit, English). LUX alias: 'Language'."@en ;
    rdfs:subClassOf crm:E56_Language .

heritageGraph:Currency a owl:Class ;
    rdfs:label "Currency"@en ;
    rdfs:comment "Monetary unit referenced in Acquisition/Payment activities. LUX alias: 'Currency'."@en ;
    rdfs:subClassOf crm:E98_Currency .

heritageGraph:MonetaryAmount a owl:Class ;
    rdfs:label "Monetary Amount"@en ;
    rdfs:comment "Amount of money. LUX alias: 'MonetaryAmount'."@en ;
    rdfs:subClassOf crm:E97_Monetary_Amount .

heritageGraph:BeginningOfExistence a owl:Class ;
    rdfs:label "Beginning of Existence"@en ;
    rdfs:comment "Generic existence-start event when no specific Production/Birth/Formation applies. LUX alias: 'BeginningOfExistence'."@en ;
    rdfs:subClassOf crm:E63_Beginning_of_Existence .

heritageGraph:EndOfExistence a owl:Class ;
    rdfs:label "End of Existence"@en ;
    rdfs:comment "Generic existence-end event (mirror). LUX alias: 'EndOfExistence'."@en ;
    rdfs:subClassOf crm:E64_End_of_Existence .

heritageGraph:PropositionalObject a owl:Class ;
    rdfs:label "Propositional Object"@en ;
    rdfs:comment "Abstract works, doctrines, beliefs — separate from any physical carrier. LUX alias: 'PropositionalObject'."@en ;
    rdfs:subClassOf crm:E89_Propositional_Object .

heritageGraph:Measurement a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:comment "Act of measuring an object's dimension. LUX alias: 'Measurement'."@en ;
    rdfs:subClassOf crm:E16_Measurement .

heritageGraph:Inscription a owl:Class ;
    rdfs:label "Inscription"@en ;
    rdfs:comment "Inscriptions on stone/metal/manuscripts. LUX alias: 'Inscription'."@en ;
    rdfs:subClassOf crm:E34_Inscription .

heritageGraph:Title a owl:Class ;
    rdfs:label "Title"@en ;
    rdfs:comment "Titled name of a work or object. LUX alias: 'Title'."@en ;
    rdfs:subClassOf crm:E35_Title .

#####################################################################
# 4. INTERNAL HG HIERARCHY & PROPERTIES FOR NEW CLASSES
#
#    Without this section, the new classes from Section 3 only
#    sit under external CRM/Linked-Art URIs and appear as orphans
#    when the HG ontology is viewed on its own (Niraj, June 2026).
#    This section wires every new class into the existing HG graph
#    via (a) HG-internal rdfs:subClassOf links and (b) object
#    properties whose domain and range are HG classes.
#####################################################################

# ---- 4.1  Existence-event hierarchy (CRM E63/E64 tree mirrored in HG) -----

heritageGraph:Birth        rdfs:subClassOf heritageGraph:BeginningOfExistence .
heritageGraph:Formation    rdfs:subClassOf heritageGraph:BeginningOfExistence .
crm:E12_Production   rdfs:subClassOf heritageGraph:BeginningOfExistence .

heritageGraph:Death            rdfs:subClassOf heritageGraph:EndOfExistence .
heritageGraph:Dissolution      rdfs:subClassOf heritageGraph:EndOfExistence .
crm:E6_Destruction rdfs:subClassOf heritageGraph:EndOfExistence .

# ---- 4.2  Curation / activity hierarchy -----------------------------------

crm:E10_Transfer_of_Custody   rdfs:subClassOf heritageGraph:CurationActivity .
crm:E14_Condition_Assessment rdfs:subClassOf heritageGraph:CurationActivity .
heritageGraph:Modification        rdfs:subClassOf heritageGraph:CurationActivity .

heritageGraph:Acquisition rdfs:subClassOf heritageGraph:ProvenanceActivity .
heritageGraph:Move        rdfs:subClassOf heritageGraph:ProvenanceActivity .

# ---- 4.3  Identification / linguistic hierarchy ---------------------------

heritageGraph:Title       rdfs:subClassOf heritageGraph:Name .             # E35 ⊏ E33_E41
heritageGraph:Inscription rdfs:subClassOf heritageGraph:LinguisticObject . # E34 ⊏ E33

# ---- 4.4  Information-object hierarchy ------------------------------------

heritageGraph:DigitalObject        rdfs:subClassOf heritageGraph:InformationObject .
heritageGraph:LinguisticObject     rdfs:subClassOf heritageGraph:InformationObject .
heritageGraph:PropositionalObject  rdfs:subClassOf heritageGraph:InformationObject .
heritageGraph:Metadata             rdfs:subClassOf heritageGraph:InformationObject .

# ---- 4.5  Curated holding / set -------------------------------------------

heritageGraph:Set rdfs:subClassOf heritageGraph:CuratedHolding ;
    rdfs:comment "Linked Art mints la:Set distinct from crm:E78 to allow ad-hoc groupings. Within HG we additionally treat Set as a CuratedHolding for navigation; no semantic collapse — both parents remain."@en .

# ---- 4.6  Actor hierarchy --------------------------------------------------

heritageGraph:DataCustodian rdfs:subClassOf crm:E39_Actor .

# ---- 4.7  Object properties wiring new classes to existing HG graph -------

# --- Descriptive properties of a physical heritage thing --------------------

heritageGraph:carries_inscription a owl:ObjectProperty ;
    rdfs:label "carries inscription"@en ;
    rdfs:domain crm:E22_Human-Made_Object ;
    rdfs:range  heritageGraph:Inscription ;
    rdfs:subPropertyOf crm:P128_carries .

heritageGraph:has_dimension a owl:ObjectProperty ;
    rdfs:label "has dimension"@en ;
    rdfs:domain heritageGraph:PhysicalHeritageThing ;
    rdfs:range  heritageGraph:Dimension ;
    rdfs:subPropertyOf crm:P43_has_dimension .

heritageGraph:has_visual_item a owl:ObjectProperty ;
    rdfs:label "shows visual item"@en ;
    rdfs:domain crm:E22_Human-Made_Object ;
    rdfs:range  heritageGraph:VisualItem ;
    rdfs:subPropertyOf crm:P65_shows_visual_item .

heritageGraph:has_digital_representation a owl:ObjectProperty ;
    rdfs:label "has digital representation"@en ;
    rdfs:domain heritageGraph:PhysicalHeritageThing ;
    rdfs:range  heritageGraph:DigitalObject ;
    rdfs:subPropertyOf crm:P138i_has_representation .

heritageGraph:has_right a owl:ObjectProperty ;
    rdfs:label "has right"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:Right .

heritageGraph:subject_to_legal_object a owl:ObjectProperty ;
    rdfs:label "subject to legal status"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:LegalObject ;
    rdfs:subPropertyOf crm:P67i_is_referred_to_by .

# --- Identification ---------------------------------------------------------

heritageGraph:identified_by_identifier a owl:ObjectProperty ;
    rdfs:label "identified by identifier"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:Identifier ;
    rdfs:subPropertyOf crm:P1_is_identified_by .

heritageGraph:identified_by_name a owl:ObjectProperty ;
    rdfs:label "identified by name"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:Name ;
    rdfs:subPropertyOf crm:P1_is_identified_by .

heritageGraph:identified_by_title a owl:ObjectProperty ;
    rdfs:label "has title"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:Title ;
    rdfs:subPropertyOf crm:P102_has_title .

# --- Lifecycle events linking individuals & groups to event nodes ----------

heritageGraph:was_born_by a owl:ObjectProperty ;
    rdfs:label "was born by"@en ;
    rdfs:domain crm:E21_Person ;
    rdfs:range  heritageGraph:Birth ;
    rdfs:subPropertyOf crm:P98i_was_born .

heritageGraph:died_in_event a owl:ObjectProperty ;
    rdfs:label "died in event"@en ;
    rdfs:domain crm:E21_Person ;
    rdfs:range  heritageGraph:Death ;
    rdfs:subPropertyOf crm:P100i_died_in .

heritageGraph:was_formed_by a owl:ObjectProperty ;
    rdfs:label "was formed by"@en ;
    rdfs:domain heritageGraph:Group ;
    rdfs:range  heritageGraph:Formation ;
    rdfs:subPropertyOf crm:P95i_was_formed_by .

heritageGraph:dissolved_by a owl:ObjectProperty ;
    rdfs:label "dissolved by"@en ;
    rdfs:domain heritageGraph:Group ;
    rdfs:range  heritageGraph:Dissolution ;
    rdfs:subPropertyOf crm:P99i_dissolved_by .

# --- Object-history events --------------------------------------------------

heritageGraph:was_modified_by a owl:ObjectProperty ;
    rdfs:label "was modified by"@en ;
    rdfs:domain heritageGraph:PhysicalHeritageThing ;
    rdfs:range  heritageGraph:Modification ;
    rdfs:subPropertyOf crm:P31i_was_modified_by .

heritageGraph:was_moved_by a owl:ObjectProperty ;
    rdfs:label "was moved by"@en ;
    rdfs:domain heritageGraph:PhysicalHeritageThing ;
    rdfs:range  heritageGraph:Move ;
    rdfs:subPropertyOf crm:P25i_moved_by .

heritageGraph:was_acquired_through a owl:ObjectProperty ;
    rdfs:label "was acquired through"@en ;
    rdfs:domain heritageGraph:PhysicalHeritageThing ;
    rdfs:range  heritageGraph:Acquisition ;
    rdfs:subPropertyOf crm:P24i_changed_ownership_through .

heritageGraph:was_encountered_in a owl:ObjectProperty ;
    rdfs:label "was encountered in"@en ;
    rdfs:domain heritageGraph:PhysicalHeritageThing ;
    rdfs:range  heritageGraph:Encounter ;
    rdfs:subPropertyOf sci:O19i_was_object_encountered_at .

heritageGraph:was_measured_by a owl:ObjectProperty ;
    rdfs:label "was measured by"@en ;
    rdfs:domain heritageGraph:PhysicalHeritageThing ;
    rdfs:range  heritageGraph:Measurement ;
    rdfs:subPropertyOf crm:P39i_was_measured_by .

# --- Measurement / monetary internal wiring --------------------------------

heritageGraph:measurement_observes a owl:ObjectProperty ;
    rdfs:label "measurement observes"@en ;
    rdfs:domain heritageGraph:Measurement ;
    rdfs:range  heritageGraph:Dimension ;
    rdfs:subPropertyOf crm:P40_observed_dimension .

heritageGraph:dimension_has_unit a owl:ObjectProperty ;
    rdfs:label "dimension has unit"@en ;
    rdfs:domain heritageGraph:Dimension ;
    rdfs:range  heritageGraph:MeasurementUnit ;
    rdfs:subPropertyOf crm:P91_has_unit .

heritageGraph:amount_in_currency a owl:ObjectProperty ;
    rdfs:label "amount in currency"@en ;
    rdfs:domain heritageGraph:MonetaryAmount ;
    rdfs:range  heritageGraph:Currency ;
    rdfs:subPropertyOf crm:P180_has_currency .

heritageGraph:acquisition_amount a owl:ObjectProperty ;
    rdfs:label "acquisition amount"@en ;
    rdfs:domain heritageGraph:Acquisition ;
    rdfs:range  heritageGraph:MonetaryAmount ;
    rdfs:subPropertyOf crm:P179_had_sales_price .

# --- Language --------------------------------------------------------------

heritageGraph:has_language a owl:ObjectProperty ;
    rdfs:label "has language"@en ;
    rdfs:domain heritageGraph:LinguisticObject ;
    rdfs:range  heritageGraph:Language ;
    rdfs:subPropertyOf crm:P72_has_language .

# --- Set / curated-holding membership --------------------------------------

heritageGraph:member_of_set a owl:ObjectProperty ;
    rdfs:label "is member of set"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:Set .

heritageGraph:holds_item a owl:ObjectProperty ;
    rdfs:label "holds item"@en ;
    rdfs:domain heritageGraph:CuratedHolding ;
    rdfs:range  heritageGraph:AssertableEntity ;
    rdfs:subPropertyOf crm:P46_is_composed_of .

# --- Period containment ----------------------------------------------------

heritageGraph:occurs_during_period a owl:ObjectProperty ;
    rdfs:label "occurs during period"@en ;
    rdfs:domain heritageGraph:RitualEvent ;
    rdfs:range  heritageGraph:Period ;
    rdfs:subPropertyOf crm:P10_falls_within .

# --- Propositional object / doctrine ---------------------------------------

heritageGraph:about_proposition a owl:ObjectProperty ;
    rdfs:label "is about proposition"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:PropositionalObject ;
    rdfs:subPropertyOf crm:P129_is_about .

# --- Metadata on any heritage thing ----------------------------------------

heritageGraph:has_metadata a owl:ObjectProperty ;
    rdfs:label "has metadata"@en ;
    rdfs:domain heritageGraph:AssertableEntity ;
    rdfs:range  heritageGraph:Metadata ;
    rdfs:subPropertyOf crm:P67i_is_referred_to_by .

# --- DataCustodian role ----------------------------------------------------

heritageGraph:has_data_custodian a owl:ObjectProperty ;
    rdfs:label "has data custodian"@en ;
    rdfs:domain heritageGraph:DataSource ;
    rdfs:range  heritageGraph:DataCustodian ;
    rdfs:subPropertyOf crm:P109_has_current_or_former_curator .

# --- Container (LinkML construct, kept as InformationObject child) ---------

heritageGraph:Container rdfs:subClassOf heritageGraph:InformationObject ;
    rdfs:comment "LinkML container construct; no LUX equivalent. Treated as a structural InformationObject for navigation."@en .

#####################################################################
# 5. COVERAGE & TAXONOMY COMPLETION (July 2026 gap audit)
#
#    Two gap families closed here:
#    (a) LUX classes with NO HG target — six of the seven genuine la:
#        classes (only la:Set was mapped) plus crm:/sci: classes that
#        occur as @type in LUX data at full scale (Purchase, Joining,
#        Leaving, BiologicalObject, Mark, Site, …). Any of these firing
#        V1 would hard-fail a full-scale migration run.
#    (b) Section-3 classes that §4 wired only via OBJECT PROPERTIES
#        (domain/range edges) but not taxonomically — 20 classes had
#        no HG-internal rdfs:subClassOf parent. They are re-parented
#        below with CRM-consistent internal edges.
#
#    Deliberate HG roots after this section (documented, not orphans):
#    hg:Period (temporal top), hg:Concept (conceptual top),
#    hg:Dimension (value-space top), hg:LegalObject (legal top).
#####################################################################

# ---- 5.1  Structural super-classes -----------------------------------------

heritageGraph:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:comment "Generic intentional activity; landing class for LUX crm:E7_Activity instances that match no more specific HG class. LUX alias: 'Activity'. NOTE (July 2026): the core ontology also uses the English label 'Activity' for an unrelated abstract class whose class_uri is prov:Activity (PROV-O top, no crm:E7 relation) — a naming coincidence only. heritageGraph:Activity (this resource, our own URI) and prov:Activity (theirs) are distinct RDF resources; no logical clash, but avoid confusing the two in documentation/diagrams."@en ;
    owl:equivalentClass crm:E7_Activity ;
    rdfs:subClassOf heritageGraph:HistoricalEvent .          # E7 ⊏ E5

heritageGraph:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "Conceptual/type top — landing class for LUX crm:E55_Type concept records (/data/concept/). Deliberate HG root."@en ;
    owl:equivalentClass crm:E55_Type .

heritageGraph:Appellation a owl:Class ;
    rdfs:label "Appellation"@en ;
    rdfs:comment "Names, identifiers and other appellations. LUX alias: 'Appellation' → crm:E41. Internal parent hg:Metadata is pragmatic (appellations are record-level metadata in HG), not CRM-derived."@en ;
    rdfs:subClassOf crm:E41_Appellation ;
    rdfs:subClassOf heritageGraph:Metadata .

heritageGraph:Creation a owl:Class ;
    rdfs:label "Creation"@en ;
    rdfs:comment "Creation of an information object (non-physical). LUX alias: 'Creation' → crm:E65. CRM: E65 ⊏ E7 ∧ E63, mirrored internally."@en ;
    rdfs:subClassOf crm:E65_Creation ;
    rdfs:subClassOf heritageGraph:Activity ;
    rdfs:subClassOf heritageGraph:BeginningOfExistence .

# ---- 5.2  The six missing genuine la: classes -------------------------------

heritageGraph:Payment a owl:Class ;
    rdfs:label "Payment"@en ;
    rdfs:comment "Monetary payment inside a provenance activity. LUX alias: 'Payment' → la:Payment (genuine la: class, ⊏ crm:E7 per Linked Art ontology)."@en ;
    rdfs:subClassOf la:Payment ;
    rdfs:subClassOf heritageGraph:ProvenanceActivity .

heritageGraph:Transfer a owl:Class ;
    rdfs:label "Transfer"@en ;
    rdfs:comment "Generic transfer of an object between actors when neither title nor custody change is asserted. LUX alias: 'Transfer' → la:Transfer (genuine la: class)."@en ;
    rdfs:subClassOf la:Transfer ;
    rdfs:subClassOf heritageGraph:ProvenanceActivity .

heritageGraph:SetAddition a owl:Class ;
    rdfs:label "Addition (to set)"@en ;
    rdfs:comment "Addition of a member to a la:Set (accession into a collection). LUX alias: 'Addition' → la:Addition (genuine la: class). Named SetAddition in HG to avoid confusion with crm:E79_Part_Addition (hg:PartAddition)."@en ;
    rdfs:subClassOf la:Addition ;
    rdfs:subClassOf heritageGraph:CurationActivity .

heritageGraph:SetRemoval a owl:Class ;
    rdfs:label "Removal (from set)"@en ;
    rdfs:comment "Removal of a member from a la:Set (deaccession). LUX alias: 'Removal' → la:Removal (genuine la: class). Mirror of hg:SetAddition."@en ;
    rdfs:subClassOf la:Removal ;
    rdfs:subClassOf heritageGraph:CurationActivity .

heritageGraph:RightAcquisition a owl:Class ;
    rdfs:label "Right Acquisition"@en ;
    rdfs:comment "Acquisition of a Right (copyright, access) over a thing. LUX alias: 'RightAcquisition' → la:RightAcquisition (genuine la: class)."@en ;
    rdfs:subClassOf la:RightAcquisition ;
    rdfs:subClassOf heritageGraph:ProvenanceActivity .

heritageGraph:DigitalService a owl:Class ;
    rdfs:label "Digital Service"@en ;
    rdfs:comment "Access service for digital content (IIIF image/presentation endpoints on virtually every LUX digital record). LUX alias: 'DigitalService' → la:DigitalService (genuine la: class). Treated as an InformationObject in HG."@en ;
    rdfs:subClassOf la:DigitalService ;
    rdfs:subClassOf heritageGraph:InformationObject .

# ---- 5.3  crm:/sci: classes seen in LUX data but previously unmapped --------

heritageGraph:Purchase a owl:Class ;
    rdfs:label "Purchase"@en ;
    rdfs:comment "Acquisition with a sales price. LUX alias: 'Purchase' → crm:E96 (⊏ E8, mirrored internally)."@en ;
    rdfs:subClassOf crm:E96_Purchase ;
    rdfs:subClassOf heritageGraph:Acquisition .

heritageGraph:Joining a owl:Class ;
    rdfs:label "Joining"@en ;
    rdfs:comment "Actor joining a Group (Linked Art models group membership changes via E85/E86). LUX alias: 'Joining' → crm:E85."@en ;
    rdfs:subClassOf crm:E85_Joining ;
    rdfs:subClassOf heritageGraph:Activity .

heritageGraph:Leaving a owl:Class ;
    rdfs:label "Leaving"@en ;
    rdfs:comment "Actor leaving a Group. LUX alias: 'Leaving' → crm:E86. Mirror of hg:Joining."@en ;
    rdfs:subClassOf crm:E86_Leaving ;
    rdfs:subClassOf heritageGraph:Activity .

heritageGraph:TypeCreation a owl:Class ;
    rdfs:label "Type Creation"@en ;
    rdfs:comment "Creation of a new Type/concept (taxonomy minting). LUX alias: 'TypeCreation' → crm:E83 (⊏ E65, mirrored internally)."@en ;
    rdfs:subClassOf crm:E83_Type_Creation ;
    rdfs:subClassOf heritageGraph:Creation .

heritageGraph:IdentifierAssignment a owl:Class ;
    rdfs:label "Identifier Assignment"@en ;
    rdfs:comment "Assignment of an Identifier to an entity. LUX alias: 'IdentifierAssignment' → crm:E15 (⊏ E13)."@en ;
    rdfs:subClassOf crm:E15_Identifier_Assignment ;
    rdfs:subClassOf heritageGraph:AttributeAssignment .

heritageGraph:TypeAssignment a owl:Class ;
    rdfs:label "Type Assignment"@en ;
    rdfs:comment "Assignment of a Type to an entity. LUX alias: 'TypeAssignment' → crm:E17 (⊏ E13)."@en ;
    rdfs:subClassOf crm:E17_Type_Assignment ;
    rdfs:subClassOf heritageGraph:AttributeAssignment .

heritageGraph:PartAddition a owl:Class ;
    rdfs:label "Part Addition"@en ;
    rdfs:comment "Physical part added to an object. LUX alias: 'PartAddition' → crm:E79 (⊏ E11, mirrored internally). Distinct from hg:SetAddition (la:Addition)."@en ;
    rdfs:subClassOf crm:E79_Part_Addition ;
    rdfs:subClassOf heritageGraph:Modification .

heritageGraph:PartRemoval a owl:Class ;
    rdfs:label "Part Removal"@en ;
    rdfs:comment "Physical part removed from an object. LUX alias: 'PartRemoval' → crm:E80 (⊏ E11)."@en ;
    rdfs:subClassOf crm:E80_Part_Removal ;
    rdfs:subClassOf heritageGraph:Modification .

heritageGraph:Transformation a owl:Class ;
    rdfs:label "Transformation"@en ;
    rdfs:comment "One thing ends, another begins (e.g. fragment → relic). LUX alias: 'Transformation' → crm:E81 (⊏ E63 ∧ E64, mirrored internally)."@en ;
    rdfs:subClassOf crm:E81_Transformation ;
    rdfs:subClassOf heritageGraph:BeginningOfExistence ;
    rdfs:subClassOf heritageGraph:EndOfExistence .

heritageGraph:BiologicalObject a owl:Class ;
    rdfs:label "Biological Object"@en ;
    rdfs:comment "Natural-history specimen (LUX includes Yale Peabody Museum records). LUX alias: 'BiologicalObject' → crm:E20. Internal parent hg:PhysicalHeritageThing is pragmatic (specimens as heritage-collection objects) — CRM-wise E20 ⊏ E19, not E22."@en ;
    rdfs:subClassOf crm:E20_Biological_Object ;
    rdfs:subClassOf heritageGraph:PhysicalHeritageThing .

heritageGraph:PhysicalFeature a owl:Class ;
    rdfs:label "Physical Feature"@en ;
    rdfs:comment "Physical feature attached to an object or site. LUX alias: 'PhysicalFeature' → crm:E26. Internal parent hg:PhysicalHeritageThing is pragmatic."@en ;
    rdfs:subClassOf crm:E26_Physical_Feature ;
    rdfs:subClassOf heritageGraph:PhysicalHeritageThing .

heritageGraph:Site a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "Delimited natural/built site. LUX alias: 'Site' → crm:E27 (⊏ E26, mirrored internally). NOTE: CRM Site is a physical thing, NOT an E53 Place."@en ;
    rdfs:subClassOf crm:E27_Site ;
    rdfs:subClassOf heritageGraph:PhysicalFeature .

heritageGraph:Mark a owl:Class ;
    rdfs:label "Mark"@en ;
    rdfs:comment "Hallmarks, stamps, maker's marks. LUX alias: 'Mark' → crm:E37 (⊏ E36, mirrored internally)."@en ;
    rdfs:subClassOf crm:E37_Mark ;
    rdfs:subClassOf heritageGraph:VisualItem .

heritageGraph:AuthorityDocument a owl:Class ;
    rdfs:label "Authority Document"@en ;
    rdfs:comment "Vocabulary/authority source document referenced by LUX concept records. LUX alias: 'AuthorityDocument' → crm:E32 (⊏ E31)."@en ;
    rdfs:subClassOf crm:E32_Authority_Document ;
    rdfs:subClassOf heritageGraph:DataSource .

heritageGraph:ProductType a owl:Class ;
    rdfs:label "Product Type"@en ;
    rdfs:comment "Industrial product model/type. LUX alias: 'ProductType' → crm:E99 (⊏ E55, mirrored internally)."@en ;
    rdfs:subClassOf crm:E99_Product_Type ;
    rdfs:subClassOf heritageGraph:Concept .

heritageGraph:Presence a owl:Class ;
    rdfs:label "Presence"@en ;
    rdfs:comment "Temporal slice of a thing/period at a place (used in LUX provenance/exhibition modeling). LUX alias: 'Presence' → crm:E93. Internal parent hg:Period is PRAGMATIC ONLY — CRM-wise E93 ⊏ E92 Spacetime Volume (sibling of E4); flagged for two-rater review."@en ;
    rdfs:subClassOf crm:E93_Presence ;
    rdfs:subClassOf heritageGraph:Period .

# ---- 5.4  Internal re-parenting of §3 classes (taxonomy completion) ---------
# §4 connected these via object properties only; the subClassOf edges below
# make each class reachable in the HG-only CLASS HIERARCHY view as well.

heritageGraph:Group              rdfs:subClassOf crm:E39_Actor .               # E74 ⊏ E39
heritageGraph:VisualItem         rdfs:subClassOf heritageGraph:InformationObject .   # E36 ⊏ E73
heritageGraph:Name               rdfs:subClassOf heritageGraph:LinguisticObject ,    # E33_E41 ⊏ E33 ∧ E41
                                                 heritageGraph:Appellation .
heritageGraph:Identifier         rdfs:subClassOf heritageGraph:Appellation .         # E42 ⊏ E41
heritageGraph:CuratedHolding     rdfs:subClassOf heritageGraph:PhysicalHeritageThing . # E78 ⊏ E24 (pragmatic HG parent)
heritageGraph:CurationActivity   rdfs:subClassOf heritageGraph:Activity .            # E87 ⊏ E7
heritageGraph:ProvenanceActivity rdfs:subClassOf heritageGraph:Activity .            # E7-classified
heritageGraph:AttributeAssignment rdfs:subClassOf heritageGraph:Activity .           # E13 ⊏ E7
heritageGraph:Encounter          rdfs:subClassOf heritageGraph:Activity ;            # S19 ⊏ S4 ⊏ E13 ⊏ E7 (flattened)
    rdfs:comment "Internal parent flattened to hg:Activity; the full CRMsci chain S19 ⊏ S4_Observation ⊏ E13 would land it under hg:AttributeAssignment — kept simpler for HG navigation."@en .
heritageGraph:Measurement        rdfs:subClassOf heritageGraph:AttributeAssignment . # E16 ⊏ E13
heritageGraph:BeginningOfExistence rdfs:subClassOf heritageGraph:HistoricalEvent .   # E63 ⊏ E5
heritageGraph:EndOfExistence     rdfs:subClassOf heritageGraph:HistoricalEvent .     # E64 ⊏ E5
heritageGraph:HistoricalEvent    rdfs:subClassOf heritageGraph:Period .              # E5 ⊏ E4 (CRM-exact)
heritageGraph:MonetaryAmount     rdfs:subClassOf heritageGraph:Dimension .           # E97 ⊏ E54
heritageGraph:Right              rdfs:subClassOf heritageGraph:PropositionalObject . # E30 ⊏ E89
heritageGraph:Language           rdfs:subClassOf heritageGraph:Concept .             # E56 ⊏ E55
heritageGraph:Currency           rdfs:subClassOf heritageGraph:Concept .             # E98 ⊏ E55
heritageGraph:MeasurementUnit    rdfs:subClassOf heritageGraph:Concept .             # E58 ⊏ E55
heritageGraph:Inscription        rdfs:subClassOf heritageGraph:Mark .                # E34 ⊏ E33 ∧ E37

# Existing HG activity roots rewired under the new hg:Activity top:
heritageGraph:RitualEvent           rdfs:subClassOf heritageGraph:Activity .
heritageGraph:DocumentationActivity rdfs:subClassOf heritageGraph:Activity .

# Concept-branch classes gathered under hg:Concept for HG-only navigation:
heritageGraph:ReligiousTradition rdfs:subClassOf heritageGraph:Concept .
heritageGraph:DatePrecisionEnum  rdfs:subClassOf heritageGraph:Concept .
heritageGraph:ConditionTypeEnum  rdfs:subClassOf heritageGraph:Concept .
heritageGraph:ExistenceStatusEnum rdfs:subClassOf heritageGraph:Concept .
heritageGraph:GuthiTypeEnum      rdfs:subClassOf heritageGraph:Concept .
heritageGraph:RitualTypeEnum     rdfs:subClassOf heritageGraph:Concept .
heritageGraph:SyncreticTypeEnum  rdfs:subClassOf heritageGraph:Concept .

# Main-ontology orphans spotted during the same audit (same §4 pattern):
heritageGraph:Consecration  rdfs:subClassOf heritageGraph:RitualEvent .
heritageGraph:Enshrinement  rdfs:subClassOf heritageGraph:RitualEvent .
heritageGraph:ArchitecturalElement rdfs:subClassOf heritageGraph:PhysicalFeature .   # E25 ⊏ E26
crm:E29_Design_or_Procedure            rdfs:subClassOf heritageGraph:PropositionalObject . # E29 ⊏ E89

# Documented deliberate roots (no HG-internal parent BY DESIGN):
heritageGraph:Period    rdfs:comment "Deliberate HG root: temporal top (crm:E4). Children: HistoricalEvent, LivingGoddessTenure, Presence."@en .
heritageGraph:Dimension rdfs:comment "Deliberate HG root: value-space top (crm:E54). Child: MonetaryAmount."@en .
heritageGraph:LegalObject rdfs:comment "Deliberate HG root: legal-framework top (crm:E72 has no natural HG parent)."@en .

# ---- 5.5  Object properties wiring the new classes (§4 pattern) ------------

heritageGraph:paid_amount a owl:ObjectProperty ;
    rdfs:label "paid amount"@en ;
    rdfs:domain heritageGraph:Payment ;
    rdfs:range  heritageGraph:MonetaryAmount ;
    rdfs:subPropertyOf la:paid_amount .

heritageGraph:paid_from a owl:ObjectProperty ;
    rdfs:label "paid from"@en ;
    rdfs:domain heritageGraph:Payment ;
    rdfs:range  crm:E39_Actor ;
    rdfs:subPropertyOf la:paid_from .

heritageGraph:paid_to a owl:ObjectProperty ;
    rdfs:label "paid to"@en ;
    rdfs:domain heritageGraph:Payment ;
    rdfs:range  crm:E39_Actor ;
    rdfs:subPropertyOf la:paid_to .

heritageGraph:transferred_thing a owl:ObjectProperty ;
    rdfs:label "transferred thing"@en ;
    rdfs:domain heritageGraph:Transfer ;
    rdfs:range  heritageGraph:PhysicalHeritageThing ;
    rdfs:subPropertyOf la:transferred .

heritageGraph:digitally_available_via a owl:ObjectProperty ;
    rdfs:label "digitally available via"@en ;
    rdfs:domain heritageGraph:DigitalObject ;
    rdfs:range  heritageGraph:DigitalService ;
    rdfs:subPropertyOf la:digitally_available_via .

# NOTE — abstract CRM supers (E1, E2, E18, E19, E24, E70, E71, E77, E90, E92)
# remain deliberately unmapped: LUX never uses them as @type on instances;
# they exist in the JSON-LD context only for property-range completeness.
# V1 will therefore not fire on them.


#####################################################################
# 6. ALPHA5 CORE-ONTOLOGY SYNC (July 2026)
#
#    Source: CAIRNepal/heritagegraphontology, branch `HeritageGraph`,
#    ontology/HeritageGraph.{yaml,ttl}, "GENERATED ... alpha5 ... on
#    2026-07-22" (commit chain incl. ff1a1ac6 "Fixed the ontology and
#    verified using Hermit and OOPS", 2026-07-16). This is the branch
#    our tooling actually tracks (`main` has been stale since Feb 2026
#    — see server-bootstrap.sh Bug 8 note); this repo's fetch scripts
#    were not yet pointed at `HeritageGraph` before this sync.
#
#    What changed upstream: for classes whose meaning is already fully
#    covered by an external vocabulary term, HeritageGraph.yaml now sets
#    `class_uri` directly to that external URI instead of minting a new
#    heritageGraph: resource related to it by owl:equivalentClass. The
#    LinkML → OWL generator therefore emits the class ONLY under the
#    external URI. Concretely, these 12 heritageGraph: URIs no longer
#    exist as separate resources in the core ontology — the crm: URI
#    IS the class:
#
#      heritageGraph:HumanMadeObject      → crm:E22_Human-Made_Object
#      heritageGraph:Person               → crm:E21_Person
#      heritageGraph:Actor                → crm:E39_Actor
#      heritageGraph:Place                → crm:E53_Place
#      heritageGraph:TimeSpan             → crm:E52_Time-Span
#      heritageGraph:Material             → crm:E57_Material
#      heritageGraph:Production           → crm:E12_Production
#      heritageGraph:DestructionEvent     → crm:E6_Destruction
#      heritageGraph:TransferOfCustody    → crm:E10_Transfer_of_Custody
#      heritageGraph:ConditionAssessment  → crm:E14_Condition_Assessment
#      heritageGraph:ConditionState       → crm:E3_Condition_State
#      heritageGraph:Technique            → crm:E29_Design_or_Procedure
#
#    (Three more classes moved the same way but were never referenced by
#    name in this alignment file, so nothing to change for them: Entity →
#    prov:Entity, Activity → prov:Activity, Agent → prov:Agent — all
#    abstract PROV-O tops. NOTE: heritageGraph:Activity as declared in
#    §5.1 above is OUR OWN, unrelated resource — see the disambiguation
#    comment on that class.)
#
#    Fix applied here: every owl:equivalentClass / skos:closeMatch /
#    rdfs:subClassOf axiom that related one of the 12 heritageGraph:
#    URIs above to its crm: counterpart became a tautology (X relates to
#    X) once the heritageGraph: URI was substituted for the crm: URI —
#    13 such lines were removed. All rdfs:domain / rdfs:range
#    declarations on object properties (§4, §5.5) and all rdfs:subClassOf
#    statements that used one of these 12 classes as SUBJECT (e.g.
#    heritageGraph:DataCustodian rdfs:subClassOf heritageGraph:Actor) were
#    rewritten to the crm: URI. The companion files were updated the same
#    way — see ../queries/lux_to_hg_migration.sparql and
#    ../scripts/migrate_lux_to_hg.py (TRANSFORM_TEMPLATES): every CONSTRUCT
#    / INSERT arm that minted `a heritageGraph:<one of the 12>` on a new
#    /imported/lux/ node now mints `a crm:E..` directly instead.
#
#    Not in scope here: the ~25 Nepal-domain classes added upstream in
#    the same alpha5 pass (KumariHouse, ChariotFestival, Guthi-adjacent
#    ritual/selection-criterion classes, etc.) have no LUX counterpart
#    and are intentionally NOT added to this file — this alignment only
#    covers the LUX ↔ HG bridge, not HG's native domain coverage.
#####################################################################

# ---- 6.1  Schema-level coverage marker for the 12 direct-URI-reuse classes -
#
# V1 (validation_queries.sparql) originally proved coverage by finding an
# alignment-graph triple relating a heritageGraph:-prefixed subject to the
# LUX class. That test can no longer fire for the 12 classes above (there is
# no heritageGraph: URI left to be the subject). A first fix made V1 instead
# check for *any instance* of the LUX class already present in
# imported/lux — but that is DATA-dependent: under a bounded pilot run
# (LIMIT_PER_QUERY), a genuinely-covered class can have zero migrated
# instances just from sampling, which produced 3 false V1 failures on the
# first post-alpha5 deploy (2026-07-26: E52_Time-Span, E12_Production,
# E57_Material — all legitimately handled by the transform templates, just
# not sampled into this particular limited run).
#
# Fix: an explicit, SCHEMA-level (not instance-level) coverage marker below,
# true regardless of run size. V1/t11 check this in addition to (not instead
# of) the imported/lux instance check.
heritageGraph:alignment_lux_directly_reuses a owl:AnnotationProperty ;
    rdfs:label "directly reuses (no heritageGraph: wrapper)"@en ;
    rdfs:comment "Declares that a LUX/CRM class is migrated by direct URI reuse (§6) rather than via an owl:equivalentClass/subClassOf edge to a heritageGraph: class. Used by V1_unmapped_lux_classes as a schema-level coverage proof that does not depend on how many instances a given pilot run happened to migrate."@en .

<https://w3id.org/heritagegraph/alignment/lux>
    heritageGraph:alignment_lux_directly_reuses
        crm:E22_Human-Made_Object, crm:E21_Person, crm:E39_Actor,
        crm:E53_Place, crm:E52_Time-Span, crm:E57_Material,
        crm:E12_Production, crm:E6_Destruction, crm:E10_Transfer_of_Custody,
        crm:E14_Condition_Assessment, crm:E3_Condition_State,
        crm:E29_Design_or_Procedure .

# end of file
