            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( <heritageGraph:Guthi> <heritageGraph:CasteGroup> ) ] ;
            owl:onProperty <heritageGraph:performed_by_group> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:DocumentationActivity> ;
            owl:onProperty <heritageGraph:was_documented_by> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:performed_by_group> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:was_documented_by> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:TimeSpan> ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:LivingGoddessTenure> ;
            owl:onProperty <heritageGraph:ended_tenure_of> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Place> ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Person> ;
            owl:onProperty <heritageGraph:carried_out_by> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:note> ],
        <heritageGraph:RitualEvent> ;
    skos:definition " Ritual or administrative event that formally ends a Living Goddess tenure, marking the person's return to secular status. Common triggers include first menstruation, injury causing blood loss, or serious illness. This event terminates the divine embodiment and restores the girl to ordinary status." ;
    skos:exactMatch <heritageGraph:LivingGoddessRetirement>,
        crm:E7_Activity ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:Material> a owl:Class ;
    rdfs:label "Material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:name> ] ;
    skos:definition "Physical substance used in construction or crafting" ;
    skos:exactMatch crm:E57_Material ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:Murti> a owl:Class ;
    rdfs:label "Murti" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Deity> ;
            owl:onProperty <heritageGraph:is_about_deity> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:consecrated_by_event> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:is_about_deity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Consecration> ;
            owl:onProperty <heritageGraph:consecrated_by_event> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:is_about_deity> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:consecrated_by_event> ],
        <heritageGraph:IconographicObject> ;
    skos:definition "Consecrated statue of a deity, ritually activated to serve as divine presence (not merely depiction)" ;
    skos:exactMatch <heritageGraph:Murti>,
        aat:300264383,
        wikidata:Q2594295 ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:Temple> a owl:Class ;
    rdfs:label "Temple" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_architectural_style> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:enshrines_deity_through_event> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <heritageGraph:has_architectural_style> ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E55_Type ;
            owl:onProperty <heritageGraph:has_architectural_style> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Enshrinement> ;
            owl:onProperty <heritageGraph:enshrines_deity_through_event> ],
        <heritageGraph:ArchitecturalStructure> ;
    skos:closeMatch <http://schema.org/PlaceOfWorship> ;
    skos:definition "Sacred architectural structure legally classified as an 'Ancient Monument' under Nepal's preservation laws, characterized by deity enshrinement and ritual activation." ;
    skos:exactMatch <heritageGraph:Temple>,
        dbo:ReligiousBuilding,
        dbo:Temple,
        <http://schema.org/HinduTemple>,
        aat:300007595,
        <wd:Q44539> ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:TransferOfCustody> a owl:Class ;
    rdfs:label "TransferOfCustody" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:transferred_object> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:transferred_from_actor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:transferred_object> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:transferred_to_guthi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Guthi> ;
            owl:onProperty <heritageGraph:transferred_to_guthi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Place> ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:transferred_to_guthi> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Actor> ;
            owl:onProperty <heritageGraph:transferred_to_actor> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:transferred_from_actor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:PhysicalHeritageThing> ;
            owl:onProperty <heritageGraph:transferred_object> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:transferred_to_actor> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Actor> ;
            owl:onProperty <heritageGraph:transferred_from_actor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:transferred_to_actor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:TimeSpan> ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:has_timespan> ] ;
    skos:definition "Event of transferring responsibility for temple maintenance, ritual performance, or artifact stewardship" ;
    skos:exactMatch crm:E10_Transfer_of_Custody ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:WaterStructure> a owl:Class ;
    rdfs:label "WaterStructure" ;
    rdfs:subClassOf <heritageGraph:ArchitecturalStructure> ;
    skos:definition "Engineered water supply systems with ritual and civic significance" ;
    skos:exactMatch <heritageGraph:WaterStructure> ;
    skos:inScheme <CulturalHeritageOntology> .

