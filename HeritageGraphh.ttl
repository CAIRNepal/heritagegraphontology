<heritageGraph:ritual_on_structure> a owl:ObjectProperty ;
    rdfs:label "ritual_on_structure" ;
    rdfs:range <heritageGraph:PhysicalHeritageThing> ;
    skos:definition "Ritual occurs at specific temple or monument" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:ritual_type> a owl:ObjectProperty ;
    rdfs:label "ritual_type" ;
    rdfs:range <heritageGraph:RitualTypeEnum> ;
    skos:definition "Classification of ritual (puja, jatra, consecration)" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:route_description> a owl:DatatypeProperty ;
    rdfs:label "route_description" ;
    rdfs:range xsd:string ;
    skos:definition "Text description of the procession route" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:schema_version> a owl:DatatypeProperty ;
    rdfs:label "schema_version" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:selected_person> a owl:ObjectProperty ;
    rdfs:label "selected_person" ;
    rdfs:range <heritageGraph:Person> ;
    skos:definition "Person selected through a ritual selection process to assume a sacred role or office" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:source_citation> a owl:DatatypeProperty ;
    rdfs:label "source_citation" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf <heritageGraph:note> ;
    skos:definition "Formal citation of source" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:source_url> a owl:DatatypeProperty ;
    rdfs:label "source_url" ;
    rdfs:range xsd:string ;
    skos:definition "URL or digital identifier for source" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:start_place> a owl:ObjectProperty ;
    rdfs:label "start_place" ;
    rdfs:range <heritageGraph:Place> ;
    skos:definition "Starting location of movement ritual" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:supersedes_assertion> a owl:ObjectProperty ;
    rdfs:label "supersedes_assertion" ;
    rdfs:range <heritageGraph:HeritageAssertion> ;
    skos:definition " Previous version of this assertion (if this is an update). Creates version chain: A1 → A2 → A3 Query pattern: latest assertion = one with no incoming prov:invalidated" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:syncretic_type> a owl:ObjectProperty ;
    rdfs:label "syncretic_type" ;
    rdfs:range <heritageGraph:SyncreticTypeEnum> ;
    skos:definition "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:traditional_role> a owl:DatatypeProperty ;
    rdfs:label "traditional_role" ;
    rdfs:range xsd:string ;
    skos:definition "Hereditary occupation or ritual duty" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:transferred_from_actor> a owl:ObjectProperty ;
    rdfs:label "transferred_from_actor" ;
    rdfs:range <heritageGraph:Actor> ;
    skos:definition "Previous custodian" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:transferred_object> a owl:ObjectProperty ;
    rdfs:label "transferred_object" ;
    rdfs:range <heritageGraph:PhysicalHeritageThing> ;
    skos:definition "Object transferred in custody event" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:transferred_to_actor> a owl:ObjectProperty ;
    rdfs:label "transferred_to_actor" ;
    rdfs:range <heritageGraph:Actor> ;
    skos:definition "New custodian (person or group)" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:transferred_to_guthi> a owl:ObjectProperty ;
    rdfs:label "transferred_to_guthi" ;
    rdfs:range <heritageGraph:Guthi> ;
    skos:definition "New custodian (Guthi)" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:used_method> a owl:DatatypeProperty ;
    rdfs:label "used_method" ;
    rdfs:range xsd:string ;
    skos:definition "Documentation method used" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:verification_method> a owl:DatatypeProperty ;
    rdfs:label "verification_method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used for verification (cross-check, expert review, field visit)" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:year_offset_from_gregorian> a owl:DatatypeProperty ;
    rdfs:label "year_offset_from_gregorian" ;
    rdfs:range xsd:integer ;
    skos:definition "Mathematical offset to convert to Common Era (e.g., +57 for BS)." ;
    skos:inScheme <CulturalHeritageOntology> .

aat:300007576 a owl:Class ;
    rdfs:label "Stupa" ;
    rdfs:subClassOf crm:E55_Type ;
    skos:definition "Buddhist dome-shaped reliquary" .

<heritageGraph:IconographicObject> a owl:Class ;
    rdfs:label "IconographicObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:has_current_location> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:used_by> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:was_produced_by_event> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:RitualEvent> ;
            owl:onProperty <heritageGraph:participates_in_ritual> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:was_produced_by_event> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:participates_in_ritual> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_current_location> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Production> ;
            owl:onProperty <heritageGraph:was_produced_by_event> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( <heritageGraph:Person> <heritageGraph:CasteGroup> <heritageGraph:Guthi> ) ] ;
            owl:onProperty <heritageGraph:used_by> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Place> ;
            owl:onProperty <heritageGraph:has_current_location> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:depicts_deity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Deity> ;
            owl:onProperty <heritageGraph:depicts_deity> ],
        <heritageGraph:HumanMadeObject> ;
    skos:closeMatch crm:E36_Visual_Item ;
    skos:definition "Sacred visual art objects that depict or embody deities through iconographic conventions" ;
    skos:exactMatch dbo:Artwork,
        aat:300033618,
        aat:300041273,
        crm:E22_Human-Made_Object ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:LivingGoddessTenure> a owl:Class ;
    rdfs:label "LivingGoddessTenure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Actor> ;
            owl:onProperty <heritageGraph:had_participant> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Deity> ;
            owl:onProperty <heritageGraph:embodied_deity> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_retirement_event> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <heritageGraph:embodied_deity> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:residence_structure> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_participant> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:ArchitecturalStructure> ;
            owl:onProperty <heritageGraph:residence_structure> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:TimeSpan> ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:DocumentationActivity> ;
            owl:onProperty <heritageGraph:was_documented_by> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <heritageGraph:residence_structure> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:has_retirement_event> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Guthi> ;
            owl:onProperty <heritageGraph:supported_by_institution> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:had_participant> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <heritageGraph:has_participant> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:was_documented_by> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:embodied_deity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:LivingGoddessRetirement> ;
            owl:onProperty <heritageGraph:has_retirement_event> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:supported_by_institution> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Person> ;
            owl:onProperty <heritageGraph:has_participant> ] ;
    skos:definition "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families." ;
    skos:exactMatch crm:E4_Period,
        crm:E7_Activity ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:RestHouse> a owl:Class ;
    rdfs:label "RestHouse" ;
    rdfs:subClassOf <heritageGraph:ArchitecturalStructure> ;
    skos:definition "Community structures for travelers and pilgrims, maintained by Guthi organizations" ;
    skos:exactMatch <heritageGraph:RestHouse> ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:ended_tenure_of> a owl:ObjectProperty ;
    rdfs:label "ended_tenure_of" ;
    rdfs:range <heritageGraph:LivingGoddessTenure> ;
    owl:inverseOf <heritageGraph:has_retirement_event> ;
    skos:definition "Points from a LivingGoddessRetirement event to the tenure that it terminated. Enables reconstruction of complete Living Goddess lifecycle." ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:has_condition_assessment> a owl:ObjectProperty ;
    rdfs:label "has_condition_assessment" ;
    rdfs:range <heritageGraph:ConditionAssessment> ;
    skos:definition "Condition assessment events for this structure" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:has_retirement_event> a owl:ObjectProperty ;
    rdfs:label "has_retirement_event" ;
    rdfs:range <heritageGraph:LivingGoddessRetirement> ;
    owl:inverseOf <heritageGraph:ended_tenure_of> ;
    skos:definition "Retirement event that ended this Living Goddess tenure" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:includes_ritual_event> a owl:ObjectProperty ;
    rdfs:label "includes_ritual_event" ;
    rdfs:range <heritageGraph:RitualEvent> ;
    skos:definition "Component rituals of festival" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:participates_in_ritual> a owl:ObjectProperty ;
    rdfs:label "participates_in_ritual" ;
    rdfs:range <heritageGraph:RitualEvent> ;
    skos:definition "Rituals in which this structure participates" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:produced_information_object> a owl:ObjectProperty ;
    rdfs:label "produced_information_object" ;
    rdfs:range <heritageGraph:InformationObject> ;
    skos:definition "Information object (record, document) produced by documentation" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:Enshrinement> a owl:Class ;
    rdfs:label "Enshrinement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:enshrined_in_structure> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:TimeSpan> ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:enshrined_deity> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:enshrined_in_structure> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Temple> ;
            owl:onProperty <heritageGraph:enshrined_in_structure> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Actor> ;
            owl:onProperty <heritageGraph:carried_out_by> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:enshrined_deity> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:carried_out_by> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Deity> ;
            owl:onProperty <heritageGraph:enshrined_deity> ] ;
    skos:definition "Event of installing a deity's murti or symbol within a temple sanctum" ;
    skos:exactMatch crm:E7_Activity ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:Festival> a owl:Class ;
    rdfs:label "Festival" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:includes_ritual_event> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:RitualEvent> ;
            owl:onProperty <heritageGraph:includes_ritual_event> ],
        <heritageGraph:RitualEvent> ;
    skos:definition "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
    skos:exactMatch crm:E7_Activity ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:Production> a owl:Class ;
    rdfs:label "Production" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:commissioned_by> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:DocumentationActivity> ;
            owl:onProperty <heritageGraph:was_documented_by> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Place> ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:produced_object> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:TimeSpan> ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Actor> ;
            owl:onProperty <heritageGraph:carried_out_by> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:was_documented_by> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Technique> ;
            owl:onProperty <heritageGraph:used_technique> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:PhysicalHeritageThing> ;
            owl:onProperty <heritageGraph:produced_object> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:HeritageAssertion> ;
            owl:onProperty <heritageGraph:has_provenance_assertion> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:used_technique> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:has_provenance_assertion> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:has_timespan> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:carried_out_by> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:took_place_at> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Actor> ;
            owl:onProperty <heritageGraph:commissioned_by> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:produced_object> ] ;
    skos:definition "Event of creating an architectural structure, murti, or paubha" ;
    skos:exactMatch crm:E12_Production ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:ReligiousTradition> a owl:Class ;
    rdfs:label "ReligiousTradition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:note> ] ;
    skos:definition "Religious or philosophical tradition (e.g., Hindu, Buddhist, Syncretic)" ;
    skos:exactMatch aat:300073708,
        crm:E55_Type ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:ConditionTypeEnum> a owl:Class ;
    rdfs:label "ConditionTypeEnum" ;
    owl:unionOf ( <heritageGraph:ConditionTypeEnum#Good> <heritageGraph:ConditionTypeEnum#Damaged> <heritageGraph:ConditionTypeEnum#Ruined> <heritageGraph:ConditionTypeEnum#Restored> ) ;
    skos:inScheme <CulturalHeritageOntology> ;
    linkml:permissible_values <heritageGraph:ConditionTypeEnum#Damaged>,
        <heritageGraph:ConditionTypeEnum#Good>,
        <heritageGraph:ConditionTypeEnum#Restored>,
        <heritageGraph:ConditionTypeEnum#Ruined> .

<heritageGraph:SyncreticTypeEnum> a owl:Class ;
    rdfs:label "SyncreticTypeEnum" ;
    owl:unionOf ( <heritageGraph:SyncreticTypeEnum#Equivalence> <heritageGraph:SyncreticTypeEnum#Appropriation> <heritageGraph:SyncreticTypeEnum#Fusion> <heritageGraph:SyncreticTypeEnum#Historical> ) ;
    skos:inScheme <CulturalHeritageOntology> ;
    linkml:permissible_values <heritageGraph:SyncreticTypeEnum#Appropriation>,
        <heritageGraph:SyncreticTypeEnum#Equivalence>,
        <heritageGraph:SyncreticTypeEnum#Fusion>,
        <heritageGraph:SyncreticTypeEnum#Historical> .

<heritageGraph:id> a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Globally unique URI identifier" ;
    skos:exactMatch <http://schema.org/identifier> ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:performed_by_group> a owl:DatatypeProperty ;
    rdfs:label "performed_by_group" ;
    rdfs:range [ owl:unionOf ( <heritageGraph:Guthi> <heritageGraph:CasteGroup> ) ] ;
    rdfs:subPropertyOf <heritageGraph:carried_out_by> ;
    skos:definition "Group (Guthi, caste) responsible for ritual" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:source_language> a owl:DatatypeProperty ;
    rdfs:label "source_language" ;
    rdfs:range xsd:string ;
    skos:definition "Language of the source material" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:CasteGroup> a owl:Class ;
    rdfs:label "CasteGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:traditional_role> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:traditional_role> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:note> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:traditional_role> ] ;
    skos:definition "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    skos:exactMatch crm:E74_Group ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:DatePrecisionEnum> a owl:Class ;
    rdfs:label "DatePrecisionEnum" ;
    owl:unionOf ( <heritageGraph:DatePrecisionEnum#Exact> <heritageGraph:DatePrecisionEnum#Year> <heritageGraph:DatePrecisionEnum#Decade> <heritageGraph:DatePrecisionEnum#Century> <heritageGraph:DatePrecisionEnum#Circa> ) ;
    skos:inScheme <CulturalHeritageOntology> ;
    linkml:permissible_values <heritageGraph:DatePrecisionEnum#Century>,
        <heritageGraph:DatePrecisionEnum#Circa>,
        <heritageGraph:DatePrecisionEnum#Decade>,
        <heritageGraph:DatePrecisionEnum#Exact>,
        <heritageGraph:DatePrecisionEnum#Year> .

<heritageGraph:ExistenceStatusEnum> a owl:Class ;
    rdfs:label "ExistenceStatusEnum" ;
    owl:unionOf ( <heritageGraph:ExistenceStatusEnum#Extant> <heritageGraph:ExistenceStatusEnum#PartiallyExtant> <heritageGraph:ExistenceStatusEnum#Destroyed> <heritageGraph:ExistenceStatusEnum#Lost> <heritageGraph:ExistenceStatusEnum#Hypothetical> <heritageGraph:ExistenceStatusEnum#Unknown> ) ;
