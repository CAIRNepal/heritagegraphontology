            owl:onProperty <heritageGraph:name> ] ;
    skos:definition "Defined geographic location where events occur and structures exist" ;
    skos:exactMatch crm:E53_Place ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:RitualTypeEnum> a owl:Class ;
    rdfs:label "RitualTypeEnum" ;
    owl:unionOf ( <heritageGraph:NityaPuja> <heritageGraph:NaimittikaPuja> <heritageGraph:KamyaPuja> <heritageGraph:Abhisheka> <heritageGraph:Homa> <heritageGraph:Bhajan> <heritageGraph:Yagna> <heritageGraph:Vrata> <heritageGraph:Jatra> <heritageGraph:ChariotProcession> <heritageGraph:MaskedPerformance> <heritageGraph:RitualTypeEnum#RitualConsecration> <heritageGraph:RitualTypeEnum#ProcessionRitual> <heritageGraph:RitualTypeEnum#InstallationRitual> <heritageGraph:RitualTypeEnum#DeinstallationRitual> <heritageGraph:RitualTypeEnum#ReturningRitual> <heritageGraph:RitualTypeEnum#Circumambulation> <heritageGraph:RitualTypeEnum#RelicTour> <heritageGraph:RitualTypeEnum#ProcessionalMovement> ) ;
    skos:inScheme <CulturalHeritageOntology> ;
    linkml:permissible_values <heritageGraph:Abhisheka>,
        <heritageGraph:Bhajan>,
        <heritageGraph:ChariotProcession>,
        <heritageGraph:Homa>,
        <heritageGraph:Jatra>,
        <heritageGraph:KamyaPuja>,
        <heritageGraph:MaskedPerformance>,
        <heritageGraph:NaimittikaPuja>,
        <heritageGraph:NityaPuja>,
        <heritageGraph:RitualTypeEnum#Circumambulation>,
        <heritageGraph:RitualTypeEnum#DeinstallationRitual>,
        <heritageGraph:RitualTypeEnum#InstallationRitual>,
        <heritageGraph:RitualTypeEnum#ProcessionRitual>,
        <heritageGraph:RitualTypeEnum#ProcessionalMovement>,
        <heritageGraph:RitualTypeEnum#RelicTour>,
        <heritageGraph:RitualTypeEnum#ReturningRitual>,
        <heritageGraph:RitualTypeEnum#RitualConsecration>,
        <heritageGraph:Vrata>,
        <heritageGraph:Yagna> .

<heritageGraph:took_place_at> a owl:ObjectProperty ;
    rdfs:label "took_place_at" ;
    rdfs:range <heritageGraph:Place> ;
    skos:definition "Place Where event occurred" ;
    skos:inScheme <CulturalHeritageOntology> .

<heritageGraph:RitualEvent> a owl:Class ;
