        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:Place> ;
            owl:onProperty <heritageGraph:has_current_location> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <heritageGraph:has_condition_assessment> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:HeritageAssertion> ;
            owl:onProperty <heritageGraph:has_provenance_assertion> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:DataSource> ;
            owl:onProperty <heritageGraph:documented_in_source> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <heritageGraph:name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:destruction_event> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <heritageGraph:DestructionEvent> ;
            owl:onProperty <heritageGraph:destruction_event> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <heritageGraph:existence_status> ],
        [ a owl:Restriction ;
