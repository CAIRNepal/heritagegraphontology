# Competency questions that are answered only under OWL reasoning.
# Each is asked in the vocabulary of a client that knows only part of the
# picture (CIDOC-CRM only, PROV-O only, or the generic classes), and is run by
# evaluation/run_inference_cq.py over the demonstrator (TBox + ABox) twice:
# over the asserted triples and over their OWL 2 RL closure. A CQ passes when
# the closure's bindings equal the frozen expected set
# (evaluation/cq_inference_expected.json) and the asserted triples alone return
# strictly fewer rows -- the answer depends on the ontology's axioms.

# IQ1: Which groups carry out which rituals, as a CIDOC-CRM-only client sees them?
# (hg:performedByGroup rdfs:subPropertyOf crm:P14_carried_out_by; Guthi and CasteGroup rdfs:subClassOf crm:E74_Group)
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
SELECT ?ritual ?group WHERE {
  ?ritual a hg:RitualEvent ; crm:P14_carried_out_by ?group .
  ?group a crm:E74_Group .
}

# IQ2: Which entities were derived from which sources, as a PROV-O-only client sees them?
# (crminf:I2_Belief and hg:SyncreticRelationship rdfs:subClassOf prov:Entity)
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?entity ?source WHERE {
  ?entity a prov:Entity ; prov:wasDerivedFrom ?source .
}

# IQ3: Which assertions are recorded about each heritage subject, seen from the subject?
# (hg:hasAssertion owl:inverseOf hg:assertsAbout)
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
SELECT ?subject ?assertion WHERE {
  ?subject hg:hasAssertion ?assertion .
}

# IQ4: Which physical heritage things are located where?
# (hg:PhysicalHeritageThing owl:equivalentClass the union of ArchitecturalStructure, IconographicObject, ArchitecturalElement; class hierarchy)
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
SELECT ?thing ?place WHERE {
  ?thing a hg:PhysicalHeritageThing ; crm:P55_has_current_location ?place .
}
