# Minimal SHACL-conformant instance (verified required-field core).
# FICTIONAL: the labels and dates are invented to exercise the shapes; they describe no real
# temple, guthi or festival (the demonstrator, kathmandu-mini-abox.ttl, holds the sourced facts).
@prefix hg:<https://cair-nepal.org/heritagegraph/> .
@prefix crm:<http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms:<http://purl.org/dc/terms/> .
@prefix rdfs:<http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:<http://www.w3.org/2001/XMLSchema#> .
@prefix aat:<http://vocab.getty.edu/aat/> .
@prefix ex:<https://cair-nepal.org/heritagegraph/example/> .
ex:Place a crm:E53_Place ; rdfs:label "Example square (fictional)" .
ex:TSpan a crm:E52_Time-Span ;
    crm:P82a_begin_of_the_begin "0900-01-01T00:00:00"^^xsd:dateTime ;
    crm:P82b_end_of_the_end "1200-12-31T00:00:00"^^xsd:dateTime .
ex:T a hg:Temple ; rdfs:label "Example temple (fictional)" ;
    dcterms:identifier "https://cair-nepal.org/heritagegraph/example/t"^^xsd:anyURI ;
    hg:hasArchitecturalStyle <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> ; crm:P55_has_current_location ex:Place .
ex:G a hg:Guthi ; rdfs:label "Example deity guthi (fictional)" ; hg:guthiType <https://cair-nepal.org/heritagegraph/GuthiType#TempleGuthi> .
ex:R a hg:RitualEvent ; rdfs:label "Example festival (fictional)" ; crm:P4_has_time-span ex:TSpan .
ex:S a hg:DataSource ; rdfs:label "Example source (fictional)" .
