# --- deepened flagship case: cited Kumari Hindu-Buddhist syncretism ---
# The Royal Kumari is chosen from the Newar Buddhist Shakya lineage yet is
# venerated as the Hindu goddess Taleju/Durga -- a documented living instance
# of the syncretism pattern (Allen 1975).
ex:ShakyaCommunity a hg:CasteGroup ;
    rdfs:label "Shakya (Newar Buddhist) lineage" ;
    hg:traditionalRole "hereditary lineage from which the Royal Kumari is selected" ;
    hg:mentionedInSource ex:Src_Allen .
ex:Assert_KumariSyncretism a crminf:I2_Belief ;
    rdfs:label "Kumari embodies a Hindu goddess yet is drawn from a Buddhist lineage" ;
    hg:assertsAbout ex:Tenure_2017 ;
    prov:value "Selected from the Buddhist Shakya lineage; venerated as the Hindu goddess Taleju/Durga" ;
    prov:wasDerivedFrom ex:Src_Allen ;
    prov:wasAttributedTo ex:Allen ;
    hg:confidenceScore "0.9"^^xsd:decimal ;
    prov:generatedAtTime "2026-07-25T00:00:00"^^xsd:dateTime .
# The Newar Buddhist identification of the Kumari (the office, not a child)
# with Vajradevi, as published (see the note at ex:Vajradevi above).
ex:Assert_KumariVajradevi a crminf:I2_Belief ;
    rdfs:label "Newar Buddhists regard the Kumari as the embodiment of Vajradevi" ;
    hg:assertsAbout ex:RoyalKumariRole ;
    prov:value "To Newar Buddhists, the kumari is regarded as the embodiment of the supreme female deity Vajradevi, a Buddha." ;
    prov:wasDerivedFrom ex:Src_NatGeo_Kumari2015 , ex:Src_HinduismToday_Kumari1997 ;
    prov:wasAttributedTo ex:Tree ;
    prov:generatedAtTime "2026-11-26T00:00:00"^^xsd:dateTime ;
    crminf:J4_that ex:Prop_KumariVajradevi .
ex:Prop_KumariVajradevi a hg:Proposition ;
    hg:propositionSubject ex:RoyalKumariRole ;
    hg:propositionPredicate "https://cair-nepal.org/heritagegraph/roleDeity"^^xsd:anyURI ;
    hg:propositionObjectEntity ex:Vajradevi .

