# =====================================================================
# CITED GOLD-STANDARD LAYER
# Facts are attributed to a checkable source where one was found: a
# description cites it with hg:mentionedInSource, a belief (crminf:I2) with
# prov:wasDerivedFrom and prov:wasAttributedTo: the
# Kumari tenure and retirement, the Guthi and custody records, the Indra
# Jatra 2025 dates, the Taleju Temple patronage, the Kasthamandap build-date
# accounts and the syncretic identifications. Contested facts are recorded
# as source-attributed beliefs (crminf:I2), not stated flatly.
# Illustrative, not sourced: some CQ witnesses are authored to exercise the
# patterns and carry no source: the daily pujas (NityaPuja_KM,
# NityaPuja_Bungamati), GunlaBajan, ShantiSwastiPuja,
# BhavanishankarRituals, CA_2015, Pinnacle_KM, ChariotConstruction, SalWood,
# Kasthamandap's participation in Indra Jatra, and the route-change belief
# Assert_RouteChange with its invented source and agent (Src_Illustrative,
# IllustrativeAgent), which stand for no real person or body. They show what
# the ontology can express, not documented events. Murti_Taleju records only
# that an image of Taleju is kept in her restricted temple; its access
# protocol is the cataloguer's, pending the community concerned. Deities,
# traditions, calendars and source authors are identified by name only.
# Links to Wikidata use skos:exactMatch (same thing) or skos:closeMatch (a
# wider item), not owl:sameAs, so the demonstrator neither asserts OWL
# identity with Wikidata items nor takes on their typing; rdfs:seeAlso links
# related entities; hg:mentionedInSource names the scholarly work each
# thematic cluster is drawn from.
# =====================================================================

# --- linked-data authority links (Wikidata, verified QIDs) ---
ex:Kasthamandap        skos:exactMatch wd:Q6374805 .
ex:SwayambhuMahachaitya skos:closeMatch wd:Q12946982 .   # Q12946982 is the Swayambhunath complex, not only the stupa
ex:Bungamati           skos:exactMatch wd:Q2608296 .
ex:Taleju              skos:exactMatch wd:Q9355345 .
ex:KathmanduDurbarSquare skos:exactMatch wd:Q6122177 .
ex:Earthquake2015      skos:exactMatch wd:Q19830062 .
# ex:Bungadyah: no link; Wikidata has no item for the deity Bunga Dyah / Rato
# Machhindranath (searched 2026-11-24); the festival link is BungadyahJatra.
# ex:Matsyendranath now stands for the Nath yogi with whom Bungadyah is
# identified (Syn_Matsyendranath); it is not linked to wd:Q1420753 here.
ex:TalejuTemple        rdfs:seeAlso wd:Q12947124 .
# The Wikidata items for Indra Jatra and Bungadyah Jatra are the recurring
# festivals; ex:IndraJatra and ex:BungadyahJatra are their 2025 occurrences
# (each has one time-span), so they are related, not the same.
ex:IndraJatra          rdfs:seeAlso wd:Q301339 .
ex:BungadyahJatra      rdfs:seeAlso wd:Q16971988 .

# --- canonical scholarship as bibliographic sources ---
ex:Src_Allen a hg:DataSource ; rdfs:label "Allen, The Cult of Kumari (1975)" ;
    hg:sourceCreator ex:Allen ; dcterms:date "1975" ;
    hg:sourceCitation "Allen, M. (1975). The Cult of Kumari: Virgin Worship in Nepal. Institute of Nepal and Asian Studies, Tribhuvan University." .
ex:Src_Toffin a hg:DataSource ; rdfs:label "Toffin, Newar Society (2007)" ;
    hg:sourceCreator ex:Toffin ; dcterms:date "2007" ;
    hg:sourceCitation "Toffin, G. (2007). Newar Society: City, Village and Periphery. Himal Books." .
ex:Src_Gutschow a hg:DataSource ; rdfs:label "Gutschow, Architecture of the Newars (2011)" ;
    hg:sourceCreator ex:Gutschow ; dcterms:date "2011" ;
    hg:sourceCitation "Gutschow, N. (2011). Architecture of the Newars: A History of Building Typologies and Details in Nepal. Serindia Publications." .
ex:Src_Owens a hg:DataSource ; rdfs:label "Owens, The Politics of Divinity (1989)" ;
    hg:sourceCreator ex:Owens ; dcterms:date "1989" ;
    hg:sourceCitation "Owens, B. M. (1989). The Politics of Divinity in the Kathmandu Valley: The Festival of Bungadya/Rato Matsyendranath. PhD dissertation, Columbia University." .
ex:Allen a crm:E39_Actor ; rdfs:label "Michael Allen" ;
    dcterms:identifier "https://cair-nepal.org/heritagegraph/example/agent/allen"^^xsd:anyURI .

# --- per-cluster source attribution (hg:mentionedInSource) ---
ex:Tenure_2017      hg:mentionedInSource ex:Src_Allen .
