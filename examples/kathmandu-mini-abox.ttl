# HeritageGraph demonstrator ABox — Kathmandu Valley exemplar.
# Hand-authored to exercise all four modelling patterns + the provenance and
# multi-calendar layers, and to conform to HeritageGraph.shacl.ttl.
@prefix hg:   <https://cair-nepal.org/heritagegraph/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:   <https://cair-nepal.org/heritagegraph/demo/> .

# --- places & time-spans ---
ex:KathmanduDurbarSquare a crm:E53_Place ; rdfs:label "Kathmandu Durbar Square" .
ex:TS_Festival a crm:E52_Time-Span ; rdfs:label "Indra Jatra (annual, Bhadra)" .

# --- tangible heritage: a temple + its construction (event-mediated) ---
ex:Kasthamandap a hg:Temple ;
    rdfs:label "Kasthamandap" ;
    dcterms:identifier "https://cair-nepal.org/heritagegraph/demo/site/kasthamandap"^^xsd:anyURI ;
    hg:has_architectural_style hg:Pagoda ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare .

ex:Prod_Kasthamandap a hg:Production ;
    rdfs:label "Construction of Kasthamandap" ;
    hg:produced_object ex:Kasthamandap ;
    hg:carried_out_by ex:LicchaviBuilders .
ex:LicchaviBuilders a hg:Actor ; rdfs:label "Builders (tradition)" .

# condition history via an assessment event
ex:CA_2015 a hg:ConditionAssessment ;
    rdfs:label "Post-2015-earthquake assessment of Kasthamandap" .
ex:CS_Damaged a hg:ConditionState ; rdfs:label "Damaged" .

# --- institutional layer: a Guthi custodian ---
ex:KasthamandapGuthi a hg:Guthi ;
    rdfs:label "Kasthamandap Temple Guthi" ;
    hg:guthi_type hg:TempleGuthi ;
    hg:holds_custody_of ex:Kasthamandap ;
    hg:performs_ritual ex:IndraJatra .

# --- ritual layer + multi-calendar recurrence ---
ex:IndraJatra a hg:RitualEvent ;
    rdfs:label "Indra Jatra" ;
    crm:P4_has_time-span ex:TS_Festival ;
    hg:recurrence_pattern "annual" .

# --- syncretic relationship (provenance-aware) ---
ex:Avalokitesvara a hg:Deity ; rdfs:label "Avalokiteshvara" ;
    hg:has_religious_tradition ex:Buddhist .
ex:Matsyendranath a hg:Deity ; rdfs:label "Matsyendranath" ;
    hg:has_religious_tradition ex:Hindu .
ex:Buddhist a hg:ReligiousTradition ; rdfs:label "Buddhist" .
ex:Hindu a hg:ReligiousTradition ; rdfs:label "Hindu" .
ex:Syn_Karunamaya a hg:SyncreticRelationship ;
    rdfs:label "Avalokiteshvara identified as Matsyendranath" ;
    hg:assigned_to_deity ex:Avalokitesvara ;
    hg:assigned_equivalent ex:Matsyendranath ;
    hg:syncretic_type hg:Equivalence .

# --- Living Goddess lifecycle ---
ex:Taleju a hg:Deity ; rdfs:label "Taleju Bhavani" .
ex:KumariPerson a hg:Person ; rdfs:label "Kumari (incumbent)" .
ex:Tenure_2017 a hg:LivingGoddessTenure ;
    rdfs:label "Royal Kumari tenure (2017--2025)" ;
    hg:embodied_deity ex:Taleju ;
    hg:supported_by_institution ex:KasthamandapGuthi .
ex:Sel_2017 a hg:LivingGoddessSelection ;
    rdfs:label "Selection event" ; hg:initiated_tenure ex:Tenure_2017 .
ex:Ret_2025 a hg:LivingGoddessRetirement ;
    rdfs:label "Retirement event" ; hg:ended_tenure_of ex:Tenure_2017 .

# --- epistemic provenance: TWO CONFLICTING, source-attributed claims ---
ex:Assert_BuildA a hg:HeritageAssertion ;
    rdfs:label "Kasthamandap build-date (account A)" ;
    hg:asserts_about_entity ex:Kasthamandap ;
    hg:asserted_value "12th century CE" ;
    hg:was_derived_from_source ex:Src_Slusser ;
    hg:was_attributed_to_agent ex:Slusser ;
    hg:confidence_score "0.7"^^xsd:float .
ex:Assert_BuildB a hg:HeritageAssertion ;
    rdfs:label "Kasthamandap build-date (account B)" ;
    hg:asserts_about_entity ex:Kasthamandap ;
    hg:asserted_value "7th century CE" ;
    hg:was_derived_from_source ex:Src_DoA ;
    hg:was_attributed_to_agent ex:DoA ;
    hg:confidence_score "0.5"^^xsd:float .
ex:Src_Slusser a hg:DataSource ; rdfs:label "Slusser, Nepal Mandala (1982)" .
ex:Src_DoA a hg:DataSource ; rdfs:label "Department of Archaeology survey" .
ex:Slusser a hg:Actor ; rdfs:label "M. S. Slusser" .
ex:DoA a hg:Actor ; rdfs:label "Department of Archaeology" .
