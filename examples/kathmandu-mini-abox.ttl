    hg:epochDateGregorian "-0056-04-14" ;
    hg:yearOffsetFromGregorian 57 ;
    crm:P3_has_note "Solar calendar of Nepal; new year at Mesh Sankranti (13-15 April)." .
ex:NepalSambat a hg:CalendarSystem ; rdfs:label "Nepal Sambat" ;
    hg:epochDateGregorian "0879-10-24" ;
    hg:yearOffsetFromGregorian -879 ;
    crm:P3_has_note "Lunisolar Newar calendar counted in elapsed years; new year at Mha Puja (Kartik Shukla Pratipada, late October to November)." .

