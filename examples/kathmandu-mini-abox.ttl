# --- hereditary office: the Barahi chariot builders of Bungadyah ---
ex:Office_BungadyahChariotBuilder a hg:RitualOffice ; rdfs:label "Builder of the Bungadyah chariot" .
ex:HRT_BarahiChariot a hg:HereditaryRoleTenure ;
    rdfs:label "Barahi office of building the Bungadyah chariot" ;
    hg:roleHolder ex:Barahis ;
    hg:tenureOffice ex:Office_BungadyahChariotBuilder ;
    hg:roleDuty "search for, carve and assemble the wooden parts of the Bungadyah (Rato Machhindranath) chariot each year; rebuild it from scratch every 12 years, when it is built at Bungamati" ;
    hg:dutyFor ex:BungadyahJatra ;
    hg:mandatedBy ex:GuthiSansthan ;
    hg:successionRule "hereditary within the Barahi (Newar carpenter) community" ;
    hg:mentionedInSource ex:Src_NT_Barahi , ex:Src_Owens , ex:Src_HT_Chariot2015 , ex:Src_DANAM_Bungamati .
# Nepali Times (2015): the Barahis work on the chariot "every year", and it
# "has to be rebuilt from scratch every 12 years"; Himalayan Times (2015): the
# Guthi Sansthan's Lalitpur office sought its head office's support to rebuild
# the chariot after the 2015 earthquake; DANAM: in the twelve-yearly jatra the
# chariot is assembled in Bungamati.

