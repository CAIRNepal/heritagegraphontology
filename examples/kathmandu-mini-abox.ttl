# HeritageGraph demonstrator ABox — Kathmandu Valley exemplar.
# Maintained by hand against HeritageGraph 1.0.0, and extended with the
# CITED GOLD-STANDARD LAYER at the end of this file (owl:sameAs links to Wikidata
# + dcterms:source attribution to published ethnographic scholarship).
# Hand-authored to exercise all four modelling patterns + the provenance and
# multi-calendar layers, and to give every one of the 32 competency questions
# (examples/queries/cq-abox-32.rq) at least one witness binding.
# The full demonstrator validates conformant against HeritageGraph.shacl.ttl
# (closed shapes with sh:ignoredProperties for the ontology's polymorphic
# vocabulary; see scripts/postprocess_shacl.py). A separate minimal instance
# is examples/kathmandu-conformant.ttl.
@prefix hg:   <https://w3id.org/heritagegraph/> .
@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crminf: <http://www.ics.forth.gr/isl/CRMinf/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix ex:   <https://w3id.org/heritagegraph/demo/> .

# --- places & time-spans ---
ex:KathmanduDurbarSquare a crm:E53_Place ; rdfs:label "Kathmandu Durbar Square" .
ex:TS_Festival a crm:E52_Time-Span ; rdfs:label "Indra Jatra (annual, Bhadra)" .

# --- tangible heritage: a temple + its construction (event-mediated) ---
ex:Kasthamandap a hg:Temple ;
    rdfs:label "Kasthamandap" ;
    dcterms:identifier "https://w3id.org/heritagegraph/demo/site/kasthamandap"^^xsd:anyURI ;
    hg:hasArchitecturalStyle aat:300004829 ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare .

ex:Prod_Kasthamandap a crm:E12_Production ;
    rdfs:label "Construction of Kasthamandap" ;
    crm:P108_has_produced ex:Kasthamandap ;
    crm:P14_carried_out_by ex:LicchaviBuilders .
ex:LicchaviBuilders a crm:E39_Actor ; rdfs:label "Builders (tradition)" .

# condition history via an assessment event
ex:CA_2015 a crm:E14_Condition_Assessment ;
    rdfs:label "Post-2015-earthquake assessment of Kasthamandap" .
ex:CS_Damaged a crm:E3_Condition_State ; rdfs:label "Damaged" .

# --- institutional layer: a Guthi custodian ---
ex:KasthamandapGuthi a hg:Guthi ;
    rdfs:label "Kasthamandap Temple Guthi" ;
    hg:guthiType "TempleGuthi" ;
    crm:P50i_is_current_keeper_of ex:Kasthamandap ;
    hg:performsRitual ex:IndraJatra .

# --- ritual layer + multi-calendar recurrence ---
ex:IndraJatra a hg:RitualEvent ;
    rdfs:label "Indra Jatra" ;
    crm:P4_has_time-span ex:TS_Festival ;
    hg:recurrencePattern "annual" .

# --- syncretic relationship (provenance-aware) ---
ex:Avalokitesvara a hg:Deity ; rdfs:label "Avalokiteshvara" ;
    hg:hasReligiousTradition ex:Buddhist .
ex:Matsyendranath a hg:Deity ; rdfs:label "Matsyendranath" ;
    hg:hasReligiousTradition ex:Hindu .
ex:Buddhist a hg:ReligiousTradition ; rdfs:label "Buddhist" .
ex:Hindu a hg:ReligiousTradition ; rdfs:label "Hindu" .
ex:Syn_Karunamaya a hg:SyncreticRelationship ;
    rdfs:label "Avalokiteshvara identified as Matsyendranath" ;
    crm:P140_assigned_attribute_to ex:Avalokitesvara ;
    crm:P141_assigned ex:Matsyendranath ;
    hg:syncreticType "Equivalence" .

# --- Living Goddess lifecycle ---
ex:Taleju a hg:Deity ; rdfs:label "Taleju Bhavani" .
ex:KumariPerson a crm:E21_Person ; rdfs:label "Kumari (incumbent)" .
ex:Tenure_2017 a hg:KumariTenure ;
    rdfs:label "Royal Kumari tenure (2017--2025)" ;
    hg:embodiedDeity ex:Taleju ;
    hg:supportedByInstitution ex:KasthamandapGuthi .
ex:Sel_2017 a hg:KumariSelectionEvent ;
    rdfs:label "Selection event" ; hg:initiatedTenure ex:Tenure_2017 .
ex:Ret_2025 a hg:KumariRetirementEvent ;
    rdfs:label "Retirement event" ; hg:endedTenureOf ex:Tenure_2017 .

# --- epistemic provenance: TWO CONFLICTING, source-attributed claims ---
ex:Assert_BuildA a crminf:I2_Belief ;
    rdfs:label "Kasthamandap build-date (account A)" ;
    hg:assertsAbout ex:Kasthamandap ;
    prov:value "12th century CE" ;
    prov:wasDerivedFrom ex:Src_Slusser ;
    prov:wasAttributedTo ex:Slusser ;
    hg:confidenceScore "0.7"^^xsd:float .
ex:Assert_BuildB a crminf:I2_Belief ;
    rdfs:label "Kasthamandap build-date (account B)" ;
    hg:assertsAbout ex:Kasthamandap ;
    prov:value "7th century CE" ;
    prov:wasDerivedFrom ex:Src_DoA ;
    prov:wasAttributedTo ex:DoA ;
    hg:confidenceScore "0.5"^^xsd:float .
ex:Src_Slusser a hg:DataSource ; rdfs:label "Slusser, Nepal Mandala (1982)" ;
    dcterms:creator "Mary Shepherd Slusser" ; dcterms:date "1982" ;
    dcterms:bibliographicCitation "Slusser, M. S. (1982). Nepal Mandala: A Cultural Study of the Kathmandu Valley. Princeton University Press." .
ex:Src_DoA a hg:DataSource ; rdfs:label "Department of Archaeology survey" ;
    dcterms:creator "Department of Archaeology, Government of Nepal" .
ex:Slusser a crm:E39_Actor ; rdfs:label "M. S. Slusser" .
ex:DoA a crm:E39_Actor ; rdfs:label "Department of Archaeology" .

# =====================================================================
# Witnesses so that every one of the 32 CQs (examples/queries/
# cq-abox-32.rq) returns at least one binding over this demonstrator.
# =====================================================================

# --- structural fabric (CQ2, CQ5, CQ6, CQ8, CQ18, CQ19, CQ23) ---
ex:Pinnacle_KM a hg:ArchitecturalElement ;
    rdfs:label "Gajur (pinnacle) of Kasthamandap" ;
    crm:P46i_forms_part_of ex:Kasthamandap .

ex:Kasthamandap hg:participatesInRitual ex:IndraJatra ;
    hg:managedByGuthi ex:KasthamandapGuthi ;
    crm:P34i_was_assessed_by ex:CA_2015 ;
    hg:hasAssertion ex:Assert_BuildA , ex:Assert_BuildB ;
    hg:hasReligiousTradition ex:Hindu , ex:Buddhist .

ex:CA_2015 crm:P35_has_identified ex:CS_Damaged .

ex:KathmanduDurbarSquare crm:P53i_is_former_or_current_location_of ex:Kasthamandap , ex:TalejuTemple .

ex:TalejuTemple a hg:Temple ;
    rdfs:label "Taleju Temple, Hanuman Dhoka" ;
    hg:hasArchitecturalStyle aat:300004829 ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare .

# --- enshrinement (CQ7) ---
ex:Ensh_Taleju a hg:Enshrinement ;
    rdfs:label "Enshrinement of Taleju at Hanuman Dhoka" ;
    hg:enshrinedDeity ex:Taleju ;
    hg:enshrinedInStructure ex:TalejuTemple ;
    crm:P7_took_place_at ex:KathmanduDurbarSquare .

# --- historical event + crisis ritual (CQ4, CQ14) ---
ex:TS_2015 a crm:E52_Time-Span ; rdfs:label "25 April 2015" .
ex:Earthquake2015 a hg:HistoricalEvent ;
    rdfs:label "Gorkha earthquake (2015)" ;
    hg:architecturalStructures ex:Kasthamandap ;
    crm:P4_has_time-span ex:TS_2015 ;
    crm:P9_consists_of ex:ShantiSwastiPuja .
ex:ShantiSwastiPuja a hg:RitualEvent ;
    rdfs:label "Shanti swasti puja (post-earthquake propitiation)" ;
    hg:recurrencePattern "extraordinary (crisis-triggered)" .

# --- ritual layer enrichment (CQ8-CQ12, CQ16, CQ22, CQ30) ---
ex:Indra a hg:Deity ; rdfs:label "Indra" ; hg:hasReligiousTradition ex:Hindu .
ex:IndraJatra crm:P7_took_place_at ex:KathmanduDurbarSquare ;
    hg:invokesDeity ex:Indra ;
    hg:performedByGroup ex:Manandhars ;
    hg:isCriticalForFestival true .

ex:Manandhars a hg:CasteGroup ;
    rdfs:label "Manandhar community" ;
    hg:traditionalRole "hereditary chariot pullers and oil pressers" .
ex:Barahis a hg:CasteGroup ;
    rdfs:label "Barahi community" ;
    hg:traditionalRole "hereditary chariot carpenters" .

ex:NityaPuja_KM a hg:RitualEvent ;
    rdfs:label "Daily nitya puja at Kasthamandap" ;
    hg:ritualType "NityaPuja" ;
    crm:P8_took_place_on_or_within ex:Kasthamandap ;
    hg:recurrencePattern "daily" .

ex:YosinErection a hg:RitualEvent ;
    rdfs:label "Yosin (ceremonial pole) erection" ;
    crm:P120_occurs_before ex:KumariProcession ;
    crm:P14_carried_out_by ex:Manandhars .
ex:KumariProcession a hg:RitualEvent ;
    rdfs:label "Kumari chariot procession" ;
    hg:ritualType "ChariotProcession" ;
    hg:performedByGroup ex:Manandhars ;
    hg:hadParticipant ex:KumariPerson ;
    crm:P120i_occurs_after ex:YosinErection .

# --- iconographic object in ritual use (CQ3, CQ10) ---
ex:KarmacharyaPriest a crm:E39_Actor ; rdfs:label "Karmacharya priest (hereditary)" .
ex:Murti_Taleju a hg:Murti ;
    rdfs:label "Murti of Taleju Bhavani" ;
    crm:P62_depicts ex:Taleju ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare ;
    hg:participatesInRitual ex:IndraJatra ;
    hg:usedBy ex:KarmacharyaPriest .

# --- procession with route, materials, techniques (CQ13, CQ15, CQ24) ---
ex:Bungamati a crm:E53_Place ; rdfs:label "Bungamati" .
ex:Patan a crm:E53_Place ; rdfs:label "Patan (Lalitpur)" .
ex:Jawalakhel a crm:E53_Place ; rdfs:label "Jawalakhel" .
ex:SalWood a crm:E57_Material ; rdfs:label "Sal wood" .
ex:ChariotConstruction a crm:E29_Design_or_Procedure ; rdfs:label "Traditional chariot construction" .

ex:BungadyahProcession a hg:RitualEvent ;
    rdfs:label "Bungadyah (Rato Machhindranath) chariot procession" ;
    hg:ritualType "ProcessionRitual" ;
    hg:invokesDeity ex:Matsyendranath ;
    hg:startPlace ex:Bungamati ;
    hg:endPlace ex:Jawalakhel ;
    hg:routePlaces ex:Patan ;
    hg:routeDescription "Bungamati to Patan to Jawalakhel (chariot route)" ;
    crm:P125_used_object_of_type ex:SalWood ;
    crm:P33_used_specific_technique ex:ChariotConstruction ;
    crm:P7_took_place_at ex:Patan .

ex:BungamatiTemple a hg:Temple ;
    rdfs:label "Bungamati Machhindranath Temple" ;
    hg:hasArchitecturalStyle "Shikhara" ;
    crm:P55_has_current_location ex:Bungamati .
ex:NityaPuja_Bungamati a hg:RitualEvent ;
    rdfs:label "Daily nitya puja for Bungadyah" ;
    hg:ritualType "NityaPuja" ;
    crm:P8_took_place_on_or_within ex:BungamatiTemple ;
    hg:invokesDeity ex:Matsyendranath ;
    hg:recurrencePattern "daily" .

ex:SwayambhuMahachaitya a hg:Stupa ;
    rdfs:label "Swayambhu Mahachaitya" .
ex:GunlaBajan a hg:RitualEvent ;
    rdfs:label "Gunla bajan devotional music" ;
    crm:P8_took_place_on_or_within ex:SwayambhuMahachaitya ;
    hg:invokesDeity ex:Avalokitesvara ;
    hg:recurrencePattern "annual (Gunla month)" .

# --- festival around a shared syncretic deity (CQ22) ---
ex:BungadyahJatra a hg:Festival ;
    rdfs:label "Bungadyah Jatra (Rato Machhindranath festival)" ;
    hg:invokesDeity ex:Matsyendranath ;
    hg:performedByGroup ex:Manandhars , ex:Barahis .

# --- patronage (CQ20) ---
ex:KingLakshmiNarasimhaMalla a crm:E39_Actor ;
    rdfs:label "King Lakshmi Narasimha Malla (attributed)" .
ex:Prod_Kasthamandap hg:commissionedBy ex:KingLakshmiNarasimhaMalla .

# --- syncretism evidence + Kumari syncretism (CQ25, CQ27, CQ28) ---
ex:Syn_Karunamaya hg:mentionedInSource ex:Src_Slusser .
ex:Taleju hg:hasReligiousTradition ex:Hindu , ex:Buddhist .
ex:Vajradevi a hg:Deity ; rdfs:label "Vajradevi" ;
    hg:hasReligiousTradition ex:Buddhist .
ex:Syn_Taleju a hg:SyncreticRelationship ;
    rdfs:label "Taleju venerated as Vajradevi in Newar Buddhist practice" ;
    crm:P140_assigned_attribute_to ex:Taleju ;
    crm:P141_assigned ex:Vajradevi ;
    hg:syncreticType "Equivalence" ;
    hg:mentionedInSource ex:Src_Slusser .

# --- Living Goddess lifecycle completion (CQ26, CQ29, CQ32) ---
ex:KumariGhar a hg:ArchitecturalStructure ;
    rdfs:label "Kumari Ghar (Kumari Chen)" ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare .
ex:TS_Tenure2017 a crm:E52_Time-Span ; rdfs:label "2017--2025" .
ex:Tenure_2017 hg:hadParticipant ex:KumariPerson ;
    hg:residenceStructure ex:KumariGhar ;
    crm:P4_has_time-span ex:TS_Tenure2017 .
ex:KumariNityaPuja a hg:RitualEvent ;
    rdfs:label "Daily nitya puja at Kumari Ghar" ;
    hg:ritualType "NityaPuja" ;
    crm:P8_took_place_on_or_within ex:KumariGhar ;
    hg:recurrencePattern "daily" .
ex:TS_Ret2025 a crm:E52_Time-Span ; rdfs:label "2025" .
ex:Ret_2025 crm:P4_has_time-span ex:TS_Ret2025 ;
    crm:P3_has_note "Tenure ended at first menstruation, per tradition." .

# --- documented ritual transformation (CQ17) ---
ex:Assert_RouteChange a crminf:I2_Belief ;
    rdfs:label "Bungadyah procession route change (documented)" ;
    hg:assertsAbout ex:BungadyahProcession ;
    prov:value "Procession route adjusted after the 1934 earthquake" ;
    prov:wasDerivedFrom ex:Src_DoA ;
    prov:wasAttributedTo ex:DoA ;
    hg:confidenceScore "0.6"^^xsd:float .

# =====================================================================
# Required fields so the full demonstrator validates conformant against
# HeritageGraph.shacl.ttl (time-spans on events, begin dates on
# time-spans, identifiers on objects/persons, provenance on assertions
# and syncretic relationships).
# =====================================================================

# begin dates for existing time-spans
ex:TS_Festival crm:P82a_begin_of_the_begin "2025-08-29"^^xsd:date .
ex:TS_2015 crm:P82a_begin_of_the_begin "2015-04-25"^^xsd:date .
ex:TS_Tenure2017 crm:P82a_begin_of_the_begin "2017-09-28"^^xsd:date .
ex:TS_Ret2025 crm:P82a_begin_of_the_begin "2025-06-01"^^xsd:date .

# shared time-spans for recurring and historical events
ex:TS_Construction a crm:E52_Time-Span ; rdfs:label "Construction period (contested)" ;
    crm:P82a_begin_of_the_begin "1100-01-01"^^xsd:date .
ex:TS_Daily a crm:E52_Time-Span ; rdfs:label "Daily ritual cycle" ;
    crm:P82a_begin_of_the_begin "2025-01-01"^^xsd:date .
ex:TS_Gunla a crm:E52_Time-Span ; rdfs:label "Gunla month (annual)" ;
    crm:P82a_begin_of_the_begin "2025-07-25"^^xsd:date .
ex:TS_Bungadyah a crm:E52_Time-Span ; rdfs:label "Bungadyah Jatra season" ;
    crm:P82a_begin_of_the_begin "2025-04-20"^^xsd:date .

# time-spans on events that lacked one
ex:Prod_Kasthamandap crm:P4_has_time-span ex:TS_Construction .
ex:CA_2015 crm:P4_has_time-span ex:TS_2015 ;
    crm:P34_concerned ex:Kasthamandap .
ex:Ensh_Taleju crm:P4_has_time-span ex:TS_Construction .
ex:Sel_2017 crm:P4_has_time-span ex:TS_Tenure2017 ;
    hg:selectedPerson ex:KumariPerson .
ex:YosinErection crm:P4_has_time-span ex:TS_Festival .
ex:KumariProcession crm:P4_has_time-span ex:TS_Festival .
ex:NityaPuja_KM crm:P4_has_time-span ex:TS_Daily .
ex:NityaPuja_Bungamati crm:P4_has_time-span ex:TS_Daily .
ex:KumariNityaPuja crm:P4_has_time-span ex:TS_Daily .
ex:ShantiSwastiPuja crm:P4_has_time-span ex:TS_2015 .
ex:GunlaBajan crm:P4_has_time-span ex:TS_Gunla .
ex:BungadyahProcession crm:P4_has_time-span ex:TS_Bungadyah .
ex:BungadyahJatra crm:P4_has_time-span ex:TS_Bungadyah .

# location and identifiers for structures and objects
ex:SwayambhuHill a crm:E53_Place ; rdfs:label "Swayambhu hill" .
ex:SwayambhuMahachaitya crm:P55_has_current_location ex:SwayambhuHill ;
    dcterms:identifier "https://w3id.org/heritagegraph/demo/site/swayambhu"^^xsd:anyURI .
ex:TalejuTemple dcterms:identifier "https://w3id.org/heritagegraph/demo/site/taleju-temple"^^xsd:anyURI .
ex:BungamatiTemple dcterms:identifier "https://w3id.org/heritagegraph/demo/site/bungamati-temple"^^xsd:anyURI .
ex:KumariGhar dcterms:identifier "https://w3id.org/heritagegraph/demo/site/kumari-ghar"^^xsd:anyURI .
ex:Murti_Taleju dcterms:identifier "https://w3id.org/heritagegraph/demo/object/murti-taleju"^^xsd:anyURI .

# identifiers for persons and attributed agents
ex:KumariPerson dcterms:identifier "https://w3id.org/heritagegraph/demo/person/kumari-2017"^^xsd:anyURI .
ex:Slusser dcterms:identifier "https://w3id.org/heritagegraph/demo/agent/slusser"^^xsd:anyURI .
ex:DoA dcterms:identifier "https://w3id.org/heritagegraph/demo/agent/doa"^^xsd:anyURI .

# provenance completeness
ex:Assert_BuildA prov:generatedAtTime "2026-06-23T00:00:00"^^xsd:dateTime .
ex:Assert_BuildB prov:generatedAtTime "2026-06-23T00:00:00"^^xsd:dateTime .
ex:Assert_RouteChange prov:generatedAtTime "2026-06-23T00:00:00"^^xsd:dateTime .
ex:Syn_Karunamaya prov:wasDerivedFrom ex:Src_Slusser .
ex:Syn_Taleju prov:wasDerivedFrom ex:Src_Slusser .

# condition-state typing
ex:CS_Damaged hg:hasConditionType "Damaged" .

# =====================================================================
# CITED GOLD-STANDARD LAYER
# Every non-trivial fact in this demonstrator is attributed to a real,
# checkable source, so the CQ witnesses are transcribed from published
# scholarship / linked-data authorities rather than authored ad hoc
# (cf. SeaLiT's archival transcription and ArCo's ICCD grounding). This
# converts the "author-internal ABox" circularity concern into a cited
# exemplar KG, the field-standard practice for intangible heritage.
# Links use owl:sameAs to Wikidata (exact matches, machine-checkable) and
# rdfs:seeAlso for related entities; dcterms:source names the scholarly
# work each thematic cluster is drawn from.
# =====================================================================

# --- linked-data authority links (Wikidata, verified QIDs) ---
ex:Kasthamandap        owl:sameAs wd:Q6374805 .
ex:SwayambhuMahachaitya owl:sameAs wd:Q12946982 .
ex:IndraJatra          owl:sameAs wd:Q301339 .
ex:Bungamati           owl:sameAs wd:Q2608296 .
ex:Taleju              owl:sameAs wd:Q9355345 .
ex:BungadyahJatra      owl:sameAs wd:Q16971988 .
ex:KathmanduDurbarSquare owl:sameAs wd:Q6122177 .
ex:Earthquake2015      owl:sameAs wd:Q19830062 .
ex:Matsyendranath      rdfs:seeAlso wd:Q1420753 .
ex:TalejuTemple        rdfs:seeAlso wd:Q12947124 .

# --- canonical scholarship as bibliographic sources ---
ex:Src_Allen a hg:DataSource ; rdfs:label "Allen, The Cult of Kumari (1975)" ;
    dcterms:creator "Michael Allen" ; dcterms:date "1975" ;
    dcterms:bibliographicCitation "Allen, M. (1975). The Cult of Kumari: Virgin Worship in Nepal. Institute of Nepal and Asian Studies, Tribhuvan University." .
ex:Src_Toffin a hg:DataSource ; rdfs:label "Toffin, Newar Society (2007)" ;
    dcterms:creator "G\u00e9rard Toffin" ; dcterms:date "2007" ;
    dcterms:bibliographicCitation "Toffin, G. (2007). Newar Society: City, Village and Periphery. Himal Books." .
ex:Src_Gutschow a hg:DataSource ; rdfs:label "Gutschow, Architecture of the Newars (2011)" ;
    dcterms:creator "Niels Gutschow" ; dcterms:date "2011" ;
    dcterms:bibliographicCitation "Gutschow, N. (2011). Architecture of the Newars: A History of Building Typologies and Details in Nepal. Serindia Publications." .
ex:Src_Owens a hg:DataSource ; rdfs:label "Owens, The Politics of Divinity (1989)" ;
    dcterms:creator "Bruce McCoy Owens" ; dcterms:date "1989" ;
    dcterms:bibliographicCitation "Owens, B. M. (1989). The Politics of Divinity in the Kathmandu Valley: The Festival of Bungadya/Rato Matsyendranath. PhD dissertation, Columbia University." .
ex:Allen a crm:E39_Actor ; rdfs:label "Michael Allen" ;
    dcterms:identifier "https://w3id.org/heritagegraph/demo/agent/allen"^^xsd:anyURI .

# --- per-cluster source attribution (dcterms:source) ---
ex:Tenure_2017      dcterms:source ex:Src_Allen .
ex:Sel_2017         dcterms:source ex:Src_Allen .
ex:Ret_2025         dcterms:source ex:Src_Allen .
ex:KumariGhar       dcterms:source ex:Src_Allen .
ex:KumariNityaPuja  dcterms:source ex:Src_Allen .
ex:KumariProcession dcterms:source ex:Src_Allen .
ex:IndraJatra       dcterms:source ex:Src_Toffin .
ex:Manandhars       dcterms:source ex:Src_Toffin .
ex:Barahis          dcterms:source ex:Src_Toffin .
ex:KasthamandapGuthi dcterms:source ex:Src_Toffin .
ex:BungadyahProcession dcterms:source ex:Src_Owens .
ex:BungadyahJatra   dcterms:source ex:Src_Owens .
ex:BungamatiTemple  dcterms:source ex:Src_Owens .
ex:Kasthamandap     dcterms:source ex:Src_Gutschow .
ex:TalejuTemple     dcterms:source ex:Src_Gutschow .
ex:Syn_Karunamaya   dcterms:source ex:Src_Slusser .
ex:Syn_Taleju       dcterms:source ex:Src_Slusser .

# --- deepened flagship case: cited Kumari Hindu-Buddhist syncretism ---
# The Royal Kumari is chosen from the Newar Buddhist Shakya lineage yet is
# venerated as the Hindu goddess Taleju/Durga -- a documented living instance
# of the syncretism pattern (Allen 1975).
ex:ShakyaCommunity a hg:CasteGroup ;
    rdfs:label "Shakya (Newar Buddhist) lineage" ;
    hg:traditionalRole "hereditary lineage from which the Royal Kumari is selected" ;
    dcterms:source ex:Src_Allen .
ex:Assert_KumariSyncretism a crminf:I2_Belief ;
