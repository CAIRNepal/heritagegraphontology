    crm:P82a_begin_of_the_begin "2015-04-25T00:00:00"^^xsd:dateTime .
# Was the Kasthamandap construction period (from 1100 CE): the Taleju Temple
# that houses this enshrinement was built in 1564 (Mahendra Malla), so the
# enshrinement cannot begin earlier; its own date is not recorded here.
ex:TS_EnshTaleju a crm:E52_Time-Span ; rdfs:label "Enshrinement of Taleju (not before the temple's construction, 1564)" ;
    crm:P82a_begin_of_the_begin "1564-01-01T00:00:00"^^xsd:dateTime .

