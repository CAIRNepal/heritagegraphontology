    crm:P82a_begin_of_the_begin "2025-04-20T00:00:00"^^xsd:dateTime .
# One time-span per occurrence (CRM P4: several events share an E52 only if
# they begin and end through identical events). Where the data has no
# precise date, the part's time-span carries only a bound that is known to
# hold: it cannot begin before the festival, assessment or founding it
# belongs to begins.
ex:TS_YosinErection2025 a crm:E52_Time-Span ; rdfs:label "Raising of the lingo (yosin), 4 September 2025" ;
    crm:P82a_begin_of_the_begin "2025-09-04T00:00:00"^^xsd:dateTime ;
