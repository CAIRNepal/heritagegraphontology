# HeritageGraph demonstrator ABox — Kathmandu Valley exemplar.
# Maintained by hand against HeritageGraph 1.1.0, and extended with the
# CITED GOLD-STANDARD LAYER at the end of this file (SKOS links to Wikidata
# + hg:mentionedInSource attribution to published ethnographic scholarship).
# Hand-authored to exercise all four modelling patterns + the provenance and
# multi-calendar layers, and to give every one of the 32 competency questions
# (examples/queries/cq-abox-32.rq) at least one witness binding.
# The full demonstrator validates conformant against HeritageGraph.shacl.ttl
# (released open; see scripts/finalize_alpha5_artifacts.py). A separate
# minimal instance is examples/kathmandu-conformant.ttl.
@prefix hg:   <https://cair-nepal.org/heritagegraph/> .
@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crminf: <http://www.cidoc-crm.org/extensions/crminf/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix schema: <http://schema.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix crmsci: <http://www.cidoc-crm.org/extensions/crmsci/> .
@prefix crm:  <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix wd:   <http://www.wikidata.org/entity/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex:   <https://cair-nepal.org/heritagegraph/example/> .

# --- places & time-spans ---
ex:KathmanduDurbarSquare a crm:E53_Place ; rdfs:label "Kathmandu Durbar Square" .
ex:TS_Festival a crm:E52_Time-Span ; rdfs:label "Indra Jatra 2025 (from the raising of the lingo, 4 September 2025)" .

# --- tangible heritage: a sacred pavilion + its construction (event-mediated) ---
# Kasthamandap ("Maru Satta") is a multi-tiered public pavilion (sattal) housing
# a Gorakhnath shrine, not a temple (Kathmandu Post 2018, Src_KP_MaruSatta).
ex:Kasthamandap a hg:Sattal ;
    rdfs:label "Kasthamandap" ;
    dcterms:identifier "https://cair-nepal.org/heritagegraph/example/site/kasthamandap"^^xsd:anyURI ;
    hg:hasArchitecturalStyle <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare .

ex:Prod_Kasthamandap a crm:E12_Production ;
    rdfs:label "Construction of Kasthamandap" ;
    crm:P108_has_produced ex:Kasthamandap .
# Who built it and when are contested: the two accounts are the beliefs
# Assert_BuildA / Assert_BuildB below, not facts of this production. (Earlier
# versions stated a builder, "Licchavi builders", and a patron, King Lakshmi
# Narasimha Malla, here; neither was supported by a cited source.)

# condition history via an assessment event
ex:CA_2015 a crm:E14_Condition_Assessment ;
    rdfs:label "Post-2015-earthquake assessment of Kasthamandap" .
ex:CS_Ruined a crm:E3_Condition_State ; rdfs:label "Collapsed in the 2015 earthquake" .
# M10: the collapse altered Kasthamandap without ending its identity (the
# same monument was rebuilt on its foundations), so it is a natural
# alteration (CRMsci S18: change "without changing their identity"), part of
# the earthquake, not a CRM E6 destruction; the rebuild is a modification
# (E11), not a second production.
ex:Collapse_Kasthamandap2015 a crmsci:S18_Alteration ;
    rdfs:label "Collapse of the Kasthamandap superstructure in the 2015 earthquake" ;
    crmsci:O18_altered ex:Kasthamandap ;
    crm:P9i_forms_part_of ex:Earthquake2015 ;
    crm:P4_has_time-span ex:TS_Collapse2015 ;
    hg:mentionedInSource ex:Src_Durham_Kasthamandap .
ex:TS_Collapse2015 a crm:E52_Time-Span ; rdfs:label "25 April 2015" ;
    crm:P82a_begin_of_the_begin "2015-04-25T00:00:00"^^xsd:dateTime ;
    crm:P82b_end_of_the_end "2015-04-25T23:59:59"^^xsd:dateTime .
crmsci:S18_Alteration a owl:Class .
crmsci:O18_altered a owl:ObjectProperty .
crm:E11_Modification a owl:Class .
crm:P31_has_modified a owl:ObjectProperty .

# --- institutional layer: a Guthi custodian ---
# The guthi responsible for conserving Kasthamandap (myRepublica). The earlier
# statements that it performs Indra Jatra and is a temple guthi are not
# supported by the cited sources and were removed (Kasthamandap is a sattal).
ex:KasthamandapGuthi a hg:Guthi ;
    rdfs:label "Kasthamandap Guthi" ;
    crm:P50i_is_current_keeper_of ex:Kasthamandap ;
    hg:mentionedInSource ex:Src_Republica_Kasthamandap .
ex:Src_Republica_Kasthamandap a hg:DataSource ; rdfs:label "myRepublica, Kasthamandap losing its grandeur" ;
    hg:sourceCreator ex:MyRepublica ;
    hg:sourceCitation "myRepublica. Kasthamandap losing its grandeur. https://myrepublica.nagariknetwork.com/news/kasthamandap-losing-its-grandeur" .

# --- ritual layer + multi-calendar recurrence ---
ex:IndraJatra a hg:RitualEvent ;
    rdfs:label "Indra Jatra" ;
    crm:P4_has_time-span ex:TS_Festival ;
    hg:recurrencePattern "annual" .

# --- syncretic relationships (provenance-aware) ---
# The deity of Bungamati and Patan is Bungadyah, with its own identity. Newar
# Buddhists worship it as Karunamaya, Bunga Lokeshvara, a form of the
# bodhisattva Avalokiteshvara; from the seventeenth century it was also
# associated with the Hindu Nath yogi Matsyendranath, as Rato Machhindranath
# (Alsop 2023, Src_Alsop_BungaDya; Locke 1980, Src_Locke1980). The two
# identifications are separate acts. (Earlier versions made Avalokiteshvara
# the deity identified as Matsyendranath, which inverted the history.)
ex:Bungadyah a hg:Deity ; rdfs:label "Bungadyah (Bunga Dyah)" ;
    hg:mentionedInSource ex:Src_Alsop_BungaDya .
ex:Avalokitesvara a hg:Deity ; rdfs:label "Avalokiteshvara" ;
    hg:hasReligiousTradition ex:Buddhist .
ex:Matsyendranath a hg:Deity ; rdfs:label "Matsyendranath" ;
    hg:hasReligiousTradition ex:Hindu .
ex:Buddhist a hg:ReligiousTradition ; rdfs:label "Buddhist" .
ex:Hindu a hg:ReligiousTradition ; rdfs:label "Hindu" .
ex:Syn_Karunamaya a hg:SyncreticRelationship ;
    rdfs:label "Bungadyah worshipped by Newar Buddhists as Karunamaya (Bunga Lokeshvara), a form of Avalokiteshvara" ;
    crm:P140_assigned_attribute_to ex:Bungadyah ;
    crm:P141_assigned ex:Avalokitesvara ;
    hg:syncreticType <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> .
ex:Syn_Matsyendranath a hg:SyncreticRelationship ;
    rdfs:label "Bungadyah associated with the Nath yogi Matsyendranath (from the seventeenth century)" ;
    crm:P140_assigned_attribute_to ex:Bungadyah ;
    crm:P141_assigned ex:Matsyendranath ;
    hg:syncreticType <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> ;
    crm:P3_has_note "Alsop (2023): in the seventeenth century Bunga Dya became associated with the Hindu Nath yogi Matsyendranath, as Rato Macchendranath." ;
    hg:mentionedInSource ex:Src_Alsop_BungaDya .

# --- Living Goddess lifecycle ---
ex:Taleju a hg:Deity ; rdfs:label "Taleju Bhavani" .
# The two holders of the office are living minors. They are identified only by
# office and period (role-based IRIs and labels); nothing about the child is
# recorded beyond what the office's public calendar states.
ex:RoyalKumariHolder_2017 a crm:E21_Person ; rdfs:label "Holder of the Royal Kumari office, tenure 2017-2025" .
ex:Tenure_2017 a hg:KumariTenure ;
    rdfs:label "Royal Kumari tenure (2017--2025)" ;
    hg:embodiedDeity ex:Taleju ;
    hg:supportedByInstitution ex:GuthiSansthan .
# the Kathmandu Guthi Office (Guthi Sansthan) bears the Kumari's lodging, food,
# daily worship and festival costs during her stay (Src_Republica_Kumari)
ex:GuthiSansthan a hg:StateHeritageAuthority ;
    rdfs:label "Guthi Sansthan (Kathmandu Guthi Office)" ;
    crm:P3_has_note "Public corporation established in 1964 CE (VS 2021) to take over the administration of guthi land." ;
    hg:mentionedInSource ex:Src_KP_GuthiBill , ex:Src_Republica_Kumari .
ex:Sel_2017 a hg:KumariSelectionEvent ;
    rdfs:label "Selection event" ; hg:initiatedTenure ex:Tenure_2017 .
ex:Ret_2025 a hg:KumariRetirementEvent ;
    rdfs:label "Retirement event" ; hg:endedTenureOf ex:Tenure_2017 .

# --- epistemic provenance: TWO CONFLICTING, source-attributed claims ---
ex:Assert_BuildA a crminf:I2_Belief ;
    rdfs:label "Kasthamandap build-date (account A)" ;
    hg:assertsAbout ex:Kasthamandap ;
    prov:value "12th century CE" ;
    prov:wasDerivedFrom ex:Src_Slusser ;
    prov:wasAttributedTo ex:Slusser ;
    hg:confidenceScore "0.7"^^xsd:decimal .
ex:Assert_BuildB a crminf:I2_Belief ;
    rdfs:label "Kasthamandap build-date (account B)" ;
    hg:assertsAbout ex:Kasthamandap ;
    prov:value "early 7th to early 9th century CE" ;
    crm:P3_has_note "Radiocarbon dates from the foundations: early 7th to early 9th century CE, with a major reconstruction in the 11th to 12th century." ;
    prov:wasDerivedFrom ex:Src_Durham_Kasthamandap ;
    prov:wasAttributedTo ex:DurhamTeam ;
    hg:confidenceScore "0.5"^^xsd:decimal .
ex:Src_Slusser a hg:DataSource ; rdfs:label "Slusser, Nepal Mandala (1982)" ;
    hg:sourceCreator ex:Slusser ; dcterms:date "1982" ;
    hg:sourceCitation "Slusser, M. S. (1982). Nepal Mandala: A Cultural Study of the Kathmandu Valley. Princeton University Press." .
ex:Src_Durham_Kasthamandap a hg:DataSource ;
    rdfs:label "Durham University, Kasthamandap: causes of collapse" ;
    hg:sourceCreator ex:DurhamTeam ;
    hg:sourceCitation "Durham University. Resilience: causes of collapse (post-2015 archaeological investigation of the Kasthamandap). https://stories.durham.ac.uk/resilience-2" .
ex:DurhamTeam a crm:E39_Actor ; rdfs:label "Durham University (authors of the cited post-earthquake investigation)" .
# Illustrative: an invented source and agent, used only by the illustrative
# belief Assert_RouteChange. They stand for no real body or publication.
ex:Src_Illustrative a hg:DataSource ; rdfs:label "Illustrative source (fictional; no real publication)" ;
    hg:sourceCreator ex:IllustrativeAgent .
ex:IllustrativeAgent a crm:E39_Actor ; rdfs:label "Illustrative agent (fictional; stands for no real person or body)" .
ex:Slusser a crm:E39_Actor ; rdfs:label "M. S. Slusser" .

# =====================================================================
# Witnesses so that every one of the 32 CQs (examples/queries/
# cq-abox-32.rq) returns at least one binding over this demonstrator.
# =====================================================================

# --- structural fabric (CQ2, CQ5, CQ6, CQ8, CQ18, CQ19, CQ23) ---
ex:Pinnacle_KM a hg:ArchitecturalElement ;
    rdfs:label "Gajur (pinnacle) of Kasthamandap" ;
    crm:P46i_forms_part_of ex:Kasthamandap .

ex:Kasthamandap hg:participatesInRitual ex:IndraJatra ;
    hg:managedByGuthi ex:KasthamandapGuthi ;
    crm:P34i_was_assessed_by ex:CA_2015 ;
    hg:hasAssertion ex:Assert_BuildA , ex:Assert_BuildB ;
    hg:hasReligiousTradition ex:Hindu .
# Kasthamandap houses a shrine of the Nath yogi Gorakhnath (Src_KP_MaruSatta);
# no cited source supports a Buddhist tradition for it, so none is recorded
# (earlier versions recorded Hindu and Buddhist).

ex:CA_2015 crm:P35_has_identified ex:CS_Ruined .

ex:KathmanduDurbarSquare crm:P53i_is_former_or_current_location_of ex:Kasthamandap , ex:TalejuTemple .

ex:TalejuTemple a hg:Temple ;
    rdfs:label "Taleju Temple, Hanuman Dhoka" ;
    hg:hasArchitecturalStyle <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare .

# --- enshrinement (CQ7) ---
ex:Ensh_Taleju a hg:Enshrinement ;
    rdfs:label "Enshrinement of Taleju at Hanuman Dhoka" ;
    hg:enshrinedDeity ex:Taleju ;
    hg:enshrinedInStructure ex:TalejuTemple ;
    crm:P7_took_place_at ex:KathmanduDurbarSquare .

# --- historical event + crisis ritual (CQ4, CQ14) ---
ex:TS_2015 a crm:E52_Time-Span ; rdfs:label "25 April 2015" .
ex:Earthquake2015 a hg:HistoricalEvent ;
    rdfs:label "Gorkha earthquake (2015)" ;
    hg:architecturalStructures ex:Kasthamandap ;
    crm:P4_has_time-span ex:TS_2015 .
ex:ShantiSwastiPuja a hg:RitualEvent ;
    rdfs:label "Shanti swasti puja (post-earthquake propitiation)" ;
    crm:P17_was_motivated_by ex:Earthquake2015 ;
    hg:recurrencePattern "extraordinary (crisis-triggered)" .

# --- ritual layer enrichment (CQ8-CQ12, CQ16, CQ22, CQ30) ---
ex:Indra a hg:Deity ; rdfs:label "Indra" ; hg:hasReligiousTradition ex:Hindu .
ex:IndraJatra crm:P7_took_place_at ex:KathmanduDurbarSquare ;
    hg:invokesDeity ex:Indra .
ex:IndraJatra a hg:Festival .
# the Kumari chariot procession is part of Indra Jatra and essential to it
ex:KumariProcession crm:P9i_forms_part_of ex:IndraJatra ;
    hg:isCriticalForFestival true .

# The documented Manandhar role in Indra Jatra is the yosin (lingo) pole: the
# Manandhar Sangh handles all its rituals, and the Chansa Sayamis hoist it
# (Kathmandu Post 2019, Src_KP_IndraJatra2019). Earlier versions called the
# Manandhars "hereditary chariot pullers and oil pressers" and had them pull
# the Kumari chariot and take part in Bungadyah Jatra; no source supports
# this (the chariots are "manually pulled by the locals", ibid.).
ex:Manandhars a hg:CasteGroup ;
    rdfs:label "Manandhar community" ;
    hg:traditionalRole "responsible, through the Manandhar Sangh, for the rituals of the yosin (lingo) pole of Indra Jatra" ;
    hg:mentionedInSource ex:Src_KP_IndraJatra2019 .
ex:ChansaSayamis a crm:E74_Group ;
    rdfs:label "Chansa Sayamis (hoisters of the yosin pole)" ;
    hg:mentionedInSource ex:Src_KP_IndraJatra2019 .
ex:Barahis a hg:CasteGroup ;
    rdfs:label "Barahi community" ;
    hg:traditionalRole "hereditary chariot carpenters" ;
    hg:mentionedInSource ex:Src_NT_Barahi .
# The Yewals (Yahwal), master vinesmen who weave the rope and rattan that
# secure the chariot's wooden structure (Nepali Times 2015, Src_NT_Barahi).
ex:Yewals a hg:CasteGroup ;
    rdfs:label "Yewal (Yahwal) community" ;
    hg:traditionalRole "weave the rope and rattan that secure the wooden structure of the Bungadyah chariot" ;
    hg:mentionedInSource ex:Src_NT_Barahi .

ex:NityaPuja_KM a hg:RitualEvent ;
    rdfs:label "Daily nitya puja at Kasthamandap" ;
    hg:ritualType <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> ;
    crm:P8_took_place_on_or_within ex:Kasthamandap ;
    hg:recurrencePattern "daily" .

# The raising of the pole marks the official start of the festival (Kathmandu
# Post 2019), hence part of Indra Jatra and critical for it.
ex:YosinErection a hg:RitualEvent ;
    rdfs:label "Raising of the yosin (lingo) pole, with its rituals" ;
    crm:P9i_forms_part_of ex:IndraJatra ;
    hg:isCriticalForFestival true ;
    crm:P183_ends_before_the_start_of ex:KumariProcession ;
    hg:performedByGroup ex:Manandhars ;
    crm:P14_carried_out_by ex:Manandhars , ex:ChansaSayamis ;
    crm:P3_has_note "The Manandhar Sangh handles all the rituals of the pole; the Chansa Sayamis hoist it (Kathmandu Post 2019)." ;
    hg:mentionedInSource ex:Src_KP_IndraJatra2019 .
ex:KumariProcession a hg:RitualEvent ;
    rdfs:label "Kumari chariot procession" ;
    hg:ritualType <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> ;
    hg:hadParticipant ex:RoyalKumariHolder_2017 ;
    crm:P183i_starts_after_the_end_of ex:YosinErection .

# --- a restricted iconographic object (CQ3) ---
# Taleju's image is not public: access to her temple is traditionally
# restricted, the temple opening to devotees only on Mahanawami of Dashain
# (Onlinekhabar 2017, Src_OK_Taleju). The record therefore carries the access
# protocol InitiatesOnly and states no handler and no ritual use; the protocol
# value is the cataloguer's, to be confirmed with the community concerned.
# (Earlier versions said the murti was used in Indra Jatra and handled by a
# Karmacharya priest; no published source supports either.)
ex:Murti_Taleju a hg:Murti ;
    rdfs:label "Murti of Taleju Bhavani" ;
    crm:P62_depicts ex:Taleju ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare ;
    hg:accessProtocol <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> ;
    hg:mentionedInSource ex:Src_OK_Taleju .

# --- procession with route, materials, techniques (CQ13, CQ15, CQ24) ---
ex:Bungamati a crm:E53_Place ; rdfs:label "Bungamati" .
ex:Pulchowk a crm:E53_Place ; rdfs:label "Pulchowk, Patan" .
ex:Patan a crm:E53_Place ; rdfs:label "Patan (Lalitpur)" .
ex:Jawalakhel a crm:E53_Place ; rdfs:label "Jawalakhel" .
ex:SalWood a crm:E57_Material ; rdfs:label "Sal wood" .
ex:ChariotConstruction a crm:E29_Design_or_Procedure ; rdfs:label "Traditional chariot construction" .

# The 2025 occurrence. In ordinary years the chariot is built at Pulchowk and
# pulled from there through Patan to Jawalakhel (Himal Press, 28 April 2025;
# Wikipedia, Rato Machindranath Jatra); only in the twelve-yearly jatra is it
# built at and pulled from Bungamati (DANAM, Bungamati focus area). Earlier
# versions started the 2025 procession at Bungamati.
ex:BungadyahProcession a hg:RitualEvent ;
    rdfs:label "Bungadyah (Rato Machhindranath) chariot procession, 2025" ;
    hg:ritualType <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> ;
    hg:invokesDeity ex:Bungadyah ;
    hg:startPlace ex:Pulchowk ;
    hg:endPlace ex:Jawalakhel ;
    hg:routePlaces ex:Patan ;
    hg:routeDescription "Pulchowk through Gabahal, Mangal Bazar, Hakha, Sundhara, Chakrabahil and Lagankhel to Jawalakhel (ordinary-year chariot route)" ;
    crm:P125_used_object_of_type ex:SalWood ;
    crm:P33_used_specific_technique ex:ChariotConstruction ;
    crm:P7_took_place_at ex:Patan .

# DANAM (BUN0001): one of the rare Shikhara-style Buddhist temples of the
# Valley, also worshipped by Vaishnavas, Shaivas, Shaktas, Brahmins and
# hermits, each under another identity.
ex:BungamatiTemple a hg:Temple ;
    rdfs:label "Karunamaya Mandira (temple of Bungadyah), Bungamati" ;
    hg:hasArchitecturalStyle <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> ;
    hg:hasReligiousTradition ex:Buddhist , ex:Hindu ;
    crm:P55_has_current_location ex:Bungamati ;
    hg:mentionedInSource ex:Src_DANAM_Bungamati .
ex:NityaPuja_Bungamati a hg:RitualEvent ;
    rdfs:label "Daily nitya puja for Bungadyah" ;
    hg:ritualType <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> ;
    crm:P8_took_place_on_or_within ex:BungamatiTemple ;
    hg:invokesDeity ex:Bungadyah ;
    hg:recurrencePattern "daily" .

ex:SwayambhuMahachaitya a hg:Stupa ;
    rdfs:label "Swayambhu Mahachaitya" .
ex:GunlaBajan a hg:RitualEvent ;
    rdfs:label "Gunla bajan devotional music" ;
    crm:P8_took_place_on_or_within ex:SwayambhuMahachaitya ;
    hg:recurrencePattern "annual (Gunla month)" .
# No deity is recorded: Gunla bajan goes to Swayambhu in honour of the
# Svayambhu caitya and the Buddha, not of Avalokiteshvara (earlier versions).

# --- festival around a shared syncretic deity (CQ22) ---
ex:BungadyahJatra a hg:Festival ;
    rdfs:label "Bungadyah Jatra (Rato Machhindranath festival)" ;
    hg:invokesDeity ex:Bungadyah ;
    hg:performedByGroup ex:Barahis , ex:Yewals .

# --- patronage (CQ20) ---
ex:KingMahendraMalla a crm:E21_Person ; rdfs:label "King Mahendra Malla of Kathmandu" ;
    dcterms:identifier "https://cair-nepal.org/heritagegraph/example/person/mahendra-malla"^^xsd:anyURI .
ex:Prod_TalejuTemple a crm:E12_Production ;
    rdfs:label "Construction of the Taleju Temple, Hanuman Dhoka" ;
    crm:P108_has_produced ex:TalejuTemple ;
    hg:commissionedBy ex:KingMahendraMalla ;
    crm:P4_has_time-span ex:TS_TalejuTemple1564 ;
    hg:mentionedInSource ex:Src_Wikipedia_TalejuTemple .
ex:TS_TalejuTemple1564 a crm:E52_Time-Span ; rdfs:label "1564 CE" ;
    crm:P82a_begin_of_the_begin "1564-01-01T00:00:00"^^xsd:dateTime ;
    crm:P82b_end_of_the_end "1564-12-31T23:59:59"^^xsd:dateTime .
ex:Src_Wikipedia_TalejuTemple a hg:DataSource ; rdfs:label "Wikipedia, Taleju Temple, Kathmandu" ;
    hg:sourceCitation "Taleju Temple, Kathmandu. Wikipedia. https://en.wikipedia.org/wiki/Taleju_Temple,_Kathmandu (built by King Mahendra Malla in 1564)" .
ex:Ensh_Taleju hg:mentionedInSource ex:Src_Wikipedia_TalejuTemple .

# --- syncretism evidence + Kumari syncretism (CQ25, CQ27, CQ28) ---
ex:Syn_Karunamaya hg:mentionedInSource ex:Src_Alsop_BungaDya , ex:Src_Locke1980 .
ex:Taleju hg:hasReligiousTradition ex:Hindu .
# The documented Buddhist identification is of the Kumari, not of Taleju:
# "To Newar Buddhists, the kumari is regarded as the embodiment of the supreme
# female deity Vajradevi" (Tree 2015, National Geographic); Vajrayana
# Buddhists "regard her as their chief female deity Vajradevi" (Hinduism Today
# 1997). It is recorded as an attributed belief about the Kumari office
# (Assert_KumariVajradevi below). Earlier versions identified Taleju with
# Vajradevi, attributed to Slusser without a page; that could not be verified.
ex:Vajradevi a hg:Deity ; rdfs:label "Vajradevi" ;
    hg:hasReligiousTradition ex:Buddhist .

# --- Living Goddess lifecycle completion (CQ26, CQ29, CQ32) ---
ex:KumariGhar a hg:KumariHouse ;
    rdfs:label "Kumari Ghar (Kumari Chen)" ;
    crm:P55_has_current_location ex:KathmanduDurbarSquare .
ex:TS_Tenure2017 a crm:E52_Time-Span ; rdfs:label "2017--2025" .
ex:Tenure_2017 hg:tenureHolder ex:RoyalKumariHolder_2017 ;
    hg:residenceStructure ex:KumariGhar ;
    crm:P4_has_time-span ex:TS_Tenure2017 .
ex:KumariNityaPuja a hg:RitualEvent ;
    rdfs:label "Daily nitya puja at Kumari Ghar" ;
    hg:ritualType <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> ;
    crm:P8_took_place_on_or_within ex:KumariGhar ;
    hg:hadParticipant ex:RoyalKumariHolder_2017 ;
    hg:recurrencePattern "daily" .
ex:TS_Ret2025 a crm:E52_Time-Span ; rdfs:label "30 September 2025 (successor installed)" .
ex:Ret_2025 crm:P4_has_time-span ex:TS_Ret2025 ;
    # The record states the event and its date, not a reason (no reason for a
    # named child's retirement is recorded).
    crm:P3_has_note "The successor was installed on 30 September 2025." ;
    hg:mentionedInSource ex:Src_AP_Kumari2025 .

# --- an ILLUSTRATIVE ritual transformation (CQ17) ---
# Not a documented fact: no source reports such a route change. The belief,
# its source and its agent are invented to show the pattern, and are
# attributed to no real body (earlier versions attributed it to the
# Department of Archaeology).
ex:Assert_RouteChange a crminf:I2_Belief ;
    rdfs:label "Bungadyah procession route change (illustrative, not documented)" ;
    hg:assertsAbout ex:BungadyahProcession ;
    prov:value "Illustrative only: a route change after the 1934 earthquake (no source)" ;
    prov:wasDerivedFrom ex:Src_Illustrative ;
    prov:wasAttributedTo ex:IllustrativeAgent ;
    hg:confidenceScore "0.6"^^xsd:decimal .

