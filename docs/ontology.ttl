###  https://w3id.org/heritagegraph/ConditionType
<https://w3id.org/heritagegraph/ConditionType> rdf:type owl:Class ;
                                               owl:equivalentClass [ rdf:type owl:Class ;
                                                                     owl:oneOf ( <https://w3id.org/heritagegraph/ConditionType#Damaged>
                                                                                 <https://w3id.org/heritagegraph/ConditionType#Good>
                                                                                 <https://w3id.org/heritagegraph/ConditionType#Restored>
                                                                                 <https://w3id.org/heritagegraph/ConditionType#Ruined>
                                                                               )
                                                                   ] ;
                                               rdfs:label "Condition Type"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Controlled vocabulary for the physical condition of heritage objects and structures."@en ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> ;
                                               <https://w3id.org/linkml/permissible_values> <https://w3id.org/heritagegraph/ConditionType#Damaged> ,
                                                                                            <https://w3id.org/heritagegraph/ConditionType#Good> ,
                                                                                            <https://w3id.org/heritagegraph/ConditionType#Restored> ,
                                                                                            <https://w3id.org/heritagegraph/ConditionType#Ruined> .


