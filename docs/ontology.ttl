                                             rdfs:range <https://w3id.org/heritagegraph/Place> ;
                                             rdfs:label "start_place" ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Starting location of movement ritual" ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


