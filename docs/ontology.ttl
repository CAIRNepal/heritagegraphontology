@prefix : <https://w3id.org/heritagegraph/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/heritagegraph/ontology#> .

<https://w3id.org/heritagegraph/ontology> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://w3id.org/heritagegraph/ontology/0.1.0> ;
                                           <http://purl.org/dc/terms/bibliographicCitation> "CAIR-Nepal (2026). HeritageGraph Ontology (0.1.0). https://w3id.org/heritagegraph/ontology" ;
                                           <http://purl.org/dc/terms/created> "2025-11-23"^^xsd:date ;
                                           <http://purl.org/dc/terms/creator> "CAIR-Nepal" ;
                                           <http://purl.org/dc/terms/description> "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning."@en ;
                                           <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                           <http://purl.org/dc/terms/modified> "2026-07-22"^^xsd:date ;
                                           <http://purl.org/dc/terms/publisher> "CAIR-Nepal" ;
                                           <http://purl.org/dc/terms/source> <https://github.com/CAIRNepal/heritagegraphontology> ;
                                           <http://purl.org/dc/terms/title> "HeritageGraph Ontology"@en ;
                                           <http://purl.org/ontology/bibo/status> "Pre-release specification draft" ;
                                           <http://purl.org/pav/version> "0.1.0" ;
                                           <http://purl.org/vocab/vann/preferredNamespacePrefix> "heritageGraph" ;
                                           <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/heritagegraph/" ;
                                           rdfs:label "HeritageGraph"@en ;
                                           owl:versionInfo "0.1.0" ;
                                           <http://www.w3.org/2004/02/skos/core#definition> "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning."@en .

