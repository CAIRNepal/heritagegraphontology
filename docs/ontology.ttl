###  https://w3id.org/heritagegraph/SyncreticRelationship
<https://w3id.org/heritagegraph/SyncreticRelationship> rdf:type owl:Class ;
                                                       rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to> ;
                                                                         owl:allValuesFrom <https://w3id.org/heritagegraph/Deity>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P141_assigned> ;
                                                                         owl:allValuesFrom <https://w3id.org/heritagegraph/Deity>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/prov#used> ;
                                                                         owl:allValuesFrom <http://www.w3.org/ns/prov#Entity>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/heritagegraph/documentedBy> ;
                                                                         owl:allValuesFrom <https://w3id.org/heritagegraph/DocumentationActivity>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/heritagegraph/mentionedInSource> ;
                                                                         owl:allValuesFrom <https://w3id.org/heritagegraph/DataSource>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/heritagegraph/syncreticType> ;
                                                                         owl:allValuesFrom <https://w3id.org/heritagegraph/SyncreticType>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to> ;
                                                                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P141_assigned> ;
                                                                         owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.w3.org/ns/prov#used> ;
                                                                         owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/heritagegraph/documentedBy> ;
                                                                         owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/heritagegraph/mentionedInSource> ;
                                                                         owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/heritagegraph/syncreticType> ;
                                                                         owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to> ;
                                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/heritagegraph/syncreticType> ;
                                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P3_has_note> ;
                                                                         owl:allValuesFrom xsd:string
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P3_has_note> ;
                                                                         owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P3_has_note> ;
                                                                         owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                       ] ;
                                                       rdfs:label "Syncretic Relationship"@en ;
                                                       <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.cidoc-crm.org/cidoc-crm/E13_Attribute_Assignment> ;
                                                       <http://www.w3.org/2004/02/skos/core#definition> "Formalizes the syncretic equivalence between divine entities across different theological frameworks. Following CIDOC CRM E13, it treats syncretism as a propositional claim with associated epistemic authority and provenance."@en ;
                                                       <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> .


###  https://w3id.org/heritagegraph/SyncreticType
<https://w3id.org/heritagegraph/SyncreticType> rdf:type owl:Class ;
                                               owl:equivalentClass [ rdf:type owl:Class ;
                                                                     owl:oneOf ( <https://w3id.org/heritagegraph/SyncreticType#Appropriation>
                                                                                 <https://w3id.org/heritagegraph/SyncreticType#Equivalence>
                                                                                 <https://w3id.org/heritagegraph/SyncreticType#Fusion>
                                                                                 <https://w3id.org/heritagegraph/SyncreticType#Historical>
                                                                               )
                                                                   ] ;
                                               rdfs:label "Syncretic Type"@en ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Controlled vocabulary for kinds of syncretic theological relationships between deities."@en ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> ;
                                               <https://w3id.org/linkml/permissible_values> <https://w3id.org/heritagegraph/SyncreticType#Appropriation> ,
                                                                                            <https://w3id.org/heritagegraph/SyncreticType#Equivalence> ,
                                                                                            <https://w3id.org/heritagegraph/SyncreticType#Fusion> ,
                                                                                            <https://w3id.org/heritagegraph/SyncreticType#Historical> .


###  https://w3id.org/heritagegraph/Temple
<https://w3id.org/heritagegraph/Temple> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/heritagegraph/ReligiousStructure> ,
                                                        [ rdf:type owl:Restriction ;
