                                                          owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/heritagegraph/hasArchitecturalStyle> ;
                                                          owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/heritagegraph/hasArchitecturalStyle> ;
                                                          owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                        ] ;
                                        rdfs:label "Temple"@en ;
                                        <http://www.w3.org/2004/02/skos/core#altLabel> "Mandir"@en ;
                                        <http://www.w3.org/2004/02/skos/core#broadMatch> <http://dbpedia.org/ontology/ReligiousBuilding> ;
                                        <http://www.w3.org/2004/02/skos/core#closeMatch> <http://schema.org/HinduTemple> ,
                                                                                         <http://schema.org/PlaceOfWorship> ;
                                        <http://www.w3.org/2004/02/skos/core#definition> "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion."@en ;
                                        <http://www.w3.org/2004/02/skos/core#exactMatch> <http://dbpedia.org/ontology/Temple> ,
