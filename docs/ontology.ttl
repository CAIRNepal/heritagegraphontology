                                               rdfs:label "ritual_events" ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Collection of RitualEvent instances" ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/ritual_on_structure
<https://w3id.org/heritagegraph/ritual_on_structure> rdf:type owl:ObjectProperty ;
                                                     rdfs:subPropertyOf <http://www.cidoc-crm.org/cidoc-crm/P8_took_place_on_or_within> ;
                                                     rdfs:range <https://w3id.org/heritagegraph/PhysicalHeritageThing> ;
                                                     rdfs:label "ritual_on_structure" ;
                                                     <http://www.w3.org/2004/02/skos/core#definition> "Ritual occurs at specific temple or monument" ;
                                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/ritual_type
<https://w3id.org/heritagegraph/ritual_type> rdf:type owl:ObjectProperty ;
                                             rdfs:range <https://w3id.org/heritagegraph/RitualTypeEnum> ;
                                             rdfs:label "ritual_type" ;
                                             <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.cidoc-crm.org/cidoc-crm/P2_has_type> ;
                                             <http://www.w3.org/2004/02/skos/core#definition> "Classification of ritual (puja, jatra, consecration)" ;
                                             <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/route_places
