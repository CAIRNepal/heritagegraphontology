                                                              owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                            ] ,
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty <https://w3id.org/heritagegraph/roleDeity> ;
                                                              owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                            ] ;
                                            rdfs:label "Kumari Role"@en ;
                                            <http://www.w3.org/2004/02/skos/core#altLabel> "Living Goddess"@en ,
                                                                                           "Royal Kumari"@en ;
                                            <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.cidoc-crm.org/cidoc-crm/E55_Type> ;
                                            <http://www.w3.org/2004/02/skos/core#definition> "The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder."@en ;
                                            <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> .


