###  https://w3id.org/heritagegraph/confidenceScore
<https://w3id.org/heritagegraph/confidenceScore> rdf:type owl:DatatypeProperty ;
                                                 rdfs:range [ rdf:type rdfs:Datatype ;
                                                              owl:intersectionOf ( xsd:float
                                                                                   [ rdf:type rdfs:Datatype ;
                                                                                     owl:onDatatype xsd:integer ;
                                                                                     owl:withRestrictions ( [ xsd:minInclusive 0
                                                                                                            ]
                                                                                                          )
                                                                                   ]
                                                                                   [ rdf:type rdfs:Datatype ;
                                                                                     owl:onDatatype xsd:integer ;
                                                                                     owl:withRestrictions ( [ xsd:maxInclusive 1
                                                                                                            ]
                                                                                                          )
                                                                                   ]
                                                                                 )
                                                            ] ;
                                                 rdfs:label "Confidence score"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Reliability score for assertion (0.0-1.0)"@en ;
                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> .


