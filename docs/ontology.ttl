                                                       owl:onProperty <http://www.w3.org/ns/prov#endedAtTime> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/prov#startedAtTime> ;
                                                       owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://purl.org/dc/terms/identifier> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/prov#endedAtTime> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty <http://www.w3.org/ns/prov#startedAtTime> ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     rdfs:label "Activity"@en ;
                                     <http://www.w3.org/2004/02/skos/core#definition> "Direct LinkML representation of prov:Activity. Applied to events and processes that use, transform, generate, document, assess, or verify entities."@en ;
                                     <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/heritagegraph/Activity> ;
                                     <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class ;
                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/prov#actedOnBehalfOf> ;
                                                    owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/prov#wasInfluencedBy> ;
                                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                                        owl:unionOf ( <http://www.w3.org/ns/prov#Activity>
                                                                                      <http://www.w3.org/ns/prov#Agent>
                                                                                      <http://www.w3.org/ns/prov#Entity>
                                                                                    )
                                                                      ]
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/prov#actedOnBehalfOf> ;
                                                    owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://www.w3.org/ns/prov#wasInfluencedBy> ;
                                                    owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.org/dc/terms/identifier> ;
                                                    owl:allValuesFrom xsd:anyURI
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.org/dc/terms/identifier> ;
                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <http://purl.org/dc/terms/identifier> ;
                                                    owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                  ] ;
                                  rdfs:label "Agent"@en ;
                                  <http://www.w3.org/2004/02/skos/core#definition> "Direct LinkML representation of prov:Agent. Agents bear responsibility for activities or entities. PROV-O permits an individual agent also to be typed as an Entity, but does not define every Agent as a subclass of Entity."@en ;
                                  <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/heritagegraph/Agent> ;
                                  <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> .


###  http://www.w3.org/ns/prov#Entity
<http://www.w3.org/ns/prov#Entity> rdf:type owl:Class ;
                                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasAttributedTo> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/prov#Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasDerivedFrom> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/prov#Entity>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasGeneratedBy> ;
                                                     owl:allValuesFrom <http://www.w3.org/ns/prov#Activity>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasInfluencedBy> ;
                                                     owl:allValuesFrom [ rdf:type owl:Class ;
                                                                         owl:unionOf ( <http://www.w3.org/ns/prov#Activity>
                                                                                       <http://www.w3.org/ns/prov#Agent>
                                                                                       <http://www.w3.org/ns/prov#Entity>
                                                                                     )
                                                                       ]
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasAttributedTo> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasDerivedFrom> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasGeneratedBy> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasInfluencedBy> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#wasGeneratedBy> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/dc/terms/identifier> ;
                                                     owl:allValuesFrom xsd:anyURI
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                     owl:allValuesFrom xsd:dateTime
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/dc/terms/identifier> ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://purl.org/dc/terms/identifier> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   rdfs:label "Entity"@en ;
                                   <http://www.w3.org/2004/02/skos/core#definition> "Direct LinkML representation of prov:Entity. Applied to physical, digital, conceptual, and assertion-bearing things that participate in provenance relations. PROVENANCE SCOPE (design decision): for classes whose instances are real-world referents (structures, deities, places, actors), the provenance slots (was_derived_from, was_attributed_to, was_generated_by, generated_at_time) describe the DATA RECORD about the referent, not the referent itself -- a stupa is not generated by the survey that records it. Referent-level history is modelled through events (Production, DestructionEvent, etc.). RDF deployments SHOULD carry record-level provenance in named graphs or on InformationObject/Assertion nodes."@en ;
                                   <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/heritagegraph/Entity> ;
                                   <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> ;
                                   <https://w3id.org/heritagegraph/provenance_scope> "record" .


###  https://w3id.org/heritagegraph/AgeCriterion
