                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://w3id.org/heritagegraph/selectedPerson> ;
                                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://w3id.org/heritagegraph/isCriticalForFestival> ;
                                                                        owl:allValuesFrom xsd:boolean
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://w3id.org/heritagegraph/isCriticalForFestival> ;
                                                                        owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                      ] ,
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty <https://w3id.org/heritagegraph/isCriticalForFestival> ;
                                                                        owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                      ] ;
                                                      rdfs:label "Kumari Selection Event"@en ;
                                                      <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.cidoc-crm.org/cidoc-crm/E7_Activity> ,
                                                                                                       <http://www.w3.org/ns/prov#Activity> ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer."@en ;
                                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> ;
                                                      <https://w3id.org/heritagegraph/prov_alignment_note> "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .


