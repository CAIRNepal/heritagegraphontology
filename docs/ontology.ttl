                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/assertsAbout> ;
                                                                 owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#wasGeneratedBy> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#wasRevisionOf> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/assertsAbout> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                                 owl:allValuesFrom xsd:dateTime
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#value> ;
                                                                 owl:allValuesFrom xsd:string
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/confidenceScore> ;
                                                                 owl:allValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                     owl:intersectionOf ( xsd:float
                                                                                                          [ rdf:type rdfs:Datatype ;
                                                                                                            owl:onDatatype xsd:integer ;
                                                                                                            owl:withRestrictions ( [ xsd:minInclusive 0
                                                                                                                                   ]
                                                                                                                                 )
                                                                                                          ]
                                                                                                          [ rdf:type rdfs:Datatype ;
                                                                                                            owl:onDatatype xsd:integer ;
                                                                                                            owl:withRestrictions ( [ xsd:maxInclusive 1
                                                                                                                                   ]
                                                                                                                                 )
                                                                                                          ]
                                                                                                        )
                                                                                   ]
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/dataQualityNote> ;
                                                                 owl:allValuesFrom xsd:string
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/reconciliationStatus> ;
                                                                 owl:allValuesFrom xsd:string
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#value> ;
                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/confidenceScore> ;
                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/dataQualityNote> ;
                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/reconciliationStatus> ;
                                                                 owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#generatedAtTime> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <http://www.w3.org/ns/prov#value> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/confidenceScore> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/dataQualityNote> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ,
                                                               [ rdf:type owl:Restriction ;
                                                                 owl:onProperty <https://w3id.org/heritagegraph/reconciliationStatus> ;
                                                                 owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                               ] ;
                                               rdfs:label "Assertion"@en ;
                                               <http://www.w3.org/2004/02/skos/core#closeMatch> <http://schema.org/Claim> ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "A provenance-bearing belief or claim about a heritage entity or event. The assertion is represented as CRMinf I2 Belief and as a prov:Entity, allowing source, attribution, generation time, revision, confidence, and reconciliation status to be recorded explicitly."@en ;
                                               <http://www.w3.org/2004/02/skos/core#exactMatch> <https://w3id.org/heritagegraph/Assertion> ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/schema> ;
                                               <http://www.w3.org/2004/02/skos/core#relatedMatch> <http://www.w3.org/ns/prov#Entity> ;
                                               <https://w3id.org/heritagegraph/crminf_pattern> "I2_Belief -J4_that-> I4_Proposition_Set; evidence via I5_Inference_Making (J1_used_as_premise / J2_concluded_that); expert re-check via I7_Belief_Adoption" .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


