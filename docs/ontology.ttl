#################################################################
#    Classes
#################################################################

###  http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody
<http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody> rdf:type owl:Class ;
                                                             rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by> ;
                                                                               owl:allValuesFrom <http://www.cidoc-crm.org/cidoc-crm/E39_Actor>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by> ;
                                                                               owl:allValuesFrom <http://www.cidoc-crm.org/cidoc-crm/E39_Actor>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of> ;
                                                                               owl:allValuesFrom <https://w3id.org/heritagegraph/PhysicalHeritageThing>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> ;
                                                                               owl:allValuesFrom <http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at> ;
                                                                               owl:allValuesFrom <http://www.cidoc-crm.org/cidoc-crm/E53_Place>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://w3id.org/heritagegraph/transferredToGuthi> ;
                                                                               owl:allValuesFrom <https://w3id.org/heritagegraph/Guthi>
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by> ;
                                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by> ;
                                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of> ;
                                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> ;
                                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at> ;
                                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <https://w3id.org/heritagegraph/transferredToGuthi> ;
                                                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by> ;
                                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by> ;
                                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of> ;
                                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span> ;
                                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
                                                                               owl:onProperty <http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at> ;
                                                                               owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                                             ] ,
                                                                             [ rdf:type owl:Restriction ;
