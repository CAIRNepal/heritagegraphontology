                                                rdfs:range <https://w3id.org/heritagegraph/PhysicalHeritageThing> ;
                                                rdfs:label "subject_entity" ;
                                                <http://www.w3.org/2004/02/skos/core#definition> "Heritage entity documented by this activity (documentation subject, not E13 assignment target)." ;
                                                <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/subject_event
<https://w3id.org/heritagegraph/subject_event> rdf:type owl:ObjectProperty ;
                                               rdfs:range <https://w3id.org/heritagegraph/RitualEvent> ;
                                               rdfs:label "subject_event" ;
                                               <http://www.w3.org/2004/02/skos/core#definition> "Event documented by this activity (documentation subject, not E13 assignment target)." ;
                                               <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/supersedes_assertion
<https://w3id.org/heritagegraph/supersedes_assertion> rdf:type owl:ObjectProperty ;
                                                      rdfs:subPropertyOf <http://www.w3.org/ns/prov#invalidated> ;
                                                      rdfs:range <https://w3id.org/heritagegraph/HeritageAssertion> ;
                                                      rdfs:label "supersedes_assertion" ;
                                                      <http://www.w3.org/2004/02/skos/core#definition> "Previous version of this assertion (if this is an update). Creates version chain: A1 → A2 → A3. Query pattern: latest assertion = one with no incoming prov:invalidated" ;
                                                      <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/supported_by_institution
<https://w3id.org/heritagegraph/supported_by_institution> rdf:type owl:ObjectProperty ;
                                                          rdfs:range <https://w3id.org/heritagegraph/Guthi> ;
                                                          rdfs:label "supported_by_institution" ;
                                                          <http://www.w3.org/2004/02/skos/core#definition> "Institution(s) providing economic support (stipend, land endowment) or ritual support (priest salaries) for a Living Goddess during tenure. Extends Guthi role beyond structure management to person support." ;
                                                          <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


