                                              rdfs:label "route_places" ;
                                              <http://www.w3.org/2004/02/skos/core#broadMatch> <http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at> ;
                                              <http://www.w3.org/2004/02/skos/core#definition> "Ordered list of places visited during movement ritual" ;
                                              <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/selected_person
<https://w3id.org/heritagegraph/selected_person> rdf:type owl:ObjectProperty ;
                                                 rdfs:range <https://w3id.org/heritagegraph/Person> ;
                                                 rdfs:label "selected_person" ;
                                                 <http://www.w3.org/2004/02/skos/core#definition> "Person selected through a ritual selection process to assume a sacred role or office" ;
                                                 <http://www.w3.org/2004/02/skos/core#inScheme> <https://w3id.org/heritagegraph/ontology> .


