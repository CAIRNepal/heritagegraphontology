      {
        "@language": "en",
        "@value": "Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n738c82c2e75f400ea1981391464417e8b821"
      },
      {
        "@id": "_:n738c82c2e75f400ea1981391464417e8b822"
