  {
    "@id": "http://www.cidoc-crm.org/cidoc-crm/E39_Actor",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Actor"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Scope note:\nThis class comprises people, either individually or in groups, who have the potential to perform intentional actions of kinds for which they can be held responsible.\n\nExamples:\n- London and Continental Railways (E74)\n- the Governor of the Bank of England in 1975 (E21)\n- Sir Ian McKellen (E21) (Gibson, 1986)\n\nIn First Order Logic:\n- E39(x) ⇒ E77(x)"
      }
    ]
  },
