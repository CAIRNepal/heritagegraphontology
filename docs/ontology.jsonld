      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@value": "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
