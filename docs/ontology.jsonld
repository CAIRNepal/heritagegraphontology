  {
    "@id": "http://www.cidoc-crm.org/cidoc-crm/E72_Legal_Object",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Legal Object"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Scope note:\nThis class comprises those material or immaterial items to which instances of E30 Right, such as the right of ownership or use, can be applied. \nThis is generally true for all instances of E18 Physical Thing. In the case of instances of E28 Conceptual Object, however, the identity of an instance of E28 Conceptual Object or the method of its use may be too ambiguous to reliably establish instances of E30 Right, as in the case of taxa and inspirations. Ownership of corporations is currently regarded as out of scope of the CIDOC CRM.\n\nExamples:\n- the Cullinan diamond (E19) (Scarratt and Shor, 2006)\n- definition of the CIDOC Conceptual Reference Model Version 5.0.4 (E73) (ISO 21127: 2014)\n\nIn First Order Logic:\n- E72(x) ⇒ E70(x)"
      }
    ]
  },
