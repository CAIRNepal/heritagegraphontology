        "@value": "Recorded date"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#PlainLiteral"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broadMatch": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/P3_has_note"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "The date as written in the source, in the calendar given by hg:calendarSystem (e.g. '2072' for a Bikram Sambat year, 'NS 1135 Kaulaathwa', 'VS 2021'). It is never put into an xsd:dateTime: the converted Gregorian bounds go in crm:P82a_begin_of_the_begin / crm:P82b_end_of_the_end."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/schema"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#relatedMatch": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/P1_is_identified_by"
      }
    ]
  },
  {
    "@id": "_:n908fb06c9e6143c3be2ae96a746557e3b550",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDifferent"
    ],
    "http://www.w3.org/2002/07/owl#distinctMembers": [
      {
        "@list": [
          {
            "@id": "https://cair-nepal.org/heritagegraph/EndowmentEventType#Alienation"
