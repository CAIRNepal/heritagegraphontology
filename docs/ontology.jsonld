  {
    "@id": "http://www.cidoc-crm.org/cidoc-crm/E69_Death",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Death"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Scope note:\nThis class comprises the deaths of human beings. \nIf a person is killed, their death should be instantiated as E69 Death and as E7 Activity. The death or perishing of other living beings should be documented as instances of E64 End of Existence.\n\nExamples:\n- the murder of Julius Caesar (E69, E7) (Irwin, 1935)\n- the death of Senator Paul Wellstone (Monast and Tao, 2002)\n\nIn First Order Logic:\n- E69(x) ⇒ E64(x)"
      }
    ]
  },
