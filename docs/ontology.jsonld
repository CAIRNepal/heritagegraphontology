  {
    "@id": "https://cair-nepal.org/heritagegraph/SyncreticType#Historical",
    "@type": [
      "http://www.w3.org/2002/07/owl#NamedIndividual",
      "http://www.w3.org/2004/02/skos/core#Concept",
      "https://cair-nepal.org/heritagegraph/SyncreticType"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/ontology"
      }
    ],
