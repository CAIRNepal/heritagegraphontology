        "@value": "Selected through"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/KumariSelectionEvent"
      }
    ],
    "http://www.w3.org/2002/07/owl#inverseOf": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/initiatedTenure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Selection event that preceded this tenure. Not a tenure-opening event: the tenure opens with the enthronement (hg:enthronedThrough, a subproperty of hg:tenureOpenedBy)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/schema"
      }
    ]
  },
  {
    "@id": "http://purl.org/dc/terms/accessRights",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
