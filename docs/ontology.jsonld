      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Claimed identity: the two are held to be one deity in different traditions (e.g. Avalokiteshvara and Matsyendranath for Newar Buddhists)."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/scheme/SyncreticType"
      }
    ],
