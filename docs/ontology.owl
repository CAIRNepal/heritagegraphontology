        <rdfs:label>LivingGoddessTenure</rdfs:label>
        <skos:definition>Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families.</skos:definition>
        <skos:exactMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E4_Period"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


