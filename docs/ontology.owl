<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/heritagegraph/ontology#"
     xml:base="https://w3id.org/heritagegraph/ontology"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:linkml="https://w3id.org/linkml/">
    <owl:Ontology rdf:about="https://w3id.org/heritagegraph/ontology">
        <owl:versionIRI rdf:resource="https://w3id.org/heritagegraph/ontology/1.0.0"/>
        <terms:creator>CAIR-Nepal</terms:creator>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:modified>2026-06-23</terms:modified>
        <terms:publisher>CAIR-Nepal</terms:publisher>
        <terms:title>HeritageGraph Ontology</terms:title>
        <pav:version>1.0.0</pav:version>
        <rdfs:label>HeritageGraph</rdfs:label>
        <owl:ontologyIRI>https://w3id.org/heritagegraph/ontology</owl:ontologyIRI>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition>An event-centric LinkML schema for representing Nepal cultural heritage information, fully aligned with CIDOC-CRM v7.2.1 and PROV-O. Enables provenance tracking, ritual-spatial-temporal reasoning, and multi-calendar date representation. DL expressivity: ALCIQ(D).</skos:definition>
    </owl:Ontology>
    


