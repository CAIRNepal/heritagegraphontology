    <!-- https://w3id.org/heritagegraph/epoch_date_gregorian -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/epoch_date_gregorian">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>epoch_date_gregorian</rdfs:label>
        <skos:definition>The start date of this calendar era in Gregorian ISO format.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/expertise_area -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/expertise_area">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>expertise_area</rdfs:label>
        <skos:definition>Areas of expertise (e.g., Lichhavi inscriptions, Sanskrit epigraphy, Newari archaeology)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/generated_at_time -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/generated_at_time">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#generatedAtTime"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label>generated_at_time</rdfs:label>
        <skos:definition>When this assertion was recorded (ISO 8601)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/generated_date -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/generated_date">
        <rdfs:label>generated_date</rdfs:label>
        <skos:definition>Date the dataset was generated or last exported (ISO 8601).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/id -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/id">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/identifier"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>id</rdfs:label>
        <skos:definition>Globally unique URI identifier</skos:definition>
        <skos:exactMatch rdf:resource="http://schema.org/identifier"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/institutional_affiliation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/institutional_affiliation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>institutional_affiliation</rdfs:label>
        <skos:definition>Institutional affiliation (e.g., Tribhuvan University, Nepal Heritage Society)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/is_about_entity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/is_about_entity">
        <rdfs:label>is_about_entity</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P129_is_about"/>
        <skos:definition>Entity that this information object describes. Range intentionally left open: the LUX alignment module asserts owl:equivalentProperty with the generic crm:P129_is_about, so a narrow rdfs:range would over-constrain P129 and make sibling is_about_* sub-properties unsatisfiable under merged reasoning.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/is_about_event -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/is_about_event">
        <rdfs:label>is_about_event</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P129_is_about"/>
        <skos:definition>Event that this information object describes. Range intentionally left open (see is_about_entity): owl:equivalentProperty crm:P129_is_about in the LUX module precludes a narrow rdfs:range here.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/is_critical_for_festival -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/is_critical_for_festival">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:label>is_critical_for_festival</rdfs:label>
        <skos:definition>Whether this ritual is essential for the festival&apos;s completion</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/last_known_existence_date -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/last_known_existence_date">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:label>last_known_existence_date</rdfs:label>
        <skos:definition>Latest date when this structure is documented as existing (ISO 8601)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/license -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/license">
        <rdfs:label>license</rdfs:label>
        <skos:definition>License under which the dataset is published (e.g. CC BY 4.0).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/local_contexts_label -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/local_contexts_label">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>local_contexts_label</rdfs:label>
        <skos:definition>URI of an applied Local Contexts Traditional Knowledge (TK) or Biocultural (BC) Notice or Label.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/lunar_date_tithi -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/lunar_date_tithi">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>lunar_date_tithi</rdfs:label>
        <skos:definition>Lunar day (Tithi) for ritual timing</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/name -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/name">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>name</rdfs:label>
        <skos:definition>Primary name or label</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/note -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/note">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P3_has_note"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>note</rdfs:label>
        <skos:definition>Free-text note (description, reason, verification notes)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/orcid_identifier -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/orcid_identifier">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label>orcid_identifier</rdfs:label>
        <skos:broadMatch rdf:resource="http://purl.org/dc/terms/identifier"/>
        <skos:definition>ORCID persistent identifier URI for a researcher or documented contributor.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/place_coordinates -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/place_coordinates">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#asWKT"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
        <rdfs:label>place_coordinates</rdfs:label>
        <skos:definition>Coordinates as WKT literal</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/place_type -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/place_type">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>place_type</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <skos:definition>Type of place (city, village, region)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/reconciliation_status -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/reconciliation_status">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>reconciliation_status</rdfs:label>
        <skos:definition>Status of multi-source reconciliation (confirmed, conflicting, unverified)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/recurrence_pattern -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/recurrence_pattern">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>recurrence_pattern</rdfs:label>
