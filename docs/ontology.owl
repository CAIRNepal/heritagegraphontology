    <!-- https://w3id.org/heritagegraph/PropositionalObject -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/PropositionalObject">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E89_Propositional_Object"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/InformationObject"/>
        <rdfs:comment xml:lang="en">Abstract works, doctrines, beliefs — separate from any physical carrier. LUX alias: &apos;PropositionalObject&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">Propositional Object</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/ProvenanceActivity -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/ProvenanceActivity">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <rdfs:comment xml:lang="en">Wrapper for chains of custody / ownership / movement events. LUX models this as crm:E7_Activity classified_as a &apos;provenance&apos; Type — NOT a separate la: class. Migration: LUX provenance activities land here as crm:E7_Activity instances.</rdfs:comment>
        <rdfs:label xml:lang="en">Provenance Activity</rdfs:label>
    </owl:Class>
    


