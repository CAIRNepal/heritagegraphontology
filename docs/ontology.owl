        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P72_has_language"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>source_language</rdfs:label>
        <skos:definition>Language of the source material</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/source_url -->


