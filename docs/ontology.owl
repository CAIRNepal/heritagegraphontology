    <!-- https://w3id.org/heritagegraph/selected_person -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/selected_person">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Person"/>
        <rdfs:label>selected_person</rdfs:label>
        <skos:definition>Person selected through a ritual selection process to assume a sacred role or office</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/source_type -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/source_type">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/SourceTypeEnum"/>
        <rdfs:label>source_type</rdfs:label>
        <skos:definition>Controlled source-type classification for provenance and epistemic filtering.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/start_place -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/start_place">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Place"/>
        <rdfs:label>start_place</rdfs:label>
        <skos:definition>Starting location of movement ritual</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/subject_entity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/subject_entity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label>subject_entity</rdfs:label>
        <skos:definition>Heritage entity documented by this activity (documentation subject, not E13 assignment target).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/subject_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/subject_event">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label>subject_event</rdfs:label>
        <skos:definition>Event documented by this activity (documentation subject, not E13 assignment target).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/supersedes_assertion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/supersedes_assertion">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasRevisionOf"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/HeritageAssertion"/>
        <rdfs:label>supersedes_assertion</rdfs:label>
        <skos:definition>Previous version of this assertion (if this is an update). Creates version chain: A1 → A2 → A3. Query pattern: latest assertion = one with no incoming prov:wasRevisionOf</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/supported_by_institution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/supported_by_institution">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Guthi"/>
        <rdfs:label>supported_by_institution</rdfs:label>
        <skos:definition>Institution(s) providing economic support (stipend, land endowment) or ritual support (priest salaries) for a Living Goddess during tenure. Extends Guthi role beyond structure management to person support.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/syncretic_relationships -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/syncretic_relationships">
        <rdfs:label>syncretic_relationships</rdfs:label>
        <skos:definition>Collection of SyncreticRelationship instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/syncretic_type -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/syncretic_type">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/SyncreticTypeEnum"/>
        <rdfs:label>syncretic_type</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <skos:definition>The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/took_place_at -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/took_place_at">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Place"/>
        <rdfs:label>took_place_at</rdfs:label>
        <skos:definition>Place where event occurred</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/transferred_from_actor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/transferred_from_actor">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>transferred_from_actor</rdfs:label>
        <skos:definition>Previous custodian</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/transferred_object -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/transferred_object">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label>transferred_object</rdfs:label>
        <skos:definition>Object transferred in custody event</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/transferred_to_actor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/transferred_to_actor">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>transferred_to_actor</rdfs:label>
        <skos:definition>New custodian (person or group)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/transferred_to_guthi -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/transferred_to_guthi">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Guthi"/>
        <rdfs:label>transferred_to_guthi</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by"/>
        <skos:definition>New custodian (Guthi)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/used_by -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/used_by">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>used_by</rdfs:label>
        <skos:definition>Actor(s) who use, handle, or are responsible for this object in ritual contexts</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/used_materials -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/used_materials">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P125_used_object_of_type"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Material"/>
        <rdfs:label>used_materials</rdfs:label>
        <skos:definition>Ephemeral materials consumed during the ritual (e.g., oil, rice).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/used_technique -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/used_technique">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P32_used_general_technique"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Technique"/>
        <rdfs:label>used_technique</rdfs:label>
        <skos:definition>Craft technique used in production</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/verified_assertion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/verified_assertion">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/HeritageAssertion"/>
        <rdfs:label>verified_assertion</rdfs:label>
        <skos:definition>Assertions verified by this activity</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/verified_by_expert -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/verified_by_expert">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/heritagegraph/carried_out_by"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Person"/>
        <rdfs:label>verified_by_expert</rdfs:label>
        <skos:definition>Expert who performed verification</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/was_attributed_to_agent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/was_attributed_to_agent">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAttributedTo"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Person"/>
        <rdfs:label>was_attributed_to_agent</rdfs:label>
        <skos:definition>Person who made this assertion</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/was_derived_from_source -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/was_derived_from_source">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasDerivedFrom"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DataSource"/>
        <rdfs:label>was_derived_from_source</rdfs:label>
        <skos:definition>Source(s) from which this assertion was derived</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/was_documented_by -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/was_documented_by">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DocumentationActivity"/>
        <rdfs:label>was_documented_by</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
        <skos:definition>Documentation event that recorded this entity or event</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/was_produced_by_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/was_produced_by_event">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by"/>
        <owl:inverseOf rdf:resource="https://w3id.org/heritagegraph/produced_object"/>
        <rdfs:domain rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Production"/>
        <rdfs:label>was_produced_by_event</rdfs:label>
        <skos:definition>Event that created this object or structure</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


