        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/residence_structure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/residence_structure">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P74_has_current_or_former_residence"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
        <rdfs:label>residence_structure</rdfs:label>
        <skos:definition>Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ritual_events -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ritual_events">
        <rdfs:label>ritual_events</rdfs:label>
        <skos:definition>Collection of RitualEvent instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ritual_on_structure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ritual_on_structure">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P8_took_place_on_or_within"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label>ritual_on_structure</rdfs:label>
        <skos:definition>Ritual occurs at specific temple or monument</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ritual_type -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ritual_type">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualTypeEnum"/>
        <rdfs:label>ritual_type</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <skos:definition>Classification of ritual (puja, jatra, consecration)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/route_places -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/route_places">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Place"/>
        <rdfs:label>route_places</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"/>
        <skos:definition>Ordered list of places visited during movement ritual</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/selected_person -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/selected_person">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Person"/>
        <rdfs:label>selected_person</rdfs:label>
        <skos:definition>Person selected through a ritual selection process to assume a sacred role or office</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/source_type -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/source_type">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/SourceTypeEnum"/>
        <rdfs:label>source_type</rdfs:label>
        <skos:definition>Controlled source-type classification for provenance and epistemic filtering.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/start_place -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/start_place">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Place"/>
        <rdfs:label>start_place</rdfs:label>
        <skos:definition>Starting location of movement ritual</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/subject_entity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/subject_entity">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label>subject_entity</rdfs:label>
