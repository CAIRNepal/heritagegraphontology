    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:closeMatch rdf:resource="http://schema.org/Claim"/>
    <skos:definition>A provenance-bearing belief or claim about a heritage entity or event. The assertion is represented as CRMinf I2 Belief and as a prov:Entity, allowing source, attribution, generation time, revision, confidence, and reconciliation status to be recorded explicitly.</skos:definition>
    <skos:exactMatch rdf:resource="https://w3id.org/heritagegraph/Assertion"/>
    <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    <skos:relatedMatch rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <heritageGraph:crminf_pattern>I2_Belief -J4_that-&gt; I4_Proposition_Set; evidence via I5_Inference_Making (J1_used_as_premise / J2_concluded_that); expert re-check via I7_Belief_Adoption</heritageGraph:crminf_pattern>
  </rdf:Description>
