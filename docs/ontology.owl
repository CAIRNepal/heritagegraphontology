        <rdfs:label>FieldSurveyActivity</rdfs:label>
        <skos:definition>The activity of measuring, photographing, or assessing a site in person.</skos:definition>
        <skos:exactMatch rdf:resource="http://www.cidoc-crm.org/crmsci/S4_Observation"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


