        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/asserted_property -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/asserted_property">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>asserted_property</rdfs:label>
        <skos:definition>Optional property or attribute name when the assertion is structured as a property-value pair.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/asserted_value -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/asserted_value">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>asserted_value</rdfs:label>
        <skos:definition>Optional value claimed for asserted_property when using structured property-value assertions.</skos:definition>
