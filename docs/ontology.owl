  <rdf:Description rdf:about="https://w3id.org/heritagegraph/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>HeritageGraph</rdfs:label>
    <dcterms:bibliographicCitation>CAIR-Nepal (2026). HeritageGraph Ontology (0.1.0-alpha.5). https://w3id.org/heritagegraph/ontology</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-23</dcterms:created>
    <dcterms:creator>CAIR-Nepal</dcterms:creator>
    <dcterms:description>An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning.</dcterms:description>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-16</dcterms:modified>
    <dcterms:publisher>CAIR-Nepal</dcterms:publisher>
    <dcterms:source rdf:resource="https://github.com/CAIRNepal/heritagegraphontology"/>
    <dcterms:title>HeritageGraph Ontology</dcterms:title>
    <bibo:status>Pre-release specification draft (alpha)</bibo:status>
    <pav:version>0.1.0-alpha.5</pav:version>
    <vann:preferredNamespacePrefix>heritageGraph</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://w3id.org/heritagegraph/</vann:preferredNamespaceUri>
    <owl:versionIRI rdf:resource="https://w3id.org/heritagegraph/ontology/0.1.0-alpha.5"/>
    <skos:definition>An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning.</skos:definition>
  </rdf:Description>
