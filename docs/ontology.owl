    <!-- https://w3id.org/heritagegraph/PhysicalHeritageThing -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/PhysicalHeritageThing">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalElement"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/IconographicObject"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">Physical Heritage Thing</rdfs:label>
        <skos:definition xml:lang="en">Union of the tangible heritage classes: architectural structures, iconographic objects, and standalone architectural elements. Used as the range of slots that apply to any physical heritage thing (production, custody, condition assessment).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:Class>
    


