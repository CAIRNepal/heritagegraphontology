  <rdf:Description rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>supersedes_assertion</rdfs:label>
    <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMinf/I2_Belief"/>
    <skos:definition>Previous assertion that this one revises (version chain A1-&gt;A2-&gt;A3). Uses prov:wasRevisionOf (a derivation between entities); the latest assertion is the one with no incoming wasRevisionOf. NOTE: prov:invalidated was incorrect here (it is an Activity-&gt;Entity relation, not Entity-&gt;Entity).</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
  </rdf:Description>
