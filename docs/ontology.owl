    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b344"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b345"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b346"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b347"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/KumariLifecycleEvent"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:broadMatch rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition>Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    <heritageGraph:prov_alignment_note>prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM&lt;-&gt;PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally.</heritageGraph:prov_alignment_note>
  </rdf:Description>
