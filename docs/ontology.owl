<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/heritagegraph/alignment/lux#"
     xml:base="https://w3id.org/heritagegraph/alignment/lux"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:linkml="https://w3id.org/linkml/"
     xmlns:cidoc-crm="http://www.cidoc-crm.org/cidoc-crm/"
     xmlns:heritagegraph="https://w3id.org/heritagegraph/">
    <owl:Ontology rdf:about="https://w3id.org/heritagegraph/alignment/lux">
        <owl:versionIRI rdf:resource="https://w3id.org/heritagegraph/alignment/lux/1.0.0"/>
        <terms:contributor>Niraj Karki (CAIR Nepal)</terms:contributor>
        <terms:creator>Cair Nepal</terms:creator>
        <terms:creator>Semih Yumuşak</terms:creator>
        <terms:description xml:lang="en">Class- and property-level mapping from CAIR Nepal HeritageGraph to LUX, the Yale Linked Art / CIDOC-CRM dataset, validated against the official Linked Art JSON-LD context. A modular companion that imports the HeritageGraph core ontology and adds (a) formal owl:equivalentClass / owl:equivalentProperty axioms to CIDOC-CRM, (b) 33 interoperability classes rooted in the URIs LUX actually emits, and (c) the HG-internal hierarchy and object properties wiring those classes into the core graph.</terms:description>
        <terms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <terms:license rdf:resource="https://www.apache.org/licenses/LICENSE-2.0"/>
        <terms:license>CC-BY-4.0</terms:license>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-06-18</terms:modified>
        <terms:modified>2026-06-05</terms:modified>
        <terms:publisher>CAIR Nepal</terms:publisher>
        <terms:publisher>Cair Nepal</terms:publisher>
        <terms:source rdf:resource="https://lux.collections.yale.edu/"/>
        <terms:title xml:lang="en">HeritageGraph ↔ LUX Alignment Module</terms:title>
        <terms:title>HeritageGraph Ontology</terms:title>
        <pav:derivedFrom rdf:resource="https://github.com/CAIRNepal/heritagegraph-lux-migration"/>
        <pav:version>1.0.0</pav:version>
        <vann:preferredNamespacePrefix>heritageGraph</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://w3id.org/heritagegraph/</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">HeritageGraph–LUX alignment (Linked Art / CIDOC-CRM)</rdfs:label>
        <rdfs:label>HeritageGraph</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://linked.art/ns/v1/linked-art.json"/>
        <owl:ontologyIRI>https://w3id.org/heritagegraph/ontology</owl:ontologyIRI>
        <owl:versionInfo>1.0.0</owl:versionInfo>
        <skos:definition>An event-centric LinkML schema for representing Nepal cultural heritage information, fully aligned with CIDOC-CRM v7.2.1 and PROV-O. Enables provenance tracking, ritual-spatial-temporal reasoning, and multi-calendar date representation. DL expressivity: ALCIQ(D).</skos:definition>
    </owl:Ontology>
    


