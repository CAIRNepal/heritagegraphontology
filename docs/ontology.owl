    <!-- https://w3id.org/heritagegraph/ArchitecturalStyleEnum -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/ArchitecturalStyleEnum">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ChaityaStyle"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Dome"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Pagoda"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Shikhara"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/StupaStyle"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>ArchitecturalStyleEnum</rdfs:label>
        <skos:definition>A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ChaityaStyle"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Dome"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Pagoda"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Shikhara"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/StupaStyle"/>
    </owl:Class>
    


