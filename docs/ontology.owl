    <!-- https://w3id.org/heritagegraph/ArchitecturalStyle -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/ArchitecturalStyle">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300001280"/>
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300004829"/>
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300007562"/>
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300007576"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalStyle#Shikhara"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Architectural Style</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <skos:definition xml:lang="en">A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300001280"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300004829"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300007562"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300007576"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStyle#Shikhara"/>
    </owl:Class>
    


