    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/metadata -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/metadata">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Metadata"/>
        <rdfs:label xml:lang="en">metadata</rdfs:label>
        <skos:definition xml:lang="en">Dataset metadata</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/partOfSelection -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/partOfSelection">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/KumariSelectionEvent"/>
        <rdfs:label xml:lang="en">Part of selection</rdfs:label>
        <skos:definition xml:lang="en">Selection event this assessment is part of.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/participatesInRitual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/participatesInRitual">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P12i_was_present_at"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label xml:lang="en">Participates in ritual</rdfs:label>
        <skos:definition xml:lang="en">Rituals in which this structure participates</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/performedByGroup -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/performedByGroup">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/heritagegraph/CasteGroup"/>
                            <rdf:Description rdf:about="https://w3id.org/heritagegraph/Guthi"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">Performed by group</rdfs:label>
        <skos:definition xml:lang="en">Group (Guthi, caste) responsible for ritual</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/performsRitual -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/performsRitual">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P14i_performed"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label xml:lang="en">Performs ritual</rdfs:label>
        <skos:definition xml:lang="en">Rituals performed by this Guthi</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/persons -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/persons">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:label xml:lang="en">persons</rdfs:label>
        <skos:definition xml:lang="en">Collection of Person instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/physical_heritage_things -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/physical_heritage_things">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label xml:lang="en">Physical heritage things</rdfs:label>
        <skos:definition xml:lang="en">Collection of all physical heritage objects</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/places -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/places">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:label xml:lang="en">places</rdfs:label>
        <skos:definition xml:lang="en">Collection of Place instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/production_events -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/production_events">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E12_Production"/>
        <rdfs:label xml:lang="en">Production events</rdfs:label>
        <skos:definition xml:lang="en">Collection of Production event instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/propositionObjectEntity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/propositionObjectEntity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/AssertionSubject"/>
        <rdfs:label xml:lang="en">Proposition object entity</rdfs:label>
        <skos:definition xml:lang="en">Object of the proposition when it is a heritage entity (plays the role of rdf:object).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/propositionSubject -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/propositionSubject">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/AssertionSubject"/>
        <rdfs:label xml:lang="en">Proposition subject</rdfs:label>
        <skos:definition xml:lang="en">Entity the proposition is about (plays the role of rdf:subject).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/propositions -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/propositions">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Proposition"/>
        <rdfs:label xml:lang="en">propositions</rdfs:label>
        <skos:definition xml:lang="en">Collection of Proposition instances referenced by assertions</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/publicationTimespan -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/publicationTimespan">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:label xml:lang="en">Publication timespan</rdfs:label>
        <skos:definition xml:lang="en">When source was published</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/religious_traditions -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/religious_traditions">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ReligiousTradition"/>
        <rdfs:label xml:lang="en">Religious traditions</rdfs:label>
        <skos:definition xml:lang="en">Collection of ReligiousTradition instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/residenceStructure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/residenceStructure">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
        <rdfs:label xml:lang="en">Residence structure</rdfs:label>
        <skos:definition xml:lang="en">Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/retiredThrough -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/retiredThrough">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/KumariRetirementEvent"/>
        <rdfs:label xml:lang="en">Retired through</rdfs:label>
        <skos:definition xml:lang="en">Retirement/desanctification event that ended this tenure.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ritualType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ritualType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualType"/>
        <rdfs:label xml:lang="en">Ritual type</rdfs:label>
        <skos:definition xml:lang="en">Classification of ritual (puja, jatra, consecration)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ritual_assessments -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ritual_assessments">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualAssessment"/>
        <rdfs:label xml:lang="en">Ritual assessments</rdfs:label>
        <skos:definition xml:lang="en">Collection of RitualAssessment (e.g. FearlessnessAssessment) instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ritual_events -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ritual_events">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label xml:lang="en">Ritual events</rdfs:label>
        <skos:definition xml:lang="en">Collection of RitualEvent instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/roleDeity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/roleDeity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label xml:lang="en">Role deity</rdfs:label>
        <skos:definition xml:lang="en">Deity embodied by whoever holds this role (e.g., Taleju).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/routePlaces -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/routePlaces">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:label xml:lang="en">Route places</rdfs:label>
        <skos:definition xml:lang="en">Ordered list of places visited during movement ritual</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/selectedPerson -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/selectedPerson">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:label xml:lang="en">Selected person</rdfs:label>
        <skos:definition xml:lang="en">Person selected through a ritual selection process to assume a sacred role or office</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/selectedThrough -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/selectedThrough">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/KumariSelectionEvent"/>
        <rdfs:label xml:lang="en">Selected through</rdfs:label>
        <skos:definition xml:lang="en">Selection event that initiated this tenure.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/selection_criteria -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/selection_criteria">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/SelectionCriterion"/>
        <rdfs:label xml:lang="en">Selection criteria</rdfs:label>
        <skos:definition xml:lang="en">Collection of SelectionCriterion instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/sourceCreator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/sourceCreator">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:label xml:lang="en">Datacite creator</rdfs:label>
        <skos:definition xml:lang="en">Person or organization primarily responsible for creating the source</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.org/dc/terms/creator"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/sourcePublisher -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/sourcePublisher">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:label xml:lang="en">Datacite publisher</rdfs:label>
        <skos:definition xml:lang="en">Entity responsible for making the source available</skos:definition>
        <skos:exactMatch rdf:resource="http://purl.org/dc/terms/publisher"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/startPlace -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/startPlace">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
        <rdfs:label xml:lang="en">Start place</rdfs:label>
        <skos:definition xml:lang="en">Starting location of movement ritual</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/structures -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/structures">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
        <rdfs:label xml:lang="en">structures</rdfs:label>
        <skos:definition xml:lang="en">Collection of ArchitecturalStructure instances (incl. subclasses)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/supportedByInstitution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/supportedByInstitution">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Guthi"/>
        <rdfs:label xml:lang="en">Supported by institution</rdfs:label>
        <skos:definition xml:lang="en">Institution(s) providing economic support (stipend, land endowment) or ritual support (priest salaries) for a Living Goddess during tenure. Extends Guthi role beyond structure management to person support.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/syncreticType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/syncreticType">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/SyncreticType"/>
        <rdfs:label xml:lang="en">Syncretic type</rdfs:label>
        <skos:definition xml:lang="en">The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/syncretic_relationships -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/syncretic_relationships">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/SyncreticRelationship"/>
        <rdfs:label xml:lang="en">Syncretic relationships</rdfs:label>
        <skos:definition xml:lang="en">Collection of SyncreticRelationship instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/techniques -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/techniques">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure"/>
        <rdfs:label xml:lang="en">techniques</rdfs:label>
        <skos:definition xml:lang="en">Collection of Technique instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/time_spans -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/time_spans">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:label xml:lang="en">Time spans</rdfs:label>
        <skos:definition xml:lang="en">Collection of TimeSpan instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/transferredToGuthi -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/transferredToGuthi">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Guthi"/>
        <rdfs:label xml:lang="en">Transferred to guthi</rdfs:label>
        <skos:definition xml:lang="en">New custodian (Guthi)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/usedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/usedBy">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:label xml:lang="en">Used by</rdfs:label>
        <skos:definition xml:lang="en">Actor(s) who use, handle, or are responsible for this object in ritual contexts</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/verifiedAssertion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/verifiedAssertion">
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMinf/I2_Belief"/>
        <rdfs:label xml:lang="en">Verified assertion</rdfs:label>
        <skos:definition xml:lang="en">Assertions verified by this activity</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/verifiedByExpert -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/verifiedByExpert">
        <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by"/>
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:label xml:lang="en">Verified by expert</rdfs:label>
        <skos:definition xml:lang="en">Expert who performed verification</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/identifier -->


    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:label xml:lang="en">ID</rdfs:label>
        <skos:definition xml:lang="en">Globally unique URI identifier</skos:definition>
        <skos:exactMatch rdf:resource="http://schema.org/identifier"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://schema.org/inLanguage -->


    <owl:DatatypeProperty rdf:about="http://schema.org/inLanguage">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Source language</rdfs:label>
        <skos:definition xml:lang="en">Language of the source material</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P3_has_note -->


    <owl:DatatypeProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P3_has_note">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">note</rdfs:label>
        <skos:definition xml:lang="en">Free-text note (description, reason, verification notes)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P82a_begin_of_the_begin -->


    <owl:DatatypeProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P82a_begin_of_the_begin">
        <rdfs:label xml:lang="en">Date earliest</rdfs:label>
        <skos:definition xml:lang="en">Earliest possible date (for uncertain dates)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P82b_end_of_the_end -->


    <owl:DatatypeProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P82b_end_of_the_end">
        <rdfs:label xml:lang="en">Date latest</rdfs:label>
        <skos:definition xml:lang="en">Latest possible date (for uncertain dates)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#asWKT -->


    <owl:DatatypeProperty rdf:about="http://www.opengis.net/ont/geosparql#asWKT">
        <rdfs:label xml:lang="en">Place coordinates</rdfs:label>
        <skos:definition xml:lang="en">Coordinates as WKT literal</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/prov#endedAtTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#endedAtTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Ended at time</rdfs:label>
        <skos:definition xml:lang="en">Time at which this activity ended.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/prov#generatedAtTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#generatedAtTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Generated at time</rdfs:label>
        <skos:definition xml:lang="en">Time at which this entity was generated (ISO 8601).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/prov#startedAtTime -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#startedAtTime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:label xml:lang="en">Started at time</rdfs:label>
        <skos:definition xml:lang="en">Time at which this activity started.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/prov#value -->


    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/prov#value">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">Assertion content</rdfs:label>
        <skos:definition xml:lang="en">The factual claim being asserted</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/confidenceScore -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/confidenceScore">
        <rdfs:range>
            <rdfs:Datatype>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2001/XMLSchema#float"/>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</xsd:minInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                    <rdfs:Datatype>
                        <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                        <owl:withRestrictions rdf:parseType="Collection">
                            <rdf:Description>
                                <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:maxInclusive>
                            </rdf:Description>
                        </owl:withRestrictions>
                    </rdfs:Datatype>
                </owl:intersectionOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="en">Confidence score</rdfs:label>
        <skos:definition xml:lang="en">Reliability score for assertion (0.0-1.0)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/curator -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/curator">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">curator</rdfs:label>
        <skos:definition xml:lang="en">Person or organization curating the dataset.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:DatatypeProperty>
    


