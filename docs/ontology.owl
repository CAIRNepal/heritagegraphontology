        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>traditional_knowledge_notice</rdfs:label>
        <skos:definition>Traditional-knowledge access, attribution, or care notice (e.g., community protocol labels).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/traditional_role -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/traditional_role">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>traditional_role</rdfs:label>
        <skos:definition>Hereditary occupation or ritual duty</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/used_equipment -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/used_equipment">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>used_equipment</rdfs:label>
        <skos:definition>Equipment used in documentation (free-text). Not mapped to crm:P16_used_specific_object, which is an object property requiring an crm:E70 thing resource.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/used_method -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/used_method">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>used_method</rdfs:label>
        <skos:definition>Documentation method used (free-text). Not mapped to crm:P33_used_specific_technique, which is an object property requiring an crm:E29 technique resource.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/verification_method -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/verification_method">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>verification_method</rdfs:label>
        <skos:definition>Method used for verification (cross-check, expert review, field visit)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/year_offset_from_gregorian -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/year_offset_from_gregorian">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:label>year_offset_from_gregorian</rdfs:label>
        <skos:definition>Mathematical offset to convert to Common Era (e.g., +57 for BS).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


