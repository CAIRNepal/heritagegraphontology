                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/RitualEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/SelectionCriterion"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/SyncreticRelationship"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Assertion Subject</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
        <skos:definition xml:lang="en">Any HeritageGraph entity or event that may be the subject of an assertion.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:Class>
    


