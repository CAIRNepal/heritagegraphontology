    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b495"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b496"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:altLabel>Living Goddess Tenure</skos:altLabel>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E4_Period"/>
    <skos:definition>Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families.</skos:definition>
    <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
  </rdf:Description>
