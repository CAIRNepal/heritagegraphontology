        <rdfs:label xml:lang="en">deities</rdfs:label>
        <skos:definition xml:lang="en">Collection of Deity instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/destructionEvent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/destructionEvent">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E6_Destruction"/>
        <rdfs:label xml:lang="en">Destruction event</rdfs:label>
        <skos:definition xml:lang="en">Event that destroyed this structure (if known)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/documentation_activities -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/documentation_activities">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DocumentationActivity"/>
        <rdfs:label xml:lang="en">Documentation activities</rdfs:label>
        <skos:definition xml:lang="en">Collection of DocumentationActivity instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/documentedBy -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/documentedBy">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasInfluencedBy"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DocumentationActivity"/>
        <rdfs:label xml:lang="en">Was documented by</rdfs:label>
        <skos:definition xml:lang="en">Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
        <heritagegraph:prov_alignment>prov:wasInfluencedBy</heritagegraph:prov_alignment>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/documents -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/documents">
        <owl:inverseOf rdf:resource="https://w3id.org/heritagegraph/documentedBy"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/AssertionSubject"/>
        <rdfs:label xml:lang="en">documents</rdfs:label>
        <skos:definition xml:lang="en">Pre-existing heritage entity or event recorded by this documentation activity (inverse of was_documented_by).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


