    <!-- https://w3id.org/heritagegraph/EpistemicStanceEnum -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/EpistemicStanceEnum">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Community"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Priestly"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Scholarly"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/State"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/SyncreticTradition"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Uncertain"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>EpistemicStanceEnum</rdfs:label>
        <skos:definition>Epistemic standing of a source or assertion</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Community"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Priestly"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Scholarly"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/State"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/SyncreticTradition"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Uncertain"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/ExistenceStatusEnum -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Destroyed"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Extant"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Hypothetical"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Lost"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/PartiallyExtant"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Unknown"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>ExistenceStatusEnum</rdfs:label>
        <skos:definition>Controlled vocabulary for whether a heritage object or structure still exists.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Destroyed"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Extant"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Hypothetical"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Lost"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/PartiallyExtant"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/Unknown"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/Festival -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/Festival">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/heritagegraph/includes_ritual_event"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/heritagegraph/includes_ritual_event"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Festival</rdfs:label>
        <skos:definition>Large-scale community ritual event (Jatra) involving processions, music, and collective participation</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/FieldSurveyActivity -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/FieldSurveyActivity">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/crmsci/S4_Observation"/>
        <rdfs:subClassOf rdf:resource="http://www.ics.forth.gr/isl/CRMsci/S4_Observation"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/DocumentationActivity"/>
