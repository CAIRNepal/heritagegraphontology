    <!-- https://w3id.org/heritagegraph/ExistenceStatus -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/ExistenceStatus">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatus#Destroyed"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatus#Extant"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatus#Hypothetical"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatus#Lost"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatus#PartiallyExtant"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatus#Unknown"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Existence Status</rdfs:label>
        <skos:definition xml:lang="en">Controlled vocabulary for whether a heritage structure still exists physically.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatus#Destroyed"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatus#Extant"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatus#Hypothetical"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatus#Lost"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatus#PartiallyExtant"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatus#Unknown"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/FearlessnessAssessment -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/FearlessnessAssessment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/RitualAssessment"/>
        <rdfs:label xml:lang="en">Fearlessness Assessment</rdfs:label>
        <skos:definition xml:lang="en">The &apos;fearlessness test&apos; popularly described (animal heads, masked dancers in darkness). Its historical and contemporary practice is DISPUTED -- some former Kumaris contest how it is described. Represented as an assessment whose accounts are source-attributed via has_assertion, NOT as a mandatory criterion.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
        <skos:scopeNote xml:lang="en">Deliberately not a SelectionCriterion subclass: popular accounts and lived testimony disagree. Attach each account as a Assertion (CRMinf I2 Belief) with its own source and confidence.</skos:scopeNote>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/Festival -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/Festival">
        <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P9_consists_of"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
