        <rdfs:label xml:lang="en">Kumari Role</rdfs:label>
        <skos:altLabel xml:lang="en">Living Goddess</skos:altLabel>
        <skos:altLabel xml:lang="en">Royal Kumari</skos:altLabel>
        <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <skos:definition xml:lang="en">The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:Class>
    


