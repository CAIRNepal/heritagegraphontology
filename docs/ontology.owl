  <rdf:Description rdf:about="https://w3id.org/heritagegraph/Temple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Temple</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b216"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b217"/>
