    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b842"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b843"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b844"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b845"/>
    <rdfs:subClassOf rdf:nodeID="n6c365790743a4ec8a207754bfbd0ecc9b846"/>
    <skos:definition>Direct LinkML representation of prov:Entity. Applied to physical, digital, conceptual, and assertion-bearing things that participate in provenance relations. PROVENANCE SCOPE (alpha.5 design decision): for classes whose instances are real-world referents (structures, deities, places, actors), the provenance slots (was_derived_from, was_attributed_to, was_generated_by, generated_at_time) describe the DATA RECORD about the referent, not the referent itself -- a stupa is not generated by the survey that records it. Referent-level history is modelled through events (Production, DestructionEvent, etc.). RDF deployments SHOULD carry record-level provenance in named graphs or on InformationObject/Assertion nodes.</skos:definition>
    <skos:exactMatch rdf:resource="https://w3id.org/heritagegraph/Entity"/>
    <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    <heritageGraph:provenance_scope>record</heritageGraph:provenance_scope>
  </rdf:Description>
