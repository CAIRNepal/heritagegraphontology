    <!-- https://w3id.org/heritagegraph/SyncreticType -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/SyncreticType">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/SyncreticType#Appropriation"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/SyncreticType#Equivalence"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/SyncreticType#Fusion"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/SyncreticType#Historical"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Syncretic Type</rdfs:label>
        <skos:definition xml:lang="en">Controlled vocabulary for kinds of syncretic theological relationships between deities.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/SyncreticType#Appropriation"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/SyncreticType#Equivalence"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/SyncreticType#Fusion"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/SyncreticType#Historical"/>
    </owl:Class>
    


