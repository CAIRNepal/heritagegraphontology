    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P107_has_current_or_former_member -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P107_has_current_or_former_member">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
        <rdfs:label xml:lang="en">Has membership</rdfs:label>
        <skos:definition xml:lang="en">Members of Guthi organization</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P107i_is_current_or_former_member_of -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P107i_is_current_or_former_member_of">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Guthi"/>
        <rdfs:label xml:lang="en">Member of group</rdfs:label>
        <skos:definition xml:lang="en">Groups this person belongs to</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P108_has_produced -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P108_has_produced">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label xml:lang="en">Produced object</rdfs:label>
        <skos:definition xml:lang="en">Object produced by this production event</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E12_Production"/>
        <rdfs:label xml:lang="en">Was produced by event</rdfs:label>
        <skos:definition xml:lang="en">Event that created this object or structure</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P120_occurs_before -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P120_occurs_before">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label xml:lang="en">Occurs before</rdfs:label>
        <skos:definition xml:lang="en">Points to the next ritual in the canonical sequence.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P120i_occurs_after -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P120i_occurs_after">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label xml:lang="en">Occurs after</rdfs:label>
        <skos:definition xml:lang="en">Points to the prerequisite ritual.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P125_used_object_of_type -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P125_used_object_of_type">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E57_Material"/>
        <rdfs:label xml:lang="en">Used materials</rdfs:label>
        <skos:definition xml:lang="en">Ephemeral materials consumed during the ritual (e.g., oil, rice).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P129_is_about -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P129_is_about">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/AssertionSubject"/>
        <rdfs:label xml:lang="en">Is about</rdfs:label>
        <skos:definition xml:lang="en">Heritage entity or event described by this information object.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P12_occurred_in_the_presence_of -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P12_occurred_in_the_presence_of">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">Occurred in presence of</rdfs:label>
        <skos:definition xml:lang="en">Generic CRM presence relation (P12): entity present at an event. Canonical holder of the CRM predicate; use the specific presence slots in data.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P12i_was_present_at -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P12i_was_present_at">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label xml:lang="en">Was present at</rdfs:label>
        <skos:definition xml:lang="en">Generic CRM presence relation (P12i): event this entity was present at. Canonical holder of the CRM predicate; use the specific slots in data.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label xml:lang="en">Assigned to deity</rdfs:label>
        <skos:definition xml:lang="en">The deity instance that is the subject of the syncretic claim.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P141_assigned -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P141_assigned">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label xml:lang="en">Assigned equivalent</rdfs:label>
        <skos:definition xml:lang="en">The deity or sacred figure being identified as equivalent to the primary deity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:label xml:lang="en">Carried out by</rdfs:label>
        <skos:definition xml:lang="en">Actor(s) who performed this event</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P14i_performed -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P14i_performed">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label xml:lang="en">Carried out activity</rdfs:label>
        <skos:definition xml:lang="en">Activities performed by this actor</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P16_used_specific_object">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Murti"/>
        <rdfs:label xml:lang="en">Consecrated object</rdfs:label>
        <skos:definition xml:lang="en">Murti employed in (and transformed by) the consecration ritual</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:label xml:lang="en">Transferred from actor</rdfs:label>
        <skos:definition xml:lang="en">Previous custodian</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
        <rdfs:label xml:lang="en">Transferred to actor</rdfs:label>
        <skos:definition xml:lang="en">New custodian (person or group)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P2_has_type -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P2_has_type">
        <rdfs:label xml:lang="en">Has type</rdfs:label>
        <skos:definition xml:lang="en">Generic CRM typing property (P2 has type). Canonical holder of the CRM predicate; use the specific typing slots below in data.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label xml:lang="en">Transferred object</rdfs:label>
        <skos:definition xml:lang="en">Object transferred in custody event</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P30i_custody_transferred_through -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P30i_custody_transferred_through">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody"/>
        <rdfs:label xml:lang="en">Has custody event</rdfs:label>
        <skos:definition xml:lang="en">Custody transfer events for this structure</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P33_used_specific_technique">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure"/>
        <rdfs:label xml:lang="en">Used technique</rdfs:label>
        <skos:definition xml:lang="en">Craft technique used in production</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P34_concerned -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P34_concerned">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label xml:lang="en">Assessed object</rdfs:label>
        <skos:definition xml:lang="en">Object assessed for condition</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P34i_was_assessed_by -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P34i_was_assessed_by">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E14_Condition_Assessment"/>
        <rdfs:label xml:lang="en">Has condition assessment</rdfs:label>
        <skos:definition xml:lang="en">Condition assessment events for this structure</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P35_has_identified -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P35_has_identified">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E3_Condition_State"/>
        <rdfs:label xml:lang="en">Assessed condition state</rdfs:label>
        <skos:definition xml:lang="en">Condition state identified by the assessment</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ArchitecturalElement"/>
        <rdfs:label xml:lang="en">Has component</rdfs:label>
        <skos:definition xml:lang="en">Architectural elements composing structure</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
        <rdfs:label xml:lang="en">Is component of</rdfs:label>
        <skos:definition xml:lang="en">Larger structure that this element is part of</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span">
        <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
        <rdfs:label xml:lang="en">Has timespan</rdfs:label>
        <skos:definition xml:lang="en">Links event to its temporal extent</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P50i_is_current_keeper_of -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P50i_is_current_keeper_of">
