        <rdfs:label xml:lang="en">Physical Integrity Criterion</rdfs:label>
        <skos:definition xml:lang="en">Candidate must have an unblemished body with no scars, wounds, or loss of blood/teeth.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:Class>
    


