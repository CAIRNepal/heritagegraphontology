    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/syncretic_relationships">
        <rdfs:label>syncretic_relationships</rdfs:label>
        <skos:definition>Collection of SyncreticRelationship instances</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:ObjectProperty>
    


