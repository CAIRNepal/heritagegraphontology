                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object"/>
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure"/>
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E3_Condition_State"/>
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E57_Material"/>
                    <rdf:Description rdf:about="http://www.ics.forth.gr/isl/CRMinf/I2_Belief"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalElement"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/CalendarSystem"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Consecration"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/DataSource"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Deity"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/DocumentationActivity"/>
