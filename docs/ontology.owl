    <!-- https://w3id.org/heritagegraph/archival_location -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/archival_location">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>archival_location</rdfs:label>
        <skos:definition>Where stored (e.g., National Museum Kathmandu, British Library, URL)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/asserted_property -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/asserted_property">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>asserted_property</rdfs:label>
        <skos:definition>Optional property or attribute name when the assertion is structured as a property-value pair.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/asserted_value -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/asserted_value">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>asserted_value</rdfs:label>
        <skos:definition>Optional value claimed for asserted_property when using structured property-value assertions.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/assertion_content -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/assertion_content">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#value"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>assertion_content</rdfs:label>
        <skos:definition>The factual claim being asserted</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/community_attribution -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/community_attribution">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>community_attribution</rdfs:label>
