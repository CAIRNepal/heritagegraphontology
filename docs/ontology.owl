    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/endedTenureOf">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/heritagegraph/boundsTenure"/>
        <owl:inverseOf rdf:resource="https://w3id.org/heritagegraph/retiredThrough"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/KumariTenure"/>
        <rdfs:label xml:lang="en">Ended tenure of</rdfs:label>
        <skos:definition xml:lang="en">Points from a KumariRetirementEvent to the tenure that it terminated. Enables reconstruction of the complete Kumari lifecycle.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


