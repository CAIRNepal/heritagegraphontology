        <rdfs:label xml:lang="en">Agent</rdfs:label>
        <skos:definition xml:lang="en">Direct LinkML representation of prov:Agent. Agents bear responsibility for activities or entities. PROV-O permits an individual agent also to be typed as an Entity, but does not define every Agent as a subclass of Entity.</skos:definition>
        <skos:exactMatch rdf:resource="https://w3id.org/heritagegraph/Agent"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:Class>
    


