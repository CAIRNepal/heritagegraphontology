    <!-- https://w3id.org/heritagegraph/PhysicalHeritageThing -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/PhysicalHeritageThing">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalElement"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/IconographicObject"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>PhysicalHeritageThing</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.europeana.eu/schemas/edm/PhysicalThing"/>
        <skos:closeMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E22_Human-Made_Object"/>
        <skos:definition>Union of tangible heritage object classes: structures, iconographic objects, and architectural elements.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


