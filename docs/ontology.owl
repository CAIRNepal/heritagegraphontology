        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Proposition"/>
        <rdfs:label xml:lang="en">Asserts proposition</rdfs:label>
        <skos:definition xml:lang="en">Machine-readable proposition(s) this assertion holds to be true (CRMinf J4 that). Complements the free-text assertion_content.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#actedOnBehalfOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#actedOnBehalfOf">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:label xml:lang="en">Acted on behalf of</rdfs:label>
        <skos:definition xml:lang="en">Agent on whose behalf this agent acted.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#generated -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#generated">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#wasGeneratedBy"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">generated</rdfs:label>
        <skos:definition xml:lang="en">Entity generated by this activity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#used -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">used</rdfs:label>
        <skos:definition xml:lang="en">Entity used by this activity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:label xml:lang="en">Was associated with</rdfs:label>
        <skos:definition xml:lang="en">Agent associated with responsibility for this activity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAttributedTo -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAttributedTo">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:label xml:lang="en">Was attributed to</rdfs:label>
        <skos:definition xml:lang="en">Agent to whom responsibility for this entity is attributed.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:label xml:lang="en">Was derived from</rdfs:label>
        <skos:definition xml:lang="en">Entity from which this entity was derived.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasGeneratedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasGeneratedBy">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:label xml:lang="en">Was generated by</rdfs:label>
        <skos:definition xml:lang="en">Activity that generated this entity.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasInfluencedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInfluencedBy">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Activity"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Agent"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:label xml:lang="en">Was influenced by</rdfs:label>
        <skos:definition xml:lang="en">General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasInformedBy -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasInformedBy">
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:label xml:lang="en">Was informed by</rdfs:label>
        <skos:definition xml:lang="en">Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasRevisionOf -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasRevisionOf">
        <rdfs:range rdf:resource="http://www.ics.forth.gr/isl/CRMinf/I2_Belief"/>
        <rdfs:label xml:lang="en">Supersedes assertion</rdfs:label>
        <skos:definition xml:lang="en">Previous assertion that this one revises (version chain A1-&gt;A2-&gt;A3). Uses prov:wasRevisionOf (a derivation between entities); the latest assertion is the one with no incoming wasRevisionOf. NOTE: prov:invalidated was incorrect here (it is an Activity-&gt;Entity relation, not Entity-&gt;Entity).</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:ObjectProperty>
    


