        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/schema_version -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/schema_version">
        <rdfs:label>schema_version</rdfs:label>
        <skos:definition>Version of the HeritageGraph schema the dataset conforms to.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/selection_criteria_met -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/selection_criteria_met">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>selection_criteria_met</rdfs:label>
        <skos:definition>List of selection criteria verified during Living Goddess selection process (e.g., &apos;32 lakshana present&apos;, &apos;No scars or blemishes&apos;, &apos;Horoscope compatible with city&apos;, &apos;Passed fearlessness test&apos;)</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/source_citation -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/source_citation">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/heritagegraph/note"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>source_citation</rdfs:label>
        <skos:definition>Formal citation of source</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/source_language -->


