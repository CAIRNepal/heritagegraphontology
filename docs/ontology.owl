    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"/>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/P8_took_place_on_or_within -->


    <owl:ObjectProperty rdf:about="http://www.cidoc-crm.org/cidoc-crm/P8_took_place_on_or_within"/>
    


