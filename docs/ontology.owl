    <!-- https://w3id.org/heritagegraph/AssertionSubject -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/AssertionSubject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody"/>
