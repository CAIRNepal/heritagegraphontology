        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/heritagegraph/curator -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/heritagegraph/curator">
        <rdfs:label>curator</rdfs:label>
        <skos:definition>Person or institution responsible for curating the dataset.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:DatatypeProperty>
    


