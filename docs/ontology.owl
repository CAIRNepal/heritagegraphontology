                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/HistoricalEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Production"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/RitualEvent"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/TransferOfCustody"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>HeritageEvent</rdfs:label>
        <skos:definition>Union of heritage event classes used for actor participation and temporal reasoning.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


