        <skos:definition>Government or institutional administrative record</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/AssertableEntity -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/AssertableEntity">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalElement"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/CasteGroup"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Deity"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Guthi"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/HumanMadeObject"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/IconographicObject"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Material"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Person"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Place"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/Technique"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/TimeSpan"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E1_CRM_Entity"/>
        <rdfs:label>AssertableEntity</rdfs:label>
        <skos:definition>Any entity that can be the subject of a heritage assertion</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/BuddhistMonument -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/BuddhistMonument">
        <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
        <owl:disjointWith rdf:resource="https://w3id.org/heritagegraph/RestHouse"/>
        <owl:disjointWith rdf:resource="https://w3id.org/heritagegraph/Temple"/>
        <owl:disjointWith rdf:resource="https://w3id.org/heritagegraph/WaterStructure"/>
        <rdfs:label>BuddhistMonument</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q177980"/>
        <skos:definition>Buddhist sacred structure (Stupa, Chaitya) with circumambulation and ritual activation patterns</skos:definition>
        <skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300007576"/>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/CalendarSystem -->


