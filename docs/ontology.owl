    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody -->


    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by"/>
                <owl:allValuesFrom rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by"/>
                <owl:allValuesFrom rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
                <owl:allValuesFrom rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"/>
                <owl:allValuesFrom rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/heritagegraph/transferredToGuthi"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/heritagegraph/Guthi"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
