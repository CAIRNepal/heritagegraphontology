        <rdfs:label xml:lang="en">Proposition</rdfs:label>
        <skos:broadMatch rdf:resource="http://www.ics.forth.gr/isl/CRMinf/I4_Proposition_Set"/>
        <skos:closeMatch rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
        <skos:definition xml:lang="en">A single machine-readable proposition (subject - predicate - object) held true by an Assertion. Modelled as a singleton proposition set (CRMinf I4); the predicate is a URI/CURIE, the object either a heritage entity or a literal.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/schema"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/ReligiousStructure -->


