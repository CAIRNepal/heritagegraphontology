  {
    "@id": "https://cair-nepal.org/heritagegraph/PhysicalIntegrityCriterion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Physical Integrity Criterion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/SelectionCriterion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Candidate must have an unblemished body with no scars, wounds, or loss of blood/teeth."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/schema"
      }
    ]
  },
  {
    "@id": "https://cair-nepal.org/heritagegraph/HoroscopeCompatibilityCriterion",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Horoscope Compatibility Criterion"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/SelectionCriterion"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Candidate's horoscope must be compatible with the city and ruling authority."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/schema"
      }
    ]
  },
  {
    "@id": "https://cair-nepal.org/heritagegraph/information_objects",
