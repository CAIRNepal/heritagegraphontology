  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/RitualType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ritual Type</rdfs:label>
    <owl:oneOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db607"/>
    <skos:definition xml:lang="en">Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
    <heritageGraph:design_note>RitualType currently mixes three orthogonal axes: worship-frequency (NityaPuja/NaimittikaPuja/KamyaPuja), ritual form (Homa/Jatra/MaskedPerformance), and lifecycle (InstallationRitual/ReturningRitual). Consider splitting into RitualFrequency + RitualForm. Also: Circumambulation/ProcessionalMovement/ProcessionRitual/RelicTour overlap with RitualEvent.route_places/start_place/end_place/route_description -- pick one canonical mechanism for moving rituals.</heritageGraph:design_note>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#Abhisheka"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#Bhajan"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#Circumambulation"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#Homa"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#Jatra"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#NityaPuja"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#RelicTour"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#Vrata"/>
    <linkml:permissible_values rdf:resource="https://cair-nepal.org/heritagegraph/RitualType#Yagna"/>
  </rdf:Description>
