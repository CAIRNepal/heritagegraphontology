  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/endedTenureOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Ended tenure of</rdfs:label>
    <rdfs:range rdf:resource="https://cair-nepal.org/heritagegraph/KumariTenure"/>
    <rdfs:subPropertyOf rdf:resource="https://cair-nepal.org/heritagegraph/boundsTenure"/>
    <owl:inverseOf rdf:resource="https://cair-nepal.org/heritagegraph/retiredThrough"/>
    <skos:definition xml:lang="en">Points from a KumariRetirementEvent to the tenure that it terminated. Enables reconstruction of the complete Kumari lifecycle.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
