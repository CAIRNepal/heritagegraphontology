  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/FearlessnessAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fearlessness Assessment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/RitualAssessment"/>
    <skos:definition xml:lang="en">The 'fearlessness test' popularly described (animal heads, masked dancers in darkness). Its historical and contemporary practice is DISPUTED -- some former Kumaris contest how it is described. Represented as an assessment whose accounts are source-attributed via has_assertion, NOT as a mandatory criterion.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
    <skos:scopeNote xml:lang="en">Deliberately not a SelectionCriterion subclass: popular accounts and lived testimony disagree. Attach each account as a Assertion (CRMinf I2 Belief) with its own source and confidence.</skos:scopeNote>
  </rdf:Description>
