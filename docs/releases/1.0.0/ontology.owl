  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/KumariRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kumari Role</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db407"/>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db408"/>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db409"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:altLabel xml:lang="en">Living Goddess</skos:altLabel>
    <skos:altLabel xml:lang="en">Royal Kumari</skos:altLabel>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
    <skos:definition xml:lang="en">The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db442">
