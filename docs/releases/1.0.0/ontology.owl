    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/WaterStructure"/>
    <skos:definition xml:lang="en">Pond or tank for water storage, ritual bathing, and ecological management</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/data_custodians">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Data custodians</rdfs:label>
    <rdfs:range rdf:resource="https://cair-nepal.org/heritagegraph/DataCustodian"/>
    <skos:definition xml:lang="en">Collection of DataCustodian instances</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.cidoc-crm.org/cidoc-crm/E10_Transfer_of_Custody">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Transfer Of Custody</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">Event of transferring responsibility for temple maintenance, ritual performance, or artifact stewardship</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
    <heritageGraph:prov_alignment_note>prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM&lt;-&gt;PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally.</heritageGraph:prov_alignment_note>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/ArchivalRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Archival Record</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/DataSource"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E31_Document"/>
    <skos:definition xml:lang="en">Government or institutional administrative record</skos:definition>
    <skos:exactMatch rdf:resource="https://www.ica.org/standards/RiC/ontology#Record"/>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/KumariLifecycleEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kumari Lifecycle Event</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db317"/>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db318"/>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db319"/>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/RitualEvent"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:broadMatch rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">Abstract event that bounds a KumariTenure (selection, enthronement, or retirement). Each concrete subclass requires exactly one tenure edge via slot_usage: initiated_tenure (selection), ended_tenure_of (retirement), or bounds_tenure itself (enthronement).</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db523">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/deathTimespan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Death timespan</rdfs:label>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E52_Time-Span"/>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span"/>
    <skos:definition xml:lang="en">Person's death timespan</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/ns/prov#Entity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Entity</rdfs:label>
    <skos:definition xml:lang="en">Direct LinkML representation of prov:Entity. Applied to physical, digital, conceptual, and assertion-bearing things that participate in provenance relations. PROVENANCE SCOPE (design decision): for classes whose instances are real-world referents (structures, deities, places, actors), the provenance slots (was_derived_from, was_attributed_to, was_generated_by, generated_at_time) describe the DATA RECORD about the referent, not the referent itself -- a stupa is not generated by the survey that records it. Referent-level history is modelled through events (Production, DestructionEvent, etc.). RDF deployments SHOULD carry record-level provenance in named graphs or on InformationObject/Assertion nodes.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
    <heritageGraph:provenance_scope>record</heritageGraph:provenance_scope>
  </rdf:Description>
