  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/LineageCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lineage Criterion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/SelectionCriterion"/>
    <skos:definition xml:lang="en">Candidate must belong to an eligible lineage (Shakya / Vajracharya Newar Buddhist family).</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
