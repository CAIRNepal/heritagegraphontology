    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db287"/>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db288"/>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db289"/>
    <rdfs:subClassOf rdf:nodeID="na33664850b764a9cba8ae34a1e08bc6db290"/>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/KumariLifecycleEvent"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:broadMatch rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
    <heritageGraph:prov_alignment_note>prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM&lt;-&gt;PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally.</heritageGraph:prov_alignment_note>
  </rdf:Description>
