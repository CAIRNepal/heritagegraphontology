        "@id": "https://cair-nepal.org/heritagegraph/KumariLifecycleEvent"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broadMatch": [
      {
        "@id": "http://www.cidoc-crm.org/cidoc-crm/E7_Activity"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/schema"
      }
    ],
    "https://cair-nepal.org/heritagegraph/prov_alignment_note": [
      {
        "@value": "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."
      }
    ]
  },
