      {
        "@id": "_:na33664850b764a9cba8ae34a1e08bc6db77"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#broadMatch": [
      {
        "@id": "http://www.w3.org/ns/prov#Collection"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Root container for cultural heritage data instances. PLACEMENT RULE: put each instance in the most specific collection available (e.g. a Festival in festivals, not ritual_events; a Person in persons, not actors); broader collections exist for instances of the general classes only."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "https://cair-nepal.org/heritagegraph/schema"
      }
    ],
    "https://cair-nepal.org/heritagegraph/design_note": [
      {
        "@value": "Serialization construct, not a domain class: this is the LinkML tree_root that anchors JSON/YAML dataset serializations (its collection properties exist for data exchange only). Reasoners and domain queries should ignore it; RDF instance data does not need a Container node."
      }
    ]
  },
