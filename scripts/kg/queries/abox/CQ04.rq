# CQ04: Heritage structures associated with historical events (earthquake, restoration, ...)
# DATA-GAP: HistoricalEvent instances are not yet modelled (earthquake mentions exist only as free-text notes).
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?structure ?event ?type WHERE {
  ?event a hg:HistoricalEvent ; hg:architectural_structures ?structure .
  OPTIONAL { ?event crm:P2_has_type ?type }
}
