# CQ08: Active temples with daily Nitya Puja assessed as Poor/Endangered
# DATA-GAP: No ConditionAssessment / ConditionState data in the current open sources.
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?temple ?state WHERE {
  ?temple hg:ritual_type hg:NityaPuja ; hg:has_condition_assessment ?ca .
  ?ca hg:assessed_condition_state ?state .
  FILTER(?state IN (hg:Poor, hg:Endangered))
}
