# CQ11: Rituals/festivals, the deities they invoke, and their recurrence patterns
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?festival ?deityLabel ?recurrence WHERE {
  ?f rdfs:label ?festival ; hg:invokes_deity ?d ; hg:recurrence_pattern ?recurrence .
  ?d rdfs:label ?deityLabel .
} LIMIT 25
