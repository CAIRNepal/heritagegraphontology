# CQ26: Living Goddess (Kumari) office: participant, residence and tenure period
PREFIX hg: <https://cair-nepal.org/heritagegraph/>
PREFIX crm: <http://www.cidoc-crm.org/cidoc-crm/>
PREFIX crminf: <http://www.cidoc-crm.org/extensions/crminf/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?person ?residence ?begin WHERE {
  ?tenure crm:P11_had_participant ?p ;
          crm:P74_has_current_or_former_residence ?res ;
          crm:P4_has_time-span ?ts .
  ?p rdfs:label ?person .
  ?res rdfs:label ?residence .
  ?ts crm:P82a_begin_of_the_begin ?begin .
}
