###  https://w3id.org/heritagegraph/HeritageEvent
heritageGraph:HeritageEvent rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:unionOf ( heritageGraph:ConditionAssessment
                                                                heritageGraph:DestructionEvent
                                                                heritageGraph:DocumentationActivity
                                                                heritageGraph:HistoricalEvent
                                                                heritageGraph:Production
                                                                heritageGraph:RitualEvent
                                                                heritageGraph:TransferOfCustody
                                                              )
                                                ] ;
                            rdfs:subClassOf owl:Thing ;
                            rdfs:label "HeritageEvent" ;
                            skos:definition "Union of heritage event classes used for actor participation and temporal reasoning." ;
                            skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/HistoricalEvent
heritageGraph:HistoricalEvent rdf:type owl:Class ;
                              rdfs:subClassOf crm:E5_Event ,
                                              heritageGraph:HeritageEvent ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:architectural_structures ;
                                                owl:allValuesFrom heritageGraph:ArchitecturalStructure
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:has_timespan ;
                                                owl:allValuesFrom heritageGraph:TimeSpan
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:includes_ritual_event ;
                                                owl:allValuesFrom heritageGraph:RitualEvent
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:took_place_at ;
                                                owl:allValuesFrom heritageGraph:Place
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:architectural_structures ;
                                                owl:minCardinality "0"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:has_timespan ;
                                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:includes_ritual_event ;
                                                owl:minCardinality "0"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:took_place_at ;
                                                owl:minCardinality "0"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:has_timespan ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:took_place_at ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:name ;
                                                owl:allValuesFrom xsd:string
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:note ;
                                                owl:allValuesFrom xsd:string
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:name ;
                                                owl:minCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:note ;
                                                owl:minCardinality "0"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:name ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty heritageGraph:note ;
                                                owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                              ] ;
                              rdfs:label "HistoricalEvent" ;
                              skos:definition "Major event affecting heritage structures or ritual life (earthquake, epidemic, political transition, fire, flood)." ;
                              skos:exactMatch crm:E5_Event ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


