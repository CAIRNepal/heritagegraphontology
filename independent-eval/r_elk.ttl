###  https://w3id.org/heritagegraph/schema_version
heritageGraph:schema_version rdf:type owl:DatatypeProperty ;
                             rdfs:label "schema_version" ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/selection_criteria_met
heritageGraph:selection_criteria_met rdf:type owl:DatatypeProperty ;
                                     rdfs:range xsd:string ;
                                     rdfs:label "selection_criteria_met" ;
                                     skos:definition "List of selection criteria verified during Living Goddess selection process (e.g., '32 lakshana present', 'No scars or blemishes', 'Horoscope compatible with city', 'Passed fearlessness test')" ;
                                     skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/source_citation
heritageGraph:source_citation rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf heritageGraph:note ;
                              rdfs:range xsd:string ;
                              rdfs:label "source_citation" ;
                              skos:definition "Formal citation of source" ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/source_language
heritageGraph:source_language rdf:type owl:DatatypeProperty ;
                              rdfs:range xsd:string ;
                              rdfs:label "source_language" ;
                              skos:definition "Language of the source material" ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


