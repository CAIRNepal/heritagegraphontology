                                                       owl:onProperty heritageGraph:note ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ;
                                     owl:disjointWith heritageGraph:IconographicObject ;
                                     rdfs:label "ArchitecturalStructure" ;
                                     skos:broadMatch <http://vocab.getty.edu/aat/300004792> ;
