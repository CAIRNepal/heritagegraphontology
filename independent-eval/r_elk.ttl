                                                       owl:onProperty heritageGraph:has_architectural_style ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty heritageGraph:has_current_location ;
                                                       owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                     ] ,
