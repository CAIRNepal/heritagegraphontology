@prefix : <https://w3id.org/heritagegraph/ontology#> .
@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix crm: <http://www.cidoc-crm.org/cidoc-crm/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix edm: <http://www.europeana.eu/schemas/edm/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix crminf: <http://www.cidoc-crm.org/crminf/> .
@prefix crmsci: <http://www.cidoc-crm.org/crmsci/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix schema1: <http://schema.org/> .
@prefix wikidata: <http://www.wikidata.org/entity/> .
@prefix heritageGraph: <https://w3id.org/heritagegraph/> .
@base <https://w3id.org/heritagegraph/ontology> .

<https://w3id.org/heritagegraph/ontology> rdf:type owl:Ontology ;
                                           owl:versionIRI <https://w3id.org/heritagegraph/ontology/1.0.0> ;
                                           dct:creator "Cair Nepal" ;
                                           dct:license <https://creativecommons.org/licenses/by/4.0/> ,
                                                       "CC-BY-4.0" ,
                                                       "https://creativecommons.org/licenses/by/4.0/" ;
                                           dct:modified "2026-06-05" ;
                                           dct:publisher "Cair Nepal" ;
                                           dct:title "HeritageGraph Ontology" ;
                                           pav:version "1.0.0" ;
                                           rdfs:label "HeritageGraph" ;
                                           owl:ontologyIRI "https://w3id.org/heritagegraph/ontology" ;
                                           owl:versionInfo "1.0.0" ;
                                           skos:definition "An event-centric LinkML schema for representing Nepal cultural heritage information, fully aligned with CIDOC-CRM v7.2.1 and PROV-O. Enables provenance tracking, ritual-spatial-temporal reasoning, and multi-calendar date representation. DL expressivity: ALCIQ(D)." .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/creator
dct:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
dct:license rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/modified
dct:modified rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/publisher
dct:publisher rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dct:title rdf:type owl:AnnotationProperty .


###  http://purl.org/pav/version
pav:version rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#ontologyIRI
owl:ontologyIRI rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty .


###  https://w3id.org/linkml/permissible_values
linkml:permissible_values rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.opengis.net/ont/geosparql#wktLiteral
geo:wktLiteral rdf:type rdfs:Datatype ;
               owl:equivalentClass xsd:string .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.cidoc-crm.org/cidoc-crm/P107_has_current_or_former_member
crm:P107_has_current_or_former_member rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P107i_is_current_or_former_member_of
crm:P107i_is_current_or_former_member_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P108_has_produced
crm:P108_has_produced rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P108i_was_produced_by
crm:P108i_was_produced_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P11_had_participant
crm:P11_had_participant rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P120_occurs_before
crm:P120_occurs_before rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P120i_is_occurred_before_by
crm:P120i_is_occurred_before_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P125_used_object_of_type
crm:P125_used_object_of_type rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P129_is_about
crm:P129_is_about rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P12_occurred_in_the_presence_of
crm:P12_occurred_in_the_presence_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P14.1_in_the_role_of
crm:P14.1_in_the_role_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P140_assigned_attribute_to
crm:P140_assigned_attribute_to rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P141_assigned
crm:P141_assigned rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P14_carried_out_by
crm:P14_carried_out_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P17_was_motivated_by
crm:P17_was_motivated_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P28_custody_surrendered_by
crm:P28_custody_surrendered_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P29_custody_received_by
crm:P29_custody_received_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P30_transferred_custody_of
crm:P30_transferred_custody_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P30i_custody_transferred_through
crm:P30i_custody_transferred_through rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P32_used_general_technique
crm:P32_used_general_technique rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P34_concerned
crm:P34_concerned rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P34i_was_assessed_by
crm:P34i_was_assessed_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P35_has_identified
crm:P35_has_identified rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P46_is_composed_of
crm:P46_is_composed_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P46i_forms_part_of
crm:P46i_forms_part_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P4_has_time-span
crm:P4_has_time-span rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P50_has_current_keeper
crm:P50_has_current_keeper rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P53i_is_former_or_current_location_of
crm:P53i_is_former_or_current_location_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P55_has_current_location
crm:P55_has_current_location rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P62_depicts
crm:P62_depicts rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P62i_is_depicted_by
crm:P62i_is_depicted_by rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P74_has_current_or_former_residence
crm:P74_has_current_or_former_residence rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at
crm:P7_took_place_at rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P8_took_place_on_or_within
crm:P8_took_place_on_or_within rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P9_consists_of
crm:P9_consists_of rdf:type owl:ObjectProperty .


###  http://www.cidoc-crm.org/cidoc-crm/P9i_forms_part_of
crm:P9i_forms_part_of rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#generated
prov:generated rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#invalidated
prov:invalidated rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasAssociatedWith
prov:wasAssociatedWith rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasAttributedTo
prov:wasAttributedTo rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasDerivedFrom
prov:wasDerivedFrom rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasGeneratedBy
prov:wasGeneratedBy rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/prov#wasInfluencedBy
prov:wasInfluencedBy rdf:type owl:ObjectProperty .


###  https://w3id.org/heritagegraph/architectural_elements
heritageGraph:architectural_elements rdf:type owl:ObjectProperty ;
                                     rdfs:label "architectural_elements" ;
                                     skos:definition "Collection of ArchitecturalElement instances" ;
                                     skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/architectural_structures
heritageGraph:architectural_structures rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf crm:P12_occurred_in_the_presence_of ;
                                       rdfs:range heritageGraph:ArchitecturalStructure ;
                                       rdfs:label "architectural_structures" ;
                                       skos:definition "Heritage structures affected by or present during this historical event" ;
                                       skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/assertion_author
heritageGraph:assertion_author rdf:type owl:ObjectProperty ;
                               rdfs:range heritageGraph:Actor ;
                               rdfs:label "assertion_author" ;
                               skos:broadMatch crm:P14_carried_out_by ;
                               skos:definition "The agent (scholar, priest, or tradition-bearer) making or recording the syncretic claim." ;
                               skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/asserts_about_entity
heritageGraph:asserts_about_entity rdf:type owl:ObjectProperty ;
                                   rdfs:range heritageGraph:AssertableEntity ;
                                   rdfs:label "asserts_about_entity" ;
                                   skos:definition "Entity that is the subject of this belief/assertion (CRMinf I2_Belief scope; not an E13 attribute assignment)." ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/asserts_about_event
heritageGraph:asserts_about_event rdf:type owl:ObjectProperty ;
                                  rdfs:range heritageGraph:RitualEvent ;
                                  rdfs:label "asserts_about_event" ;
                                  skos:definition "Event that is the subject of this belief/assertion (CRMinf I2_Belief scope; not an E13 attribute assignment)." ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/assessed_condition_state
heritageGraph:assessed_condition_state rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf crm:P35_has_identified ;
                                       rdfs:range heritageGraph:ConditionState ;
                                       rdfs:label "assessed_condition_state" ;
                                       skos:definition "Condition state identified by the assessment" ;
                                       skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/assessed_object
heritageGraph:assessed_object rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf crm:P34_concerned ;
                              rdfs:range heritageGraph:PhysicalHeritageThing ;
                              rdfs:label "assessed_object" ;
                              skos:definition "Object assessed for condition" ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/assigned_equivalent
heritageGraph:assigned_equivalent rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf crm:P141_assigned ;
                                  rdfs:range heritageGraph:Deity ;
                                  rdfs:label "assigned_equivalent" ;
                                  skos:definition "The deity or sacred figure being identified as equivalent to the primary deity." ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/assigned_to_deity
heritageGraph:assigned_to_deity rdf:type owl:ObjectProperty ;
                                rdfs:subPropertyOf crm:P140_assigned_attribute_to ;
                                rdfs:range heritageGraph:Deity ;
                                rdfs:label "assigned_to_deity" ;
                                skos:definition "The deity instance that is the subject of the syncretic claim." ;
                                skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/birth_timespan
heritageGraph:birth_timespan rdf:type owl:ObjectProperty ;
                             rdfs:range heritageGraph:TimeSpan ;
                             rdfs:label "birth_timespan" ;
                             skos:broadMatch crm:P4_has_time-span ;
                             skos:definition "Person's birth timespan" ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/calendar_system
heritageGraph:calendar_system rdf:type owl:ObjectProperty ;
                              rdfs:range heritageGraph:CalendarSystem ;
                              rdfs:label "calendar_system" ;
                              skos:definition "Calendar system used for date representation" ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/calendar_systems
heritageGraph:calendar_systems rdf:type owl:ObjectProperty ;
                               rdfs:label "calendar_systems" ;
                               skos:definition "Collection of CalendarSystem instances" ;
                               skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/carried_out_activity
heritageGraph:carried_out_activity rdf:type owl:ObjectProperty ;
                                   owl:inverseOf heritageGraph:carried_out_by ;
                                   rdfs:domain heritageGraph:Actor ;
                                   rdfs:range heritageGraph:HeritageEvent ;
                                   rdfs:label "carried_out_activity" ;
                                   skos:broadMatch crm:P14i_performed ;
                                   skos:definition "Activities performed by this actor" ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/carried_out_by
heritageGraph:carried_out_by rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf crm:P14_carried_out_by ;
                             rdfs:domain heritageGraph:HeritageEvent ;
                             rdfs:range heritageGraph:Actor ;
                             rdfs:label "carried_out_by" ;
                             skos:definition "Actor(s) who performed this event" ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/caste_groups
heritageGraph:caste_groups rdf:type owl:ObjectProperty ;
                           rdfs:label "caste_groups" ;
                           skos:definition "Collection of CasteGroup instances" ;
                           skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/commissioned_by
heritageGraph:commissioned_by rdf:type owl:ObjectProperty ;
                              rdfs:subPropertyOf crm:P17_was_motivated_by ;
                              rdfs:range heritageGraph:Actor ;
                              rdfs:label "commissioned_by" ;
                              skos:definition "Person or group who commissioned production" ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/conflicts_with_assertion
heritageGraph:conflicts_with_assertion rdf:type owl:ObjectProperty ;
                                       rdfs:range heritageGraph:HeritageAssertion ;
                                       rdfs:label "conflicts_with_assertion" ;
                                       skos:definition "Other assertions that contest or contradict this claim, supporting multi-vocal heritage representation." ;
                                       skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/consecrated_by_event
heritageGraph:consecrated_by_event rdf:type owl:ObjectProperty ;
                                   rdfs:range heritageGraph:Consecration ;
                                   rdfs:label "consecrated_by_event" ;
                                   skos:definition "Consecration event that activated this murti" ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/consecrated_object
heritageGraph:consecrated_object rdf:type owl:ObjectProperty ;
                                 rdfs:range heritageGraph:Murti ;
                                 rdfs:label "consecrated_object" ;
                                 skos:broadMatch crm:P11_had_participant ;
                                 skos:definition "Murti that participated in the consecration ritual" ;
                                 skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/consecration_events
heritageGraph:consecration_events rdf:type owl:ObjectProperty ;
                                  rdfs:label "consecration_events" ;
                                  skos:definition "Collection of Consecration event instances" ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/contains_structure
heritageGraph:contains_structure rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf crm:P53i_is_former_or_current_location_of ;
                                 owl:inverseOf heritageGraph:has_current_location ;
                                 rdfs:domain heritageGraph:Place ;
                                 rdfs:range heritageGraph:PhysicalHeritageThing ;
                                 rdfs:label "contains_structure" ;
                                 skos:definition "Structures located in this place" ;
                                 skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/created_by_documentation
heritageGraph:created_by_documentation rdf:type owl:ObjectProperty ;
                                       rdfs:subPropertyOf prov:wasGeneratedBy ;
                                       owl:inverseOf heritageGraph:produced_information_object ;
                                       rdfs:domain heritageGraph:InformationObject ;
                                       rdfs:range heritageGraph:DocumentationActivity ;
                                       rdfs:label "created_by_documentation" ;
                                       skos:definition "Documentation activity that produced this information object" ;
                                       skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/custody_events
heritageGraph:custody_events rdf:type owl:ObjectProperty ;
                             rdfs:label "custody_events" ;
                             skos:definition "Collection of TransferOfCustody event instances" ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/data_custodians
heritageGraph:data_custodians rdf:type owl:ObjectProperty ;
                              rdfs:label "data_custodians" ;
                              skos:definition "Collection of DataCustodian instances" ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/data_sources
heritageGraph:data_sources rdf:type owl:ObjectProperty ;
                           rdfs:label "data_sources" ;
                           skos:definition "Collection of DataSource instances" ;
                           skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/datacite_creator
heritageGraph:datacite_creator rdf:type owl:ObjectProperty ;
                               rdfs:range heritageGraph:Actor ;
                               rdfs:label "datacite_creator" ;
                               skos:definition "Person or organization primarily responsible for creating the source" ;
                               skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/datacite_publisher
heritageGraph:datacite_publisher rdf:type owl:ObjectProperty ;
                                 rdfs:range heritageGraph:Actor ;
                                 rdfs:label "datacite_publisher" ;
                                 skos:definition "Entity responsible for making the source available" ;
                                 skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/date_precision
heritageGraph:date_precision rdf:type owl:ObjectProperty ;
                             rdfs:range heritageGraph:DatePrecisionEnum ;
                             rdfs:label "date_precision" ;
                             skos:definition "The level of precision for a recorded date." ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/death_timespan
heritageGraph:death_timespan rdf:type owl:ObjectProperty ;
                             rdfs:range heritageGraph:TimeSpan ;
                             rdfs:label "death_timespan" ;
                             skos:broadMatch crm:P4_has_time-span ;
                             skos:definition "Person's death timespan" ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/deities
heritageGraph:deities rdf:type owl:ObjectProperty ;
                      rdfs:label "deities" ;
                      skos:definition "Collection of Deity instances" ;
                      skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/depicts_deity
heritageGraph:depicts_deity rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf crm:P62_depicts ;
                            owl:inverseOf heritageGraph:is_depicted_in ;
                            rdfs:domain heritageGraph:IconographicObject ;
                            rdfs:range heritageGraph:Deity ;
                            rdfs:label "depicts_deity" ;
                            skos:definition "Deity depicted iconographically (not cultic presence)" ;
                            skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/derived_from_interview
heritageGraph:derived_from_interview rdf:type owl:ObjectProperty ;
                                     rdfs:range heritageGraph:OralHistoryInterview ;
                                     rdfs:label "derived_from_interview" ;
                                     skos:definition "Oral history interview event that produced this recording or transcript." ;
                                     skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/destruction_event
heritageGraph:destruction_event rdf:type owl:ObjectProperty ;
                                rdfs:range heritageGraph:DestructionEvent ;
                                rdfs:label "destruction_event" ;
                                skos:definition "Event that destroyed this structure (if known)" ;
