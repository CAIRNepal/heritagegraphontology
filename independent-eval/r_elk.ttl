                                  skos:definition "The activity of measuring, photographing, or assessing a site in person." ;
                                  skos:exactMatch crmsci:S4_Observation ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/FieldSurveyDataset
heritageGraph:FieldSurveyDataset rdf:type owl:Class ;
                                 rdfs:subClassOf crm:E31_Document ,
                                                 heritageGraph:DataSource ;
                                 owl:disjointWith heritageGraph:OralHistoryRecording ;
                                 rdfs:label "FieldSurveyDataset" ;
                                 skos:definition "The structured data or report resulting from a field survey." ;
                                 skos:exactMatch crm:E31_Document ;
                                 skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/Guthi
heritageGraph:Guthi rdf:type owl:Class ;
                    rdfs:subClassOf heritageGraph:AssertableEntity ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:guthi_type ;
                                      owl:allValuesFrom heritageGraph:GuthiTypeEnum
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:has_membership ;
                                      owl:allValuesFrom heritageGraph:Person
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:holds_custody_of ;
                                      owl:allValuesFrom heritageGraph:ArchitecturalStructure
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:performs_ritual ;
                                      owl:allValuesFrom heritageGraph:RitualEvent
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:guthi_type ;
                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:has_membership ;
                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:holds_custody_of ;
                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:performs_ritual ;
                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:guthi_type ;
                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:name ;
                                      owl:allValuesFrom xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:note ;
                                      owl:allValuesFrom xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:name ;
                                      owl:minCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:note ;
                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:name ;
                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:note ;
                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                    ] ;
                    owl:disjointWith heritageGraph:Person ,
                                     heritageGraph:Place ;
                    rdfs:label "Guthi" ;
                    skos:broadMatch crm:E74_Group ;
                    skos:definition "Endowed trust organization unique to Nepal, managing temples, rituals, and land through hereditary or voluntary membership" ;
                    skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/GuthiTypeEnum
heritageGraph:GuthiTypeEnum rdf:type owl:Class ;
                            owl:equivalentClass [ rdf:type owl:Class ;
                                                  owl:oneOf ( heritageGraph:JatraGuthi
                                                              heritageGraph:NashaGuthi
                                                              heritageGraph:PujaGuthi
                                                              heritageGraph:RajGuthi
                                                              heritageGraph:SanGuthi
                                                              heritageGraph:SanaGuthi
                                                              heritageGraph:SiGuthi
                                                              heritageGraph:TempleGuthi
                                                            )
                                                ] ;
                            rdfs:subClassOf owl:Thing ;
                            rdfs:label "GuthiTypeEnum" ;
                            skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)" ;
                            skos:inScheme <https://w3id.org/heritagegraph/ontology> ;
                            linkml:permissible_values heritageGraph:JatraGuthi ,
                                                      heritageGraph:NashaGuthi ,
                                                      heritageGraph:PujaGuthi ,
                                                      heritageGraph:RajGuthi ,
                                                      heritageGraph:SanGuthi ,
                                                      heritageGraph:SanaGuthi ,
                                                      heritageGraph:SiGuthi ,
                                                      heritageGraph:TempleGuthi .


###  https://w3id.org/heritagegraph/HeritageActivity
heritageGraph:HeritageActivity rdf:type owl:Class ;
                               rdfs:subClassOf crm:E7_Activity ;
                               owl:disjointWith heritageGraph:HeritageAssertion ,
                                                heritageGraph:HumanMadeObject ,
                                                heritageGraph:Place ;
                               rdfs:label "HeritageActivity" ;
                               skos:definition "Abstract superclass for intentional heritage-related activities, aligned with CIDOC CRM E7 Activity." ;
                               skos:exactMatch crm:E7_Activity ;
                               skos:inScheme <https://w3id.org/heritagegraph/ontology> .


