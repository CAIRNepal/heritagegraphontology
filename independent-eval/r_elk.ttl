###  https://w3id.org/heritagegraph/Actor
heritageGraph:Actor rdf:type owl:Class ;
                    rdfs:subClassOf crm:E39_Actor ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:carried_out_activity ;
                                      owl:allValuesFrom heritageGraph:HeritageEvent
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:carried_out_activity ;
                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:name ;
                                      owl:allValuesFrom xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:note ;
                                      owl:allValuesFrom xsd:string
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:name ;
                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:note ;
                                      owl:minCardinality "0"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:name ;
                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty heritageGraph:note ;
                                      owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                    ] ;
                    owl:disjointWith heritageGraph:HumanMadeObject ;
                    rdfs:label "Actor" ;
                    skos:broadMatch edm:Agent ;
                    skos:definition "General actor (person or group) responsible for events" ;
                    skos:exactMatch crm:E39_Actor ;
                    skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/ArchitecturalElement
heritageGraph:ArchitecturalElement rdf:type owl:Class ;
                                   rdfs:subClassOf crm:E25_Architectural_Element ,
                                                   heritageGraph:AssertableEntity ,
                                                   heritageGraph:PhysicalHeritageThing ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:is_component_of ;
                                                     owl:allValuesFrom heritageGraph:ArchitecturalStructure
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:is_component_of ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:is_component_of ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:name ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:note ;
                                                     owl:allValuesFrom xsd:string
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:name ;
                                                     owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:note ;
                                                     owl:minCardinality "0"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:name ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty heritageGraph:note ;
                                                     owl:maxCardinality "1"^^xsd:nonNegativeInteger
                                                   ] ;
                                   owl:disjointWith heritageGraph:ArchitecturalStructure ,
                                                    heritageGraph:Deity ,
                                                    heritageGraph:IconographicObject ,
                                                    heritageGraph:Person ;
                                   rdfs:label "ArchitecturalElement" ;
                                   skos:definition "Carved or constructed component of an architectural structure (e.g., Gajur, Torana, Tundal)" ;
                                   skos:exactMatch <http://vocab.getty.edu/aat/300000885> ,
                                                   crm:E25_Architectural_Element ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


