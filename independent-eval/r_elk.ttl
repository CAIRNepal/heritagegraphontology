                                     skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/ArchitecturalStyleEnum
heritageGraph:ArchitecturalStyleEnum rdf:type owl:Class ;
                                     owl:equivalentClass [ rdf:type owl:Class ;
                                                           owl:oneOf ( heritageGraph:ChaityaStyle
                                                                       heritageGraph:Dome
                                                                       heritageGraph:Pagoda
                                                                       heritageGraph:Shikhara
                                                                       heritageGraph:StupaStyle
                                                                     )
                                                         ] ;
                                     rdfs:subClassOf owl:Thing ;
                                     rdfs:label "ArchitecturalStyleEnum" ;
                                     skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type." ;
                                     skos:inScheme <https://w3id.org/heritagegraph/ontology> ;
                                     linkml:permissible_values heritageGraph:ChaityaStyle ,
                                                               heritageGraph:Dome ,
                                                               heritageGraph:Pagoda ,
                                                               heritageGraph:Shikhara ,
                                                               heritageGraph:StupaStyle .


###  https://w3id.org/heritagegraph/ArchivalRecord
heritageGraph:ArchivalRecord rdf:type owl:Class ;
                             rdfs:subClassOf heritageGraph:DataSource ,
                                             rico:Record ;
                             owl:disjointWith heritageGraph:FieldSurveyDataset ,
                                              heritageGraph:OralHistoryRecording ;
                             rdfs:label "ArchivalRecord" ;
                             skos:broadMatch crm:E31_Document ;
                             skos:definition "Government or institutional administrative record" ;
                             skos:exactMatch rico:Record ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/AssertableEntity
heritageGraph:AssertableEntity rdf:type owl:Class ;
                               owl:equivalentClass [ rdf:type owl:Class ;
                                                     owl:unionOf ( heritageGraph:ArchitecturalElement
                                                                   heritageGraph:ArchitecturalStructure
                                                                   heritageGraph:CasteGroup
                                                                   heritageGraph:Deity
                                                                   heritageGraph:Guthi
                                                                   heritageGraph:HumanMadeObject
                                                                   heritageGraph:IconographicObject
                                                                   heritageGraph:Material
                                                                   heritageGraph:Person
                                                                   heritageGraph:Place
                                                                   heritageGraph:Technique
                                                                   heritageGraph:TimeSpan
                                                                 )
                                                   ] ;
                               rdfs:subClassOf crminf:E1_Entity ;
                               rdfs:label "AssertableEntity" ;
                               skos:definition "Any entity that can be the subject of a heritage assertion" ;
                               skos:exactMatch crminf:E1_Entity ;
                               skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/BuddhistMonument
heritageGraph:BuddhistMonument rdf:type owl:Class ;
                               rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
                               owl:disjointWith heritageGraph:RestHouse ,
                                                heritageGraph:Temple ,
                                                heritageGraph:WaterStructure ;
                               rdfs:label "BuddhistMonument" ;
                               skos:definition "Buddhist sacred structure (Stupa, Chaitya) with circumambulation and ritual activation patterns" ;
                               skos:exactMatch <http://vocab.getty.edu/aat/300007576> ,
                                               wikidata:Q177980 ;
                               skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/CalendarSystem
heritageGraph:CalendarSystem rdf:type owl:Class ;
                             rdfs:subClassOf time:Calendar ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:is_primary_for_tradition ;
                                               owl:allValuesFrom heritageGraph:ReligiousTradition
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:is_primary_for_tradition ;
                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:epoch_date_gregorian ;
                                               owl:allValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:name ;
                                               owl:allValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:note ;
                                               owl:allValuesFrom xsd:string
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:year_offset_from_gregorian ;
                                               owl:allValuesFrom xsd:integer
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:epoch_date_gregorian ;
                                               owl:minCardinality "0"^^xsd:nonNegativeInteger
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty heritageGraph:name ;
                                               owl:minCardinality "1"^^xsd:nonNegativeInteger
