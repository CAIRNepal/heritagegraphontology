heritageGraph:traditional_role rdf:type owl:DatatypeProperty ;
                               rdfs:range xsd:string ;
                               rdfs:label "traditional_role" ;
                               skos:definition "Hereditary occupation or ritual duty" ;
                               skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/used_equipment
heritageGraph:used_equipment rdf:type owl:DatatypeProperty ;
                             rdfs:range xsd:string ;
                             rdfs:label "used_equipment" ;
                             skos:definition "Equipment used in documentation" ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


