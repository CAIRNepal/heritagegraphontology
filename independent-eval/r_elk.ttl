heritageGraph:syncretic_type rdf:type owl:ObjectProperty ;
                             rdfs:range heritageGraph:SyncreticTypeEnum ;
                             rdfs:label "syncretic_type" ;
                             skos:broadMatch crm:P2_has_type ;
                             skos:definition "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/took_place_at
heritageGraph:took_place_at rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf crm:P7_took_place_at ;
                            rdfs:range heritageGraph:Place ;
                            rdfs:label "took_place_at" ;
                            skos:definition "Place where event occurred" ;
                            skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/transferred_from_actor
heritageGraph:transferred_from_actor rdf:type owl:ObjectProperty ;
                                     rdfs:subPropertyOf crm:P28_custody_surrendered_by ;
                                     rdfs:range heritageGraph:Actor ;
                                     rdfs:label "transferred_from_actor" ;
                                     skos:definition "Previous custodian" ;
                                     skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/transferred_object
heritageGraph:transferred_object rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf crm:P30_transferred_custody_of ;
                                 rdfs:range heritageGraph:PhysicalHeritageThing ;
                                 rdfs:label "transferred_object" ;
                                 skos:definition "Object transferred in custody event" ;
                                 skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/transferred_to_actor
heritageGraph:transferred_to_actor rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf crm:P29_custody_received_by ;
                                   rdfs:range heritageGraph:Actor ;
                                   rdfs:label "transferred_to_actor" ;
                                   skos:definition "New custodian (person or group)" ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/transferred_to_guthi
heritageGraph:transferred_to_guthi rdf:type owl:ObjectProperty ;
                                   rdfs:range heritageGraph:Guthi ;
                                   rdfs:label "transferred_to_guthi" ;
                                   skos:broadMatch crm:P29_custody_received_by ;
                                   skos:definition "New custodian (Guthi)" ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/used_by
heritageGraph:used_by rdf:type owl:ObjectProperty ;
                      rdfs:range heritageGraph:Actor ;
                      rdfs:label "used_by" ;
                      skos:definition "Actor(s) who use, handle, or are responsible for this object in ritual contexts" ;
                      skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/used_materials
heritageGraph:used_materials rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf crm:P125_used_object_of_type ;
                             rdfs:range heritageGraph:Material ;
                             rdfs:label "used_materials" ;
                             skos:definition "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/used_technique
heritageGraph:used_technique rdf:type owl:ObjectProperty ;
                             rdfs:subPropertyOf crm:P32_used_general_technique ;
                             rdfs:range heritageGraph:Technique ;
                             rdfs:label "used_technique" ;
                             skos:definition "Craft technique used in production" ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/verified_assertion
heritageGraph:verified_assertion rdf:type owl:ObjectProperty ;
                                 rdfs:range heritageGraph:HeritageAssertion ;
                                 rdfs:label "verified_assertion" ;
                                 skos:definition "Assertions verified by this activity" ;
                                 skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/verified_by_expert
heritageGraph:verified_by_expert rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf heritageGraph:carried_out_by ;
                                 rdfs:range heritageGraph:Person ;
                                 rdfs:label "verified_by_expert" ;
                                 skos:definition "Expert who performed verification" ;
                                 skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/was_attributed_to_agent
heritageGraph:was_attributed_to_agent rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf prov:wasAttributedTo ;
                                      rdfs:range heritageGraph:Person ;
                                      rdfs:label "was_attributed_to_agent" ;
                                      skos:definition "Person who made this assertion" ;
                                      skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/was_derived_from_source
heritageGraph:was_derived_from_source rdf:type owl:ObjectProperty ;
                                      rdfs:subPropertyOf prov:wasDerivedFrom ;
                                      rdfs:range heritageGraph:DataSource ;
                                      rdfs:label "was_derived_from_source" ;
                                      skos:definition "Source(s) from which this assertion was derived" ;
                                      skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/was_documented_by
heritageGraph:was_documented_by rdf:type owl:ObjectProperty ;
                                rdfs:range heritageGraph:DocumentationActivity ;
                                rdfs:label "was_documented_by" ;
                                skos:broadMatch prov:wasGeneratedBy ;
                                skos:definition "Documentation event that recorded this entity or event" ;
                                skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/was_produced_by_event
heritageGraph:was_produced_by_event rdf:type owl:ObjectProperty ;
                                    rdfs:subPropertyOf crm:P108i_was_produced_by ;
                                    rdfs:domain heritageGraph:PhysicalHeritageThing ;
                                    rdfs:range heritageGraph:Production ;
                                    rdfs:label "was_produced_by_event" ;
                                    skos:definition "Event that created this object or structure" ;
                                    skos:inScheme <https://w3id.org/heritagegraph/ontology> .


