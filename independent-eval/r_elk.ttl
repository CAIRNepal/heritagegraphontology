heritageGraph:traditional_knowledge_notice rdf:type owl:DatatypeProperty ;
                                           rdfs:range xsd:string ;
                                           rdfs:label "traditional_knowledge_notice" ;
                                           skos:definition "Traditional-knowledge access, attribution, or care notice (e.g., community protocol labels)." ;
                                           skos:inScheme <https://w3id.org/heritagegraph/ontology> .


