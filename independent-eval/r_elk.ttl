###  https://w3id.org/heritagegraph/publication_timespan
heritageGraph:publication_timespan rdf:type owl:ObjectProperty ;
                                   rdfs:range heritageGraph:TimeSpan ;
                                   rdfs:label "publication_timespan" ;
                                   skos:broadMatch crm:P4_has_time-span ;
                                   skos:definition "When source was published" ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/religious_traditions
heritageGraph:religious_traditions rdf:type owl:ObjectProperty ;
                                   rdfs:label "religious_traditions" ;
                                   skos:definition "Collection of ReligiousTradition instances" ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/residence_structure
heritageGraph:residence_structure rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf crm:P74_has_current_or_former_residence ;
                                  rdfs:range heritageGraph:ArchitecturalStructure ;
                                  rdfs:label "residence_structure" ;
                                  skos:definition "Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house)." ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/ritual_events
heritageGraph:ritual_events rdf:type owl:ObjectProperty ;
                            rdfs:label "ritual_events" ;
                            skos:definition "Collection of RitualEvent instances" ;
                            skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/ritual_on_structure
heritageGraph:ritual_on_structure rdf:type owl:ObjectProperty ;
                                  rdfs:subPropertyOf crm:P8_took_place_on_or_within ;
                                  rdfs:range heritageGraph:PhysicalHeritageThing ;
                                  rdfs:label "ritual_on_structure" ;
                                  skos:definition "Ritual occurs at specific temple or monument" ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/ritual_type
heritageGraph:ritual_type rdf:type owl:ObjectProperty ;
                          rdfs:range heritageGraph:RitualTypeEnum ;
                          rdfs:label "ritual_type" ;
                          skos:broadMatch crm:P2_has_type ;
                          skos:definition "Classification of ritual (puja, jatra, consecration)" ;
                          skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/route_places
heritageGraph:route_places rdf:type owl:ObjectProperty ;
                           rdfs:range heritageGraph:Place ;
                           rdfs:label "route_places" ;
                           skos:broadMatch crm:P7_took_place_at ;
                           skos:definition "Ordered list of places visited during movement ritual" ;
                           skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/selected_person
heritageGraph:selected_person rdf:type owl:ObjectProperty ;
                              rdfs:range heritageGraph:Person ;
                              rdfs:label "selected_person" ;
                              skos:definition "Person selected through a ritual selection process to assume a sacred role or office" ;
                              skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/source_type
heritageGraph:source_type rdf:type owl:ObjectProperty ;
                          rdfs:range heritageGraph:SourceTypeEnum ;
                          rdfs:label "source_type" ;
                          skos:definition "Controlled source-type classification for provenance and epistemic filtering." ;
                          skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/start_place
heritageGraph:start_place rdf:type owl:ObjectProperty ;
                          rdfs:range heritageGraph:Place ;
                          rdfs:label "start_place" ;
                          skos:definition "Starting location of movement ritual" ;
                          skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/subject_entity
heritageGraph:subject_entity rdf:type owl:ObjectProperty ;
                             rdfs:range heritageGraph:PhysicalHeritageThing ;
                             rdfs:label "subject_entity" ;
                             skos:definition "Heritage entity documented by this activity (documentation subject, not E13 assignment target)." ;
                             skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/subject_event
heritageGraph:subject_event rdf:type owl:ObjectProperty ;
                            rdfs:range heritageGraph:RitualEvent ;
                            rdfs:label "subject_event" ;
                            skos:definition "Event documented by this activity (documentation subject, not E13 assignment target)." ;
                            skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/supersedes_assertion
heritageGraph:supersedes_assertion rdf:type owl:ObjectProperty ;
                                   rdfs:subPropertyOf prov:invalidated ;
                                   rdfs:range heritageGraph:HeritageAssertion ;
                                   rdfs:label "supersedes_assertion" ;
                                   skos:definition "Previous version of this assertion (if this is an update). Creates version chain: A1 → A2 → A3. Query pattern: latest assertion = one with no incoming prov:invalidated" ;
                                   skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/supported_by_institution
heritageGraph:supported_by_institution rdf:type owl:ObjectProperty ;
                                       rdfs:range heritageGraph:Guthi ;
                                       rdfs:label "supported_by_institution" ;
                                       skos:definition "Institution(s) providing economic support (stipend, land endowment) or ritual support (priest salaries) for a Living Goddess during tenure. Extends Guthi role beyond structure management to person support." ;
                                       skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/syncretic_relationships
heritageGraph:syncretic_relationships rdf:type owl:ObjectProperty ;
                                      rdfs:label "syncretic_relationships" ;
                                      skos:definition "Collection of SyncreticRelationship instances" ;
                                      skos:inScheme <https://w3id.org/heritagegraph/ontology> .


