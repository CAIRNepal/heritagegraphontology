heritageGraph:verification_method rdf:type owl:DatatypeProperty ;
                                  rdfs:range xsd:string ;
                                  rdfs:label "verification_method" ;
                                  skos:definition "Method used for verification (cross-check, expert review, field visit)" ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/year_offset_from_gregorian
