###  https://w3id.org/heritagegraph/EpistemicStanceEnum
heritageGraph:EpistemicStanceEnum rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Class ;
                                                        owl:oneOf ( heritageGraph:Community
                                                                    heritageGraph:Priestly
                                                                    heritageGraph:Scholarly
                                                                    heritageGraph:State
                                                                    heritageGraph:SyncreticTradition
                                                                    heritageGraph:Uncertain
                                                                  )
                                                      ] ;
                                  rdfs:subClassOf owl:Thing ;
                                  rdfs:label "EpistemicStanceEnum" ;
                                  skos:definition "Epistemic standing of a source or assertion" ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> ;
                                  linkml:permissible_values heritageGraph:Community ,
                                                            heritageGraph:Priestly ,
                                                            heritageGraph:Scholarly ,
                                                            heritageGraph:State ,
                                                            heritageGraph:SyncreticTradition ,
                                                            heritageGraph:Uncertain .


###  https://w3id.org/heritagegraph/ExistenceStatusEnum
heritageGraph:ExistenceStatusEnum rdf:type owl:Class ;
                                  owl:equivalentClass [ rdf:type owl:Class ;
                                                        owl:oneOf ( heritageGraph:Destroyed
                                                                    heritageGraph:Extant
                                                                    heritageGraph:Hypothetical
                                                                    heritageGraph:Lost
                                                                    heritageGraph:PartiallyExtant
                                                                    heritageGraph:Unknown
                                                                  )
                                                      ] ;
                                  rdfs:subClassOf owl:Thing ;
                                  rdfs:label "ExistenceStatusEnum" ;
                                  skos:definition "Controlled vocabulary for whether a heritage object or structure still exists." ;
                                  skos:inScheme <https://w3id.org/heritagegraph/ontology> ;
                                  linkml:permissible_values heritageGraph:Destroyed ,
                                                            heritageGraph:Extant ,
                                                            heritageGraph:Hypothetical ,
                                                            heritageGraph:Lost ,
                                                            heritageGraph:PartiallyExtant ,
                                                            heritageGraph:Unknown .


###  https://w3id.org/heritagegraph/Festival
heritageGraph:Festival rdf:type owl:Class ;
                       rdfs:subClassOf heritageGraph:RitualEvent ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty heritageGraph:includes_ritual_event ;
                                         owl:allValuesFrom heritageGraph:RitualEvent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty heritageGraph:includes_ritual_event ;
                                         owl:minCardinality "0"^^xsd:nonNegativeInteger
                                       ] ;
                       rdfs:label "Festival" ;
                       skos:definition "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
                       skos:inScheme <https://w3id.org/heritagegraph/ontology> .


###  https://w3id.org/heritagegraph/FieldSurveyActivity
heritageGraph:FieldSurveyActivity rdf:type owl:Class ;
