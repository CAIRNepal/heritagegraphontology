# Copy to .env and fill in. Do NOT commit .env.
#
# Public hostname for the endpoint. A DNS A/AAAA record for this name must point
# at the server before you start, so Caddy can issue a TLS certificate.
DOMAIN=data.example.org

# Admin password for Fuseki. The admin API is blocked at the proxy, but set a
# strong value anyway.
FUSEKI_ADMIN_PASSWORD=change-me-to-something-strong
