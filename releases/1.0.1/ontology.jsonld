  {
    "@id": "https://cair-nepal.org/heritagegraph/ontology",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/bibliographicCitation": [
      {
        "@value": "Karki, N., Oli, N., Sapkota, A., Yumusak, S., & Chhetri, T. R. (2026). HeritageGraph Ontology (Version 1.0.1). CAIR-Nepal. https://doi.org/10.5281/zenodo.23435676"
      }
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2025-11-23"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@value": "Anu Sapkota"
      },
      {
        "@value": "Nabin Oli"
      },
      {
        "@value": "Niraj Karki"
      },
      {
        "@value": "Semih Yumusak"
      },
      {
        "@value": "Tek Raj Chhetri"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning."
      }
    ],
    "http://purl.org/dc/terms/issued": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-10-17"
      }
    ],
