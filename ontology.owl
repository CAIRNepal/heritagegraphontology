                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/heritagegraph/has_architectural_style"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Temple</rdfs:label>
        <skos:closeMatch rdf:resource="http://schema.org/PlaceOfWorship"/>
        <skos:definition>Sacred architectural structure legally classified as an &apos;Ancient Monument&apos; under Nepal&apos;s preservation laws, characterized by deity enshrinement and ritual activation.</skos:definition>
        <skos:exactMatch rdf:resource="http://dbpedia.org/ontology/ReligiousBuilding"/>
        <skos:exactMatch rdf:resource="http://dbpedia.org/ontology/Temple"/>
        <skos:exactMatch rdf:resource="http://schema.org/HinduTemple"/>
        <skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300007595"/>
        <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q44539"/>
        <skos:exactMatch rdf:resource="https://w3id.org/heritagegraph/Temple"/>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:Class>
    


