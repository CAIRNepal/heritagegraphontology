        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/was_produced_by_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/was_produced_by_event">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Production"/>
        <rdfs:label>was_produced_by_event</rdfs:label>
        <skos:definition>Event that created this object or structure</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


