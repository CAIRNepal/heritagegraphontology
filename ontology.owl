<?xml version="1.0"?>
<rdf:RDF xmlns="file:/input/CulturalHeritageOntology.owl.ttl#"
     xml:base="file:/input/CulturalHeritageOntology.owl.ttl"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:pav="http://purl.org/pav/"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:linkml="https://w3id.org/linkml/">
    <owl:Ontology rdf:about="file:/input/CulturalHeritageOntology.owl.ttl">
        <terms:creator>Cair Nepal</terms:creator>
        <terms:license>CC-BY-4.0</terms:license>
        <terms:license>https://creativecommons.org/licenses/by/4.0/</terms:license>
        <terms:publisher>Cair Nepal</terms:publisher>
        <pav:version>0.1.0-alpha.2</pav:version>
        <rdfs:label>CulturalHeritageOntology</rdfs:label>
        <owl:imports>http://www.cidoc-crm.org/cidoc-crm/ http://www.w3.org/ns/prov#</owl:imports>
        <owl:ontologyIRI>https://w3id.org/heritagegraph/ontology</owl:ontologyIRI>
        <owl:versionIRI>https://w3id.org/heritagegraph/ontology/0.1.0-alpha.2</owl:versionIRI>
        <skos:definition>An event-centric LinkML schema for representing cultural heritage information that fully aligns with CIDOC-CRM and PROV-O, enabling provenance tracking and ritual-spatial-temporal reasoning.</skos:definition>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/creator -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/creator"/>
    


    <!-- http://purl.org/dc/terms/license -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/license"/>
    


    <!-- http://purl.org/dc/terms/publisher -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/publisher"/>
    


    <!-- http://purl.org/pav/version -->


    <owl:AnnotationProperty rdf:about="http://purl.org/pav/version"/>
    


    <!-- http://www.w3.org/2002/07/owl#imports -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#imports"/>
    


    <!-- http://www.w3.org/2002/07/owl#ontologyIRI -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#ontologyIRI"/>
    


    <!-- http://www.w3.org/2002/07/owl#versionIRI -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2002/07/owl#versionIRI"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#broadMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#broadMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#exactMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#exactMatch"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme"/>
    


    <!-- https://w3id.org/linkml/permissible_values -->


    <owl:AnnotationProperty rdf:about="https://w3id.org/linkml/permissible_values"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.opengis.net/ont/geosparql#wktLiteral -->


    <rdfs:Datatype rdf:about="http://www.opengis.net/ont/geosparql#wktLiteral">
        <owl:equivalentClass rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/heritagegraph/architectural_elements -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/architectural_elements">
        <rdfs:label>architectural_elements</rdfs:label>
        <skos:definition>Collection of ArchitecturalElement instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/architectural_structures -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/architectural_structures">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
        <rdfs:label>architectural_structures</rdfs:label>
        <skos:definition>Heritage structures affected by or present during this historical event</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/assertion_author -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/assertion_author">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>assertion_author</rdfs:label>
        <skos:definition>The agent (scholar, priest, or tradition-bearer) making or recording the syncretic claim.</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/asserts_about_entity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/asserts_about_entity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/AssertableEntity"/>
        <rdfs:label>asserts_about_entity</rdfs:label>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/asserts_about_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/asserts_about_event">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label>asserts_about_event</rdfs:label>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/assessed_condition_state -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/assessed_condition_state">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ConditionState"/>
        <rdfs:label>assessed_condition_state</rdfs:label>
        <skos:definition>Condition state identified by the assessment</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/assessed_object -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/assessed_object">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label>assessed_object</rdfs:label>
        <skos:definition>Object assessed for condition</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/assigned_equivalent -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/assigned_equivalent">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label>assigned_equivalent</rdfs:label>
        <skos:definition>The deity or sacred figure being identified as equivalent to the primary deity.</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/assigned_to_deity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/assigned_to_deity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label>assigned_to_deity</rdfs:label>
        <skos:definition>The deity instance that is the subject of the syncretic claim.</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/birth_timespan -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/birth_timespan">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/TimeSpan"/>
        <rdfs:label>birth_timespan</rdfs:label>
        <skos:definition>Person&apos;s birth timespan</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/calendar_system -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/calendar_system">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/CalendarSystem"/>
        <rdfs:label>calendar_system</rdfs:label>
        <skos:definition>Calendar system used for date representation</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/calendar_systems -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/calendar_systems">
        <rdfs:label>calendar_systems</rdfs:label>
        <skos:definition>Collection of CalendarSystem instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/carried_out_activity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/carried_out_activity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label>carried_out_activity</rdfs:label>
        <skos:definition>Activities performed by this actor</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/carried_out_by -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/carried_out_by">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>carried_out_by</rdfs:label>
        <skos:definition>Actor(s) who performed this event</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/caste_groups -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/caste_groups">
        <rdfs:label>caste_groups</rdfs:label>
        <skos:definition>Collection of CasteGroup instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/commissioned_by -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/commissioned_by">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>commissioned_by</rdfs:label>
        <skos:definition>Person or group who commissioned production</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/consecrated_by_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/consecrated_by_event">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Consecration"/>
        <rdfs:label>consecrated_by_event</rdfs:label>
        <skos:definition>Consecration event that activated this murti</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/consecrated_object -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/consecrated_object">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Murti"/>
        <rdfs:label>consecrated_object</rdfs:label>
        <skos:definition>Murti that participated in the consecration ritual</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/consecration_events -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/consecration_events">
        <rdfs:label>consecration_events</rdfs:label>
        <skos:definition>Collection of Consecration event instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/contains_structure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/contains_structure">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ArchitecturalStructure"/>
        <rdfs:label>contains_structure</rdfs:label>
        <skos:definition>Structures located in this place</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/created_by_documentation -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/created_by_documentation">
        <owl:inverseOf rdf:resource="https://w3id.org/heritagegraph/produced_information_object"/>
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DocumentationActivity"/>
        <rdfs:label>created_by_documentation</rdfs:label>
        <skos:definition>Documentation activity that produced this information object</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/custody_events -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/custody_events">
        <rdfs:label>custody_events</rdfs:label>
        <skos:definition>Collection of TransferOfCustody event instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/data_custodians -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/data_custodians">
        <rdfs:label>data_custodians</rdfs:label>
        <skos:definition>Collection of DataCustodian instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/data_sources -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/data_sources">
        <rdfs:label>data_sources</rdfs:label>
        <skos:definition>Collection of DataSource instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/datacite_creator -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/datacite_creator">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>datacite_creator</rdfs:label>
        <skos:definition>Person or organization primarily responsible for creating the source</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/datacite_publisher -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/datacite_publisher">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Actor"/>
        <rdfs:label>datacite_publisher</rdfs:label>
        <skos:definition>Entity responsible for making the source available</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/date_precision -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/date_precision">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DatePrecisionEnum"/>
        <rdfs:label>date_precision</rdfs:label>
        <skos:definition>The level of precision for a recorded date.</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/death_timespan -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/death_timespan">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/TimeSpan"/>
        <rdfs:label>death_timespan</rdfs:label>
        <skos:definition>Person&apos;s death timespan</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/deities -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/deities">
        <rdfs:label>deities</rdfs:label>
        <skos:definition>Collection of Deity instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/depicts_deity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/depicts_deity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label>depicts_deity</rdfs:label>
        <skos:definition>Deity depicted iconographically (not cultic presence)</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/destruction_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/destruction_event">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DestructionEvent"/>
        <rdfs:label>destruction_event</rdfs:label>
        <skos:definition>Event that destroyed this structure (if known)</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/documentation_activities -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/documentation_activities">
        <rdfs:label>documentation_activities</rdfs:label>
        <skos:definition>Collection of DocumentationActivity instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/documented_in_source -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/documented_in_source">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/DataSource"/>
        <rdfs:label>documented_in_source</rdfs:label>
        <skos:definition>Sources that mention or document this entity</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/embodied_deity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/embodied_deity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label>embodied_deity</rdfs:label>
        <skos:definition>Deity role embodied by participant</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/end_place -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/end_place">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Place"/>
        <rdfs:label>end_place</rdfs:label>
        <skos:definition>Ending location of movement ritual</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ended_tenure_of -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ended_tenure_of">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/LivingGoddessTenure"/>
        <rdfs:label>ended_tenure_of</rdfs:label>
        <skos:definition>Points from a LivingGoddessRetirement event to the tenure that it terminated. Enables reconstruction of complete Living Goddess lifecycle.</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/enshrined_deity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/enshrined_deity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Deity"/>
        <rdfs:label>enshrined_deity</rdfs:label>
        <skos:definition>Deity installed through enshrinement</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/enshrined_in_structure -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/enshrined_in_structure">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Temple"/>
        <rdfs:label>enshrined_in_structure</rdfs:label>
        <skos:definition>Temple where deity was enshrined</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/enshrinement_events -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/enshrinement_events">
        <rdfs:label>enshrinement_events</rdfs:label>
        <skos:definition>Collection of Enshrinement event instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/enshrines_deity_through_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/enshrines_deity_through_event">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Enshrinement"/>
        <rdfs:label>enshrines_deity_through_event</rdfs:label>
        <skos:definition>Enshrinement event that installed deity in temple</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/existence_status -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/existence_status">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/ExistenceStatusEnum"/>
        <rdfs:label>existence_status</rdfs:label>
        <skos:definition>Current physical status of the structure</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/festivals -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/festivals">
        <rdfs:label>festivals</rdfs:label>
        <skos:definition>Collection of Festival instances</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/generated_assertion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/generated_assertion">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/HeritageAssertion"/>
        <rdfs:label>generated_assertion</rdfs:label>
