    <!-- https://w3id.org/heritagegraph/ExistenceStatusEnum -->


    <owl:Class rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum#Destroyed"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum#Extant"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum#Hypothetical"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum#Lost"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum#PartiallyExtant"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ExistenceStatusEnum#Unknown"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>ExistenceStatusEnum</rdfs:label>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatusEnum#Destroyed"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatusEnum#Extant"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatusEnum#Hypothetical"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatusEnum#Lost"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatusEnum#PartiallyExtant"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ExistenceStatusEnum#Unknown"/>
    </owl:Class>
    


