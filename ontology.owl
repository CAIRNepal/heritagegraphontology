                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/DatePrecisionEnum#Century"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/DatePrecisionEnum#Circa"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/DatePrecisionEnum#Decade"/>
