    <!-- http://vocab.getty.edu/aat/300001285 -->


    <owl:Class rdf:about="http://vocab.getty.edu/aat/300001285">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Dome</rdfs:label>
        <skos:definition>Dome-based style (Mughal/Neo-classical influence)</skos:definition>
    </owl:Class>
    


    <!-- http://vocab.getty.edu/aat/300004829 -->


    <owl:Class rdf:about="http://vocab.getty.edu/aat/300004829">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Pagoda</rdfs:label>
        <skos:definition>Multi-tiered roof style indigenous to Nepal</skos:definition>
    </owl:Class>
    


    <!-- http://vocab.getty.edu/aat/300007562 -->


    <owl:Class rdf:about="http://vocab.getty.edu/aat/300007562">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Chaitya</rdfs:label>
        <skos:definition>Buddhist votive shrine style</skos:definition>
    </owl:Class>
    


    <!-- http://vocab.getty.edu/aat/300007576 -->


    <owl:Class rdf:about="http://vocab.getty.edu/aat/300007576">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Stupa</rdfs:label>
        <skos:definition>Buddhist dome-shaped reliquary</skos:definition>
    </owl:Class>
    


    <!-- http://vocab.getty.edu/aat/300446671 -->


    <owl:Class rdf:about="http://vocab.getty.edu/aat/300446671">
        <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E55_Type"/>
        <rdfs:label>Shikhara</rdfs:label>
        <skos:definition>North Indian spire-shaped style</skos:definition>
    </owl:Class>
    


    <!-- http://www.cidoc-crm.org/cidoc-crm/E55_Type -->


    <owl:Class rdf:about="http://www.cidoc-crm.org/cidoc-crm/E55_Type">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300001285"/>
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300004829"/>
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300007562"/>
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300007576"/>
                    <rdf:Description rdf:about="http://vocab.getty.edu/aat/300446671"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>ArchitecturalStyleEnum</rdfs:label>
        <skos:definition>A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type.</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300001285"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300004829"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300007562"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300007576"/>
        <linkml:permissible_values rdf:resource="http://vocab.getty.edu/aat/300446671"/>
    </owl:Class>
    


    <!-- https://w3id.org/heritagegraph/Abhisheka -->


