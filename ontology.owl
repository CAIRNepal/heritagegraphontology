        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>asserted_property</rdfs:label>
        <skos:definition>Property or attribute name (e.g., &apos;existence_status&apos;, &apos;hypothesized_location&apos;, &apos;construction_date&apos;)</skos:definition>
