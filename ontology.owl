        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label>ritual_on_structure</rdfs:label>
        <skos:definition>Ritual occurs at specific temple or monument</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/ritual_type -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/ritual_type">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualTypeEnum"/>
        <rdfs:label>ritual_type</rdfs:label>
        <skos:definition>Classification of ritual (puja, jatra, consecration)</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/route_places -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/route_places">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Place"/>
        <rdfs:label>route_places</rdfs:label>
        <skos:definition>Ordered list of places visited during movement ritual</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/selected_person -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/selected_person">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Person"/>
        <rdfs:label>selected_person</rdfs:label>
        <skos:definition>Person selected through a ritual selection process to assume a sacred role or office</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/start_place -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/start_place">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Place"/>
        <rdfs:label>start_place</rdfs:label>
        <skos:definition>Starting location of movement ritual</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/subject_entity -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/subject_entity">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/PhysicalHeritageThing"/>
        <rdfs:label>subject_entity</rdfs:label>
        <skos:definition>Heritage entity that is the subject of documentation</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/subject_event -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/subject_event">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
        <rdfs:label>subject_event</rdfs:label>
        <skos:definition>Event that is the subject of documentation</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/supersedes_assertion -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/supersedes_assertion">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/HeritageAssertion"/>
        <rdfs:label>supersedes_assertion</rdfs:label>
        <skos:definition> Previous version of this assertion (if this is an update). Creates version chain: A1 → A2 → A3 Query pattern: latest assertion = one with no incoming prov:invalidated</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/heritagegraph/supported_by_institution -->


    <owl:ObjectProperty rdf:about="https://w3id.org/heritagegraph/supported_by_institution">
        <rdfs:range rdf:resource="https://w3id.org/heritagegraph/Guthi"/>
        <rdfs:label>supported_by_institution</rdfs:label>
        <skos:definition>Institution(s) providing economic support (stipend, land endowment) or ritual support (priest salaries) for a Living Goddess during tenure. Extends Guthi role beyond structure management to person support.</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
    </owl:ObjectProperty>
    


