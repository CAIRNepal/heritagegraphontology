        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/GuthiTypeEnum#SanGuthi"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/GuthiTypeEnum#SanaGuthi"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/GuthiTypeEnum#SiGuthi"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/GuthiTypeEnum#TempleGuthi"/>
