                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ConditionTypeEnum#Good"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ConditionTypeEnum#Restored"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/ConditionTypeEnum#Ruined"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>ConditionTypeEnum</rdfs:label>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ConditionTypeEnum#Damaged"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ConditionTypeEnum#Good"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ConditionTypeEnum#Restored"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/ConditionTypeEnum#Ruined"/>
    </owl:Class>
    


