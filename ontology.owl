                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/GuthiTypeEnum#SiGuthi"/>
                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/GuthiTypeEnum#TempleGuthi"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>GuthiTypeEnum</rdfs:label>
        <skos:definition>Controlled vocabulary of Guthi functional types (CRM E55_Type)</skos:definition>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
