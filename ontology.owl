                    <rdf:Description rdf:about="https://w3id.org/heritagegraph/DatePrecisionEnum#Year"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label>DatePrecisionEnum</rdfs:label>
        <skos:inScheme rdf:resource="file:/input/CulturalHeritageOntology"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/DatePrecisionEnum#Century"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/DatePrecisionEnum#Circa"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/DatePrecisionEnum#Decade"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/DatePrecisionEnum#Exact"/>
        <linkml:permissible_values rdf:resource="https://w3id.org/heritagegraph/DatePrecisionEnum#Year"/>
    </owl:Class>
    


