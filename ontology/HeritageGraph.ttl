heritageGraph:Chaitya a owl:Class ;
    rdfs:label "Chaitya" ;
    rdfs:subClassOf heritageGraph:ReligiousStructure ;
    skos:definition "Buddhist votive shrine (chaitya); votive stupa form found across the Kathmandu Valley." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DataCustodian a owl:Class ;
    rdfs:label "DataCustodian" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:custodianType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:custodianType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:custodianType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        crm:E39_Actor ;
    skos:broadMatch prov:Agent ;
    skos:definition "Institution or person currently responsible for stewarding heritage data." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:InformationObject a owl:Class ;
    rdfs:label "InformationObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom prov:Activity ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P129_is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty schema1:inLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty crm:P129_is_about ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema1:inLanguage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty schema1:inLanguage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasGeneratedBy ],
        heritageGraph:DataSource ;
    skos:broadMatch crm:E73_Information_Object ;
    skos:definition "A recorded piece of information about heritage" ;
    skos:inScheme heritageGraph:schema .

