            owl:onProperty heritageGraph:startPlace ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:managedByGuthi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performedByGroup ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P9i_forms_part_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P120i_occurs_after ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P120i_occurs_after ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:startPlace ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:invokesDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty crm:P8_took_place_on_or_within ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty heritageGraph:routePlaces ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:routeDescription ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:lunarDateTithi ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P8_took_place_on_or_within ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P120_occurs_before ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:endPlace ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:recurrencePattern ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty heritageGraph:endPlace ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P9i_forms_part_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P8_took_place_on_or_within ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualType ;
            owl:onProperty heritageGraph:ritualType ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E57_Material ;
            owl:onProperty crm:P125_used_object_of_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:managedByGuthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Festival ;
            owl:onProperty crm:P9i_forms_part_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] crm:E39_Actor ) ] ;
            owl:onProperty heritageGraph:performedByGroup ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:endPlace ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:routePlaces ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P120i_occurs_after ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:routeDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:lunarDateTithi ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P125_used_object_of_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:routeDescription ],
        prov:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Intentional ritual activity that activates sacred space, invokes deities, and binds social groups" ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

crm:E52_Time-Span a owl:Class ;
    rdfs:label "TimeSpan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DatePrecision ;
            owl:onProperty heritageGraph:datePrecision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P82b_end_of_the_end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P82a_begin_of_the_begin ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P82a_begin_of_the_begin ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:calendarSystem ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:CalendarSystem ;
            owl:onProperty heritageGraph:calendarSystem ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:datePrecision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P82b_end_of_the_end ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:datePrecision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:calendarSystem ],
        prov:Entity ;
    skos:definition "Temporal extent of an event or period" ;
    skos:exactMatch heritageGraph:TimeSpan ;
    skos:inScheme heritageGraph:schema .

crm:E53_Place a owl:Class ;
    rdfs:label "Place" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:placeType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty geo:asWKT ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty geo:asWKT ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P53i_is_former_or_current_location_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty crm:P53i_is_former_or_current_location_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:placeType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:placeType ],
        prov:Entity ;
    skos:definition "Defined geographic location where events occur and structures exist" ;
    skos:exactMatch heritageGraph:Place ;
    skos:inScheme heritageGraph:schema .

crm:P7_took_place_at a owl:ObjectProperty ;
    rdfs:label "took_place_at" ;
    rdfs:range crm:E53_Place ;
    skos:definition "Place where the event occurred" ;
    skos:inScheme heritageGraph:schema .

prov:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasInfluencedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:generated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasInformedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:endedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Entity ;
            owl:onProperty prov:generated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Entity ;
            owl:onProperty prov:used ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Agent ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:startedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( prov:Entity prov:Activity prov:Agent ) ] ;
            owl:onProperty prov:wasInfluencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Activity ;
            owl:onProperty prov:wasInformedBy ] ;
    skos:definition "Direct LinkML representation of prov:Activity. Applied to events and processes that use, transform, generate, document, assess, or verify entities." ;
    skos:exactMatch heritageGraph:Activity ;
    skos:inScheme heritageGraph:schema .

crm:E39_Actor a owl:Class ;
    rdfs:label "Actor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        prov:Agent ;
    skos:definition "General actor (person or group) responsible for events" ;
    skos:exactMatch heritageGraph:Actor ;
    skos:inScheme heritageGraph:schema .

prov:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasInfluencedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasDerivedFrom ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Agent ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Activity ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Entity ;
            owl:onProperty prov:wasDerivedFrom ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( prov:Entity prov:Activity prov:Agent ) ] ;
            owl:onProperty prov:wasInfluencedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:generatedAtTime ] ;
    skos:definition "Direct LinkML representation of prov:Entity. Applied to physical, digital, conceptual, and assertion-bearing things that participate in provenance relations. PROVENANCE SCOPE (alpha.5 design decision): for classes whose instances are real-world referents (structures, deities, places, actors), the provenance slots (was_derived_from, was_attributed_to, was_generated_by, generated_at_time) describe the DATA RECORD about the referent, not the referent itself -- a stupa is not generated by the survey that records it. Referent-level history is modelled through events (Production, DestructionEvent, etc.). RDF deployments SHOULD carry record-level provenance in named graphs or on InformationObject/Assertion nodes." ;
    skos:exactMatch heritageGraph:Entity ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:provenance_scope "record" .

crm:P4_has_time-span a owl:ObjectProperty ;
    rdfs:label "has_timespan" ;
    rdfs:range crm:E52_Time-Span ;
    skos:definition "Links event to its temporal extent" ;
    skos:inScheme heritageGraph:schema .

skos:Concept a owl:Class .

crm:P3_has_note a owl:DatatypeProperty ;
    rdfs:label "note" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text note (description, reason, verification notes)" ;
    skos:inScheme heritageGraph:schema .

