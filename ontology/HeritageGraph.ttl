prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:label "ended_at_time" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Time at which this activity ended." ;
    skos:inScheme heritageGraph:schema .

prov:startedAtTime a owl:DatatypeProperty ;
    rdfs:label "started_at_time" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Time at which this activity started." ;
    skos:inScheme heritageGraph:schema .

prov:value a owl:DatatypeProperty ;
    rdfs:label "assertion_content" ;
    rdfs:range xsd:string ;
    skos:definition "The factual claim being asserted" ;
    skos:inScheme heritageGraph:schema .

prov:wasRevisionOf a owl:ObjectProperty ;
    rdfs:label "supersedes_assertion" ;
    rdfs:range crminf:I2_Belief ;
    skos:definition "Previous assertion that this one revises (version chain A1->A2->A3). Uses prov:wasRevisionOf (a derivation between entities); the latest assertion is the one with no incoming wasRevisionOf. NOTE: prov:invalidated was incorrect here (it is an Activity->Entity relation, not Entity->Entity)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:HistoricalEvent a owl:Class ;
    rdfs:label "HistoricalEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:architecturalStructures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P9_consists_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P9_consists_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:architecturalStructures ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        prov:Activity ;
    skos:broadMatch crm:E5_Event ;
    skos:definition "Major event affecting heritage structures or ritual life (earthquake, epidemic, political transition, fire, flood)." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:Proposition a owl:Class ;
    rdfs:label "Proposition" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:propositionObjectEntity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:propositionPredicate ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:propositionSubject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:propositionSubject ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:propositionPredicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:propositionObjectEntity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:propositionSubject ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:propositionObjectEntity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:propositionLiteralValue ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:propositionLiteralValue ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:propositionLiteralValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty heritageGraph:propositionPredicate ],
        prov:Entity ;
    skos:broadMatch crminf:I4_Proposition_Set ;
    skos:closeMatch rdf:Statement ;
    skos:definition "A single machine-readable proposition (subject - predicate - object) held true by an Assertion. Modelled as a singleton proposition set (CRMinf I4); the predicate is a URI/CURIE, the object either a heritage entity or a literal." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RestHouse a owl:Class ;
    rdfs:label "RestHouse" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Community structures for travelers and pilgrims, maintained by Guthi organizations" ;
    skos:inScheme heritageGraph:schema .

