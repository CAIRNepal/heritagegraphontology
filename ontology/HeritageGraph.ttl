    skos:inScheme heritageGraph:schema .

heritageGraph:enshrinesDeityThroughEvent a owl:ObjectProperty ;
    rdfs:label "enshrines_deity_through_event" ;
    rdfs:range heritageGraph:Enshrinement ;
    owl:inverseOf heritageGraph:enshrinedInStructure ;
    skos:definition "Enshrinement event that installed deity in temple" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enthronedPerson a owl:ObjectProperty ;
    rdfs:label "enthroned_person" ;
    rdfs:range crm:E21_Person ;
    skos:definition "Girl enthroned as Kumari by this enthronement event." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enthronedThrough a owl:ObjectProperty ;
    rdfs:label "enthroned_through" ;
    rdfs:range heritageGraph:KumariEnthronementEvent ;
    skos:definition "Enthronement event that activated this tenure." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:epochDateGregorian a owl:DatatypeProperty ;
    rdfs:label "epoch_date_gregorian" ;
    rdfs:range xsd:string ;
    skos:definition "The start date of this calendar era in Gregorian ISO format." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:existenceStatus a owl:ObjectProperty ;
    rdfs:label "existence_status" ;
    rdfs:range heritageGraph:ExistenceStatus ;
    skos:definition "Current physical status of the structure" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:generated_date a owl:DatatypeProperty ;
    rdfs:label "generated_date" ;
    skos:definition "Date the dataset serialization was generated (ISO 8601)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:guthiType a owl:ObjectProperty ;
    rdfs:label "guthi_type" ;
    rdfs:range heritageGraph:GuthiType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Type of Guthi (Si, Jatra, Temple)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasConditionType a owl:ObjectProperty ;
    rdfs:label "has_condition_type" ;
    rdfs:range heritageGraph:ConditionType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Categorization of the condition state" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:identifierScheme a owl:DatatypeProperty ;
    rdfs:label "datacite_identifier_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:institutionalAffiliation a owl:DatatypeProperty ;
    rdfs:label "institutional_affiliation" ;
    rdfs:range xsd:string ;
    skos:definition "Institutional affiliation (e.g., Tribhuvan University, Nepal Heritage Society)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isAboutDeity a owl:ObjectProperty ;
    rdfs:label "is_about_deity" ;
    rdfs:range heritageGraph:Deity ;
    rdfs:subPropertyOf crm:P62_depicts ;
    skos:definition "Deity represented and ritually associated with the Murti" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isCriticalForFestival a owl:DatatypeProperty ;
    rdfs:label "is_critical_for_festival" ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this ritual is essential for the festival's completion" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:isEnshrinedThroughEvent a owl:ObjectProperty ;
    rdfs:label "is_enshrined_through_event" ;
    rdfs:range heritageGraph:Enshrinement ;
    owl:inverseOf heritageGraph:enshrinedDeity ;
    skos:definition "Events where this deity was enshrined" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:license a owl:DatatypeProperty ;
    rdfs:label "license" ;
    skos:definition "License under which the dataset is released." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:lunarDateTithi a owl:DatatypeProperty ;
    rdfs:label "lunar_date_tithi" ;
    rdfs:range xsd:string ;
    skos:definition "Lunar day (Tithi) for ritual timing" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:makesDeityPresent a owl:ObjectProperty ;
    rdfs:label "makes_deity_present" ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Deity made present through consecration" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:metadata a owl:ObjectProperty ;
    rdfs:label "metadata" ;
    skos:definition "Dataset metadata" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:partOfSelection a owl:ObjectProperty ;
    rdfs:label "part_of_selection" ;
    rdfs:range heritageGraph:KumariSelectionEvent ;
    skos:definition "Selection event this assessment is part of." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:persistentIdentifier a owl:DatatypeProperty ;
    rdfs:label "datacite_identifier" ;
    rdfs:range xsd:string ;
    skos:definition "Persistent identifier for the source (DOI, archive ID, catalog number)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:placeType a owl:DatatypeProperty ;
    rdfs:label "place_type" ;
    rdfs:range xsd:string ;
    skos:definition "Type of place (city, village, region), free text" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionLiteralValue a owl:DatatypeProperty ;
    rdfs:label "proposition_object_literal" ;
    rdfs:range xsd:string ;
    skos:definition "Object of the proposition when it is a literal value (e.g. a date)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionObjectEntity a owl:ObjectProperty ;
    rdfs:label "proposition_object_entity" ;
    rdfs:range heritageGraph:AssertionSubject ;
    skos:definition "Object of the proposition when it is a heritage entity (plays the role of rdf:object)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionPredicate a owl:DatatypeProperty ;
    rdfs:label "proposition_predicate" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Property (URI/CURIE) claimed of the subject, e.g. crm:P108i_was_produced_by (plays the role of rdf:predicate)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:propositionSubject a owl:ObjectProperty ;
    rdfs:label "proposition_subject" ;
    rdfs:range heritageGraph:AssertionSubject ;
    skos:definition "Entity the proposition is about (plays the role of rdf:subject)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:publicationTimespan a owl:ObjectProperty ;
    rdfs:label "publication_timespan" ;
    rdfs:range crm:E52_Time-Span ;
    rdfs:subPropertyOf crm:P4_has_time-span ;
    skos:definition "When source was published" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:reconciliationStatus a owl:DatatypeProperty ;
    rdfs:label "reconciliation_status" ;
    rdfs:range xsd:string ;
    skos:definition "Status of multi-source reconciliation (confirmed, conflicting, unverified)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:recurrencePattern a owl:DatatypeProperty ;
    rdfs:label "recurrence_pattern" ;
    rdfs:range xsd:string ;
    skos:definition "Frequency of recurring ritual (e.g., annual, monthly)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:residenceStructure a owl:ObjectProperty ;
    rdfs:label "residence_structure" ;
    rdfs:range heritageGraph:ArchitecturalStructure ;
    skos:definition "Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:resourceType a owl:DatatypeProperty ;
    rdfs:label "datacite_resource_type" ;
    rdfs:range xsd:string ;
    skos:definition "High-level DataCite resource type (Dataset, Text, Image, Audio, Interview)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ritualType a owl:ObjectProperty ;
    rdfs:label "ritual_type" ;
    rdfs:range heritageGraph:RitualType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Classification of ritual (puja, jatra, consecration)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:roleDeity a owl:ObjectProperty ;
    rdfs:label "role_deity" ;
    rdfs:range heritageGraph:Deity ;
    skos:definition "Deity embodied by whoever holds this role (e.g., Taleju)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:routeDescription a owl:DatatypeProperty ;
    rdfs:label "route_description" ;
    rdfs:range xsd:string ;
    skos:definition "Text description of the procession route" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:schema_version a owl:DatatypeProperty ;
    rdfs:label "schema_version" ;
    skos:definition "HeritageGraph schema version the dataset conforms to." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:selectedPerson a owl:ObjectProperty ;
    rdfs:label "selected_person" ;
    rdfs:range crm:E21_Person ;
    skos:definition "Person selected through a ritual selection process to assume a sacred role or office" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:sourceCitation a owl:DatatypeProperty ;
    rdfs:label "source_citation" ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf crm:P3_has_note ;
    skos:definition "Formal citation of source" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:sourcePublisher a owl:ObjectProperty ;
    rdfs:label "datacite_publisher" ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Entity responsible for making the source available" ;
    skos:exactMatch dcterms:publisher ;
    skos:inScheme heritageGraph:schema .

heritageGraph:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "source_url" ;
    rdfs:range xsd:string ;
    skos:definition "URL or digital identifier for source" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:startPlace a owl:ObjectProperty ;
    rdfs:label "start_place" ;
    rdfs:range crm:E53_Place ;
    skos:definition "Starting location of movement ritual" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:syncreticType a owl:ObjectProperty ;
    rdfs:label "syncretic_type" ;
    rdfs:range heritageGraph:SyncreticType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:traditionalRole a owl:DatatypeProperty ;
    rdfs:label "traditional_role" ;
    rdfs:range xsd:string ;
    skos:definition "Hereditary occupation or ritual duty" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:transferredToGuthi a owl:ObjectProperty ;
    rdfs:label "transferred_to_guthi" ;
    rdfs:range heritageGraph:Guthi ;
    rdfs:subPropertyOf crm:P29_custody_received_by ;
    skos:definition "New custodian (Guthi)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:usedMethod a owl:DatatypeProperty ;
    rdfs:label "used_method" ;
    rdfs:range xsd:string ;
    skos:definition "Documentation method used" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:verificationMethod a owl:DatatypeProperty ;
    rdfs:label "verification_method" ;
    rdfs:range xsd:string ;
    skos:definition "Method used for verification (cross-check, expert review, field visit)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:yearOffsetFromGregorian a owl:DatatypeProperty ;
    rdfs:label "year_offset_from_gregorian" ;
    rdfs:range xsd:integer ;
    skos:definition "Mathematical offset to convert to Common Era (e.g., +57 for BS)." ;
    skos:inScheme heritageGraph:schema .

crm:E10_Transfer_of_Custody a owl:Class ;
    rdfs:label "TransferOfCustody" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:transferredToGuthi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P29_custody_received_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:transferredToGuthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P30_transferred_custody_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P30_transferred_custody_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P28_custody_surrendered_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P28_custody_surrendered_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P28_custody_surrendered_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P29_custody_received_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty crm:P30_transferred_custody_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P29_custody_received_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:transferredToGuthi ],
        prov:Activity ;
    skos:definition "Event of transferring responsibility for temple maintenance, ritual performance, or artifact stewardship" ;
    skos:exactMatch heritageGraph:TransferOfCustody ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

crm:E29_Design_or_Procedure a owl:Class ;
    rdfs:label "Technique" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        prov:Entity ;
    skos:definition "Method or craft process used in production or ritual" ;
    skos:exactMatch heritageGraph:Technique ;
    skos:inScheme heritageGraph:schema .

crm:E3_Condition_State a owl:Class ;
    rdfs:label "ConditionState" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:hasConditionType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasConditionType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ConditionType ;
            owl:onProperty heritageGraph:hasConditionType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        prov:Entity ;
    skos:definition "A physical condition state of a heritage object" ;
    skos:exactMatch heritageGraph:ConditionState ;
    skos:inScheme heritageGraph:schema .

crm:E57_Material a owl:Class ;
    rdfs:label "Material" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        prov:Entity ;
    skos:definition "Physical substance used in construction or crafting" ;
    skos:exactMatch heritageGraph:Material ;
    skos:inScheme heritageGraph:schema .

crm:P16_used_specific_object a owl:ObjectProperty ;
    rdfs:label "consecrated_object" ;
    rdfs:range heritageGraph:Murti ;
    owl:inverseOf heritageGraph:consecratedByEvent ;
    skos:definition "Murti employed in (and transformed by) the consecration ritual" ;
    skos:inScheme heritageGraph:schema .

crm:P29_custody_received_by a owl:ObjectProperty ;
    rdfs:label "transferred_to_actor" ;
    rdfs:range crm:E39_Actor ;
    skos:definition "New custodian (person or group)" ;
    skos:inScheme heritageGraph:schema .

crm:P34i_was_assessed_by a owl:ObjectProperty ;
    rdfs:label "has_condition_assessment" ;
    rdfs:range crm:E14_Condition_Assessment ;
    skos:definition "Condition assessment events for this structure" ;
    skos:inScheme heritageGraph:schema .

crm:P8_took_place_on_or_within a owl:ObjectProperty ;
    rdfs:label "ritual_on_structure" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Ritual occurs at specific temple or monument" ;
    skos:inScheme heritageGraph:schema .

crm:P9_consists_of a owl:ObjectProperty ;
    rdfs:label "includes_ritual_event" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Component rituals of festival" ;
    skos:inScheme heritageGraph:schema .

prov:used a owl:ObjectProperty ;
    rdfs:label "used" ;
    rdfs:range prov:Entity ;
    skos:definition "Entity used by this activity." ;
    skos:inScheme heritageGraph:schema .

prov:wasAssociatedWith a owl:ObjectProperty ;
    rdfs:label "was_associated_with" ;
    rdfs:range prov:Agent ;
    skos:definition "Agent associated with responsibility for this activity." ;
    skos:inScheme heritageGraph:schema .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:label "was_attributed_to" ;
    rdfs:range prov:Agent ;
    skos:definition "Agent to whom responsibility for this entity is attributed." ;
    skos:inScheme heritageGraph:schema .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:label "was_derived_from" ;
    rdfs:range prov:Entity ;
    skos:definition "Entity from which this entity was derived." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:CalendarSystem a owl:Class ;
    rdfs:label "CalendarSystem" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty heritageGraph:yearOffsetFromGregorian ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:yearOffsetFromGregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:yearOffsetFromGregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:isPrimaryForTradition ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isPrimaryForTradition ],
        prov:Entity ;
    skos:broadMatch time:TRS ;
    skos:definition "Calendar reckoning system with conversion rules for multi-calendar temporal reasoning" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Consecration a owl:Class ;
    rdfs:label "Consecration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Murti ;
            owl:onProperty crm:P16_used_specific_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P16_used_specific_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:makesDeityPresent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:makesDeityPresent ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:makesDeityPresent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P16_used_specific_object ],
        prov:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)" ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:KumariLifecycleEvent a owl:Class ;
    rdfs:label "KumariLifecycleEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:boundsTenure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:boundsTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariTenure ;
            owl:onProperty heritageGraph:boundsTenure ],
        heritageGraph:RitualEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Abstract event that bounds a KumariTenure (selection, enthronement, or retirement). Each concrete subclass requires exactly one tenure edge via slot_usage: initiated_tenure (selection), ended_tenure_of (retirement), or bounds_tenure itself (enthronement)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariSelectionEvent a owl:Class ;
    rdfs:label "KumariSelectionEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performedByGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] crm:E39_Actor ) ] ;
            owl:onProperty heritageGraph:performedByGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariTenure ;
            owl:onProperty heritageGraph:initiatedTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:selectedPerson ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:initiatedTenure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasCriterion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:initiatedTenure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:selectedPerson ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:selectedPerson ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty heritageGraph:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:SelectionCriterion ;
            owl:onProperty heritageGraph:hasCriterion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRole ;
            owl:onProperty heritageGraph:confersRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:confersRole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:confersRole ],
        heritageGraph:KumariLifecycleEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:ReligiousStructure a owl:Class ;
    rdfs:label "ReligiousStructure" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Architectural structure whose defining purpose is religious: enshrines a deity and/or is a locus of ritual activation. Abstract grouping for sacred structures across traditions (temple, stupa, chaitya)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:assertsAbout a owl:ObjectProperty ;
    rdfs:label "asserts_about" ;
    rdfs:range heritageGraph:AssertionSubject ;
    owl:inverseOf heritageGraph:hasAssertion ;
    skos:definition "Heritage entity or event that is the subject of this assertion." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:consecratedByEvent a owl:ObjectProperty ;
    rdfs:label "consecrated_by_event" ;
    rdfs:range heritageGraph:Consecration ;
    owl:inverseOf crm:P16_used_specific_object ;
    skos:definition "Consecration event that activated this murti" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:endedTenureOf a owl:ObjectProperty ;
    rdfs:label "ended_tenure_of" ;
    rdfs:range heritageGraph:KumariTenure ;
    rdfs:subPropertyOf heritageGraph:boundsTenure ;
    owl:inverseOf heritageGraph:retiredThrough ;
    skos:definition "Points from a KumariRetirementEvent to the tenure that it terminated. Enables reconstruction of the complete Kumari lifecycle." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrinedDeity a owl:ObjectProperty ;
    rdfs:label "enshrined_deity" ;
    rdfs:range heritageGraph:Deity ;
    rdfs:subPropertyOf crm:P12_occurred_in_the_presence_of ;
    owl:inverseOf heritageGraph:isEnshrinedThroughEvent ;
    skos:definition "Deity installed through enshrinement" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:enshrinedInStructure a owl:ObjectProperty ;
    rdfs:label "enshrined_in_structure" ;
    rdfs:range heritageGraph:Temple ;
    rdfs:subPropertyOf crm:P8_took_place_on_or_within ;
    owl:inverseOf heritageGraph:enshrinesDeityThroughEvent ;
    skos:definition "Temple where deity was enshrined" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:initiatedTenure a owl:ObjectProperty ;
    rdfs:label "initiated_tenure" ;
    rdfs:range heritageGraph:KumariTenure ;
    rdfs:subPropertyOf heritageGraph:boundsTenure ;
    owl:inverseOf heritageGraph:selectedThrough ;
    skos:definition "Kumari tenure that was initiated by this selection event" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:mentionedInSource a owl:ObjectProperty ;
    rdfs:label "documented_in_source" ;
    rdfs:range heritageGraph:DataSource ;
    skos:definition "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment "prov:wasInfluencedBy" .

heritageGraph:participatesInRitual a owl:ObjectProperty ;
    rdfs:label "participates_in_ritual" ;
    rdfs:range heritageGraph:RitualEvent ;
    rdfs:subPropertyOf crm:P12i_was_present_at ;
    skos:definition "Rituals in which this structure participates" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:retiredThrough a owl:ObjectProperty ;
    rdfs:label "retired_through" ;
    rdfs:range heritageGraph:KumariRetirementEvent ;
    owl:inverseOf heritageGraph:endedTenureOf ;
    skos:definition "Retirement/desanctification event that ended this tenure." ;
    skos:inScheme heritageGraph:schema .

<https://w3id.org/heritagegraph/scheme/ConditionType> a skos:ConceptScheme ;
    rdfs:label "ConditionType" ;
    skos:definition "Controlled vocabulary for the physical condition of heritage objects and structures." ;
    skos:prefLabel "ConditionType" .

<https://w3id.org/heritagegraph/scheme/SyncreticType> a skos:ConceptScheme ;
    rdfs:label "SyncreticType" ;
    skos:definition "Controlled vocabulary for kinds of syncretic theological relationships between deities." ;
    skos:prefLabel "SyncreticType" .

heritageGraph:selectedThrough a owl:ObjectProperty ;
    rdfs:label "selected_through" ;
    rdfs:range heritageGraph:KumariSelectionEvent ;
    owl:inverseOf heritageGraph:initiatedTenure ;
    skos:definition "Selection event that initiated this tenure." ;
    skos:inScheme heritageGraph:schema .

crm:E14_Condition_Assessment a owl:Class ;
    rdfs:label "ConditionAssessment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P34_concerned ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P35_has_identified ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty crm:P34_concerned ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E3_Condition_State ;
            owl:onProperty crm:P35_has_identified ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P34_concerned ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P35_has_identified ],
        prov:Activity ;
    skos:definition "Event of evaluating the physical state of a heritage object or structure" ;
    skos:exactMatch heritageGraph:ConditionAssessment ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

prov:generated a owl:ObjectProperty ;
    rdfs:label "generated" ;
    rdfs:range prov:Entity ;
    owl:inverseOf prov:wasGeneratedBy ;
    skos:definition "Entity generated by this activity." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ArchitecturalElement a owl:Class ;
    rdfs:label "ArchitecturalElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P46i_forms_part_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P46i_forms_part_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty crm:P46i_forms_part_of ],
        prov:Entity ;
    skos:broadMatch crm:E25_Human-Made_Feature ;
    skos:definition "Carved or constructed component of an architectural structure (e.g., Gajur, Torana, Tundal)" ;
    skos:exactMatch aat:300000885 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:CasteGroup a owl:Class ;
    rdfs:label "CasteGroup" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:traditionalRole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:traditionalRole ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:traditionalRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        crm:E39_Actor ;
    skos:broadMatch crm:E74_Group,
        prov:Organization ;
    skos:definition "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Festival a owl:Class ;
    rdfs:label "Festival" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P9_consists_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P9_consists_of ],
        heritageGraph:RitualEvent ;
    skos:altLabel "Jatra" ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

<https://w3id.org/heritagegraph/scheme/ArchitecturalStyle> a skos:ConceptScheme ;
    rdfs:label "ArchitecturalStyle" ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type." ;
    skos:prefLabel "ArchitecturalStyle" .

<https://w3id.org/heritagegraph/scheme/DatePrecision> a skos:ConceptScheme ;
    rdfs:label "DatePrecision" ;
    skos:definition "Controlled vocabulary for the temporal precision of recorded heritage dates." ;
    skos:prefLabel "DatePrecision" .

schema1:inLanguage a owl:DatatypeProperty ;
