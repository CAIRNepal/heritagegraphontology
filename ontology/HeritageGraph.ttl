heritageGraph:SyncreticRelationship a owl:Class ;
    rdfs:label "SyncreticRelationship" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom prov:Entity ;
            owl:onProperty prov:used ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty crm:P140_assigned_attribute_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P141_assigned ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:mentionedInSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:SyncreticType ;
            owl:onProperty heritageGraph:syncreticType ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P140_assigned_attribute_to ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:mentionedInSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty crm:P141_assigned ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:syncreticType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P140_assigned_attribute_to ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:syncreticType ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:used ],
        prov:Activity ;
    skos:broadMatch crm:E13_Attribute_Assignment ;
    skos:definition "Formalizes the syncretic equivalence between divine entities across different theological frameworks. Following CIDOC CRM E13, it treats syncretism as a propositional claim with associated epistemic authority and provenance." ;
    skos:inScheme heritageGraph:schema .

