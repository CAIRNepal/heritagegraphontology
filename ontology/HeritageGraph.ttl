hg:Murti a owl:Class ;
    rdfs:label "Murti"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hg:Deity ;
            owl:onProperty hg:isAboutDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:consecratedByEvent ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:isAboutDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Consecration ;
            owl:onProperty hg:consecratedByEvent ],
        hg:IconographicObject ;
    skos:definition "Consecrated image or seat of a deity, figural or aniconic (e.g. a stone, a linga, a pitha), ritually activated to serve as divine presence (not merely depiction)."@en ;
    skos:exactMatch wikidata:Q1781039 ;
    skos:inScheme hg:schema .

hg:RitualOffice a owl:Class ;
    rdfs:label "Ritual Office"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:Office ;
    skos:definition "A ritual office or specialist role (e.g. Vajracharya or Rajopadhyaya priest, Karmacharya, chariot builder, festival musician, the Kumari), held by a person or a caste group, often hereditarily."@en ;
    skos:inScheme hg:schema .

