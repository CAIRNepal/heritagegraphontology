    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:RestHouse ;
    skos:altLabel "Phalcha"@en ;
    skos:definition "Open-air pavilion for resting travelers."@en ;
    skos:inScheme hg:schema .

hg:Paubha a owl:Class ;
