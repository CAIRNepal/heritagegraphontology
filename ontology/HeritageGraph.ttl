        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P7_took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E29_Design_or_Procedure ;
            owl:onProperty crm:P33_used_specific_technique ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty crm:P14_carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:commissionedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P108_has_produced ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14_carried_out_by ],
        prov:Activity ;
    skos:definition "Event of creating an architectural structure, murti, or paubha" ;
