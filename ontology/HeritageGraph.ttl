heritageGraph:Dharmashala a owl:Class ;
    rdfs:label "Dharmashala" ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:definition "Pilgrim lodge operated by a Guthi organization" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DhungeDhara a owl:Class ;
    rdfs:label "DhungeDhara" ;
    rdfs:subClassOf heritageGraph:WaterStructure ;
    skos:altLabel "Hiti" ;
    skos:definition "Stone spout (hiti) with carved imagery, used for ritual bathing and daily water supply" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:FearlessnessAssessment a owl:Class ;
    rdfs:label "FearlessnessAssessment" ;
    rdfs:subClassOf heritageGraph:RitualAssessment ;
    skos:definition "The 'fearlessness test' popularly described (animal heads, masked dancers in darkness). Its historical and contemporary practice is DISPUTED -- some former Kumaris contest how it is described. Represented as an assessment whose accounts are source-attributed via has_assertion, NOT as a mandatory criterion." ;
    skos:inScheme heritageGraph:schema ;
    skos:scopeNote "Deliberately not a SelectionCriterion subclass: popular accounts and lived testimony disagree. Attach each account as a Assertion (CRMinf I2 Belief) with its own source and confidence." .

heritageGraph:FieldSurveyActivity a owl:Class ;
    rdfs:label "FieldSurveyActivity" ;
    rdfs:subClassOf heritageGraph:DocumentationActivity ;
    skos:broadMatch crmsci:S4_Observation ;
    skos:definition "The activity of measuring, photographing, or assessing a site in person." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:FieldSurveyDataset a owl:Class ;
    rdfs:label "FieldSurveyDataset" ;
    rdfs:subClassOf heritageGraph:DataSource ;
    skos:broadMatch crm:E31_Document ;
    skos:definition "The structured data or report resulting from a field survey." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:HoroscopeCompatibilityCriterion a owl:Class ;
    rdfs:label "HoroscopeCompatibilityCriterion" ;
    rdfs:subClassOf heritageGraph:SelectionCriterion ;
    skos:definition "Candidate's horoscope must be compatible with the city and ruling authority." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariHouse a owl:Class ;
    rdfs:label "KumariHouse" ;
    rdfs:subClassOf heritageGraph:ReligiousStructure ;
    skos:altLabel "Kumari Ghar" ;
    skos:definition "God-house residence of a Kumari during tenure (e.g., Kumari Ghar, Kathmandu). Specialised ReligiousStructure." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:LineageCriterion a owl:Class ;
    rdfs:label "LineageCriterion" ;
    rdfs:subClassOf heritageGraph:SelectionCriterion ;
    skos:definition "Candidate must belong to an eligible lineage (Shakya / Vajracharya Newar Buddhist family)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:MaskedDance a owl:Class ;
    rdfs:label "MaskedDance" ;
    rdfs:subClassOf heritageGraph:Festival ;
    skos:definition "Festival featuring masked dancers embodying deities (e.g., Kartik Naach)" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:OralHistoryInterview a owl:Class ;
    rdfs:label "OralHistoryInterview" ;
    rdfs:subClassOf heritageGraph:DocumentationActivity ;
    skos:broadMatch crm:E65_Creation ;
    skos:definition "The interaction event between a researcher and a knowledge holder." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:OralHistoryRecording a owl:Class ;
    rdfs:label "OralHistoryRecording" ;
    rdfs:subClassOf heritageGraph:DataSource ;
    skos:broadMatch crm:E33_Linguistic_Object ;
    skos:definition "The recording or transcript of an oral history interview." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Pati a owl:Class ;
    rdfs:label "Pati" ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:altLabel "Phalcha" ;
    skos:definition "Open-air pavilion for resting travelers" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Paubha a owl:Class ;
    rdfs:label "Paubha" ;
    rdfs:subClassOf heritageGraph:IconographicObject ;
    skos:broadMatch aat:300033618 ;
    skos:closeMatch wikidata:Q916651 ;
    skos:definition "Traditional Newari scroll painting (thangka) with mandala and deity iconography" ;
    skos:exactMatch wikidata:Q7148832 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:PhysicalIntegrityCriterion a owl:Class ;
    rdfs:label "PhysicalIntegrityCriterion" ;
    rdfs:subClassOf heritageGraph:SelectionCriterion ;
    skos:definition "Candidate must have an unblemished body with no scars, wounds, or loss of blood/teeth." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Pokhari a owl:Class ;
    rdfs:label "Pokhari" ;
    rdfs:subClassOf heritageGraph:WaterStructure ;
    skos:definition "Pond or tank for water storage, ritual bathing, and ecological management" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Sattal a owl:Class ;
    rdfs:label "Sattal" ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:definition "Multi-story rest house (3-5 floors) with ritual and social functions" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Stupa a owl:Class ;
    rdfs:label "Stupa" ;
    rdfs:subClassOf heritageGraph:ReligiousStructure ;
    owl:disjointWith heritageGraph:Chaitya ;
    skos:definition "Buddhist dome-shaped reliquary shrine with circumambulation and ritual activation (e.g., Boudhanath, Swayambhunath)." ;
    skos:exactMatch aat:300007576,
        wikidata:Q180987 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ThirtyTwoPerfectionsCriterion a owl:Class ;
    rdfs:label "ThirtyTwoPerfectionsCriterion" ;
    rdfs:subClassOf heritageGraph:SelectionCriterion ;
    skos:altLabel "Battis Lakshana" ;
    skos:definition "Candidate must exhibit the battis lakshana (thirty-two perfections/auspicious bodily marks)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Verification a owl:Class ;
    rdfs:label "Verification" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:verifiedAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:verifiedByExpert ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:verificationMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:verifiedAssertion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:verificationMethod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:verifiedByExpert ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:verificationMethod ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        heritageGraph:DocumentationActivity ;
    skos:broadMatch prov:Activity ;
    skos:definition "Process of cross-checking heritage claims against multiple sources" ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

heritageGraph:crminf_pattern a owl:AnnotationProperty .

heritageGraph:design_note a owl:AnnotationProperty .

heritageGraph:ontology a owl:Ontology ;
    rdfs:label "HeritageGraph" ;
    dcterms:bibliographicCitation "CAIR-Nepal (2026). HeritageGraph Ontology (0.1.0-alpha.5). https://w3id.org/heritagegraph/ontology" ;
    dcterms:created "2025-11-23"^^xsd:date ;
    dcterms:creator "CAIR-Nepal" ;
    dcterms:description "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-07-16"^^xsd:date ;
    dcterms:publisher "CAIR-Nepal" ;
    dcterms:source <https://github.com/CAIRNepal/heritagegraphontology> ;
    dcterms:title "HeritageGraph Ontology" ;
    bibo:status "Pre-release specification draft (alpha)" ;
    pav:version "0.1.0-alpha.5" ;
    vann:preferredNamespacePrefix "heritageGraph" ;
    vann:preferredNamespaceUri "https://w3id.org/heritagegraph/" ;
    owl:versionIRI <https://w3id.org/heritagegraph/ontology/0.1.0-alpha.5> ;
    skos:definition "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning." .

