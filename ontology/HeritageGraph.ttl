    skos:narrowMatch wikidata:Q838948 .

crm:P2_has_type a owl:ObjectProperty ;
    rdfs:label "has_type" ;
    skos:definition "Generic CRM typing property (P2 has type). Canonical holder of the CRM predicate; use the specific typing slots below in data." ;
    skos:inScheme heritageGraph:schema .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:label "generated_at_time" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Time at which this entity was generated (ISO 8601)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ConditionType a owl:Class ;
    rdfs:label "ConditionType" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/ConditionType#Good> <https://w3id.org/heritagegraph/ConditionType#Damaged> <https://w3id.org/heritagegraph/ConditionType#Ruined> <https://w3id.org/heritagegraph/ConditionType#Restored> ) ;
    skos:definition "Controlled vocabulary for the physical condition of heritage objects and structures." ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://w3id.org/heritagegraph/ConditionType#Damaged>,
        <https://w3id.org/heritagegraph/ConditionType#Good>,
        <https://w3id.org/heritagegraph/ConditionType#Restored>,
        <https://w3id.org/heritagegraph/ConditionType#Ruined> .

heritageGraph:Enshrinement a owl:Class ;
