hg:WaterStructure a owl:Class ;
    rdfs:label "Water Structure"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:ArchitecturalStructure ;
    skos:definition "Engineered water supply systems with ritual and civic significance."@en ;
    skos:inScheme hg:schema .

hg:assessesCandidate a owl:ObjectProperty ;
    rdfs:label "Assesses candidate"@en ;
    schema:domainIncludes hg:RitualAssessment ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E21_Person ;
    skos:definition "Candidate being assessed."@en ;
    skos:inScheme hg:schema .

hg:assumesRole a owl:ObjectProperty ;
    rdfs:label "Assumes role"@en ;
    schema:domainIncludes hg:KumariTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariRole ;
    rdfs:subPropertyOf hg:tenureOffice ;
    skos:definition "KumariRole held during this tenure."@en ;
    skos:inScheme hg:schema .

hg:consecratedByEvent a owl:ObjectProperty ;
    rdfs:label "Consecrated by event"@en ;
    schema:domainIncludes hg:Murti ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Consecration ;
    skos:definition "Consecration event that activated this murti."@en ;
    skos:inScheme hg:schema .

hg:custodyClosedBy a owl:ObjectProperty ;
    rdfs:label "Custody closed by"@en ;
    schema:domainIncludes hg:CustodyPeriod ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E10_Transfer_of_Custody ;
    rdfs:subPropertyOf hg:tenureClosedBy ;
    skos:definition "Transfer of custody that ended the period."@en ;
    skos:inScheme hg:schema .

hg:custodyOpenedBy a owl:ObjectProperty ;
    rdfs:label "Custody opened by"@en ;
    schema:domainIncludes hg:CustodyPeriod ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E10_Transfer_of_Custody ;
    rdfs:subPropertyOf hg:tenureOpenedBy ;
    skos:definition "Transfer of custody that began the period."@en ;
    skos:inScheme hg:schema .

hg:destructionEvent a owl:ObjectProperty ;
    rdfs:label "has destruction event"@en ;
    dcterms:title "has destruction event"@en ;
    schema:domainIncludes hg:ArchitecturalStructure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E6_Destruction ;
    owl:inverseOf crm:P13_destroyed ;
    skos:definition "Event that destroyed this structure (if known)."@en ;
    skos:inScheme hg:schema .

hg:documents a owl:ObjectProperty ;
    rdfs:label "records"@en ;
    dcterms:title "records"@en ;
    schema:domainIncludes hg:DocumentationActivity ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:AssertionSubject ;
    owl:inverseOf hg:documentedBy ;
    skos:definition "Pre-existing heritage entity or event recorded by this documentation activity (inverse of hg:documentedBy)."@en ;
    skos:inScheme hg:schema ;
    skos:relatedMatch crm:P70_documents .

hg:endPlace a owl:ObjectProperty ;
    rdfs:label "End place"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E53_Place ;
    skos:definition "Ending location of movement ritual."@en ;
    skos:inScheme hg:schema ;
    skos:relatedMatch crm:P26_moved_to .

hg:endowmentRecipient a owl:ObjectProperty ;
    rdfs:label "Endowment recipient"@en ;
    schema:domainIncludes hg:EndowmentEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E39_Actor ;
    rdfs:subPropertyOf crm:P22_transferred_title_to ;
    skos:definition "Guthi or state body that received the property (e.g. the Guthi Sansthan in a nationalisation)."@en ;
    skos:inScheme hg:schema .

hg:enshrinesDeityThroughEvent a owl:ObjectProperty ;
    rdfs:label "Enshrines deity through event"@en ;
    schema:domainIncludes hg:Temple ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Enshrinement ;
    owl:inverseOf hg:enshrinedInStructure ;
    skos:definition "Enshrinement event that installed deity in temple."@en ;
    skos:inScheme hg:schema .

hg:enthronedThrough a owl:ObjectProperty ;
    rdfs:label "Enthroned through"@en ;
    schema:domainIncludes hg:KumariTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariEnthronementEvent ;
    rdfs:subPropertyOf hg:tenureOpenedBy ;
    skos:definition "Enthronement event that activated this tenure."@en ;
    skos:inScheme hg:schema .

hg:epochDateGregorian a owl:DatatypeProperty ;
    rdfs:label "Epoch date gregorian"@en ;
    schema:domainIncludes hg:CalendarSystem ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:string ;
    skos:definition "Proleptic Gregorian (ISO 8601, astronomical year numbering) date on which the era began, in the era's own reckoning (Bikram Sambat counts from year 1, e.g. -0056-04-14, a nominal back-projection of the modern solar reckoning rather than an attested date; Nepal Sambat counts elapsed years from year 0, 0879-10-24 = 20 October 879 Julian). Its month and day only indicate the approximate new-year season: the actual new year varies (Bikram Sambat 13-15 April, solar; Nepal Sambat late October to November, lunisolar), so it must not be used for day-level conversion. A value ending in -01-01 marks a calendar whose new year is 1 January, for which year conversion is exact."@en ;
    skos:inScheme hg:schema .

hg:existenceStatus a owl:ObjectProperty ;
    rdfs:label "has existence status"@en ;
    dcterms:title "has existence status"@en ;
    schema:domainIncludes hg:ArchitecturalStructure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:ExistenceStatus ;
    skos:definition "Current physical status of the structure."@en ;
    skos:inScheme hg:schema .

hg:guthiType a owl:ObjectProperty ;
    rdfs:label "has guthi type"@en ;
    dcterms:title "has guthi type"@en ;
    schema:domainIncludes hg:Guthi ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:GuthiType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Type of Guthi (Si, Jatra, Temple)."@en ;
    skos:inScheme hg:schema .

hg:hadParticipant a owl:ObjectProperty ;
    rdfs:label "Had participant"@en ;
    schema:domainIncludes hg:KumariTenure,
        hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E39_Actor ;
    skos:closeMatch crm:P11_had_participant ;
    skos:definition "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the Kumari in a chariot procession). The holder of a tenure is given with hg:tenureHolder."@en ;
    skos:inScheme hg:schema .

hg:hasCriterion a owl:ObjectProperty ;
    rdfs:label "Has criterion"@en ;
    schema:domainIncludes hg:KumariSelectionEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:SelectionCriterion ;
    skos:definition "Eligibility criterion applied in this selection."@en ;
    skos:inScheme hg:schema .

hg:hasReligiousTradition a owl:ObjectProperty ;
    rdfs:label "Has religious tradition"@en ;
    schema:domainIncludes hg:ArchitecturalStructure,
        hg:Deity ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:ReligiousTradition ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Religious tradition(s) within which this deity is venerated, or which use this structure (a temple, or a pavilion, rest house or water spout with a shrine)."@en ;
    skos:inScheme hg:schema .

hg:identifierScheme a owl:DatatypeProperty ;
    rdfs:label "Datacite identifier type"@en ;
    schema:domainIncludes hg:DataSource ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:string ;
    skos:definition "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)."@en ;
    skos:inScheme hg:schema .

hg:invokesDeity a owl:ObjectProperty ;
    rdfs:label "Invokes deity"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Deity ;
    rdfs:subPropertyOf crm:P12_occurred_in_the_presence_of ;
    owl:inverseOf hg:isInvokedInRitual ;
    skos:definition "Deity invoked or made present through ritual."@en ;
    skos:inScheme hg:schema .

hg:isAboutDeity a owl:ObjectProperty ;
    rdfs:label "Is about deity"@en ;
    schema:domainIncludes hg:Murti ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Deity ;
    rdfs:subPropertyOf crm:P62_depicts ;
    skos:definition "Deity represented and ritually associated with the Murti."@en ;
    skos:inScheme hg:schema .

hg:isCriticalForFestival a owl:DatatypeProperty ;
    rdfs:label "Is critical for festival"@en ;
    schema:domainIncludes hg:KumariSelectionEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:boolean ;
    skos:definition "Whether this ritual is essential for the festival's completion."@en ;
    skos:inScheme hg:schema .

hg:isEnshrinedThroughEvent a owl:ObjectProperty ;
    rdfs:label "Is enshrined through event"@en ;
    schema:domainIncludes hg:Deity ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Enshrinement ;
    owl:inverseOf hg:enshrinedDeity ;
    skos:definition "Events where this deity was enshrined."@en ;
    skos:inScheme hg:schema .

hg:isInvokedInRitual a owl:ObjectProperty ;
    rdfs:label "Is invoked in ritual"@en ;
    schema:domainIncludes hg:Deity ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:RitualEvent ;
    rdfs:subPropertyOf crm:P12i_was_present_at ;
    owl:inverseOf hg:invokesDeity ;
    skos:definition "Rituals where this deity is invoked."@en ;
    skos:inScheme hg:schema .

hg:lastKnownExistenceDate a owl:DatatypeProperty ;
    rdfs:label "Last known existence date"@en ;
    schema:domainIncludes hg:ArchitecturalStructure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:dateTime ;
    skos:definition "Latest date when this structure is documented as existing (ISO 8601)."@en ;
    skos:inScheme hg:schema .

hg:makesDeityPresent a owl:ObjectProperty ;
    rdfs:label "Makes deity present"@en ;
    schema:domainIncludes hg:Consecration ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Deity ;
    skos:definition "Deity made present through consecration."@en ;
    skos:inScheme hg:schema .

hg:managedByGuthi a owl:ObjectProperty ;
    rdfs:label "Managed by guthi"@en ;
    schema:domainIncludes hg:ArchitecturalStructure,
        hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Guthi ;
    skos:definition "Guthi organization managing this structure or ritual."@en ;
    skos:inScheme hg:schema ;
    skos:relatedMatch crm:P49_has_former_or_current_keeper .

hg:mandatedBy a owl:ObjectProperty ;
    rdfs:label "Mandated by"@en ;
    schema:domainIncludes hg:HereditaryRoleTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E74_Group ;
    skos:definition "Guthi or state body that mandates (and usually funds) the hereditary duty."@en ;
    skos:inScheme hg:schema .

hg:mentionedInSource a owl:ObjectProperty ;
    rdfs:label "Documented in source"@en ;
    schema:domainIncludes hg:ArchitecturalStructure,
        hg:SyncreticRelationship ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:DataSource ;
    skos:definition "Source(s) that mention/document this entity: the normative way to cite a source for a description of a heritage thing, event, actor or relationship. Distinct from prov:wasDerivedFrom, which is used only on assertions (I2 Belief) with prov:wasAttributedTo for the claimant. A source's own bibliographic data uses hg:sourceCitation, hg:sourceCreator, hg:sourceUrl and hg:persistentIdentifier. Entity-mention is not logical derivation."@en ;
    skos:editorialNote "PROV-O alignment: prov:wasInfluencedBy"@en ;
    skos:inScheme hg:schema .

hg:partOfSelection a owl:ObjectProperty ;
    rdfs:label "Part of selection"@en ;
    schema:domainIncludes hg:RitualAssessment ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariSelectionEvent ;
    skos:definition "Selection event this assessment is part of."@en ;
    skos:inScheme hg:schema .

hg:persistentIdentifier a owl:DatatypeProperty ;
    rdfs:label "Datacite identifier"@en ;
    schema:domainIncludes hg:DataSource ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:string ;
    skos:definition "Persistent identifier for the source (DOI, archive ID, catalog number)."@en ;
    skos:inScheme hg:schema .

hg:propositionLiteralValue a owl:DatatypeProperty ;
    rdfs:label "Proposition object literal"@en ;
    schema:domainIncludes hg:Proposition ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range rdfs:Literal ;
    skos:definition "Object of the proposition when it is a literal value (e.g. a date)."@en ;
    skos:inScheme hg:schema .

hg:propositionObjectEntity a owl:ObjectProperty ;
    rdfs:label "Proposition object entity"@en ;
    schema:domainIncludes hg:Proposition ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:AssertionSubject ;
    skos:definition "Object of the proposition when it is a heritage entity (plays the role of rdf:object)."@en ;
    skos:inScheme hg:schema .

hg:publicationTimespan a owl:ObjectProperty ;
    rdfs:label "Publication timespan"@en ;
    schema:domainIncludes hg:DataSource ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E52_Time-Span ;
    skos:definition "When source was published."@en ;
    skos:inScheme hg:schema .

hg:resourceType a owl:DatatypeProperty ;
    rdfs:label "Datacite resource type"@en ;
    schema:domainIncludes hg:DataSource ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:string ;
    skos:definition "High-level DataCite resource type (Dataset, Text, Image, Audio, Interview)."@en ;
    skos:inScheme hg:schema .

hg:ritualType a owl:ObjectProperty ;
    rdfs:label "has ritual type"@en ;
    dcterms:title "has ritual type"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:RitualType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Classification of ritual (puja, jatra, consecration)."@en ;
    skos:inScheme hg:schema .

hg:roleDeity a owl:ObjectProperty ;
    rdfs:label "Role deity"@en ;
    schema:domainIncludes hg:KumariRole ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Deity ;
    skos:definition "Deity embodied by whoever holds this role (e.g., Taleju)."@en ;
    skos:inScheme hg:schema .

hg:roleDuty a owl:DatatypeProperty ;
    rdfs:label "Role duty"@en ;
    schema:domainIncludes hg:HereditaryRoleTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "The ritual duty held (e.g. building the festival chariot, performing the daily worship)."@en ;
    skos:inScheme hg:schema .

hg:sourcePublisher a owl:ObjectProperty ;
    rdfs:label "Datacite publisher"@en ;
    schema:domainIncludes hg:DataSource ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Entity responsible for making the source available."@en ;
    skos:exactMatch dcterms:publisher ;
    skos:inScheme hg:schema .

hg:sourceUrl a owl:DatatypeProperty ;
    rdfs:label "Source url"@en ;
    schema:domainIncludes hg:DataSource ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:string ;
    skos:definition "URL or digital identifier for source."@en ;
    skos:inScheme hg:schema .

hg:startPlace a owl:ObjectProperty ;
    rdfs:label "Start place"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E53_Place ;
    skos:definition "Starting location of movement ritual."@en ;
    skos:inScheme hg:schema ;
    skos:relatedMatch crm:P27_moved_from .

hg:succeeds a owl:AsymmetricProperty,
        owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:label "succeeds"@en ;
    schema:domainIncludes hg:HereditaryRoleTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:HereditaryRoleTenure ;
    skos:definition "Earlier tenure of the same hereditary office that this tenure succeeds."@en ;
    skos:inScheme hg:schema .

hg:sustains a owl:ObjectProperty ;
    rdfs:label "sustains"@en ;
    schema:domainIncludes hg:Endowment ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( hg:ArchitecturalStructure hg:RitualEvent hg:Office ) ] hg:AssertionSubject ) ] ;
    skos:definition "Structure, ritual or festival, or sacred office whose upkeep or performance the endowment funds."@en ;
    skos:inScheme hg:schema .

hg:syncreticType a owl:ObjectProperty ;
    rdfs:label "has syncretic type"@en ;
    dcterms:title "has syncretic type"@en ;
    schema:domainIncludes hg:SyncreticRelationship ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:SyncreticType ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)."@en ;
    skos:inScheme hg:schema .

hg:yearOffsetFromGregorian a owl:DatatypeProperty ;
    rdfs:label "Year offset from gregorian"@en ;
    schema:domainIncludes hg:CalendarSystem ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:integer ;
    skos:definition "Number of years this calendar runs ahead of the Gregorian (Common Era) year at the start of its year (e.g. 57 for Bikram Sambat, -879 for Nepal Sambat). Because the calendar's new year does not fall on 1 January (see hg:epochDateGregorian), a year-precision date Y converts to the two-year interval [Y - offset, Y - offset + 1] CE; the single year Y - offset is correct only for dates between the calendar's new year and 31 December. A calendar whose new year is 1 January converts to Y - offset exactly."@en ;
    skos:inScheme hg:schema .

crm:P108i_was_produced_by a owl:ObjectProperty ;
    rdfs:label "was produced by"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Quantification of the inverse property: one to many, necessary, dependent (1,n:1,1)

Scope note of the inverse property:
This property identifies the instance of E24 Physical Human-Made Thing that came into existence as a result of the instance of E12 Production.
The identity of an instance of E24 Physical Human-Made Thing is not defined by its matter, but by its existence as a subject of documentation. An E12 Production can result in the creation of multiple instances of E24 Physical Human-Made Thing.

Examples of the inverse property:
- The building of Rome (E12) has produced the Colosseum (E24). (Hopkins &amp; Beard, 2011)

In First Order Logic of the inverse property:
- P108(x,y) ⇒ E12(x)
- P108(x,y) ⇒ E24(y)
- P108(x,y) ⇒ P31(x,y)
- P108(x,y) ⇒ P92(x,y)"""@en .

crm:P12_occurred_in_the_presence_of a owl:ObjectProperty ;
    rdfs:label "occurred in the presence of"@en ;
    rdfs:isDefinedBy crm: ;
    owl:inverseOf crm:P12i_was_present_at ;
    skos:definition """Quantification: many to many, necessary (1,n:0,n)

Scope note:
This property describes the active or passive presence of an E77 Persistent Item in an instance of E5 Event without implying any specific role. 
It documents known events in which an instance of E77 Persistent Item was present during the course of its life or history. For example, an object may be the desk, now in a museum, on which a treaty was signed. The instance of E53 Place and the instance of E52 Time-Span where and when these events happened provide constraints about the presence of the related instance E77 Persistent Item in the past. Instances of E90 Symbolic Object, in particular information objects, are physically present in events via at least one of the instances of E18 Physical Thing carrying them. Note, that the human mind can be such a carrier. A precondition for a transfer of information to a person or another new physical carrier is the presence of the respective information object and this person or physical thing in one event.

Examples:
- Deckchair 42 (E19) was present at the sinking of the Titanic (E5). (Aldridge, 2008)

In First Order Logic:
- P12(x,y) ⇒ E5(x)
- P12(x,y) ⇒ E77(y)"""@en .

crm:P12i_was_present_at a owl:ObjectProperty ;
    rdfs:label "was present at"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Quantification of the inverse property: many to many, necessary (1,n:0,n)

Scope note of the inverse property:
This property describes the active or passive presence of an E77 Persistent Item in an instance of E5 Event without implying any specific role. 
It documents known events in which an instance of E77 Persistent Item was present during the course of its life or history. For example, an object may be the desk, now in a museum, on which a treaty was signed. The instance of E53 Place and the instance of E52 Time-Span where and when these events happened provide constraints about the presence of the related instance E77 Persistent Item in the past. Instances of E90 Symbolic Object, in particular information objects, are physically present in events via at least one of the instances of E18 Physical Thing carrying them. Note, that the human mind can be such a carrier. A precondition for a transfer of information to a person or another new physical carrier is the presence of the respective information object and this person or physical thing in one event.

Examples of the inverse property:
- Deckchair 42 (E19) was present at the sinking of the Titanic (E5). (Aldridge, 2008)

In First Order Logic of the inverse property:
- P12(x,y) ⇒ E5(x)
- P12(x,y) ⇒ E77(y)"""@en .

hg:ArchitecturalElement a owl:Class ;
    rdfs:label "Architectural Element"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P46i_forms_part_of ],
        crm:E24_Physical_Human-Made_Thing,
        prov:Entity ;
    skos:broadMatch crm:E25_Human-Made_Feature ;
    skos:definition "Carved or constructed component of an architectural structure (e.g., Gajur, Torana, Tundal)."@en ;
    skos:exactMatch aat:300000885 ;
    skos:inScheme hg:schema .

<https://cair-nepal.org/heritagegraph/GuthiType#SanaGuthi> a owl:NamedIndividual,
        skos:Concept,
        hg:GuthiType ;
    rdfs:label "Sana Guthi"@en ;
    rdfs:isDefinedBy hg:ontology ;
    skos:definition "Funeral association (sanah guthi): the association that organises the funeral procession and cremation of member households; in some localities it and the si guthi are one body."@en ;
    skos:inScheme <https://cair-nepal.org/heritagegraph/scheme/GuthiType> ;
    skos:prefLabel "Sana Guthi"@en .

hg:HistoricalEvent a owl:Class ;
    rdfs:label "Historical Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ArchitecturalStructure ;
            owl:onProperty hg:architecturalStructures ],
        crm:E5_Event,
        prov:Activity ;
    skos:definition "Major event affecting heritage structures or ritual life (earthquake, epidemic, political transition, fire, flood)."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

hg:KumariRetirementEvent a owl:Class ;
    rdfs:label "Kumari Retirement Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariTenure ;
            owl:onProperty hg:endedTenureOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:endedTenureOf ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( hg:Guthi hg:CasteGroup ) ] crm:E39_Actor ) ] ;
            owl:onProperty hg:performedByGroup ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:endedTenureOf ],
        hg:KumariLifecycleEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Ritual or administrative event that formally ends a Living Goddess tenure according to tradition, returning the person to secular life. Record the event and its date, not the reason: the traditional grounds concern the bodily state of a child, and HeritageGraph does not record health or bodily data about persons."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

hg:RestHouse a owl:Class ;
    rdfs:label "Rest House"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:ArchitecturalStructure ;
    skos:definition "Community structures for travelers and pilgrims, maintained by Guthi organizations."@en ;
    skos:inScheme hg:schema .

hg:RitualAssessment a owl:Class ;
    rdfs:label "Ritual Assessment"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:partOfSelection ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty hg:assessesCandidate ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariSelectionEvent ;
            owl:onProperty hg:partOfSelection ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:assessesCandidate ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        hg:RitualEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "A performed assessment carried out during Kumari selection. Modelled as an event (not a hard criterion) so that source-specific, possibly conflicting accounts of whether/how it was conducted attach as provenanced Assertions rather than being asserted as fact."@en ;
    skos:inScheme hg:schema .

hg:Temple a owl:Class ;
    rdfs:label "Temple"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Enshrinement ;
            owl:onProperty hg:enshrinesDeityThroughEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ArchitecturalStyle ;
            owl:onProperty hg:hasArchitecturalStyle ],
        hg:ReligiousStructure ;
    skos:altLabel "Mandir"@en ;
    skos:broadMatch dbo:ReligiousBuilding,
        schema:PlaceOfWorship ;
    skos:definition "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion."@en ;
    skos:exactMatch dbo:Temple,
        aat:300007595,
        wikidata:Q44539 ;
    skos:inScheme hg:schema ;
    skos:narrowMatch schema:HinduTemple .

hg:Verification a owl:Class ;
    rdfs:label "Verification"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:verifiedAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:verificationMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty hg:verifiedByExpert ],
        hg:DocumentationActivity ;
    skos:broadMatch prov:Activity ;
    skos:definition "Process of cross-checking heritage claims against multiple sources."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

hg:concernsEndowment a owl:ObjectProperty ;
    rdfs:label "Concerns endowment"@en ;
    schema:domainIncludes hg:EndowmentEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Endowment ;
    skos:definition "Endowment founded, augmented, nationalised or alienated by this event."@en ;
    skos:inScheme hg:schema .

hg:custodyHolder a owl:ObjectProperty ;
    rdfs:label "Custody holder"@en ;
    schema:domainIncludes hg:CustodyPeriod ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E39_Actor ;
    rdfs:subPropertyOf hg:tenureHolder ;
    skos:definition "Actor (typically a Guthi) holding custody during the period."@en ;
    skos:inScheme hg:schema .

hg:custodyObject a owl:ObjectProperty ;
    rdfs:label "Custody object"@en ;
    schema:domainIncludes hg:CustodyPeriod ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( hg:PhysicalHeritageThing crm:E22_Human-Made_Object ) ] hg:AssertionSubject ) ] ;
    skos:definition "Structure or object in custody during the period (any heritage structure, element or human-made object, e.g. a museum object)."@en ;
    skos:inScheme hg:schema .

hg:embodiedDeity a owl:ObjectProperty ;
    rdfs:label "Embodied deity"@en ;
    schema:domainIncludes hg:KumariTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Deity ;
    skos:definition "Deity role embodied by participant."@en ;
    skos:inScheme hg:schema .

hg:endowmentEventType a owl:ObjectProperty ;
    rdfs:label "has endowment event type"@en ;
    dcterms:title "has endowment event type"@en ;
    schema:domainIncludes hg:EndowmentEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:EndowmentEventType ;
    skos:definition "Kind of endowment event (founding, augmentation, nationalisation, alienation)."@en ;
    skos:inScheme hg:schema .

hg:enshrinedDeity a owl:ObjectProperty ;
    rdfs:label "Enshrined deity"@en ;
    schema:domainIncludes hg:Enshrinement ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Deity ;
    rdfs:subPropertyOf crm:P12_occurred_in_the_presence_of ;
    owl:inverseOf hg:isEnshrinedThroughEvent ;
    skos:definition "Deity installed through enshrinement."@en ;
    skos:inScheme hg:schema .

hg:enshrinedInStructure a owl:ObjectProperty ;
    rdfs:label "Enshrined in structure"@en ;
    schema:domainIncludes hg:Enshrinement ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Temple ;
    rdfs:subPropertyOf crm:P8_took_place_on_or_within ;
    owl:inverseOf hg:enshrinesDeityThroughEvent ;
    skos:definition "Temple where deity was enshrined."@en ;
    skos:inScheme hg:schema .

hg:enthronedPerson a owl:ObjectProperty ;
    rdfs:label "Enthroned person"@en ;
    schema:domainIncludes hg:KumariEnthronementEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E21_Person ;
    skos:definition "Girl enthroned as Kumari by this enthronement event."@en ;
    skos:inScheme hg:schema .

hg:performedByGroup a owl:ObjectProperty ;
    rdfs:label "Performed by group"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( hg:Guthi hg:CasteGroup ) ] crm:E39_Actor ) ] ;
    rdfs:subPropertyOf crm:P14_carried_out_by ;
    skos:definition "Group (Guthi, caste) responsible for ritual."@en ;
    skos:inScheme hg:schema .

hg:propositionPredicate a owl:DatatypeProperty ;
    rdfs:label "Proposition predicate"@en ;
    schema:domainIncludes hg:Proposition ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range xsd:anyURI ;
    skos:definition "Property (URI/CURIE) claimed of the subject, e.g. crm:P108i_was_produced_by (plays the role of rdf:predicate)."@en ;
    skos:inScheme hg:schema .

hg:propositionSubject a owl:ObjectProperty ;
    rdfs:label "Proposition subject"@en ;
    schema:domainIncludes hg:Proposition ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:AssertionSubject ;
    skos:definition "Entity the proposition is about (plays the role of rdf:subject)."@en ;
    skos:inScheme hg:schema .

hg:residenceStructure a owl:ObjectProperty ;
    rdfs:label "Residence structure"@en ;
    schema:domainIncludes hg:KumariTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:ArchitecturalStructure ;
    skos:definition "Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house)."@en ;
    skos:inScheme hg:schema .

hg:retiredThrough a owl:ObjectProperty ;
    rdfs:label "Retired through"@en ;
    schema:domainIncludes hg:KumariTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariRetirementEvent ;
    rdfs:subPropertyOf hg:tenureClosedBy ;
    owl:inverseOf hg:endedTenureOf ;
    skos:definition "Retirement/desanctification event that ended this tenure."@en ;
    skos:inScheme hg:schema .

hg:roleHolder a owl:ObjectProperty ;
    rdfs:label "Role holder"@en ;
    schema:domainIncludes hg:HereditaryRoleTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( crm:E21_Person hg:CasteGroup ) ] crm:E39_Actor ) ] ;
    rdfs:subPropertyOf hg:tenureHolder ;
    skos:definition "Person or caste group holding the hereditary duty during this tenure."@en ;
    skos:inScheme hg:schema .

hg:selectedPerson a owl:ObjectProperty ;
    rdfs:label "Selected person"@en ;
    schema:domainIncludes hg:KumariSelectionEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E21_Person ;
    skos:definition "Person selected through a ritual selection process to assume a sacred role or office."@en ;
    skos:inScheme hg:schema .

hg:selectedThrough a owl:ObjectProperty ;
    rdfs:label "Selected through"@en ;
    schema:domainIncludes hg:KumariTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariSelectionEvent ;
    owl:inverseOf hg:initiatedTenure ;
    skos:definition "Selection event that preceded this tenure. Not a tenure-opening event: the tenure opens with the enthronement (hg:enthronedThrough, a subproperty of hg:tenureOpenedBy)."@en ;
    skos:inScheme hg:schema .

crm:E4_Period a owl:Class ;
    rdfs:label "Period"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises sets of coherent phenomena or cultural manifestations occurring in time and space.
It is the social or physical coherence of these phenomena that identify an instance of E4 Period and not the associated spatiotemporal extent. This extent is only the “ground” or space in an abstract physical sense that the actual process of growth, spread and retreat has covered. Consequently, different periods can overlap and coexist in time and space, such as when a nomadic culture exists in the same area and time as a sedentary culture. This also means that overlapping land use rights, common among first nations, amounts to overlapping periods.
Often, this class is used to describe prehistoric or historic periods such as the “Neolithic Period”, the “Ming Dynasty” or the “McCarthy Era”, but also geopolitical units and activities of settlements are regarded as special cases of E4 Period. However, there are no assumptions about the scale of the associated phenomena. In particular all events are seen as synthetic processes consisting of coherent phenomena. Therefore, E4 Period is a superclass of E5 Event. For example, a modern clinical birth, an instance of E67 Birth, can be seen as both a single event, i.e. an instance of E5 Event, and as an extended period, i.e. an instance of E4 Period, that consists of multiple physical processes and complementary activities performed by multiple instances of E39 Actor.
E4 Period is a subclass of E2 Temporal Entity and of E92 Spacetime Volume. The latter is intended as a phenomenal spacetime volume as defined in CIDOC CRMgeo (Doerr &amp; Hiebel, 2013). By virtue of this multiple inheritance, it is possible to discuss the physical extent of an instance of E4 Period without representing each instance of it together with an instance of its associated spacetime volume. This model combines two quite different kinds of substance: an instance of E4 Period is a phenomenon while an instance of E92 Spacetime Volume is an aggregation of points in spacetime. However, the real spatiotemporal extent of an instance of E4 Period is regarded to be unique to it due to all its details and fuzziness; its identity and existence depends uniquely on the identity of the instance of E4 Period. Therefore, this multiple inheritance is unambiguous and effective and furthermore corresponds to the intuitions of natural language.
Typical use of this class in cultural heritage documentation is for documenting cultural and artistic periods. There are two different conceptualisations of ‘artistic style’, defined either by physical features or by historical context. For example, “Impressionism” can be viewed as a period in the European sphere of influence lasting from approximately 1870 to 1905 during which paintings with particular characteristics were produced by a group of artists that included (among others) Monet, Renoir, Pissarro, Sisley and Degas. Alternatively, it can be regarded as a style applicable to all paintings sharing the characteristics of the works produced by the Impressionist painters, regardless of historical context. The first interpretation is an instance of E4 Period, and the second defines morphological object types that fall under E55 Type.
A geopolitical unit as a specific case of an instance of E4 Period is the set of activities and phenomena related to the claim of power, the consequences of belonging to a jurisdictional area and an administrative system that establishes a geopolitical unit. Examples from the modern period are countries or administrative areas of countries such as districts whose actions and structures define activities and phenomena in the area that they intend to govern. The borders of geopolitical units are often defined in contracts or treaties although they may deviate from the actual practice. The spatiotemporal properties of Geopolitical units can be modelled through the properties inherited from E92 Spacetime Volume.
Another specific case of an instance of E4 Period is the actual extent of the set of activities and phenomena as evidenced by their physical traces that define a settlement, such as the populated period of Nineveh.

Examples:
- Jurassic (Hallam, 1975)
- Populated Period of Nineveh
- Imperial Rome under Marcus Aurelius
- European Bronze Age (Harrison, 2004) 
- Italian Renaissance (Macdonald, 1992)
- Thirty Years War (Lee, 1991)
- Sturm und Drang (Berkoff, 2013)
- Cubism (Cox, 2000)
- The Capital of Russia (E4) [the capital of Russia in the sense of an administrative unit moved in historical times from Moscow to St Petersburg and then back to Moscow. This exemplifies an administrative unit changing place over time without temporal discontinuity]
- The settling activity of the community of Helsinki (a.k.a. Helsingfors) (E7) [the original settlement called Helsinki was located in the area of the modern airport. The community moved later to settle on the coast. This exemplifies a continued activity changing place over time without temporal discontinuity]
- Bronze Age (E4) [Bronze Age, in the sense of technological adoption, spread over disjoint areas including islands such as the British Isles without temporal discontinuity]
- Japan, the state (E4) [In 2021, the Japanese state as a political unit comprised in 6852 islands extending along the Pacific coast of Asia]

In First Order Logic:
- E4(x) ⇒ E2(x)
- E4(x) ⇒ E92(x)"""@en .

crm:E6_Destruction a owl:Class ;
    rdfs:label "Destruction"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises events that destroy one or more instances of E18 Physical Thing, such that they lose their identity as the subjects of documentation.
Some destruction events are intentional, while others are independent of human activity. Intentional destruction can be documented by classifying the event as both an instance of E6 Destruction and of E7 Activity. 
The decision to document an object as destroyed, transformed, or modified is context-sensitive: 
1. If the matter remaining from the destruction is not documented, the event is modelled solely as an instance of E6 Destruction. 
2. An event should also be documented using E81 Transformation if it results in the destruction of one or more objects and the simultaneous production of others using parts or material from the original. In this case, the new items have separate identities. Matter is preserved, but identity is not.
3. When the initial identity of the changed instance of E18 Physical Thing is preserved, the event should be documented as an instance of E11 Modification.

Examples:
- the destruction of Herculaneum by volcanic eruption in 79 AD (Camardo, 2013)
- the destruction of Nineveh (E6, E7) (River, 2016) 
- the breaking of a champagne glass yesterday by my dog (fictitious)

In First Order Logic:
- E6(x) ⇒ E64(x)"""@en .

hg:Consecration a owl:Class ;
    rdfs:label "Consecration"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:makesDeityPresent ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Deity ;
            owl:onProperty hg:makesDeityPresent ],
        crm:E7_Activity,
        prov:Activity,
        hg:RitualEvent ;
    skos:definition "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

hg:CustodyPeriod a owl:Class ;
    rdfs:label "Custody Period"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:custodyOpenedBy ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:custodyHolder ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:custodyClosedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E10_Transfer_of_Custody ;
            owl:onProperty hg:custodyOpenedBy ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:custodyHolder ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:custodyObject ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E10_Transfer_of_Custody ;
            owl:onProperty hg:custodyClosedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:custodyObject ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:custodyHolder ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( hg:PhysicalHeritageThing crm:E22_Human-Made_Object ) ] hg:AssertionSubject ) ] ;
            owl:onProperty hg:custodyObject ],
        hg:Tenure ;
    skos:broadMatch crm:E4_Period ;
    skos:definition "Dated period during which an actor (typically a Guthi) holds custody of a heritage structure or object, opened and closed by transfer-of-custody events. Unlike the untimed crm:P50i_is_current_keeper_of, it answers who held custody at a given date."@en ;
    skos:editorialNote "Design note: PROV placement: a prov:Entity, i.e. a thing whose provenance is tracked (sources, attributions, assertions about it), and a crm:E4_Period (stated, 1.1.0). A period is not a crm:E7_Activity, so the class stays outside any E7 ⊑ prov:Activity alignment and the PROV-O Entity/Activity disjointness is not engaged; reasoning with CIDOC-CRM, CRMinf, CRMsci and PROV-O loaded is consistent with the example data."@en ;
    skos:inScheme hg:schema .

hg:KumariEnthronementEvent a owl:Class ;
    rdfs:label "Kumari Enthronement Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:boundsTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariTenure ;
            owl:onProperty hg:boundsTenure ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:confersRole ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:boundsTenure ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:confersRole ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:enthronedPerson ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:enthronedPerson ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty hg:enthronedPerson ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariRole ;
            owl:onProperty hg:confersRole ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        hg:KumariLifecycleEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Ritual installing a selected girl into the Kumari role and residence, activating the tenure (distinct from selection, which chooses her, and retirement, which ends it)."@en ;
    skos:inScheme hg:schema .

hg:KumariLifecycleEvent a owl:Class ;
    rdfs:label "Kumari Lifecycle Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:boundsTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariTenure ;
            owl:onProperty hg:boundsTenure ],
        hg:RitualEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Abstract event that bounds a KumariTenure (selection, enthronement, or retirement). Each concrete subclass requires exactly one tenure edge via slot_usage: hg:initiatedTenure (selection), hg:endedTenureOf (retirement), or hg:boundsTenure itself (enthronement)."@en ;
    skos:inScheme hg:schema .

hg:PhysicalHeritageThing a owl:Class ;
    rdfs:label "Physical Heritage Thing"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf prov:Entity ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( hg:ArchitecturalStructure hg:IconographicObject hg:ArchitecturalElement ) ] ;
    skos:definition "Union of the tangible heritage classes: architectural structures, iconographic objects, and standalone architectural elements. Used as the range of slots that apply to any physical heritage thing (production, custody, condition assessment)."@en ;
    skos:inScheme hg:schema .

hg:ReligiousStructure a owl:Class ;
    rdfs:label "Religious Structure"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:ArchitecturalStructure ;
    skos:definition "Architectural structure whose defining purpose is religious: enshrines a deity and/or is a locus of ritual activation. Abstract grouping for sacred structures across traditions (temple, stupa, chaitya)."@en ;
    skos:inScheme hg:schema .

hg:SyncreticRelationship a owl:Class ;
    rdfs:label "Syncretic Relationship"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P140_assigned_attribute_to ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DataSource ;
            owl:onProperty hg:mentionedInSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:syncreticType ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:SyncreticType ;
            owl:onProperty hg:syncreticType ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P141_assigned ],
        crm:E13_Attribute_Assignment,
        prov:Activity ;
    skos:definition "The act of identifying one deity with another across theological frameworks (a CIDOC-CRM E13 Attribute Assignment: P140 the deity identified, P141 the deity it is identified with), recorded with the source that reports it (hg:mentionedInSource)."@en ;
    skos:inScheme hg:schema .

hg:endedTenureOf a owl:ObjectProperty ;
    rdfs:label "Ended tenure of"@en ;
    schema:domainIncludes hg:KumariRetirementEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariTenure ;
    rdfs:subPropertyOf hg:boundsTenure ;
    owl:inverseOf hg:retiredThrough ;
    skos:definition "Points from a KumariRetirementEvent to the tenure that it terminated. Enables reconstruction of the complete Kumari lifecycle."@en ;
    skos:inScheme hg:schema .

hg:hasArchitecturalStyle a owl:ObjectProperty ;
    rdfs:label "Has architectural style"@en ;
    schema:domainIncludes hg:ArchitecturalStructure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:ArchitecturalStyle ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Architectural style classification."@en ;
    skos:inScheme hg:schema .

hg:initiatedTenure a owl:ObjectProperty ;
    rdfs:label "Initiated tenure"@en ;
    schema:domainIncludes hg:KumariSelectionEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariTenure ;
    rdfs:subPropertyOf hg:boundsTenure ;
    owl:inverseOf hg:selectedThrough ;
    skos:definition "Kumari tenure that was initiated by this selection event."@en ;
    skos:inScheme hg:schema .

<https://cair-nepal.org/heritagegraph/scheme/ConditionType> a skos:ConceptScheme ;
    rdfs:label "Condition Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for the physical condition of heritage objects and structures."@en ;
    skos:prefLabel "Condition Type (concept scheme)"@en .

<https://cair-nepal.org/heritagegraph/scheme/EndowmentEventType> a skos:ConceptScheme ;
    rdfs:label "Endowment Event Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for events in the life of a Guthi endowment."@en ;
    skos:prefLabel "Endowment Event Type (concept scheme)"@en .

<https://cair-nepal.org/heritagegraph/scheme/SyncreticType> a skos:ConceptScheme ;
    rdfs:label "Syncretic Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for kinds of syncretic theological relationships between deities."@en ;
    skos:prefLabel "Syncretic Type (concept scheme)"@en .

hg:tenureClosedBy a owl:ObjectProperty ;
    rdfs:label "Tenure closed by"@en ;
    schema:domainIncludes hg:Tenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:TenureEvent ;
    skos:definition "Event that closed the tenure (e.g. a retirement, a death, a transfer of custody)."@en ;
    skos:inScheme hg:schema .

hg:tenureOpenedBy a owl:ObjectProperty ;
    rdfs:label "Tenure opened by"@en ;
    schema:domainIncludes hg:Tenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:TenureEvent ;
    skos:definition "Event that opened the tenure (e.g. an enthronement, an appointment, a transfer of custody)."@en ;
    skos:inScheme hg:schema .

skos:editorialNote a owl:AnnotationProperty .

hg:ConditionType a owl:Class ;
    rdfs:label "Condition Type"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/ConditionType#Good> <https://cair-nepal.org/heritagegraph/ConditionType#Damaged> <https://cair-nepal.org/heritagegraph/ConditionType#Ruined> <https://cair-nepal.org/heritagegraph/ConditionType#Restored> ) ;
    skos:definition "Controlled vocabulary for the physical condition of heritage objects and structures."@en ;
    skos:inScheme hg:schema .

hg:Endowment a owl:Class ;
    rdfs:label "Endowment"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:sustains ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P105_right_held_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty hg:endowedLand ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( hg:ArchitecturalStructure hg:RitualEvent hg:Office ) ] hg:AssertionSubject ) ] ;
            owl:onProperty hg:sustains ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        crm:E72_Legal_Object,
        prov:Entity ;
    skos:definition "Land, income or other property permanently dedicated to sustain a structure, a ritual or festival, or a sacred office, and held by a Guthi. The endowment, not the membership, is what makes a Guthi a trust."@en ;
    skos:inScheme hg:schema .

hg:IconographicObject a owl:Class ;
    rdfs:label "Iconographic Object"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:RitualEvent ;
            owl:onProperty hg:participatesInRitual ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:usedBy ],
        crm:E22_Human-Made_Object ;
    skos:broadMatch dbo:Artwork ;
    skos:definition "Sacred visual art objects that depict or embody deities through iconographic conventions."@en ;
    skos:inScheme hg:schema ;
    skos:relatedMatch crm:E36_Visual_Item .

hg:StructureType a owl:Class ;
    rdfs:label "Structure Type"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type,
        prov:Entity ;
    skos:definition "A type of heritage structure from a controlled vocabulary or a community's own term list (a CIDOC-CRM E55 Type), e.g. the Newar bahah or bahi (Buddhist monastic courtyard), dyochhen (god-house), agam chhen (esoteric shrine house) or pitha (seat of a goddess). Link each term to AAT or Wikidata with SKOS mappings where an equivalent exists; local types need no new ontology class."@en ;
    skos:inScheme hg:schema .

hg:confersRole a owl:ObjectProperty ;
    rdfs:label "Confers role"@en ;
    schema:domainIncludes hg:KumariEnthronementEvent,
        hg:KumariSelectionEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariRole ;
    skos:definition "KumariRole conferred by this selection or enthronement event."@en ;
    skos:inScheme hg:schema .

<https://cair-nepal.org/heritagegraph/scheme/AccessProtocol> a skos:ConceptScheme ;
    rdfs:label "Access Protocol (concept scheme)"@en ;
    skos:definition "Cultural access protocol for heritage knowledge or a record of it, to be set with the community concerned."@en ;
    skos:prefLabel "Access Protocol (concept scheme)"@en .

<https://cair-nepal.org/heritagegraph/scheme/ArchitecturalStyle> a skos:ConceptScheme ;
    rdfs:label "Architectural Style (concept scheme)"@en ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type."@en ;
    skos:prefLabel "Architectural Style (concept scheme)"@en .

hg:tenureOffice a owl:ObjectProperty ;
    rdfs:label "Tenure office"@en ;
    schema:domainIncludes hg:Tenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:Office ;
    skos:definition "Office, role or duty held during the tenure."@en ;
    skos:inScheme hg:schema .

crm:E10_Transfer_of_Custody a owl:Class ;
    rdfs:label "Transfer of Custody"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises transfers of the physical custody or the legal responsibility for the physical custody of objects. The recording of the donor or recipient is optional. It is possible that in an instance of E10 Transfer of Custody there is either no donor or no recipient. 
Depending on the circumstances, it may describe: 
1. the beginning of custody (there is no previous custodian)
2. the end of custody (there is no subsequent custodian)
3. the transfer of custody (transfer from one custodian to the next)
4. the receipt of custody from an unknown source (the previous custodian is unknown)
5. the declared loss of an object (the current or subsequent custodian is unknown)
In the event that only a single kind of transfer of custody occurs, either the legal responsibility for the custody or the actual physical possession of the object but not both, this difference should be expressed using the property 
P2 has type (is type of).
The sense of physical possession requires that the object of custody be in the hands of the keeper at least with a part representative for the whole. The way, in which a representative part is defined, should ensure that it is unambiguous who keeps a part and who the whole and should be consistent with the identity criteria of the kept instance of E18 Physical Thing.
The interpretation of the museum notion of "accession" differs between institutions. The CIDOC CRM therefore models legal ownership and physical custody separately. Institutions will then model their specific notions of accession and deaccession as combinations of these. 
Theft is a specific case of illegal transfer of custody.

Examples:
- the delivery of the paintings by Secure Deliveries Inc. to the National Gallery
- the return of Picasso’s “Guernica” to Madrid’s Prado in 1981 (Chipp, 1988)
- the transfer of custody of the work described as “Von der Velden ein Ufer an der See” from Johann Matthäus von Merian to the Auction House Heldevier (Jacob) for the purpose of sale, ca. 1716
- the transfer of custody of the painting ‘Mrs. Fitzherbert’ to the art dealer Knoedler from Parke-Bernet Galleries (New York, NY, USA) ca. March 1941

In First Order Logic:
- E10(x) ⇒ E7(x)"""@en .

crm:E22_Human-Made_Object a owl:Class ;
    rdfs:label "Human-Made Object"@en ;
    rdfs:isDefinedBy crm: ;
    skos:closeMatch schema:CreativeWork ;
    skos:definition """Scope note:
This class comprises all persistent physical objects of any size that are purposely created by human activity and have physical boundaries that separate them completely in an objective way from other objects. 
The class also includes all aggregates of objects made for functional purposes of whatever kind, independent of physical coherence, such as a set of chessmen.

Examples:
- the Rosetta Stone (E22)
- LNER Class A4 4468 Mallard [the World’s fastest steam locomotive, preserved at the National Railway Museum of York, UK] (Solomon, 2003)
- the Portland Vase (Walker, 2004)

In First Order Logic:
- E22(x) ⇒ E19(x)
- E22(x) ⇒ E24(x)"""@en ;
    skos:narrowMatch wikidata:Q838948 .

hg:AccessProtocol a owl:Class ;
    rdfs:label "Access Protocol"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
    skos:definition "Cultural access protocol for heritage knowledge or a record of it, to be set with the community concerned."@en ;
    skos:inScheme hg:schema .

hg:EndowmentEvent a owl:Class ;
    rdfs:label "Endowment Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:concernsEndowment ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:endowmentDonor ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:endowmentEventType ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:concernsEndowment ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:endowmentRecipient ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:EndowmentEventType ;
            owl:onProperty hg:endowmentEventType ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Endowment ;
            owl:onProperty hg:concernsEndowment ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:endowmentEventType ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:endowmentRecipient ],
        crm:E8_Acquisition,
        prov:Activity ;
    skos:definition "Event that founds, augments, nationalises or alienates a Guthi endowment, with its donor or recipient and its date."@en ;
    skos:inScheme hg:schema .

hg:EndowmentEventType a owl:Class ;
    rdfs:label "Endowment Event Type"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/EndowmentEventType#Founding> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Augmentation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Nationalisation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Alienation> ) ;
    skos:definition "Controlled vocabulary for events in the life of a Guthi endowment."@en ;
    skos:inScheme hg:schema .

hg:KumariRole a owl:Class ;
    rdfs:label "Kumari Role"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:roleDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Deity ;
            owl:onProperty hg:roleDeity ],
        hg:RitualOffice ;
    skos:altLabel "Living Goddess"@en,
        "Royal Kumari"@en ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder."@en ;
    skos:inScheme hg:schema .

hg:SyncreticType a owl:Class ;
    rdfs:label "Syncretic Type"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> <https://cair-nepal.org/heritagegraph/SyncreticType#Appropriation> <https://cair-nepal.org/heritagegraph/SyncreticType#Fusion> <https://cair-nepal.org/heritagegraph/SyncreticType#Historical> ) ;
    skos:definition "Controlled vocabulary for kinds of syncretic theological relationships between deities."@en ;
    skos:inScheme hg:schema .

hg:TenureEvent a owl:Class ;
    rdfs:label "Tenure Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    skos:definition "An event that opens or closes a Tenure: a ritual (an enthronement, a retirement), a transfer of custody, an endowment event, a documentation or historical event, any other activity, or a death."@en ;
    skos:inScheme hg:schema .

<https://cair-nepal.org/heritagegraph/scheme/DatePrecision> a skos:ConceptScheme ;
    rdfs:label "Date Precision (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for the temporal precision of recorded heritage dates."@en ;
    skos:prefLabel "Date Precision (concept scheme)"@en .

crm:E74_Group a owl:Class ;
    rdfs:label "Group"@en ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E39_Actor ;
    skos:definition """Scope note:
This class comprises any gatherings or organizations of human individuals or groups that act collectively or in a similar way due to any form of unifying relationship. In the wider sense this class also comprises official positions which used to be regarded in certain contexts as one actor, independent of the current holder of the office, such as the president of a country. In such cases, it may happen that the group never had more than one member. A joint pseudonym (i.e. a name that seems indicative of an individual but that is actually used as a persona by two or more people) is a particular case of E74 Group.
A gathering of people becomes an instance of E74 Group when it exhibits organizational characteristics usually typified by a set of ideas or beliefs held in common, or actions performed together. These might be communication, creating some common artifact, a common purpose such as study, worship, business, sports, etc. Nationality can be modelled as membership in an instance of E74 Group. Married couples and other concepts of family are regarded as particular examples of E74 Group.

Examples:
- the Impressionists (Wilson, 1994)
- the Navajo (Correll, 1972)
- the Greeks (Williams, 1993)
- the peace protestors in New York City on 15(th) February 2003
- Exxon-Mobil (Raymond, 2006)
- King Solomon and his wives (Thieberger, 1947)
- the President of the Swiss Confederation
- Nicolas Bourbaki [the collective pseudonym of a group of mathematicians, predominantly French alumni of the École normale supérieure] (Aczel, 2007)
- Betty Crocker (Crocker, 2012)
- Ellery Queen [Ellery Queen is a pseudonym created in 1929 by American crime fiction writers Frederic Dannay and Manfred Bennington Lee.] (Wheat, 2005)
- Greenpeace
- Paveprime Ltd
- the National Museum of Denmark

In First Order Logic:
- E74(x) ⇒ E39(x)"""@en .

crm:P2_has_type a owl:ObjectProperty ;
    rdfs:label "has type"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Quantification: many to many (0,n:0,n)

Scope note:
This property allows sub-typing of CIDOC CRM entities –a form of specialisation – through the use of a terminological hierarchy, or thesaurus. 
The CIDOC CRM is intended to focus on the high-level entities and relationships needed to describe data structures. Consequently, it does not specialise entities any further than is required for this immediate purpose. However, entities in the isA hierarchy of the CIDOC CRM may by specialised into any number of sub-entities, which can be defined in the E55 Type hierarchy. E41 Appellation, for example, may be specialised into “e-mail address”, “telephone number”, “post office box”, “URL”, etc., none of which figures explicitly in the CIDOC CRM class hierarchy. A comprehensive explanation about refining CIDOC CRM concepts by E55 Type is given in the section “About Types” in the section on “Specific Modelling Constructs” of this document.
This property is a shortcut for the path from E1 CRM Entity through P41i was classified by, E17 Type Assignment, P42 assigned to E55 Type.

Examples:
- “enquiries@cidoc-crm.org” (E41) has type e-mail address (E55). (fictitious)

In First Order Logic:
- P2(x,y) ⇒ E1(x)
- P2(x,y) ⇒ E55(y)
- P2(x,y) ⇐ (∃z) [E17(z)] ˄ P41i(x,z) ˄ P42(z,y)]"""@en .

hg:CalendarSystem a owl:Class ;
    rdfs:label "Calendar System"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hg:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:epochDateGregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:integer ;
            owl:onProperty hg:yearOffsetFromGregorian ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ReligiousTradition ;
            owl:onProperty hg:isPrimaryForTradition ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:yearOffsetFromGregorian ],
        prov:Entity ;
    skos:broadMatch time:TRS ;
    skos:definition "Calendar reckoning system with conversion rules for multi-calendar temporal reasoning."@en ;
    skos:inScheme hg:schema .

hg:DatePrecision a owl:Class ;
    rdfs:label "Date Precision"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/DatePrecision#Exact> <https://cair-nepal.org/heritagegraph/DatePrecision#Year> <https://cair-nepal.org/heritagegraph/DatePrecision#Month> <https://cair-nepal.org/heritagegraph/DatePrecision#Decade> <https://cair-nepal.org/heritagegraph/DatePrecision#Century> <https://cair-nepal.org/heritagegraph/DatePrecision#Circa> ) ;
    skos:definition "Controlled vocabulary for the temporal precision of recorded heritage dates."@en ;
    skos:inScheme hg:schema .

hg:Enshrinement a owl:Class ;
    rdfs:label "Enshrinement"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:enshrinedDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:enshrinedInStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Temple ;
            owl:onProperty hg:enshrinedInStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Deity ;
            owl:onProperty hg:enshrinedDeity ],
        crm:E7_Activity,
        prov:Activity,
        hg:RitualEvent ;
    skos:definition "Event of installing a deity's murti or symbol within a temple sanctum."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

hg:Proposition a owl:Class ;
    rdfs:label "Proposition"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:propositionObjectEntity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:propositionSubject ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty hg:propositionPredicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:AssertionSubject ;
            owl:onProperty hg:propositionSubject ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:propositionLiteralValue ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:propositionPredicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdfs:Literal ;
            owl:onProperty hg:propositionLiteralValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:AssertionSubject ;
            owl:onProperty hg:propositionObjectEntity ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:propositionPredicate ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:propositionSubject ],
        crminf:I4_Proposition_Set,
        prov:Entity ;
    skos:closeMatch rdf:Statement ;
    skos:definition "A single machine-readable proposition (subject - predicate - object) held true by an Assertion. Modelled as a singleton proposition set (CRMinf I4); the predicate is a URI/CURIE, the object either a heritage entity or a literal."@en ;
    skos:inScheme hg:schema .

hg:boundsTenure a owl:ObjectProperty ;
    rdfs:label "Bounds tenure"@en ;
    schema:domainIncludes hg:KumariLifecycleEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:KumariTenure ;
    skos:definition "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by hg:initiatedTenure (selection) and hg:endedTenureOf (retirement)."@en ;
    skos:inScheme hg:schema .

<https://cair-nepal.org/heritagegraph/scheme/ExistenceStatus> a skos:ConceptScheme ;
    rdfs:label "Existence Status (concept scheme)"@en ;
    skos:definition "Controlled vocabulary for whether a heritage structure still exists physically."@en ;
    skos:prefLabel "Existence Status (concept scheme)"@en .

hg:tenureHolder a owl:ObjectProperty ;
    rdfs:label "Tenure holder"@en ;
    schema:domainIncludes hg:Tenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Actor holding the office, duty or custody during the tenure."@en ;
    skos:inScheme hg:schema .

crm:E52_Time-Span a owl:Class ;
    rdfs:label "Time-Span"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises abstract temporal extents, in the sense of Galilean physics, having a beginning, an end, and a duration. 
Instances of E52 Time-Span have no semantic connotations about phenomena happening within the temporal extent they represent. They do not convey any meaning other than a positioning on the “time-line” of chronology. The actual extent of an instance of E52 Time-Span can be approximated by properties of E52 Time-Span giving inner and outer bounds in the form of dates (instances of E61 Time Primitive). Comparing knowledge about time-spans is fundamental for chronological reasoning.
Some instances of E52 Time-Span may be defined as the actual, in principle observable, temporal extent of instances of E2 Temporal Entity via the property P4 has time-span (is time-span of): E52 Time-Span. They constitute phenomenal time-spans as defined in CRMgeo (Doerr &amp; Hiebel 2013). Since our knowledge of history is imperfect and physical phenomena are fuzzy in nature, the extent of phenomenal time-spans can only be described in approximation. An extreme case of approximation, might, for example, define an instance of E52 Time-Span having unknown beginning, end and duration. It may, nevertheless, be associated with other descriptions by which people can infer knowledge about it, such as in relative chronologies.
Some instances of E52 may be defined precisely as representing a declaration of a temporal extent, as, for instance, done in a business contract. They constitute declarative time-spans as defined in CRMgeo (Doerr &amp; Hiebel 2013) and can be described via the property E61 Time Primitive P170 defines time (time is defined by): E52 Time-Span. 
When used as a common E52 Time-Span for two events, it will nevertheless describe them as being simultaneous, even if nothing else is known.

Examples:
- 1961
- From 12-17-1993 to 12-8-1996
- 14h30 to 16h22 4(th) July 1945
- 9.30 am 1.1.1999 to 2.00 pm 1.1.1999
- the time-span of the Ming Dynasty (Chan, 2011)

In First Order Logic:
- E52(x) ⇒ E1(x)"""@en .

hg:ArchitecturalStyle a owl:Class ;
    rdfs:label "Architectural Style"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type."@en ;
    skos:inScheme hg:schema .

hg:CasteGroup a owl:Class ;
    rdfs:label "Caste Group"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:traditionalRole ],
        crm:E74_Group ;
    skos:broadMatch prov:Organization ;
    skos:definition "Hereditary social group (Jati) with specific ritual roles and occupational duties."@en ;
    skos:inScheme hg:schema .

hg:HereditaryRoleTenure a owl:Class ;
    rdfs:label "Hereditary Role Tenure"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:roleDuty ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:TenureEvent ;
            owl:onProperty hg:tenureClosedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E74_Group ;
            owl:onProperty hg:mandatedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:succeeds ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:roleHolder ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:mandatedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( crm:E21_Person hg:CasteGroup ) ] crm:E39_Actor ) ] ;
            owl:onProperty hg:roleHolder ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:roleDuty ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:TenureEvent ;
            owl:onProperty hg:tenureOpenedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:tenureOffice ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:RitualOffice ;
            owl:onProperty hg:tenureOffice ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:RitualEvent ;
            owl:onProperty hg:dutyFor ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:roleHolder ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:successionRule ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:HereditaryRoleTenure ;
            owl:onProperty hg:succeeds ],
        hg:Tenure ;
    skos:altLabel "Hereditary ritual office"@en ;
    skos:broadMatch crm:E4_Period ;
    skos:definition "Time-bounded holding of a hereditary ritual duty by a person or caste group, under the mandate of a Guthi, with the rule by which the duty passes on. The same period pattern as KumariTenure, applied to hereditary offices (priests, chariot builders, musicians)."@en ;
    skos:editorialNote "Design note: PROV placement: a prov:Entity, i.e. a thing whose provenance is tracked (sources, attributions, assertions about it), and a crm:E4_Period (stated, 1.1.0). A period is not a crm:E7_Activity, so the class stays outside any E7 ⊑ prov:Activity alignment and the PROV-O Entity/Activity disjointness is not engaged; reasoning with CIDOC-CRM, CRMinf, CRMsci and PROV-O loaded is consistent with the example data."@en ;
    skos:inScheme hg:schema .

hg:Office a owl:Class ;
    rdfs:label "Office"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type,
        prov:Entity ;
    skos:definition "An office, role or duty that persons or groups hold for a period (a CIDOC-CRM E55 Type): the office is the type, a Tenure is the dated holding of it, the holder is the actor."@en ;
    skos:inScheme hg:schema .

hg:ReligiousTradition a owl:Class ;
    rdfs:label "Religious Tradition"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type,
        prov:Entity ;
    skos:definition "Religious or philosophical tradition (e.g., Hindu, Buddhist, Syncretic)."@en ;
    skos:exactMatch aat:300073708 ;
    skos:inScheme hg:schema .

<https://cair-nepal.org/heritagegraph/scheme/GuthiType> a skos:ConceptScheme ;
    rdfs:label "Guthi Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)."@en ;
    skos:prefLabel "Guthi Type (concept scheme)"@en .

hg:ExistenceStatus a owl:Class ;
    rdfs:label "Existence Status"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
    skos:definition "Controlled vocabulary for whether a heritage structure still exists physically."@en ;
    skos:inScheme hg:schema .

hg:KumariSelectionEvent a owl:Class ;
    rdfs:label "Kumari Selection Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:initiatedTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty hg:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:SelectionCriterion ;
            owl:onProperty hg:hasCriterion ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariTenure ;
            owl:onProperty hg:initiatedTenure ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:isCriticalForFestival ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:initiatedTenure ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariRole ;
            owl:onProperty hg:confersRole ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:confersRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( hg:Guthi hg:CasteGroup ) ] crm:E39_Actor ) ] ;
            owl:onProperty hg:performedByGroup ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:selectedPerson ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty hg:selectedPerson ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:selectedPerson ],
        hg:KumariLifecycleEvent ;
    skos:broadMatch crm:E7_Activity,
        prov:Activity ;
    skos:definition "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana) and horoscope matching with the city and ruling authority, carried out, in published accounts, by the priests of Taleju and the Buddhist Vajracharya priests with an astrologer. Accounts of a fearlessness test are disputed and are recorded as such with FearlessnessAssessment, not stated here."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

hg:Tenure a owl:Class ;
    rdfs:label "Tenure"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:tenureOffice ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:TenureEvent ;
            owl:onProperty hg:tenureClosedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:tenureHolder ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:tenureHolder ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Office ;
            owl:onProperty hg:tenureOffice ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:TenureEvent ;
            owl:onProperty hg:tenureOpenedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        crm:E4_Period,
        prov:Entity ;
    skos:definition "A dated period during which an actor holds an office, a duty or custody of something (a CIDOC-CRM E4 Period), with the events that open and close it. KumariTenure, HereditaryRoleTenure and CustodyPeriod are specialisations; the pattern applies to offices and custody beyond Nepal."@en ;
    skos:inScheme hg:schema .

hg:documentedBy a owl:ObjectProperty ;
    rdfs:label "Was documented by"@en ;
    rdfs:domain hg:AssertionSubject ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:DocumentationActivity ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf hg:documents ;
    skos:closeMatch crmsci:O8i_was_observed_by ;
    skos:definition "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it."@en ;
    skos:editorialNote "PROV-O alignment: prov:wasInfluencedBy"@en ;
    skos:inScheme hg:schema .

crm:E7_Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises actions intentionally carried out by instances of E39 Actor that result in changes of state in the cultural, social, or physical systems documented. 
This notion includes complex, composite, and long-lasting actions such as the building of a settlement or a war, as well as simple, short-lived actions such as the opening of a door.

Examples:
- the Battle of Stalingrad (Hoyt, 1993)
- the Yalta Conference (Harbutt, 2010)
- my birthday celebration 28-6-1995
- the writing of “Faust” by Goethe (E65) (Williams, 2020)
- the formation of the Bauhaus 1919 (E66) (Droste, 2006)
- the people of Iraq giving the name ‘Quyunjig’ to the place identified by the TGN as ‘7017998’
- Kira Weber working in glass art from 1984 to 1993
- Kira Weber working in oil and pastel painting from 1993

In First Order Logic:
- E7(x) ⇒ E5(x)"""@en .

skos:ConceptScheme a owl:Class .

hg:GuthiType a owl:Class ;
    rdfs:label "Guthi Type"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/GuthiType#SiGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#JatraGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#PujaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#TempleGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#NashaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#RajGuthi> ) ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)."@en ;
    skos:inScheme hg:schema .

hg:SelectionCriterion a owl:Class ;
    rdfs:label "Selection Criterion"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type,
        prov:Entity ;
    skos:definition "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text. Ethics: candidates are children. Criteria describe the tradition; data about how a named or identifiable child met them (bodily marks, health, horoscope) must not be recorded."@en ;
    skos:inScheme hg:schema .

hg:Guthi a owl:Class ;
    rdfs:label "Guthi"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hg:GuthiType ;
            owl:onProperty hg:guthiType ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:guthiType ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:RitualEvent ;
            owl:onProperty hg:performsRitual ],
        crm:E74_Group ;
    skos:broadMatch prov:Organization ;
    skos:definition "Endowed trust organization unique to Nepal, managing temples, rituals, and land through hereditary or voluntary membership."@en ;
    skos:inScheme hg:schema .

crm:E53_Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises extents in the natural space where people live, in particular on the surface of the Earth, in the pure sense of physics: independent from temporal phenomena and matter. They may serve describing the physical location of things or phenomena or other areas of interest. Geometrically, instances of E53 Place constitute single contiguous areas or a finite aggregation of disjoint areas in space which are each individually contiguous. They may have fuzzy boundaries.
The instances of E53 Place are usually determined by reference to the position of “immobile” objects such as buildings, cities, mountains, rivers, or dedicated geodetic marks, but may also be determined by reference to mobile objects. A Place can be determined by combining a frame of reference and a location with respect to this frame.
It is sometimes argued that instances of E53 Place are best identified by global coordinates or absolute reference systems. However, relative references are often more relevant in the context of cultural documentation and tend to be more precise. In particular, people are often interested in position in relation to large, mobile objects, such as ships. For example, the Place at which Nelson died is known with reference to a large mobile object, i.e. H.M.S Victory. A resolution of this Place in terms of absolute coordinates would require knowledge of the movements of the vessel and the precise time of death, either of which may be revised, and the result would lack historical and cultural relevance.
Any instance of E18 Physical Thing can serve as a frame of reference for an instance of E53 Place. This may be documented using the property P157 is at rest relative to (provides reference space for).

Examples:
- the extent of the UK in the year 2003
- the position of the hallmark on the inside of my wedding ring (fictitious)
- the place referred to in the phrase: “Fish collected at three miles north of the confluence of the Arve and the Rhone”
- here -&gt; &lt;- [the place between these two arrows in one of the reader's paper copy of this document. Each copy constitutes a different place of this spot.]

In First Order Logic:
- E53(x) ⇒ E1(x)"""@en .

hg:hasAssertion a owl:ObjectProperty ;
    rdfs:label "Has assertion"@en ;
    rdfs:domain hg:AssertionSubject ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crminf:I2_Belief ;
    owl:inverseOf hg:assertsAbout ;
    skos:definition "Provenance-bearing assertion made about this entity or event."@en ;
    skos:inScheme hg:schema .

prov:Entity a owl:Class ;
    rdfs:label "Entity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    skos:definition "An entity is a physical, digital, conceptual, or other kind of thing with some fixed aspects; entities may be real or imaginary."@en .

hg:AssertionSubject a owl:Class ;
    rdfs:label "Assertion Subject"@en ;
    rdfs:isDefinedBy hg:ontology ;
    skos:broadMatch crm:E1_CRM_Entity ;
    skos:definition "Any HeritageGraph entity or event that may be the subject of an assertion."@en ;
    skos:inScheme hg:schema .

crm:E55_Type a owl:Class ;
    rdfs:label "Type"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises concepts denoted by terms from thesauri and controlled vocabularies used to characterize and classify instances of CIDOC CRM classes. Instances of E55 Type represent concepts, in contrast to instances of E41 Appellation which are used to name instances of CIDOC CRM classes. 
E55 Type provides an interface to domain specific ontologies and thesauri. These can be represented in the CIDOC CRM as subclasses of E55 Type, forming hierarchies of terms, i.e. instances of E55 Type linked via P127 has broader term (has narrower term): E55 Type. Such hierarchies may be extended with additional properties.

Examples:
- weight, length, depth [types for instances of E54 Dimension]
- portrait, sketch, animation [types for instances of E36 Visual Item]
- French, English, German [types for instances of E56 Language]
- excellent, good, poor [types for instances of E3 Condition State]
- Ford Model T, chop stick [types for instances of E22 Human-Made Object]
- cave, doline, scratch [types for instances of E26 Physical Feature]
- poem, short story [types for instances of E33 Linguistic Object]
- wedding, earthquake, skirmish [types for instances of E5 Event]

In First Order Logic:
- E55(x) ⇒ E28(x)"""@en .

prov:Activity a owl:Class ;
    rdfs:label "Activity" ;
    rdfs:isDefinedBy <http://www.w3.org/ns/prov-o#> ;
    skos:definition "An activity is something that occurs over a period of time and acts upon or with entities; it may include consuming, processing, transforming, modifying, relocating, using, or generating entities." .

crm:E21_Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:isDefinedBy crm: ;
    rdfs:subClassOf crm:E39_Actor ;
    skos:broadMatch prov:Person ;
    skos:definition """Scope note:
This class comprises real persons who live or are assumed to have lived. 
Legendary figures that may have existed, such as Ulysses and King Arthur, fall into this class if the documentation refers to them as historical figures. In cases where doubt exists as to whether several persons are in fact identical, multiple instances can be created and linked to indicate their relationship. The CIDOC CRM does not propose a specific form to support reasoning about possible identity.
In a bibliographic context, a name presented following the conventions usually employed for personal names will be assumed to correspond to an actual real person (an instance of E21 Person), unless evidence is available to indicate that this is not the case. The fact that a persona may erroneously be classified as an instance of E21 Person does not imply that the concept comprises personae.

Examples:
- Tut-Ankh-Amun (Edwards and Boltin, 1979)
- Nelson Mandela (Brown and Hort, 2006)

In First Order Logic:
- E21(x) ⇒ E20(x)
- E21(x) ⇒ E39(x)"""@en .

hg:KumariTenure a owl:Class ;
    rdfs:label "Kumari Tenure"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:selectedThrough ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:assumesRole ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:tenureHolder ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E74_Group ;
            owl:onProperty hg:supportedByInstitution ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Deity ;
            owl:onProperty hg:embodiedDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:residenceStructure ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:tenureHolder ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:embodiedDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariRetirementEvent ;
            owl:onProperty hg:retiredThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:hadParticipant ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:residenceStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariSelectionEvent ;
            owl:onProperty hg:selectedThrough ],
        [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariEnthronementEvent ;
            owl:onProperty hg:enthronedThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:KumariRole ;
            owl:onProperty hg:assumesRole ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:embodiedDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty hg:tenureHolder ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:enthronedThrough ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:retiredThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ArchitecturalStructure ;
            owl:onProperty hg:residenceStructure ],
        hg:Tenure ;
    skos:altLabel "Living Goddess Tenure"@en ;
    skos:broadMatch crm:E4_Period ;
    skos:definition "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families."@en ;
    skos:editorialNote "Design note: PROV placement: a prov:Entity, i.e. a thing whose provenance is tracked (sources, attributions, assertions about it), and a crm:E4_Period (stated, 1.1.0). A period is not a crm:E7_Activity, so the class stays outside any E7 ⊑ prov:Activity alignment and the PROV-O Entity/Activity disjointness is not engaged; reasoning with CIDOC-CRM, CRMinf, CRMsci and PROV-O loaded is consistent with the example data."@en ;
    skos:inScheme hg:schema .

hg:DataSource a owl:Class ;
    rdfs:label "Data Source"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:sourceCitation ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:identifierScheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hg:identifierScheme ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:sourcePublisher ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:sourceUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hg:sourceUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hg:persistentIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty hg:resourceType ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:publicationTimespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:sourcePublisher ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:resourceType ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:persistentIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:sourceCreator ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty hg:publicationTimespan ],
        crm:E73_Information_Object,
        prov:Entity ;
    skos:definition "Original source from which heritage information was derived."@en ;
    skos:inScheme hg:schema .

hg:DocumentationActivity a owl:Class ;
    rdfs:label "Documentation Activity"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:usedEquipment ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:AssertionSubject ;
            owl:onProperty hg:documents ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:usedMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        crm:E7_Activity,
        prov:Activity ;
    skos:definition "Activity that records information about a heritage entity or event and may generate information objects or assertions. It aligns CIDOC CRM documentation practices with prov:Activity."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

hg:Deity a owl:Class ;
    rdfs:label "Deity"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hg:Enshrinement ;
            owl:onProperty hg:isEnshrinedThroughEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:RitualEvent ;
            owl:onProperty hg:isInvokedInRitual ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ReligiousTradition ;
            owl:onProperty hg:hasReligiousTradition ],
        prov:Entity ;
    skos:broadMatch crm:E28_Conceptual_Object ;
    skos:closeMatch dbo:Deity,
        aat:300343850,
        wikidata:Q178885 ;
    skos:definition "Divine conceptual entity in Hindu, Buddhist, or syncretic traditions. Distinct from physical representations (Murti) and ritual presences."@en ;
    skos:inScheme hg:schema .

<https://cair-nepal.org/heritagegraph/scheme/RitualType> a skos:ConceptScheme ;
    rdfs:label "Ritual Type (concept scheme)"@en ;
    skos:definition "Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage."@en ;
    skos:prefLabel "Ritual Type (concept scheme)"@en .

crm:P4_has_time-span a owl:ObjectProperty ;
    rdfs:label "has time-span"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Quantification: many to one, necessary (1,1:0,n)

Scope note:
This property associates an instance of E2 Temporal Entity with the instance of E52 Time-Span during which it was on-going. The associated instance of E52 Time-Span is understood as the real time-span during which the phenomena making up the temporal entity instance were active. More than one instance of E2 Temporal Entity may share a common instance of E52 Time-Span only if they come into being and end being due to identical declarations or events.

Examples:
- The Yalta Conference (E7) has time-span Yalta Conference time-span (E52). (Harbutt, 2010)

In First Order Logic:
- P4(x,y) ⇒ E2(x)
- P4(x,y) ⇒ E52(y)"""@en .

crminf:I2_Belief a owl:Class ;
    rdfs:label "Belief"@en ;
    rdfs:isDefinedBy crminf: ;
    skos:closeMatch schema:Claim ;
    skos:definition "This class comprises the notion that the associated I4 Proposition Set is held to have a particular I6 Belief Value by a particular E39 Actor. This can be understood as the period of time that an individual group holds a particular set of propositions to be true, false, or somewhere in between."@en ;
    skos:relatedMatch prov:Entity .

hg:ArchitecturalStructure a owl:Class ;
    rdfs:label "Architectural Structure"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hg:StructureType ;
            owl:onProperty hg:structureType ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ArchitecturalStyle ;
            owl:onProperty hg:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:lastKnownExistenceDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Guthi ;
            owl:onProperty hg:managedByGuthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ReligiousTradition ;
            owl:onProperty hg:hasReligiousTradition ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:destructionEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty hg:hypothesizedLocation ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E6_Destruction ;
            owl:onProperty hg:destructionEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DataSource ;
            owl:onProperty hg:mentionedInSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:ExistenceStatus ;
            owl:onProperty hg:existenceStatus ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty hg:lastKnownExistenceDate ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:existenceStatus ],
        crm:E22_Human-Made_Object ;
    skos:closeMatch schema:Place ;
    skos:definition "Physical structures built for religious, social, or civic purposes. Links to events of production, use, custody, and documentation."@en ;
    skos:exactMatch wikidata:Q811979 ;
    skos:inScheme hg:schema .

hg:RitualType a owl:Class ;
    rdfs:label "Ritual Type"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf crm:E55_Type ;
    owl:oneOf ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
    skos:definition "Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage."@en ;
    skos:editorialNote "Design note: RitualType currently mixes three orthogonal axes: worship-frequency (NityaPuja/NaimittikaPuja/KamyaPuja), ritual form (Homa/Jatra/MaskedPerformance), and lifecycle (InstallationRitual/ReturningRitual). Consider splitting into RitualFrequency + RitualForm. Also: Circumambulation/ProcessionalMovement/ProcessionRitual/RelicTour overlap with RitualEvent.hg:routePlaces/hg:startPlace/hg:endPlace/hg:routeDescription -- pick one canonical mechanism for moving rituals."@en ;
    skos:inScheme hg:schema .

crm:E39_Actor a owl:Class ;
    rdfs:label "Actor"@en ;
    rdfs:isDefinedBy crm: ;
    skos:definition """Scope note:
This class comprises people, either individually or in groups, who have the potential to perform intentional actions of kinds for which they can be held responsible.

Examples:
- London and Continental Railways (E74)
- the Governor of the Bank of England in 1975 (E21)
- Sir Ian McKellen (E21) (Gibson, 1986)

In First Order Logic:
- E39(x) ⇒ E77(x)"""@en .

hg:RitualEvent a owl:Class ;
    rdfs:label "Ritual Event"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty hg:startPlace ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:ritualType ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:endPlace ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty hg:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty hg:routePlaces ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty hg:hadParticipant ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:RitualType ;
            owl:onProperty hg:ritualType ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:recurrencePattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Deity ;
            owl:onProperty hg:invokesDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hg:startPlace ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty hg:endPlace ],
        [ a owl:Restriction ;
            owl:allValuesFrom hg:Guthi ;
            owl:onProperty hg:managedByGuthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( hg:Guthi hg:CasteGroup ) ] crm:E39_Actor ) ] ;
            owl:onProperty hg:performedByGroup ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:routeDescription ],
        [ a owl:Restriction ;
            owl:allValuesFrom rdf:PlainLiteral ;
            owl:onProperty hg:lunarDateTithi ],
        crm:E7_Activity,
        prov:Activity ;
    skos:definition "Intentional ritual activity that activates sacred space, invokes deities, and binds social groups. An instance is one dated occurrence (one CIDOC-CRM E7 with at most one time-span), e.g. the Indra Jatra of 2025; the recurring practice it belongs to (annual, by lunar date) is described by hg:recurrencePattern and hg:lunarDateTithi, not by the instance's time-span."@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme hg:schema .

skos:Concept a owl:Class .

hg:schema a skos:ConceptScheme ;
    rdfs:label "HeritageGraph LinkML schema"@en ;
    skos:definition "The LinkML schema from which this ontology is generated; every generated term is skos:inScheme it."@en .

hg:ontology a owl:Ontology ;
    rdfs:label "HeritageGraph"@en ;
    dcterms:bibliographicCitation "Karki, N., Oli, N., Sapkota, A., Chhetri, T. R., & Yumusak, S. (2026). HeritageGraph Ontology (Version 1.0.1). CAIR-Nepal. https://doi.org/10.5281/zenodo.23435676" ;
    dcterms:created "2025-11-23"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0002-3905-7878>,
        <https://orcid.org/0000-0002-8878-4991>,
        <https://orcid.org/0009-0000-7679-0107>,
        <https://orcid.org/0009-0004-5297-5990>,
        <https://orcid.org/0009-0007-3770-4668> ;
    dcterms:description "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning."@en ;
    dcterms:issued "2026-10-17"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-26"^^xsd:date ;
    dcterms:publisher "CAIR-Nepal" ;
    dcterms:source <https://github.com/CAIRNepal/heritagegraphontology> ;
    dcterms:title "HeritageGraph Ontology"@en ;
    bibo:doi "10.5281/zenodo.23435676" ;
    bibo:status "Published" ;
    pav:version "1.0.1" ;
    vann:preferredNamespacePrefix "hg" ;
    vann:preferredNamespaceUri "https://cair-nepal.org/heritagegraph/" ;
    owl:priorVersion <https://cair-nepal.org/heritagegraph/ontology/1.0.0> ;
    owl:versionIRI <https://cair-nepal.org/heritagegraph/ontology/1.0.1> ;
    owl:versionInfo "1.0.1" ;
    skos:definition "An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning."@en .

