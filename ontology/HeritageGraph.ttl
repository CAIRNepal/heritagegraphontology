        <https://w3id.org/heritagegraph/SyncreticType#Equivalence>,
        <https://w3id.org/heritagegraph/SyncreticType#Fusion>,
        <https://w3id.org/heritagegraph/SyncreticType#Historical> .

heritageGraph:confersRole a owl:ObjectProperty ;
    rdfs:label "confers_role" ;
    rdfs:range heritageGraph:KumariRole ;
    skos:definition "KumariRole conferred by this selection or enthronement event." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasArchitecturalStyle a owl:ObjectProperty ;
    rdfs:label "has_architectural_style" ;
    rdfs:range crm:E55_Type ;
    rdfs:subPropertyOf crm:P2_has_type ;
    skos:definition "Architectural style classification" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:performedByGroup a owl:ObjectProperty ;
    rdfs:label "performed_by_group" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] crm:E39_Actor ) ] ;
    rdfs:subPropertyOf crm:P14_carried_out_by ;
    skos:definition "Group (Guthi, caste) responsible for ritual" ;
    skos:inScheme heritageGraph:schema .

<https://w3id.org/heritagegraph/scheme/ExistenceStatus> a skos:ConceptScheme ;
    rdfs:label "ExistenceStatus" ;
    skos:definition "Controlled vocabulary for whether a heritage structure still exists physically." ;
    skos:prefLabel "ExistenceStatus" .

skos:ConceptScheme a owl:Class .

prov:wasInfluencedBy a owl:ObjectProperty ;
    rdfs:label "was_influenced_by" ;
    rdfs:range [ owl:unionOf ( prov:Entity prov:Activity prov:Agent ) ] ;
    skos:definition "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DatePrecision a owl:Class ;
    rdfs:label "DatePrecision" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/DatePrecision#Exact> <https://w3id.org/heritagegraph/DatePrecision#Year> <https://w3id.org/heritagegraph/DatePrecision#Decade> <https://w3id.org/heritagegraph/DatePrecision#Century> <https://w3id.org/heritagegraph/DatePrecision#Circa> ) ;
    skos:definition "Controlled vocabulary for the temporal precision of recorded heritage dates." ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://w3id.org/heritagegraph/DatePrecision#Century>,
        <https://w3id.org/heritagegraph/DatePrecision#Circa>,
        <https://w3id.org/heritagegraph/DatePrecision#Decade>,
        <https://w3id.org/heritagegraph/DatePrecision#Exact>,
        <https://w3id.org/heritagegraph/DatePrecision#Year> .

heritageGraph:KumariRole a owl:Class ;
    rdfs:label "KumariRole" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:roleDeity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:roleDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:roleDeity ],
        prov:Entity ;
    skos:altLabel "Living Goddess",
        "Royal Kumari" ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ExistenceStatus a owl:Class ;
    rdfs:label "ExistenceStatus" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/ExistenceStatus#Extant> <https://w3id.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://w3id.org/heritagegraph/ExistenceStatus#Destroyed> <https://w3id.org/heritagegraph/ExistenceStatus#Lost> <https://w3id.org/heritagegraph/ExistenceStatus#Hypothetical> <https://w3id.org/heritagegraph/ExistenceStatus#Unknown> ) ;
    skos:definition "Controlled vocabulary for whether a heritage structure still exists physically." ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://w3id.org/heritagegraph/ExistenceStatus#Destroyed>,
        <https://w3id.org/heritagegraph/ExistenceStatus#Extant>,
        <https://w3id.org/heritagegraph/ExistenceStatus#Hypothetical>,
        <https://w3id.org/heritagegraph/ExistenceStatus#Lost>,
        <https://w3id.org/heritagegraph/ExistenceStatus#PartiallyExtant>,
        <https://w3id.org/heritagegraph/ExistenceStatus#Unknown> .

heritageGraph:boundsTenure a owl:ObjectProperty ;
    rdfs:label "bounds_tenure" ;
    rdfs:range heritageGraph:KumariTenure ;
    skos:definition "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)." ;
    skos:inScheme heritageGraph:schema .

<https://w3id.org/heritagegraph/scheme/GuthiType> a skos:ConceptScheme ;
    rdfs:label "GuthiType" ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)" ;
    skos:prefLabel "GuthiType" .

crm:P108i_was_produced_by a owl:ObjectProperty ;
    rdfs:label "was_produced_by_event" ;
    rdfs:range crm:E12_Production ;
    skos:definition "Event that created this object or structure" ;
    skos:inScheme heritageGraph:schema .

crm:P55_has_current_location a owl:ObjectProperty ;
    rdfs:label "has_current_location" ;
    rdfs:range crm:E53_Place ;
    skos:definition "Current location of object or structure" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:KumariTenure a owl:Class ;
    rdfs:label "KumariTenure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:hadParticipant ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:embodiedDeity ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:hadParticipant ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:retiredThrough ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enthronedThrough ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:selectedThrough ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:embodiedDeity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:selectedThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:residenceStructure ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:retiredThrough ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:supportedByInstitution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:enthronedThrough ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assumesRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRole ;
            owl:onProperty heritageGraph:assumesRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariEnthronementEvent ;
            owl:onProperty heritageGraph:enthronedThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariSelectionEvent ;
            owl:onProperty heritageGraph:selectedThrough ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:assumesRole ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:residenceStructure ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:KumariRetirementEvent ;
            owl:onProperty heritageGraph:retiredThrough ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:supportedByInstitution ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:residenceStructure ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:embodiedDeity ],
        prov:Entity ;
    skos:altLabel "Living Goddess Tenure" ;
    skos:broadMatch crm:E4_Period ;
    skos:definition "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:PhysicalHeritageThing a owl:Class ;
    rdfs:label "PhysicalHeritageThing" ;
    rdfs:subClassOf prov:Entity ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( heritageGraph:ArchitecturalStructure heritageGraph:IconographicObject heritageGraph:ArchitecturalElement ) ] ;
    skos:definition "Union of the tangible heritage classes: architectural structures, iconographic objects, and standalone architectural elements. Used as the range of slots that apply to any physical heritage thing (production, custody, condition assessment)." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:SelectionCriterion a owl:Class ;
    rdfs:label "SelectionCriterion" ;
    rdfs:subClassOf prov:Entity ;
    skos:broadMatch crm:E55_Type ;
    skos:definition "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text." ;
    skos:inScheme heritageGraph:schema .

prov:wasGeneratedBy a owl:ObjectProperty ;
    rdfs:label "was_generated_by" ;
    rdfs:range prov:Activity ;
    owl:inverseOf prov:generated ;
    skos:definition "Activity that generated this entity." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:AssertionSubject a owl:Class ;
    rdfs:label "AssertionSubject" ;
    rdfs:subClassOf prov:Entity ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( crm:E22_Human-Made_Object heritageGraph:ArchitecturalElement heritageGraph:Deity heritageGraph:ReligiousTradition heritageGraph:HistoricalEvent heritageGraph:RitualEvent crm:E12_Production heritageGraph:Consecration heritageGraph:Enshrinement crm:E10_Transfer_of_Custody crm:E14_Condition_Assessment crm:E3_Condition_State crm:E39_Actor crm:E53_Place crm:E52_Time-Span heritageGraph:DataSource heritageGraph:DocumentationActivity heritageGraph:SyncreticRelationship heritageGraph:KumariTenure crm:E29_Design_or_Procedure crm:E57_Material heritageGraph:KumariRole heritageGraph:SelectionCriterion crminf:I2_Belief heritageGraph:CalendarSystem ) ] ;
    skos:broadMatch crm:E1_CRM_Entity ;
    skos:definition "Any HeritageGraph entity or event that may be the subject of an assertion." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DataSource a owl:Class ;
    rdfs:label "DataSource" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:sourceCitation ],
        [ a owl:Restriction ;
