    schema:domainIncludes hg:Guthi ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:RitualEvent ;
    rdfs:subPropertyOf crm:P14i_performed ;
    skos:definition "Rituals performed by this Guthi."@en ;
    skos:inScheme hg:schema .

hg:recurrencePattern a owl:DatatypeProperty ;
    rdfs:label "Recurrence pattern"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span."@en ;
    skos:inScheme hg:schema .

hg:routeDescription a owl:DatatypeProperty ;
    rdfs:label "Route description"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range rdf:PlainLiteral ;
