            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E14_Condition_Assessment ;
            owl:onProperty crm:P34i_was_assessed_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P30i_custody_transferred_through ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P34i_was_assessed_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:participatesInRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:documentedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E12_Production ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E10_Transfer_of_Custody ;
            owl:onProperty crm:P30i_custody_transferred_through ],
        prov:Entity ;
    skos:closeMatch schema1:CreativeWork ;
