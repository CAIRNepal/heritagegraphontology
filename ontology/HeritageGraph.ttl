        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:propositionPredicate ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:propositionLiteralValue ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:propositionPredicate ],
        prov:Entity ;
    skos:broadMatch crminf:I4_Proposition_Set ;
    skos:closeMatch rdf:Statement ;
    skos:definition "A single machine-readable proposition (subject - predicate - object) held true by an Assertion. Modelled as a singleton proposition set (CRMinf I4); the predicate is a URI/CURIE, the object either a heritage entity or a literal."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Sattal a owl:Class ;
    rdfs:label "Sattal"@en ;
    rdfs:subClassOf heritageGraph:RestHouse ;
    skos:definition "Multi-story rest house (3-5 floors) with ritual and social functions"@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Stupa a owl:Class ;
    rdfs:label "Stupa"@en ;
    rdfs:subClassOf heritageGraph:ReligiousStructure ;
    owl:disjointWith heritageGraph:Chaitya ;
    skos:definition "Buddhist dome-shaped reliquary shrine with circumambulation and ritual activation (e.g., Boudhanath, Swayambhunath)."@en ;
    skos:exactMatch aat:300007576,
        wikidata:Q180987 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ThirtyTwoPerfectionsCriterion a owl:Class ;
    rdfs:label "Thirty Two Perfections Criterion"@en ;
    rdfs:subClassOf heritageGraph:SelectionCriterion ;
    skos:altLabel "Battis Lakshana"@en ;
    skos:definition "Candidate must exhibit the battis lakshana (thirty-two perfections/auspicious bodily marks)."@en ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Verification a owl:Class ;
    rdfs:label "Verification"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:verificationMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:verifiedAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty heritageGraph:verifiedByExpert ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:verificationMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        heritageGraph:DocumentationActivity ;
    skos:broadMatch prov:Activity ;
    skos:definition "Process of cross-checking heritage claims against multiple sources"@en ;
    skos:editorialNote "PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally."@en ;
    skos:inScheme heritageGraph:schema .

