hg:hypothesizedLocation a owl:ObjectProperty ;
    rdfs:label "Hypothesized location"@en ;
    schema:domainIncludes hg:ArchitecturalStructure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E53_Place ;
    skos:definition "Possible locations if the structure is lost."@en ;
    skos:inScheme hg:schema .

hg:isPrimaryForTradition a owl:ObjectProperty ;
    rdfs:label "Is primary for tradition"@en ;
    schema:domainIncludes hg:CalendarSystem ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:ReligiousTradition ;
    skos:definition "Religious tradition(s) that use this calendar system for their rites. Calendars are not divided by religion in Nepal: Nepal Sambat is the era of the Newar ritual calendar, used by Newar Hindus and Buddhists alike, and Bikram Sambat is the official civil era."@en ;
    skos:inScheme hg:schema .

hg:lunarDateTithi a owl:DatatypeProperty ;
    rdfs:label "Lunar date tithi"@en ;
    schema:domainIncludes hg:RitualEvent ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range rdf:PlainLiteral ;
    skos:definition "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')."@en ;
    skos:inScheme hg:schema .

hg:participatesInRitual a owl:ObjectProperty ;
