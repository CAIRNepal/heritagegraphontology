hg:PhysicalIntegrityCriterion a owl:Class ;
    rdfs:label "Physical Integrity Criterion"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:SelectionCriterion ;
    skos:definition "The traditional requirement of physical integrity in a candidate. HeritageGraph records that the criterion belongs to the selection, not any assessment of a candidate's body or health."@en ;
    skos:inScheme hg:schema .

hg:Pokhari a owl:Class ;
    rdfs:label "Pokhari"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:WaterStructure ;
    skos:definition "Pond or tank for water storage, ritual bathing, and ecological management."@en ;
    skos:inScheme hg:schema .

hg:Sattal a owl:Class ;
    rdfs:label "Sattal"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:RestHouse ;
    skos:definition "Multi-storey public rest house (e.g. the three-storey Kasthamandap) with ritual and social functions."@en ;
    skos:inScheme hg:schema .

hg:ThirtyTwoPerfectionsCriterion a owl:Class ;
    rdfs:label "Thirty Two Perfections Criterion"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:SelectionCriterion ;
    skos:altLabel "Battis Lakshana"@en ;
    skos:definition "The battis lakshana, the traditional list of thirty-two auspicious marks a candidate is held to bear. HeritageGraph records that the criterion belongs to the selection, not any assessment of a candidate."@en ;
    skos:inScheme hg:schema .

hg:accessProtocol a owl:ObjectProperty ;
    rdfs:label "has access protocol"@en ;
    dcterms:title "has access protocol"@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( crm:E10_Transfer_of_Custody crm:E12_Production crm:E14_Condition_Assessment crm:E22_Human-Made_Object crm:E29_Design_or_Procedure crm:E3_Condition_State crm:E52_Time-Span crm:E53_Place crm:E57_Material crm:E6_Destruction crminf:I2_Belief hg:ArchitecturalElement hg:CalendarSystem hg:DataSource hg:Deity hg:DocumentationActivity hg:Endowment hg:EndowmentEvent hg:HistoricalEvent hg:Office hg:PhysicalHeritageThing hg:Proposition hg:ReligiousTradition hg:RitualEvent hg:SelectionCriterion hg:StructureType hg:SyncreticRelationship hg:Tenure ) ] ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range hg:AccessProtocol ;
    rdfs:subPropertyOf dcterms:accessRights ;
    skos:definition "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published."@en ;
    skos:inScheme hg:schema .

