    skos:definition "Type of the structure from a controlled vocabulary or a local term list (e.g. bahah, dyochhen), finer than its class; a subproperty of crm:P2_has_type."@en ;
    skos:inScheme hg:schema .

hg:successionRule a owl:DatatypeProperty ;
    rdfs:label "Succession rule"@en ;
    schema:domainIncludes hg:HereditaryRoleTenure ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range rdf:PlainLiteral ;
