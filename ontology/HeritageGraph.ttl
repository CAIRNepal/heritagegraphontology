aat:300007576 a owl:Class,
        skos:Concept ;
    rdfs:label "Stupa" ;
    rdfs:subClassOf crm:E55_Type ;
    skos:definition "Buddhist dome-shaped reliquary" ;
    skos:inScheme <https://w3id.org/heritagegraph/scheme/ArchitecturalStyle> ;
    skos:prefLabel "Stupa" .

crm:P108_has_produced a owl:ObjectProperty ;
    rdfs:label "produced_object" ;
    rdfs:range heritageGraph:PhysicalHeritageThing ;
    skos:definition "Object produced by this production event" ;
    skos:inScheme heritageGraph:schema .

crm:P120_occurs_before a owl:ObjectProperty ;
    rdfs:label "occurs_before" ;
    rdfs:range heritageGraph:RitualEvent ;
    skos:definition "Points to the next ritual in the canonical sequence." ;
