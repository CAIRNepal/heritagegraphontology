    skos:inScheme hg:schema .

hg:confidenceMethod a owl:ObjectProperty ;
    rdfs:label "Confidence method"@en ;
    rdfs:domain crminf:I2_Belief ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range crm:E29_Design_or_Procedure ;
    skos:definition "The documented procedure (crm:E29 Design or Procedure) by which the confidence score was assigned, described once (e.g. an expert 5-point scale mapped to 0-1, agreement between independent sources, or coding of the source's hedging: 0.9 stated plainly, 0.7 mild hedging, 0.5 explicitly uncertain, 0.3 disputed by the author)."@en ;
    skos:inScheme hg:schema .

hg:confidenceScore a owl:DatatypeProperty ;
    rdfs:label "Confidence score"@en ;
    rdfs:domain crminf:I2_Belief ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:range [ a rdfs:Datatype ;
            owl:onDatatype xsd:decimal ;
            owl:withRestrictions ( [ xsd:minInclusive 0.0 ] [ xsd:maxInclusive 1.0 ] ) ] ;
    skos:definition "Degree of belief, between 0 and 1, that the asserted value is correct: 1 = certain, 0.5 = undecided, 0 = believed false. The assessor is either the agent the assertion is attributed to (prov:wasAttributedTo) or the activity that generated the assertion (prov:wasGeneratedBy), e.g. an extraction that codes how firmly the source states the claim; hg:confidenceMethod says which, and by what rubric. Scores are comparable only when they share an assessor or a method."@en ;
    skos:inScheme hg:schema ;
    skos:relatedMatch crminf:J5_holds_to_be .

