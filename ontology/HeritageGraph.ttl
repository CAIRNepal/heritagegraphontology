    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:DocumentationActivity ;
    skos:broadMatch crm:E65_Creation ;
    skos:definition "The interaction event between a researcher and a knowledge holder."@en ;
    skos:inScheme hg:schema .

hg:OralHistoryRecording a owl:Class ;
