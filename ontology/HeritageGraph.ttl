    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:Festival ;
    skos:definition "Festival involving ceremonial chariot procession (e.g., Rato Machhindranath Jatra)."@en ;
    skos:inScheme hg:schema .

hg:Container a owl:Class ;
    rdfs:label "obsolete Container"@en ;
    rdfs:isDefinedBy hg:ontology ;
    owl:deprecated true ;
    skos:definition "Root container for cultural heritage data instances. PLACEMENT RULE: put each instance in the most specific collection available (e.g. a Festival in festivals, not ritual_events; a Person in persons, not actors); broader collections exist for instances of the general classes only."@en ;
    skos:editorialNote "Deprecated in HeritageGraph 1.1.0: a LinkML serialization construct for JSON/YAML data files, not a domain term. It is defined in HeritageGraph-container.yaml and used only by the JSON Schema; RDF instance data should not use it."@en ;
    skos:inScheme hg:schema .

hg:Dharmashala a owl:Class ;
    rdfs:label "Dharmashala"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:RestHouse ;
    skos:definition "Pilgrim lodge operated by a Guthi organization."@en ;
    skos:inScheme hg:schema .

hg:DhungeDhara a owl:Class ;
    rdfs:label "Dhunge Dhara"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:WaterStructure ;
    skos:altLabel "Hiti"@en ;
    skos:definition "Stone spout (hiti) with carved imagery, used for ritual bathing and daily water supply."@en ;
    skos:inScheme hg:schema .

hg:FearlessnessAssessment a owl:Class ;
    rdfs:label "Fearlessness Assessment"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:RitualAssessment ;
    skos:definition "The 'fearlessness test' popularly described (animal heads, masked dancers in darkness). Its historical and contemporary practice is DISPUTED -- some former Kumaris contest how it is described. Represented as an assessment whose accounts are source-attributed via hg:hasAssertion, NOT as a mandatory criterion."@en ;
    skos:inScheme hg:schema ;
    skos:scopeNote "Deliberately not a SelectionCriterion subclass: popular accounts and lived testimony disagree. Attach each account as a Assertion (CRMinf I2 Belief) with its own source and confidence."@en .

hg:FieldSurveyActivity a owl:Class ;
    rdfs:label "Field Survey Activity"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:DocumentationActivity ;
    skos:broadMatch crmsci:S4_Observation ;
    skos:definition "The activity of measuring, photographing, or assessing a site in person."@en ;
    skos:inScheme hg:schema .

hg:FieldSurveyDataset a owl:Class ;
    rdfs:label "Field Survey Dataset"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:DataSource ;
    skos:broadMatch crm:E31_Document ;
    skos:definition "The structured data or report resulting from a field survey."@en ;
    skos:inScheme hg:schema .

hg:HoroscopeCompatibilityCriterion a owl:Class ;
    rdfs:label "Horoscope Compatibility Criterion"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:SelectionCriterion ;
    skos:definition "Candidate's horoscope must be compatible with the city and ruling authority."@en ;
    skos:inScheme hg:schema .

hg:InformationObject a owl:Class ;
    rdfs:label "Heritage information object"@en ;
    dcterms:title "Heritage information object"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom hg:DocumentationActivity ;
            owl:onProperty hg:documentedBy ],
        hg:DataSource ;
    skos:broadMatch crm:E73_Information_Object ;
    skos:definition "A recorded piece of information about heritage."@en ;
    skos:inScheme hg:schema .

hg:KumariHouse a owl:Class ;
    rdfs:label "Kumari House"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:ReligiousStructure ;
    skos:altLabel "Kumari Ghar"@en ;
    skos:definition "God-house residence of a Kumari during tenure (e.g., Kumari Ghar, Kathmandu). Specialised ReligiousStructure."@en ;
    skos:inScheme hg:schema .

hg:LineageCriterion a owl:Class ;
    rdfs:label "Lineage Criterion"@en ;
    rdfs:isDefinedBy hg:ontology ;
    rdfs:subClassOf hg:SelectionCriterion ;
    skos:definition "Candidate must belong to an eligible lineage (Shakya / Vajracharya Newar Buddhist family)."@en ;
    skos:inScheme hg:schema .

hg:MaskedDance a owl:Class ;
