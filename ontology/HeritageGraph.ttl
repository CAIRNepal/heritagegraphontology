heritageGraph:Temple a owl:Class ;
    rdfs:label "Temple" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enshrinesDeityThroughEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E55_Type ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Enshrinement ;
            owl:onProperty heritageGraph:enshrinesDeityThroughEvent ],
