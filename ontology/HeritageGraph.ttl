            owl:onProperty schema1:inLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:persistentIdentifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty heritageGraph:sourceCreator ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:sourcePublisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty schema1:inLanguage ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:identifierScheme ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:persistentIdentifier ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:persistentIdentifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:publicationTimespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:sourceCreator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:sourceUrl ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:sourceUrl ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:identifierScheme ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:publicationTimespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:sourcePublisher ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:sourceCitation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:identifierScheme ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:resourceType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty schema1:inLanguage ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:resourceType ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:sourceUrl ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:sourceCitation ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E39_Actor ;
            owl:onProperty heritageGraph:sourcePublisher ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty heritageGraph:publicationTimespan ],
        prov:Entity ;
    skos:broadMatch crm:E73_Information_Object ;
    skos:definition "Original source from which heritage information was derived" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:GuthiType a owl:Class ;
    rdfs:label "GuthiType" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/GuthiType#SiGuthi> <https://w3id.org/heritagegraph/GuthiType#JatraGuthi> <https://w3id.org/heritagegraph/GuthiType#PujaGuthi> <https://w3id.org/heritagegraph/GuthiType#TempleGuthi> <https://w3id.org/heritagegraph/GuthiType#NashaGuthi> <https://w3id.org/heritagegraph/GuthiType#SanaGuthi> <https://w3id.org/heritagegraph/GuthiType#SanGuthi> <https://w3id.org/heritagegraph/GuthiType#RajGuthi> ) ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)" ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values <https://w3id.org/heritagegraph/GuthiType#JatraGuthi>,
        <https://w3id.org/heritagegraph/GuthiType#NashaGuthi>,
        <https://w3id.org/heritagegraph/GuthiType#PujaGuthi>,
        <https://w3id.org/heritagegraph/GuthiType#RajGuthi>,
        <https://w3id.org/heritagegraph/GuthiType#SanGuthi>,
        <https://w3id.org/heritagegraph/GuthiType#SanaGuthi>,
        <https://w3id.org/heritagegraph/GuthiType#SiGuthi>,
        <https://w3id.org/heritagegraph/GuthiType#TempleGuthi> .

crm:E55_Type a owl:Class ;
    rdfs:label "ArchitecturalStyle" ;
    owl:unionOf ( aat:300004829 <http://www.cidoc-crm.org/cidoc-crm/E55_Type#Shikhara> aat:300001280 aat:300007562 aat:300007576 ) ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type." ;
    skos:inScheme heritageGraph:schema ;
    linkml:permissible_values aat:300001280,
        aat:300004829,
        aat:300007562,
        aat:300007576,
        <http://www.cidoc-crm.org/cidoc-crm/E55_Type#Shikhara> .

crm:E21_Person a owl:Class ;
    rdfs:label "Person" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty heritageGraph:deathTimespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:deathTimespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:institutionalAffiliation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:institutionalAffiliation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:expertiseArea ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty crm:P14i_performed ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty crm:P107i_is_current_or_former_member_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:expertiseArea ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:deathTimespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:institutionalAffiliation ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:birthTimespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:birthTimespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P107i_is_current_or_former_member_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P14i_performed ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty heritageGraph:birthTimespan ],
        crm:E39_Actor ;
    skos:broadMatch prov:Person ;
    skos:definition "Individual person who performs, commissions, documents, or verifies heritage activities" ;
    skos:exactMatch heritageGraph:Person ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Guthi a owl:Class ;
    rdfs:label "Guthi" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:guthiType ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty crm:P50i_is_current_keeper_of ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P107_has_current_or_former_member ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:performsRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performsRitual ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E21_Person ;
            owl:onProperty crm:P107_has_current_or_former_member ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:guthiType ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P50i_is_current_keeper_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:GuthiType ;
            owl:onProperty heritageGraph:guthiType ],
        crm:E39_Actor ;
    skos:broadMatch crm:E74_Group,
        prov:Organization ;
    skos:definition "Endowed trust organization unique to Nepal, managing temples, rituals, and land through hereditary or voluntary membership" ;
    skos:inScheme heritageGraph:schema .

crminf:I2_Belief a owl:Class ;
    rdfs:label "Assertion" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:reconciliationStatus ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:assertsAbout ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:dataQualityNote ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty prov:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crminf:J4_that ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty prov:wasDerivedFrom ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasRevisionOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Agent ;
            owl:onProperty prov:wasAttributedTo ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 1 ] ) ] ) ] ;
            owl:onProperty heritageGraph:confidenceScore ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasDerivedFrom ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasGeneratedBy ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:dataQualityNote ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty prov:generatedAtTime ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Proposition ;
            owl:onProperty crminf:J4_that ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:assertsAbout ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty prov:wasRevisionOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty prov:wasRevisionOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:dataQualityNote ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:confidenceScore ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:confidenceScore ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:reconciliationStatus ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:assertsAbout ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:reconciliationStatus ],
        prov:Entity ;
    skos:closeMatch schema1:Claim ;
    skos:definition "A provenance-bearing belief or claim about a heritage entity or event. The assertion is represented as CRMinf I2 Belief and as a prov:Entity, allowing source, attribution, generation time, revision, confidence, and reconciliation status to be recorded explicitly." ;
    skos:exactMatch heritageGraph:Assertion ;
    skos:inScheme heritageGraph:schema ;
    skos:relatedMatch prov:Entity ;
    heritageGraph:crminf_pattern "I2_Belief -J4_that-> I4_Proposition_Set; evidence via I5_Inference_Making (J1_used_as_premise / J2_concluded_that); expert re-check via I7_Belief_Adoption" .

prov:Agent a owl:Class ;
    rdfs:label "Agent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( prov:Entity prov:Activity prov:Agent ) ] ;
            owl:onProperty prov:wasInfluencedBy ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:actedOnBehalfOf ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty dcterms:identifier ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Agent ;
            owl:onProperty prov:actedOnBehalfOf ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasInfluencedBy ] ;
    skos:definition "Direct LinkML representation of prov:Agent. Agents bear responsibility for activities or entities. PROV-O permits an individual agent also to be typed as an Entity, but does not define every Agent as a subclass of Entity." ;
    skos:exactMatch heritageGraph:Agent ;
    skos:inScheme heritageGraph:schema .

dcterms:identifier a owl:DatatypeProperty ;
    rdfs:label "id" ;
    rdfs:range xsd:anyURI ;
    skos:definition "Globally unique URI identifier" ;
    skos:exactMatch schema1:identifier ;
    skos:inScheme heritageGraph:schema .

heritageGraph:ArchitecturalStructure a owl:Class ;
    rdfs:label "ArchitecturalStructure" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P34i_was_assessed_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:destructionEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E6_Destruction ;
            owl:onProperty heritageGraph:destructionEvent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hypothesizedLocation ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:lastKnownExistenceDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E14_Condition_Assessment ;
            owl:onProperty crm:P34i_was_assessed_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom crminf:I2_Belief ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E12_Production ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P46_is_composed_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P55_has_current_location ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalElement ;
            owl:onProperty crm:P46_is_composed_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ExistenceStatus ;
            owl:onProperty heritageGraph:existenceStatus ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasAssertion ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:existenceStatus ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P108i_was_produced_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:existenceStatus ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:destructionEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:mentionedInSource ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E55_Type ;
            owl:onProperty heritageGraph:hasArchitecturalStyle ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:lastKnownExistenceDate ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E53_Place ;
            owl:onProperty heritageGraph:hypothesizedLocation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:mentionedInSource ],
        crm:E22_Human-Made_Object ;
    skos:broadMatch crm:E22_Human-Made_Object ;
    skos:closeMatch schema1:Place ;
    skos:definition "Physical structures built for religious, social, or civic purposes. Links to events of production, use, custody, and documentation." ;
    skos:exactMatch wikidata:Q811979 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:hasAssertion a owl:ObjectProperty ;
    rdfs:label "has_assertion" ;
    rdfs:range crminf:I2_Belief ;
    owl:inverseOf heritageGraph:assertsAbout ;
    skos:definition "Provenance-bearing assertion made about this entity or event." ;
    skos:inScheme heritageGraph:schema .

heritageGraph:DocumentationActivity a owl:Class ;
    rdfs:label "DocumentationActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:generated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:usedMethod ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E52_Time-Span ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:usedEquipment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:usedMethod ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Entity ;
            owl:onProperty prov:generated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:usedEquipment ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertionSubject ;
            owl:onProperty heritageGraph:documents ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P4_has_time-span ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:documents ],
        [ a owl:Restriction ;
            owl:allValuesFrom prov:Agent ;
            owl:onProperty prov:wasAssociatedWith ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:usedMethod ],
        prov:Activity ;
    skos:broadMatch crm:E7_Activity ;
    skos:definition "Activity that records information about a heritage entity or event and may generate information objects or assertions. It aligns CIDOC CRM documentation practices with prov:Activity." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment_note "prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM<->PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally." .

<https://w3id.org/heritagegraph/scheme/RitualType> a skos:ConceptScheme ;
    rdfs:label "RitualType" ;
    skos:definition "Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage." ;
    skos:prefLabel "RitualType" .

crm:P14_carried_out_by a owl:ObjectProperty ;
    rdfs:label "carried_out_by" ;
    rdfs:range crm:E39_Actor ;
    skos:definition "Actor(s) who performed this event" ;
    skos:inScheme heritageGraph:schema .

heritageGraph:Deity a owl:Class ;
    rdfs:label "Deity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:IconographicObject ;
            owl:onProperty crm:P62i_is_depicted_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:isInvokedInRitual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:hasReligiousTradition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isInvokedInRitual ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Enshrinement ;
            owl:onProperty heritageGraph:isEnshrinedThroughEvent ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:hasReligiousTradition ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty crm:P62i_is_depicted_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty crm:P3_has_note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:isEnshrinedThroughEvent ],
        prov:Entity ;
    skos:broadMatch crm:E28_Conceptual_Object ;
    skos:definition "Divine conceptual entity in Hindu, Buddhist, or syncretic traditions. Distinct from physical representations (Murti) and ritual presences." ;
    skos:exactMatch dbo:Deity,
        aat:300343850,
        wikidata:Q178885 ;
    skos:inScheme heritageGraph:schema .

heritageGraph:RitualType a owl:Class ;
    rdfs:label "RitualType" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/RitualType#NityaPuja> <https://w3id.org/heritagegraph/RitualType#NaimittikaPuja> <https://w3id.org/heritagegraph/RitualType#KamyaPuja> <https://w3id.org/heritagegraph/RitualType#Abhisheka> <https://w3id.org/heritagegraph/RitualType#Homa> <https://w3id.org/heritagegraph/RitualType#Bhajan> <https://w3id.org/heritagegraph/RitualType#Yagna> <https://w3id.org/heritagegraph/RitualType#Vrata> <https://w3id.org/heritagegraph/RitualType#Jatra> <https://w3id.org/heritagegraph/RitualType#ChariotProcession> <https://w3id.org/heritagegraph/RitualType#MaskedPerformance> <https://w3id.org/heritagegraph/RitualType#RitualConsecration> <https://w3id.org/heritagegraph/RitualType#ProcessionRitual> <https://w3id.org/heritagegraph/RitualType#InstallationRitual> <https://w3id.org/heritagegraph/RitualType#DeinstallationRitual> <https://w3id.org/heritagegraph/RitualType#ReturningRitual> <https://w3id.org/heritagegraph/RitualType#Circumambulation> <https://w3id.org/heritagegraph/RitualType#RelicTour> <https://w3id.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
    skos:definition "Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:design_note "RitualType currently mixes three orthogonal axes: worship-frequency (NityaPuja/NaimittikaPuja/KamyaPuja), ritual form (Homa/Jatra/MaskedPerformance), and lifecycle (InstallationRitual/ReturningRitual). Consider splitting into RitualFrequency + RitualForm. Also: Circumambulation/ProcessionalMovement/ProcessionRitual/RelicTour overlap with RitualEvent.route_places/start_place/end_place/route_description -- pick one canonical mechanism for moving rituals." ;
    linkml:permissible_values <https://w3id.org/heritagegraph/RitualType#Abhisheka>,
        <https://w3id.org/heritagegraph/RitualType#Bhajan>,
        <https://w3id.org/heritagegraph/RitualType#ChariotProcession>,
        <https://w3id.org/heritagegraph/RitualType#Circumambulation>,
        <https://w3id.org/heritagegraph/RitualType#DeinstallationRitual>,
        <https://w3id.org/heritagegraph/RitualType#Homa>,
        <https://w3id.org/heritagegraph/RitualType#InstallationRitual>,
        <https://w3id.org/heritagegraph/RitualType#Jatra>,
        <https://w3id.org/heritagegraph/RitualType#KamyaPuja>,
        <https://w3id.org/heritagegraph/RitualType#MaskedPerformance>,
        <https://w3id.org/heritagegraph/RitualType#NaimittikaPuja>,
        <https://w3id.org/heritagegraph/RitualType#NityaPuja>,
        <https://w3id.org/heritagegraph/RitualType#ProcessionRitual>,
        <https://w3id.org/heritagegraph/RitualType#ProcessionalMovement>,
        <https://w3id.org/heritagegraph/RitualType#RelicTour>,
        <https://w3id.org/heritagegraph/RitualType#ReturningRitual>,
        <https://w3id.org/heritagegraph/RitualType#RitualConsecration>,
        <https://w3id.org/heritagegraph/RitualType#Vrata>,
        <https://w3id.org/heritagegraph/RitualType#Yagna> .

heritageGraph:documentedBy a owl:ObjectProperty ;
    rdfs:label "was_documented_by" ;
    rdfs:range heritageGraph:DocumentationActivity ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    owl:inverseOf heritageGraph:documents ;
    skos:definition "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
    skos:inScheme heritageGraph:schema ;
    heritageGraph:prov_alignment "prov:wasInfluencedBy" .

heritageGraph:RitualEvent a owl:Class ;
    rdfs:label "RitualEvent" ;
