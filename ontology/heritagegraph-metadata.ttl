@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix heritageGraph: <https://w3id.org/heritagegraph/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

heritageGraph:ontology dcterms:isPartOf heritageGraph:dataset .

heritageGraph:dataset a void:Dataset ;
    dcterms:creator "CAIR-Nepal" ;
    dcterms:title "HeritageGraph Ontology Dataset" ;
    void:inDataset heritageGraph:dataset ;
    void:triples 5077 ;
    void:vocabulary heritageGraph:alignment,
        heritageGraph:edm-profile,
        heritageGraph:ontology .

