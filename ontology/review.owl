    <rdfs:label xml:lang="en">Stupa</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/ReligiousStructure"/>
    <skos:definition xml:lang="en">Buddhist dome-shaped reliquary shrine with circumambulation and ritual activation (e.g., Boudhanath, Swayambhunath).</skos:definition>
    <skos:exactMatch rdf:resource="http://vocab.getty.edu/aat/300007576"/>
    <skos:exactMatch rdf:resource="http://www.wikidata.org/entity/Q180987"/>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
