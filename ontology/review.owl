  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/KumariRetirementEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kumari Retirement Event</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b100"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b101"/>
