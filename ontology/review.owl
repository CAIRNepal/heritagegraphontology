    <rdfs:subClassOf rdf:nodeID="n2e2cf9d97eb446d09da97ae8447aa515b88"/>
    <rdfs:subClassOf rdf:nodeID="n2e2cf9d97eb446d09da97ae8447aa515b89"/>
    <rdfs:subClassOf rdf:nodeID="n2e2cf9d97eb446d09da97ae8447aa515b90"/>
    <rdfs:subClassOf rdf:nodeID="n2e2cf9d97eb446d09da97ae8447aa515b91"/>
    <rdfs:subClassOf rdf:nodeID="n2e2cf9d97eb446d09da97ae8447aa515b92"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:definition>Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer.</skos:definition>
    <skos:exactMatch rdf:resource="https://w3id.org/heritagegraph/LivingGoddessSelection"/>
    <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
  </rdf:Description>
