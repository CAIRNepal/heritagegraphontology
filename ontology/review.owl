    <skos:definition xml:lang="en">Type of custodian (government, academic, community), free text</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b266">
