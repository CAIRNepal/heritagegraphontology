  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/RitualType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ritual Type</rdfs:label>
    <owl:oneOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b479"/>
    <skos:definition xml:lang="en">Controlled vocabulary of ritual and festival activity types in Kathmandu Valley living heritage.</skos:definition>
    <skos:editorialNote xml:lang="en">Design note: RitualType currently mixes three orthogonal axes: worship-frequency (NityaPuja/NaimittikaPuja/KamyaPuja), ritual form (Homa/Jatra/MaskedPerformance), and lifecycle (InstallationRitual/ReturningRitual). Consider splitting into RitualFrequency + RitualForm. Also: Circumambulation/ProcessionalMovement/ProcessionRitual/RelicTour overlap with RitualEvent.route_places/start_place/end_place/route_description -- pick one canonical mechanism for moving rituals.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
