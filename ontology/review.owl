    <rdfs:label xml:lang="en">Kumari Tenure</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b330"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b331"/>
