    <rdfs:range rdf:resource="https://cair-nepal.org/heritagegraph/KumariRole"/>
    <rdfs:subPropertyOf rdf:resource="https://cair-nepal.org/heritagegraph/tenureOffice"/>
    <skos:definition xml:lang="en">KumariRole held during this tenure.</skos:definition>
