    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P3_has_note"/>
    <skos:definition xml:lang="en">The date as written in the source, in the calendar given by calendar_system (e.g. '2072' for a Bikram Sambat year, 'NS 1135 Kaulaathwa', 'VS 2021'). It is never put into an xsd:dateTime: the converted Gregorian bounds go in date_earliest / date_latest.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
