    <rdf:rest rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b18"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b64">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://cair-nepal.org/heritagegraph/custodyClosedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b314">
    <rdf:first rdf:resource="https://cair-nepal.org/heritagegraph/SyncreticType#Historical"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
