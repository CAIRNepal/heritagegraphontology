  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/Endowment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Endowment</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b198"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b206"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b207"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b208"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b209"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b210"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b211"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E72_Legal_Object"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E72_Legal_Object"/>
    <skos:definition xml:lang="en">Land, income or other property permanently dedicated to sustain a structure, a ritual or festival, or a sacred office, and held by a Guthi. The endowment, not the membership, is what makes a Guthi a trust.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
