  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/confidenceMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Confidence method</rdfs:label>
    <rdfs:domain rdf:resource="http://www.cidoc-crm.org/extensions/crminf/I2_Belief"/>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E29_Design_or_Procedure"/>
    <skos:definition xml:lang="en">The documented procedure (crm:E29 Design or Procedure) by which the confidence score was assigned, described once (e.g. an expert 5-point scale mapped to 0-1, agreement between independent sources, or coding of the source's hedging: 0.9 stated plainly, 0.7 mild hedging, 0.5 explicitly uncertain, 0.3 disputed by the author).</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical">
