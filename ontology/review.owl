  <rdf:Description rdf:about="http://purl.org/pav/version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/confidenceScore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Confidence score</rdfs:label>
    <rdfs:domain rdf:resource="http://www.cidoc-crm.org/extensions/crminf/I2_Belief"/>
    <rdfs:range rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b45"/>
    <skos:definition xml:lang="en">Degree of belief, between 0 and 1, that the asserted value is correct: 1 = certain, 0.5 = undecided, 0 = believed false. The assessor is either the agent the assertion is attributed to (prov:wasAttributedTo) or the activity that generated the assertion (prov:wasGeneratedBy), e.g. an extraction that codes how firmly the source states the claim; confidence_method says which, and by what rubric. Scores are comparable only when they share an assessor or a method.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
