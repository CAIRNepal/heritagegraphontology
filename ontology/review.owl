    <rdfs:label xml:lang="en">Hypothetical</rdfs:label>
    <skos:definition xml:lang="en">Theorized (e.g. a reconstruction on paper only); never physically realized</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/scheme/ExistenceStatus"/>
    <skos:prefLabel xml:lang="en">Hypothetical</skos:prefLabel>
  </rdf:Description>
