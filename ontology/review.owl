  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/RitualOffice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ritual Office</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/Office"/>
    <skos:definition xml:lang="en">A ritual office or specialist role (e.g. Vajracharya or Rajopadhyaya priest, Karmacharya, chariot builder, festival musician, the Kumari), held by a person or a caste group, often hereditarily.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b450">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:maxCardinality>
