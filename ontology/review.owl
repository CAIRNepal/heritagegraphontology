  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b469">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://cair-nepal.org/heritagegraph/Deity"/>
