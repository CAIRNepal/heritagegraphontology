    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b220"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b221"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b222"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b223"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b224"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b225"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b226"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:definition xml:lang="en">Event that founds, augments, nationalises or alienates a Guthi endowment, with its donor or recipient and its date.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
