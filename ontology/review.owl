  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">HeritageGraph</rdfs:label>
    <dcterms:bibliographicCitation>Karki, N., Oli, N., Sapkota, A., Chhetri, T. R., &amp; Yumusak, S. (2026). HeritageGraph Ontology (Version 1.0.1). CAIR-Nepal. https://doi.org/10.5281/zenodo.23435676</dcterms:bibliographicCitation>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-11-23</dcterms:created>
    <dcterms:creator>Anu Sapkota</dcterms:creator>
    <dcterms:creator>Nabin Oli</dcterms:creator>
    <dcterms:creator>Niraj Karki</dcterms:creator>
    <dcterms:creator>Semih Yumusak</dcterms:creator>
    <dcterms:creator>Tek Raj Chhetri</dcterms:creator>
    <dcterms:description xml:lang="en">An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning.</dcterms:description>
    <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-17</dcterms:issued>
    <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-25</dcterms:modified>
    <dcterms:publisher>CAIR-Nepal</dcterms:publisher>
    <dcterms:source rdf:resource="https://github.com/CAIRNepal/heritagegraphontology"/>
    <dcterms:title xml:lang="en">HeritageGraph Ontology</dcterms:title>
    <bibo:doi>10.5281/zenodo.23435676</bibo:doi>
    <bibo:status>Published</bibo:status>
    <pav:version>1.0.1</pav:version>
    <vann:preferredNamespacePrefix>hg</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://cair-nepal.org/heritagegraph/</vann:preferredNamespaceUri>
    <owl:priorVersion rdf:resource="https://cair-nepal.org/heritagegraph/ontology/1.0.0"/>
    <owl:versionIRI rdf:resource="https://cair-nepal.org/heritagegraph/ontology/1.0.1"/>
    <owl:versionInfo>1.0.1</owl:versionInfo>
    <skos:definition xml:lang="en">An event-centric LinkML schema for representing cultural heritage information, aligned with CIDOC-CRM and PROV-O through exact/broad mappings and subproperty bridges, enabling provenance tracking and ritual-spatial-temporal reasoning.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/physical_heritage_things">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">obsolete physical heritage things</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Collection of all physical heritage objects</skos:definition>
    <skos:editorialNote xml:lang="en">Deprecated in HeritageGraph 1.1.0: a LinkML serialization construct for JSON/YAML data files, not a domain term. It is defined in HeritageGraph-container.yaml and used only by the JSON Schema; RDF instance data should not use it.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
