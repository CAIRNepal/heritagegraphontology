    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b254"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b255"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b256"/>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/KumariLifecycleEvent"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:broadMatch rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana) and horoscope matching with the city and ruling authority, performed by Vajracharya priests and astrologers. Accounts of a fearlessness test are disputed and are recorded as such with FearlessnessAssessment, not stated here.</skos:definition>
    <skos:editorialNote xml:lang="en">PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM&lt;-&gt;PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
