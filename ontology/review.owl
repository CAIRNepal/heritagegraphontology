    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A type of heritage structure from a controlled vocabulary or a community's own term list (a CIDOC-CRM E55 Type), e.g. the Newar bahah or bahi (Buddhist monastic courtyard), dyochhen (god-house), agam chhen (esoteric shrine house) or pitha (seat of a goddess). Link each term to AAT or Wikidata with SKOS mappings where an equivalent exists; local types need no new ontology class.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
