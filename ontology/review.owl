    <rdfs:label xml:lang="en">has guthi type</rdfs:label>
    <dcterms:title xml:lang="en">has guthi type</dcterms:title>
    <rdfs:range rdf:resource="https://cair-nepal.org/heritagegraph/GuthiType"/>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
    <skos:definition xml:lang="en">Type of Guthi (Si, Jatra, Temple)</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/selectedPerson">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Selected person</rdfs:label>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E21_Person"/>
