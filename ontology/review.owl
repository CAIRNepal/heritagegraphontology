  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/PhysicalIntegrityCriterion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Physical Integrity Criterion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/SelectionCriterion"/>
    <skos:definition xml:lang="en">The traditional requirement of physical integrity in a candidate. HeritageGraph records that the criterion belongs to the selection, not any assessment of a candidate's body or health.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja">
