  <rdf:Description rdf:about="https://w3id.org/heritagegraph/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>HeritageGraph</rdfs:label>
    <dct:creator>Cair Nepal</dct:creator>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:license>CC-BY-4.0</dct:license>
    <dct:license>https://creativecommons.org/licenses/by/4.0/</dct:license>
    <dct:modified>2026-06-05</dct:modified>
    <dct:publisher>Cair Nepal</dct:publisher>
    <dct:title>HeritageGraph Ontology</dct:title>
    <pav:version>1.0.0</pav:version>
    <owl:imports rdf:resource="http://www.cidoc-crm.org/cidoc-crm/"/>
    <owl:imports rdf:resource="http://www.cidoc-crm.org/crminf/"/>
    <owl:imports rdf:resource="http://www.europeana.eu/schemas/edm/"/>
    <owl:imports rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <owl:imports rdf:resource="http://www.w3.org/2006/time#"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/prov#"/>
    <owl:ontologyIRI>https://w3id.org/heritagegraph/ontology</owl:ontologyIRI>
    <owl:versionIRI rdf:resource="https://w3id.org/heritagegraph/ontology/1.0.0"/>
    <owl:versionInfo>1.0.0</owl:versionInfo>
    <skos:definition>An event-centric LinkML schema for representing Nepal cultural heritage information, fully aligned with CIDOC-CRM v7.2.1 and PROV-O. Enables provenance tracking, ritual-spatial-temporal reasoning, and multi-calendar date representation. DL expressivity: ALCIQ(D).</skos:definition>
  </rdf:Description>
