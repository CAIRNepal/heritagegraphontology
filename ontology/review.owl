  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/yearOffsetFromGregorian">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Year offset from gregorian</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <skos:definition xml:lang="en">Number of years this calendar runs ahead of the Gregorian (Common Era) year at the start of its year (e.g. 57 for Bikram Sambat, -879 for Nepal Sambat). Because the calendar's new year does not fall on 1 January (see epoch_date_gregorian), a year-precision date Y converts to the two-year interval [Y - offset, Y - offset + 1] CE; the single year Y - offset is correct only for dates between the calendar's new year and 31 December. A calendar whose new year is 1 January converts to Y - offset exactly.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
