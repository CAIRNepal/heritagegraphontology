    <skos:definition xml:lang="en">Occasional/Festival worship</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/scheme/RitualType"/>
    <skos:prefLabel xml:lang="en">Naimittika Puja</skos:prefLabel>
  </rdf:Description>
