    <rdfs:range rdf:resource="https://cair-nepal.org/heritagegraph/ArchitecturalStructure"/>
    <skos:definition xml:lang="en">Structure where a person resides during a specific period. For Living Goddess, this is typically a Kumari Ghar (god-house).</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/scheme/ConditionType">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Condition Type (concept scheme)</rdfs:label>
