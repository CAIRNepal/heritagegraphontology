  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/RitualType#Jatra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://cair-nepal.org/heritagegraph/RitualType"/>
    <rdfs:label xml:lang="en">Jatra</rdfs:label>
    <skos:definition xml:lang="en">Festival procession ritual</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/scheme/RitualType"/>
    <skos:prefLabel xml:lang="en">Jatra</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b40">
    <rdf:first rdf:resource="https://cair-nepal.org/heritagegraph/StructureType"/>
    <rdf:rest rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b41"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/caste_groups">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">obsolete caste groups</rdfs:label>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Collection of CasteGroup instances</skos:definition>
    <skos:editorialNote xml:lang="en">Deprecated in HeritageGraph 1.1.0: a LinkML serialization construct for JSON/YAML data files, not a domain term. It is defined in HeritageGraph-container.yaml and used only by the JSON Schema; RDF instance data should not use it.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/Tenure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tenure</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b277"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b278"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b279"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b280"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b281"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b282"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b283"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b284"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b285"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b286"/>
    <rdfs:subClassOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E4_Period"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <skos:definition xml:lang="en">A dated period during which an actor holds an office, a duty or custody of something (a CIDOC-CRM E4 Period), with the events that open and close it. KumariTenure, HereditaryRoleTenure and CustodyPeriod are specialisations; the pattern applies to offices and custody beyond Nepal.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/custodyHolder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Custody holder</rdfs:label>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
    <rdfs:subPropertyOf rdf:resource="https://cair-nepal.org/heritagegraph/tenureHolder"/>
    <skos:definition xml:lang="en">Actor (typically a Guthi) holding custody during the period.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/consecratedByEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Consecrated by event</rdfs:label>
    <rdfs:range rdf:resource="https://cair-nepal.org/heritagegraph/Consecration"/>
    <skos:definition xml:lang="en">Consecration event that activated this murti</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/EndowmentEventType#Nationalisation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://cair-nepal.org/heritagegraph/EndowmentEventType"/>
    <rdfs:label xml:lang="en">Nationalisation of an endowment</rdfs:label>
    <dcterms:title xml:lang="en">Nationalisation of an endowment</dcterms:title>
    <skos:definition xml:lang="en">Transfer of an endowment to state administration (e.g. the Guthi Sansthan, established 1964 CE / VS 2021).</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/scheme/EndowmentEventType"/>
    <skos:prefLabel xml:lang="en">Nationalisation of an endowment</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/endowmentDonor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">Endowment donor</rdfs:label>
    <rdfs:range rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E39_Actor"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P23_transferred_title_from"/>
    <skos:definition xml:lang="en">Person or group who gave the property (the donor in a founding or augmentation).</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b135">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:minCardinality>
    <owl:onProperty rdf:resource="https://cair-nepal.org/heritagegraph/roleHolder"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b271">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E53_Place"/>
    <owl:onProperty rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P7_took_place_at"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdf:type rdf:resource="https://cair-nepal.org/heritagegraph/AccessProtocol"/>
    <rdfs:label xml:lang="en">Seasonal</rdfs:label>
    <skos:closeMatch rdf:resource="https://localcontexts.org/label/tk-seasonal/"/>
    <skos:definition xml:lang="en">Access or use only at certain times (e.g. during a festival)</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/scheme/AccessProtocol"/>
    <skos:prefLabel xml:lang="en">Seasonal</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/scheme/ExistenceStatus">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label xml:lang="en">Existence Status (concept scheme)</rdfs:label>
    <skos:definition xml:lang="en">Controlled vocabulary for whether a heritage structure still exists physically.</skos:definition>
    <skos:prefLabel xml:lang="en">Existence Status (concept scheme)</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.cidoc-crm.org/extensions/crminf/I2_Belief">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Belief</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.cidoc-crm.org/extensions/crminf/"/>
    <skos:closeMatch rdf:resource="http://schema.org/Claim"/>
    <skos:definition xml:lang="en">This class comprises the notion that the associated I4 Proposition Set is held to have a particular I6 Belief Value by a particular E39 Actor. This can be understood as the period of time that an individual group holds a particular set of propositions to be true, false, or somewhere in between.</skos:definition>
    <skos:relatedMatch rdf:resource="http://www.w3.org/ns/prov#Entity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b526">
    <rdf:first rdf:resource="https://cair-nepal.org/heritagegraph/StateHeritageAuthority"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b338">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:maxCardinality>
    <owl:onProperty rdf:resource="https://cair-nepal.org/heritagegraph/selectedThrough"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/FearlessnessAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fearlessness Assessment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/RitualAssessment"/>
    <skos:definition xml:lang="en">The 'fearlessness test' popularly described (animal heads, masked dancers in darkness). Its historical and contemporary practice is DISPUTED -- some former Kumaris contest how it is described. Represented as an assessment whose accounts are source-attributed via has_assertion, NOT as a mandatory criterion.</skos:definition>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
    <skos:scopeNote xml:lang="en">Deliberately not a SelectionCriterion subclass: popular accounts and lived testimony disagree. Attach each account as a Assertion (CRMinf I2 Belief) with its own source and confidence.</skos:scopeNote>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/crminf_pattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">obsolete crminf pattern</rdfs:label>
    <dcterms:isReplacedBy rdf:resource="http://www.w3.org/2004/02/skos/core#editorialNote"/>
    <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    <skos:definition xml:lang="en">Editorial note naming the CRMinf pattern that a class instantiates.</skos:definition>
    <skos:editorialNote xml:lang="en">Deprecated in HeritageGraph 1.1.0: the note is published as skos:editorialNote with the prefix 'CRMinf pattern: '.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
