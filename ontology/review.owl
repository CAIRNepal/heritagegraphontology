    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b397">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.cidoc-crm.org/extensions/crminf/I2_Belief"/>
    <owl:onProperty rdf:resource="https://cair-nepal.org/heritagegraph/hasAssertion"/>
