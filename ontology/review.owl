  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/recordedDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">Recorded date</rdfs:label>
