    <rdfs:subClassOf rdf:nodeID="n2e2cf9d97eb446d09da97ae8447aa515b305"/>
    <rdfs:subClassOf rdf:nodeID="n2e2cf9d97eb446d09da97ae8447aa515b306"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/heritagegraph/RitualEvent"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:definition>Ritual or administrative event that formally ends a Living Goddess tenure, marking the person's return to secular status. Common triggers include first menstruation, injury causing blood loss, or serious illness. This event terminates the divine embodiment and restores the girl to ordinary status.</skos:definition>
    <skos:exactMatch rdf:resource="https://w3id.org/heritagegraph/LivingGoddessRetirement"/>
    <skos:inScheme rdf:resource="https://w3id.org/heritagegraph/ontology"/>
  </rdf:Description>
