  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/structureType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has structure type</rdfs:label>
    <dcterms:title xml:lang="en">has structure type</dcterms:title>
    <rdfs:range rdf:resource="https://cair-nepal.org/heritagegraph/StructureType"/>
    <rdfs:subPropertyOf rdf:resource="http://www.cidoc-crm.org/cidoc-crm/P2_has_type"/>
