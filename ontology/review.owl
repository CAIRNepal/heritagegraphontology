    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b105"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b106"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b107"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b108"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b109"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b116"/>
    <rdfs:subClassOf rdf:nodeID="n63bcb614e979492bafa4c52ada91c185b117"/>
    <rdfs:subClassOf rdf:resource="https://cair-nepal.org/heritagegraph/KumariLifecycleEvent"/>
    <skos:broadMatch rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E7_Activity"/>
    <skos:broadMatch rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <skos:definition xml:lang="en">Ritual or administrative event that formally ends a Living Goddess tenure according to tradition, returning the person to secular life. Record the event and its date, not the reason: the traditional grounds concern the bodily state of a child, and HeritageGraph does not record health or bodily data about persons.</skos:definition>
    <skos:editorialNote xml:lang="en">PROV-O alignment note: prov:Activity alignment is a HeritageGraph project-level assertion (not a normative CIDOC axiom; no official CRM&lt;-&gt;PROV mapping exists). Asserted on this class, not on crm:E7_Activity globally.</skos:editorialNote>
    <skos:inScheme rdf:resource="https://cair-nepal.org/heritagegraph/schema"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://cair-nepal.org/heritagegraph/Stupa">
