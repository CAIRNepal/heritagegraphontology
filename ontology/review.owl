  <rdf:Description rdf:about="http://www.cidoc-crm.org/extensions/crminf/I4_Proposition_Set">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Proposition Set</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://www.cidoc-crm.org/extensions/crminf/"/>
    <skos:definition xml:lang="en">This class comprises the sets of formal, binary propositions that an I2 Belief is held about. It could be implemented as a named graph, a spreadsheet, or any other structured dataset. Regardless of the specific syntax employed, the effective propositions it contains should be made up of unambiguous identifiers, concepts of a formal ontology, and constructs of logic.</skos:definition>
  </rdf:Description>
