            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 24 ;
            sh:path dcterms:accessRights ],
