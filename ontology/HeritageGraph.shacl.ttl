            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P50i_is_current_keeper_of ],
        [ sh:description "Type of Guthi (Si, Jatra, Temple)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/GuthiType#SiGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#JatraGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#PujaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#TempleGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#NashaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanaGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#SanGuthi> <https://cair-nepal.org/heritagegraph/GuthiType#RajGuthi> ) ;
            sh:maxCount 1 ;
            sh:name "has guthi type" ;
            sh:order 2 ;
            sh:path hg:guthiType ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 8 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Agent on whose behalf this agent acted." ;
            sh:name "Acted on behalf of"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 7 ;
            sh:path prov:actedOnBehalfOf ] ;
    sh:targetClass hg:Guthi .

hg:ArchitecturalElement a sh:NodeShape ;
    sh:description "Carved or constructed component of an architectural structure (e.g., Gajur, Torana, Tundal)" ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 9 ;
            sh:path dcterms:accessRights ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:ArchitecturalStructure ;
            sh:description "Larger structure that this element is part of" ;
            sh:minCount 1 ;
            sh:name "Is component of"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P46i_forms_part_of ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 6 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 8 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 5 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 4 ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass hg:ArchitecturalElement .

hg:DocumentationActivity a sh:NodeShape ;
    sh:description "Activity that records information about a heritage entity or event and may generate information objects or assertions. It aligns CIDOC CRM documentation practices with prov:Activity." ;
    sh:property [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 5 ;
            sh:path prov:generated ],
        [ sh:description "Equipment used in documentation" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 4 ;
            sh:path hg:usedEquipment ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Pre-existing heritage entity or event recorded by this documentation activity (inverse of was_documented_by)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class hg:ArchitecturalElement ] [ sh:class hg:Deity ] [ sh:class hg:ReligiousTradition ] [ sh:class hg:HistoricalEvent ] [ sh:class hg:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class hg:Consecration ] [ sh:class hg:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class hg:DataSource ] [ sh:class hg:DocumentationActivity ] [ sh:class hg:SyncreticRelationship ] [ sh:class hg:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class hg:KumariRole ] [ sh:class hg:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class hg:CalendarSystem ] [ sh:class hg:Endowment ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:HereditaryRoleTenure ] [ sh:class hg:CustodyPeriod ] ) ;
            sh:order 1 ;
            sh:path hg:documents ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 11 ;
            sh:path dcterms:accessRights ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 2 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 9 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Documentation method used" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path hg:usedMethod ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:endedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:startedAtTime ] ;
    sh:targetClass hg:DocumentationActivity .

hg:RitualEvent a sh:NodeShape ;
    sh:description "Intentional ritual activity that activates sacred space, invokes deities, and binds social groups. An instance is one dated occurrence (one CIDOC-CRM E7 with at most one time-span), e.g. the Indra Jatra of 2025; the recurring practice it belongs to (annual, by lunar date) is described by recurrence_pattern and lunar_date_tithi, not by the instance's time-span." ;
    sh:property [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path hg:hasAssertion ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path hg:routePlaces ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 28 ;
            sh:path prov:wasInformedBy ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path hg:documentedBy ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path hg:startPlace ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path prov:endedAtTime ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path hg:invokesDeity ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 7 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 25 ;
            sh:path prov:used ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 11 ;
            sh:path hg:performedByGroup ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:managedByGuthi ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 30 ;
            sh:path dcterms:accessRights ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 3 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 26 ;
            sh:path prov:generated ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 29 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 8 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path prov:startedAtTime ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:hadParticipant ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 2 ;
            sh:path hg:ritualType ],
        [ sh:description "Text description of the procession route" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 22 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 27 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:endPlace ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass hg:RitualEvent .

