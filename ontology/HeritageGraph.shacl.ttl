            sh:order 9 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Areas of expertise (e.g., Licchavi inscriptions, Sanskrit epigraphy, Newari archaeology)" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 8 ;
            sh:path hg:expertiseArea ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:RitualEvent ;
            sh:description "Activities performed by this actor" ;
            sh:name "Carried out activity"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P14i_performed ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Person's death timespan (shortcut for crm:P100i_died_in / crm:P4_has_time-span)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:deathTimespan ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:Guthi ;
            sh:description "Groups this person belongs to" ;
            sh:name "Member of group"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P107i_is_current_or_former_member_of ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Person's birth timespan (shortcut for crm:P98i_was_born / crm:P4_has_time-span)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path hg:birthTimespan ],
        [ sh:description "Institutional affiliation (e.g., Tribhuvan University, Nepal Heritage Society)" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 7 ;
            sh:path hg:institutionalAffiliation ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ] ;
    sh:targetClass crm:E21_Person .

hg:PlaceShape a sh:NodeShape ;
    sh:description "Defined geographic location where events occur and structures exist" ;
    sh:name "Place"@en ;
