hg:ArchitecturalStructure a sh:NodeShape ;
    sh:description "Physical structures built for religious, social, or civic purposes. Links to events of production, use, custody, and documentation." ;
    sh:or ( [ sh:not [ sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> ) ] ;
                sh:path hg:existenceStatus ] [ sh:minCount 1 ;
                sh:path crm:P55_has_current_location ] ) ;
    sh:property [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:name "has destruction event" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path hg:destructionEvent ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path hg:hypothesizedLocation ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this structure (a temple, or a pavilion, rest house or water spout with a shrine)" ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:hasReligiousTradition ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path hg:lastKnownExistenceDate ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:managedByGuthi ],
        [ sh:class hg:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:participatesInRitual ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 19 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 22 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 21 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:order 6 ;
            sh:path hg:hasArchitecturalStyle ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path hg:documentedBy ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class hg:ArchitecturalElement ;
