        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P55_has_current_location ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 17 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:name "Has custody event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class heritageGraph:Consecration ;
            sh:description "Consecration event that activated this murti" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:consecratedByEvent ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity depicted iconographically (not cultic presence)" ;
            sh:name "Depicts deity"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P62_depicts ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:name "Was produced by event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass heritageGraph:Murti .

heritageGraph:Proposition a sh:NodeShape ;
    sh:description "A single machine-readable proposition (subject - predicate - object) held true by an Assertion. Modelled as a singleton proposition set (CRMinf I4); the predicate is a URI/CURIE, the object either a heritage entity or a literal." ;
    sh:property [ sh:description "Entity the proposition is about (plays the role of rdf:subject)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] [ sh:class heritageGraph:Endowment ] [ sh:class heritageGraph:EndowmentEvent ] [ sh:class heritageGraph:HereditaryRoleTenure ] [ sh:class heritageGraph:CustodyPeriod ] ) ;
            sh:order 0 ;
            sh:path heritageGraph:propositionSubject ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Property (URI/CURIE) claimed of the subject, e.g. crm:P108i_was_produced_by (plays the role of rdf:predicate)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path heritageGraph:propositionPredicate ],
        [ sh:datatype xsd:string ;
            sh:description "Object of the proposition when it is a literal value (e.g. a date)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:propositionLiteralValue ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 9 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Object of the proposition when it is a heritage entity (plays the role of rdf:object)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class heritageGraph:ArchitecturalElement ] [ sh:class heritageGraph:Deity ] [ sh:class heritageGraph:ReligiousTradition ] [ sh:class heritageGraph:HistoricalEvent ] [ sh:class heritageGraph:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class heritageGraph:Consecration ] [ sh:class heritageGraph:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class heritageGraph:DataSource ] [ sh:class heritageGraph:DocumentationActivity ] [ sh:class heritageGraph:SyncreticRelationship ] [ sh:class heritageGraph:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class heritageGraph:KumariRole ] [ sh:class heritageGraph:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class heritageGraph:CalendarSystem ] [ sh:class heritageGraph:Endowment ] [ sh:class heritageGraph:EndowmentEvent ] [ sh:class heritageGraph:HereditaryRoleTenure ] [ sh:class heritageGraph:CustodyPeriod ] ) ;
            sh:order 2 ;
            sh:path heritageGraph:propositionObjectEntity ] ;
    sh:targetClass heritageGraph:Proposition .

heritageGraph:Temple a sh:NodeShape ;
    sh:description "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion." ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path heritageGraph:mentionedInSource ],
        [ sh:class heritageGraph:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:name "Has component"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 24 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this religious structure" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:hasReligiousTradition ],
        [ sh:description "Current physical status of the structure" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
            sh:maxCount 1 ;
            sh:name "has existence status" ;
            sh:order 9 ;
            sh:path heritageGraph:existenceStatus ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:name "has destruction event" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:destructionEvent ],
        [ sh:class heritageGraph:Enshrinement ;
            sh:description "Enshrinement event that installed deity in temple" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:enshrinesDeityThroughEvent ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path heritageGraph:lastKnownExistenceDate ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 1 ;
            sh:path heritageGraph:hasArchitecturalStyle ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P55_has_current_location ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:name "Was produced by event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:hypothesizedLocation ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:name "Has custody event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P30i_custody_transferred_through ] ;
    sh:targetClass heritageGraph:Temple .

heritageGraph:KumariSelectionEvent a sh:NodeShape ;
    sh:description "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana), horoscope matching with the city and ruling authority, and tests of fearlessness (e.g., remaining calm among buffalo heads and masked dancers in darkness). Performed by committee of Vajracharya priests, royal priest (Raj Jyotish), and astrologer." ;
    sh:property [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class heritageGraph:Guthi ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 5 ;
            sh:path heritageGraph:performedByGroup ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path heritageGraph:invokesDeity ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path heritageGraph:routePlaces ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path crm:P3_has_note ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 34 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 33 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E21_Person ;
            sh:description "Girl selected to become Living Goddess" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:selectedPerson ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 28 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path heritageGraph:endPlace ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:maxCount 1 ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class heritageGraph:KumariTenure ;
            sh:description "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path heritageGraph:boundsTenure ],
        [ sh:class heritageGraph:KumariTenure ;
            sh:description "Living Goddess tenure that this selection event initiated" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:initiatedTenure ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this ritual is essential for the festival's completion" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path heritageGraph:isCriticalForFestival ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path prov:generated ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path heritageGraph:startPlace ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:maxCount 1 ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:maxCount 1 ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 15 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency of recurring ritual (e.g., annual, monthly)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path heritageGraph:recurrencePattern ],
        [ sh:class heritageGraph:KumariRole ;
            sh:description "KumariRole conferred by this selection or enthronement event." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path heritageGraph:confersRole ],
        [ sh:class heritageGraph:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:maxCount 1 ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 29 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 36 ;
            sh:path prov:endedAtTime ],
        [ sh:class heritageGraph:SelectionCriterion ;
            sh:description "Eligibility criterion applied in this selection." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:hasCriterion ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path prov:used ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 14 ;
            sh:path heritageGraph:ritualType ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 35 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Name of selection event" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass heritageGraph:KumariSelectionEvent .

crm:E21_Person a sh:NodeShape ;
    sh:description "Individual person who performs, commissions, documents, or verifies heritage activities" ;
    sh:name "Person"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Institutional affiliation (e.g., Tribhuvan University, Nepal Heritage Society)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path heritageGraph:institutionalAffiliation ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Activities performed by this actor" ;
            sh:name "Carried out activity"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P14i_performed ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Person's birth timespan" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:birthTimespan ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Groups this person belongs to" ;
            sh:name "Member of group"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P107i_is_current_or_former_member_of ],
        [ sh:datatype xsd:string ;
            sh:description "Areas of expertise (e.g., Licchavi inscriptions, Sanskrit epigraphy, Newari archaeology)" ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:expertiseArea ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Person's death timespan" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:deathTimespan ],
        [ sh:class prov:Agent ;
            sh:description "Agent on whose behalf this agent acted." ;
            sh:name "Acted on behalf of"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:targetClass crm:E21_Person .

crm:E22_Human-Made_Object a sh:NodeShape ;
    sh:description "Physical objects created by human activity" ;
    sh:name "Human Made Object"@en ;
    sh:property [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P55_has_current_location ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:name "Was produced by event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:name "Has custody event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass crm:E22_Human-Made_Object .

heritageGraph:CustodyPeriod a sh:NodeShape ;
    sh:description "Dated period during which an actor (typically a Guthi) holds custody of a heritage structure or object, opened and closed by transfer-of-custody events. Unlike the untimed crm:P50i_is_current_keeper_of, it answers who held custody at a given date." ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Structure or object in custody during the period." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 3 ;
            sh:path heritageGraph:custodyObject ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Transfer of custody that ended the period." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:custodyClosedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Transfer of custody that began the period." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:custodyOpenedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 13 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor (typically a Guthi) holding custody during the period." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:custodyHolder ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass heritageGraph:CustodyPeriod .

heritageGraph:EndowmentEvent a sh:NodeShape ;
    sh:description "Event that founds, augments, nationalises or alienates a Guthi endowment, with its donor or recipient and its date." ;
    sh:property [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:description "Kind of endowment event (founding, augmentation, nationalisation, alienation)." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/EndowmentEventType#Founding> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Augmentation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Nationalisation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Alienation> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path heritageGraph:endowmentEventType ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:endedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Guthi or state body that received the property (e.g. the Guthi Sansthan in a nationalisation)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:endowmentRecipient ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 14 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:used ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class heritageGraph:Endowment ;
            sh:description "Endowment founded, augmented, nationalised or alienated by this event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:concernsEndowment ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P7_took_place_at ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or group who gave the property (the donor in a founding or augmentation)." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:endowmentDonor ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ] ;
    sh:targetClass heritageGraph:EndowmentEvent .

heritageGraph:HistoricalEvent a sh:NodeShape ;
    sh:description "Major event affecting heritage structures or ritual life (earthquake, epidemic, political transition, fire, flood)." ;
    sh:property [ sh:class heritageGraph:RitualEvent ;
            sh:description "Component rituals of festival" ;
            sh:name "Includes ritual event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P9_consists_of ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:endedAtTime ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:startedAtTime ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P7_took_place_at ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "Heritage structures affected by or present during this historical event" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:architecturalStructures ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P4_has_time-span ] ;
    sh:targetClass heritageGraph:HistoricalEvent .

heritageGraph:SyncreticRelationship a sh:NodeShape ;
    sh:description "Formalizes the syncretic equivalence between divine entities across different theological frameworks. Following CIDOC CRM E13, it treats syncretism as a propositional claim with associated epistemic authority and provenance." ;
    sh:property [ sh:class heritageGraph:Deity ;
            sh:description "The deity or sacred figure being identified as equivalent to the primary deity." ;
            sh:minCount 1 ;
            sh:name "Assigned equivalent"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P141_assigned ],
        [ sh:class heritageGraph:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:mentionedInSource ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:startedAtTime ],
        [ sh:class heritageGraph:Deity ;
            sh:description "The deity instance that is the subject of the syncretic claim." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Assigned to deity"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P140_assigned_attribute_to ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> <https://cair-nepal.org/heritagegraph/SyncreticType#Appropriation> <https://cair-nepal.org/heritagegraph/SyncreticType#Fusion> <https://cair-nepal.org/heritagegraph/SyncreticType#Historical> ) ;
            sh:maxCount 1 ;
            sh:name "has syncretic type" ;
            sh:order 4 ;
            sh:path heritageGraph:syncreticType ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:generated ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:used ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:endedAtTime ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ] ;
    sh:targetClass heritageGraph:SyncreticRelationship .

crm:E29_Design_or_Procedure a sh:NodeShape ;
    sh:description "Method or craft process used in production or ritual" ;
    sh:name "Technique"@en ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 7 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ] ;
    sh:targetClass crm:E29_Design_or_Procedure .

crm:E3_Condition_State a sh:NodeShape ;
    sh:description "A physical condition state of a heritage object" ;
    sh:name "Condition State"@en ;
    sh:property [ sh:description "Categorization of the condition state" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ConditionType#Good> <https://cair-nepal.org/heritagegraph/ConditionType#Damaged> <https://cair-nepal.org/heritagegraph/ConditionType#Ruined> <https://cair-nepal.org/heritagegraph/ConditionType#Restored> ) ;
            sh:maxCount 1 ;
            sh:order 2 ;
            sh:path heritageGraph:hasConditionType ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 8 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass crm:E3_Condition_State .

heritageGraph:CalendarSystem a sh:NodeShape ;
    sh:description "Calendar reckoning system with conversion rules for multi-calendar temporal reasoning" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:integer ;
            sh:description "Mathematical offset to convert to Common Era (e.g., +57 for BS)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:yearOffsetFromGregorian ],
        [ sh:datatype xsd:string ;
            sh:description "The start date of this calendar era in Gregorian ISO format." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path heritageGraph:epochDateGregorian ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:ReligiousTradition ;
            sh:description "Religious tradition(s) that primarily use this calendar system (e.g., Bikram Sambat for Hindu, Nepal Sambat for Newar Buddhist)" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:isPrimaryForTradition ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass heritageGraph:CalendarSystem .

heritageGraph:Consecration a sh:NodeShape ;
    sh:description "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)" ;
    sh:property [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:startedAtTime ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:class heritageGraph:Murti ;
            sh:description "Murti employed in (and transformed by) the consecration ritual" ;
            sh:maxCount 1 ;
            sh:name "Consecrated object"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path crm:P16_used_specific_object ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity made present through consecration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:makesDeityPresent ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:targetClass heritageGraph:Consecration .

heritageGraph:Endowment a sh:NodeShape ;
    sh:description "Land, income or other property permanently dedicated to sustain a structure, a ritual or festival, or a sacred office, and held by a Guthi. The endowment, not the membership, is what makes a Guthi a trust." ;
    sh:property [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Structure, ritual or festival, or sacred office whose upkeep or performance the endowment funds." ;
            sh:minCount 1 ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:RitualEvent ] [ sh:class heritageGraph:KumariTenure ] [ sh:class heritageGraph:HereditaryRoleTenure ] ) ;
            sh:order 4 ;
            sh:path heritageGraph:sustains ],
        [ sh:class crm:E53_Place ;
            sh:description "Land (plots, fields) dedicated to the endowment." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:endowedLand ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi that holds the endowment." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Endowment holder"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P105_right_held_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ] ;
    sh:targetClass heritageGraph:Endowment .

heritageGraph:SelectionCriterion a sh:NodeShape ;
    sh:description "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text." ;
    sh:property [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass heritageGraph:SelectionCriterion .

heritageGraph:Enshrinement a sh:NodeShape ;
    sh:description "Event of installing a deity's murti or symbol within a temple sanctum" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity installed through enshrinement" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:enshrinedDeity ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class heritageGraph:Temple ;
            sh:description "Temple where deity was enshrined" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:enshrinedInStructure ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:endedAtTime ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:startedAtTime ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass heritageGraph:Enshrinement .

heritageGraph:Festival a sh:NodeShape ;
    sh:description "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Frequency of recurring ritual (e.g., annual, monthly)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path heritageGraph:recurrencePattern ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:string ;
            sh:description "Text description of the procession route" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path heritageGraph:routeDescription ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path heritageGraph:routePlaces ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Component rituals of festival" ;
            sh:name "Includes ritual event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path crm:P9_consists_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path heritageGraph:startPlace ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path rdfs:label ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class heritageGraph:Guthi ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 12 ;
            sh:path heritageGraph:performedByGroup ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 29 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 31 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:string ;
            sh:description "Lunar day (Tithi) for ritual timing" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path heritageGraph:lunarDateTithi ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path heritageGraph:managedByGuthi ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path heritageGraph:endPlace ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:invokesDeity ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:maxCount 1 ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path prov:startedAtTime ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 3 ;
            sh:path heritageGraph:ritualType ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:maxCount 1 ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class heritageGraph:ArchitecturalStructure ] [ sh:class heritageGraph:IconographicObject ] [ sh:class heritageGraph:ArchitecturalElement ] ) ;
            sh:order 4 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path prov:used ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class heritageGraph:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:maxCount 1 ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path prov:generated ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:maxCount 1 ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P183_ends_before_the_start_of ] ;
    sh:targetClass heritageGraph:Festival .

heritageGraph:HereditaryRoleTenure a sh:NodeShape ;
    sh:description "Time-bounded holding of a hereditary ritual duty by a person or caste group, under the mandate of a Guthi, with the rule by which the duty passes on. The same period pattern as KumariTenure, applied to hereditary offices (priests, chariot builders, musicians)." ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 15 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Person or caste group holding the hereditary duty during this tenure." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:class crm:E21_Person ] [ sh:class heritageGraph:CasteGroup ] ) ;
            sh:order 2 ;
            sh:path heritageGraph:roleHolder ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Ritual or festival the hereditary duty serves." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:dutyFor ],
        [ sh:datatype xsd:string ;
            sh:description "Rule by which the duty passes on (e.g. eldest son of the lineage; within the caste group)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path heritageGraph:successionRule ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path heritageGraph:hasAssertion ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class heritageGraph:HereditaryRoleTenure ;
            sh:description "Earlier tenure of the same hereditary office that this tenure succeeds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:succeeds ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:string ;
            sh:description "The ritual duty held (e.g. building the festival chariot, performing the daily worship)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path heritageGraph:roleDuty ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi that mandates (and usually funds) the hereditary duty." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:mandatedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:generatedAtTime ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass heritageGraph:HereditaryRoleTenure .

heritageGraph:CasteGroup a sh:NodeShape ;
    sh:description "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    sh:property [ sh:class prov:Agent ;
            sh:description "Agent on whose behalf this agent acted." ;
            sh:name "Acted on behalf of"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:string ;
            sh:description "Hereditary occupation or ritual duty" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path heritageGraph:traditionalRole ] ;
    sh:targetClass heritageGraph:CasteGroup .

heritageGraph:KumariRole a sh:NodeShape ;
    sh:description "The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder." ;
    sh:property [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity embodied by whoever holds this role (e.g., Taleju)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path heritageGraph:roleDeity ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 6 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path dcterms:identifier ] ;
    sh:targetClass heritageGraph:KumariRole .

crm:E6_Destruction a sh:NodeShape ;
    sh:description "Event that destroyed or damaged a structure." ;
    sh:name "Destruction Event"@en ;
    sh:property [ sh:class prov:Entity ;
            sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class prov:Agent ;
            sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:maxCount 1 ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class prov:Activity ;
            sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "Heritage structures affected by or present during this historical event" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:architecturalStructures ],
        [ sh:class prov:Entity ;
            sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path rdfs:label ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path prov:startedAtTime ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Component rituals of festival" ;
            sh:name "Includes ritual event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P9_consists_of ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path crm:P3_has_note ] ;
    sh:targetClass crm:E6_Destruction .

heritageGraph:IconographicObject a sh:NodeShape ;
    sh:description "Sacred visual art objects that depict or embody deities through iconographic conventions" ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "Primary name or label" ;
            sh:maxCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:maxCount 1 ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P55_has_current_location ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:name "Has custody event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity depicted iconographically (not cultic presence)" ;
            sh:name "Depicts deity"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P62_depicts ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who use, handle, or are responsible for this object in ritual contexts" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:usedBy ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:name "Was produced by event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class heritageGraph:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path heritageGraph:participatesInRitual ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 15 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "Free-text note (description, reason, verification notes)" ;
            sh:maxCount 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P3_has_note ] ;
    sh:targetClass heritageGraph:IconographicObject .

heritageGraph:KumariTenure a sh:NodeShape ;
    sh:description "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families." ;
    sh:property [ sh:class heritageGraph:KumariSelectionEvent ;
            sh:description "Selection event that initiated this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path heritageGraph:selectedThrough ],
        [ sh:class heritageGraph:KumariRole ;
            sh:description "KumariRole held during this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path heritageGraph:assumesRole ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:class heritageGraph:KumariEnthronementEvent ;
            sh:description "Enthronement event that activated this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path heritageGraph:enthronedThrough ],
        [ sh:class heritageGraph:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path heritageGraph:documentedBy ],
        [ sh:class heritageGraph:Guthi ;
            sh:description "Guthi or state body providing economic/ritual support during tenure" ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path heritageGraph:supportedByInstitution ],
        [ sh:datatype xsd:string ;
            sh:description "Name of this tenure period (e.g., 'Kumari Samita Bajracharya Tenure 2015-2023')" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path rdfs:label ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class crm:E21_Person ;
            sh:description "The girl serving as Living Goddess during this period" ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path heritageGraph:hadParticipant ],
        [ sh:class heritageGraph:ArchitecturalStructure ;
            sh:description "God-house where Living Goddess resides (e.g., Kumari Ghar)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path heritageGraph:residenceStructure ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Duration of Living Goddess tenure (from selection to retirement)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 16 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class heritageGraph:KumariRetirementEvent ;
            sh:description "Retirement/desanctification event that ended this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path heritageGraph:retiredThrough ],
        [ sh:class heritageGraph:Deity ;
            sh:description "Deity believed to be present in this person (e.g., Taleju, Kumari Devi)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:embodiedDeity ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass heritageGraph:KumariTenure .

heritageGraph:ReligiousTradition a sh:NodeShape ;
    sh:description "Religious or philosophical tradition (e.g., Hindu, Buddhist, Syncretic)" ;
