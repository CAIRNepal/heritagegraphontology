            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P183i_starts_after_the_end_of ] ;
    sh:targetClass heritageGraph:KumariLifecycleEvent .

