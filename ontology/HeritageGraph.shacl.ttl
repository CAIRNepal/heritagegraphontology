            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 4 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 5 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 7 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass crm:E29_Design_or_Procedure .

hg:TimeSpanShape a sh:NodeShape ;
    sh:description "Temporal extent of an event or period" ;
    sh:name "Time Span"@en ;
    sh:or ( [ sh:maxCount 0 ;
                sh:path hg:recordedDate ] [ sh:minCount 1 ;
                sh:path hg:calendarSystem ] ) ;
    sh:property [ sh:description "The earliest date is not after the latest date." ;
            sh:lessThanOrEquals crm:P82b_end_of_the_end ;
            sh:path crm:P82a_begin_of_the_begin ],
        [ sh:class hg:CalendarSystem ;
            sh:description "Calendar system used for date representation" ;
            sh:maxCount 1 ;
            sh:name "has calendar system" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:calendarSystem ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "A time-span that contains this one: e.g. the exact time-span of an occurrence falls within the converted interval of each calendar record of it (a Bikram Sambat or Nepal Sambat year)." ;
            sh:name "Falls within"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path crm:P86_falls_within ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Earliest possible date, always in the proleptic Gregorian calendar (xsd:dateTime); for a date recorded in another calendar, the start of its converted Gregorian interval (see recorded_date)." ;
            sh:maxCount 1 ;
            sh:name "Date earliest"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path crm:P82a_begin_of_the_begin ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 7 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "The level of precision for a recorded date." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/DatePrecision#Exact> <https://cair-nepal.org/heritagegraph/DatePrecision#Year> <https://cair-nepal.org/heritagegraph/DatePrecision#Month> <https://cair-nepal.org/heritagegraph/DatePrecision#Decade> <https://cair-nepal.org/heritagegraph/DatePrecision#Century> <https://cair-nepal.org/heritagegraph/DatePrecision#Circa> ) ;
            sh:maxCount 1 ;
            sh:name "has date precision" ;
            sh:order 3 ;
            sh:path hg:datePrecision ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest possible date, always in the proleptic Gregorian calendar (xsd:dateTime); for a date recorded in another calendar, the end of its converted Gregorian interval (see recorded_date)." ;
            sh:maxCount 1 ;
            sh:name "Date latest"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P82b_end_of_the_end ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 12 ;
            sh:path hg:accessProtocol ],
        [ sh:description "The date as written in the source, in the calendar given by calendar_system (e.g. '2072' for a Bikram Sambat year, 'NS 1135 Kaulaathwa', 'VS 2021'). It is never put into an xsd:dateTime: the converted Gregorian bounds go in date_earliest / date_latest." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 4 ;
            sh:path hg:recordedDate ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass crm:E52_Time-Span .

hg:TransferOfCustodyShape a sh:NodeShape ;
    sh:description "Event of transferring responsibility for temple maintenance, ritual performance, or artifact stewardship" ;
    sh:name "Transfer Of Custody"@en ;
    sh:property [ sh:class hg:Guthi ;
            sh:description "New custodian (Guthi)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:transferredToGuthi ],
        [ sh:description "Object transferred in custody event" ;
            sh:name "Transferred object"@en ;
            sh:or ( [ sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ] [ sh:class crm:E22_Human-Made_Object ] ) ;
            sh:order 1 ;
            sh:path crm:P30_transferred_custody_of ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 10 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E39_Actor ;
            sh:description "Previous custodian" ;
            sh:name "Transferred from actor"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P28_custody_surrendered_by ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 11 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 9 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:startedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "New custodian (person or group)" ;
            sh:name "Transferred to actor"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P29_custody_received_by ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:endedAtTime ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 13 ;
            sh:path hg:accessProtocol ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass crm:E10_Transfer_of_Custody .

hg:shapes a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:source hg:ontology ;
    dcterms:title "HeritageGraph SHACL shapes"@en ;
    owl:versionInfo "1.0.1" .

<https://cair-nepal.org/heritagegraph/shapes/ConflictingBeliefHasRivalShape> a sh:NodeShape ;
    sh:severity sh:Violation ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/ConflictingBeliefHasRival> ;
    sh:targetSubjectsOf hg:reconciliationStatus .

<https://cair-nepal.org/heritagegraph/shapes/DeprecatedPropertyShape> a sh:NodeShape ;
    sh:severity sh:Warning ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/DeprecatedProperty> ;
    sh:targetClass crm:E10_Transfer_of_Custody,
        crm:E12_Production,
        crm:E14_Condition_Assessment,
        crm:E21_Person,
        crm:E22_Human-Made_Object,
        crm:E29_Design_or_Procedure,
        crm:E39_Actor,
        crm:E3_Condition_State,
        crm:E52_Time-Span,
        crm:E53_Place,
        crm:E57_Material,
        crm:E6_Destruction,
        crminf:I2_Belief,
        hg:AgeCriterion,
        hg:ArchitecturalElement,
        hg:ArchitecturalStructure,
        hg:ArchivalRecord,
        hg:AssertionSubject,
        hg:CalendarSystem,
        hg:CasteGroup,
        hg:Chaitya,
        hg:ChariotFestival,
        hg:Consecration,
        hg:CustodyPeriod,
        hg:DataCustodian,
        hg:DataSource,
        hg:Deity,
        hg:Dharmashala,
        hg:DhungeDhara,
        hg:DocumentationActivity,
        hg:Endowment,
        hg:EndowmentEvent,
        hg:Enshrinement,
        hg:FearlessnessAssessment,
        hg:Festival,
        hg:FieldSurveyActivity,
        hg:FieldSurveyDataset,
        hg:Guthi,
        hg:HereditaryRoleTenure,
        hg:HistoricalEvent,
        hg:HoroscopeCompatibilityCriterion,
        hg:IconographicObject,
        hg:InformationObject,
        hg:KumariEnthronementEvent,
        hg:KumariHouse,
        hg:KumariLifecycleEvent,
        hg:KumariRetirementEvent,
        hg:KumariRole,
        hg:KumariSelectionEvent,
        hg:KumariTenure,
        hg:LineageCriterion,
        hg:MaskedDance,
        hg:Murti,
        hg:Office,
        hg:OralHistoryInterview,
        hg:OralHistoryRecording,
        hg:Pati,
        hg:Paubha,
        hg:PhysicalHeritageThing,
        hg:PhysicalIntegrityCriterion,
        hg:Pokhari,
        hg:Proposition,
        hg:ReligiousStructure,
        hg:ReligiousTradition,
        hg:RestHouse,
        hg:RitualAssessment,
        hg:RitualEvent,
        hg:RitualOffice,
        hg:Sattal,
        hg:SelectionCriterion,
        hg:StateHeritageAuthority,
        hg:StructureType,
        hg:Stupa,
        hg:SyncreticRelationship,
        hg:Temple,
        hg:Tenure,
        hg:TenureEvent,
        hg:ThirtyTwoPerfectionsCriterion,
        hg:Verification,
        hg:WaterStructure .

<https://cair-nepal.org/heritagegraph/shapes/ConflictingBeliefHasRival> a sh:SPARQLConstraint ;
    rdfs:comment "A belief marked conflicting needs at least one other belief about the same subject or a subject directly linked to it (e.g. a belief about a syncretic relationship and one about its deity)."@en ;
    sh:message "A belief marked conflicting needs at least one other belief about the same subject or a subject directly linked to it (e.g. a belief about a syncretic relationship and one about its deity)."@en ;
    sh:select "SELECT $this WHERE { $this <https://cair-nepal.org/heritagegraph/reconciliationStatus> ?st . FILTER(LCASE(STR(?st)) = \"conflicting\") OPTIONAL { $this <https://cair-nepal.org/heritagegraph/assertsAbout> ?subj . ?other <https://cair-nepal.org/heritagegraph/assertsAbout> ?s2 . FILTER(?other != $this) FILTER(?s2 = ?subj || EXISTS { ?subj ?p1 ?s2 } || EXISTS { ?s2 ?p2 ?subj }) } FILTER(!BOUND(?other)) }" .

<https://cair-nepal.org/heritagegraph/shapes/DeprecatedProperty> a sh:SPARQLConstraint ;
    rdfs:comment "Uses a deprecated HeritageGraph property; see its dcterms:isReplacedBy."@en ;
    sh:message "Uses a deprecated HeritageGraph property; see its dcterms:isReplacedBy."@en ;
    sh:select "SELECT $this ?path WHERE { $this ?path ?o . FILTER(?path IN (<https://cair-nepal.org/heritagegraph/actors>, <https://cair-nepal.org/heritagegraph/architectural_elements>, <https://cair-nepal.org/heritagegraph/assertions>, <https://cair-nepal.org/heritagegraph/calendar_systems>, <https://cair-nepal.org/heritagegraph/caste_groups>, <https://cair-nepal.org/heritagegraph/condition_assessments>, <https://cair-nepal.org/heritagegraph/condition_states>, <https://cair-nepal.org/heritagegraph/consecration_events>, <https://cair-nepal.org/heritagegraph/crminf_pattern>, <https://cair-nepal.org/heritagegraph/curator>, <https://cair-nepal.org/heritagegraph/custody_events>, <https://cair-nepal.org/heritagegraph/data_custodians>, <https://cair-nepal.org/heritagegraph/data_sources>, <https://cair-nepal.org/heritagegraph/dataset_name>, <https://cair-nepal.org/heritagegraph/dataset_version>, <https://cair-nepal.org/heritagegraph/deities>, <https://cair-nepal.org/heritagegraph/design_note>, <https://cair-nepal.org/heritagegraph/documentation_activities>, <https://cair-nepal.org/heritagegraph/enshrinement_events>, <https://cair-nepal.org/heritagegraph/festivals>, <https://cair-nepal.org/heritagegraph/generated_date>, <https://cair-nepal.org/heritagegraph/guthis>, <https://cair-nepal.org/heritagegraph/historical_events>, <https://cair-nepal.org/heritagegraph/human_made_objects>, <https://cair-nepal.org/heritagegraph/iconographic_objects>, <https://cair-nepal.org/heritagegraph/information_objects>, <https://cair-nepal.org/heritagegraph/kumari_lifecycle_events>, <https://cair-nepal.org/heritagegraph/kumari_roles>, <https://cair-nepal.org/heritagegraph/kumari_tenures>, <https://cair-nepal.org/heritagegraph/license>, <https://cair-nepal.org/heritagegraph/materials>, <https://cair-nepal.org/heritagegraph/metadata>, <https://cair-nepal.org/heritagegraph/persons>, <https://cair-nepal.org/heritagegraph/physical_heritage_things>, <https://cair-nepal.org/heritagegraph/places>, <https://cair-nepal.org/heritagegraph/production_events>, <https://cair-nepal.org/heritagegraph/propositions>, <https://cair-nepal.org/heritagegraph/prov_alignment>, <https://cair-nepal.org/heritagegraph/prov_alignment_note>, <https://cair-nepal.org/heritagegraph/provenance_scope>, <https://cair-nepal.org/heritagegraph/religious_traditions>, <https://cair-nepal.org/heritagegraph/ritual_assessments>, <https://cair-nepal.org/heritagegraph/ritual_events>, <https://cair-nepal.org/heritagegraph/schema_version>, <https://cair-nepal.org/heritagegraph/selectionCriteriaMet>, <https://cair-nepal.org/heritagegraph/selection_criteria>, <https://cair-nepal.org/heritagegraph/structures>, <https://cair-nepal.org/heritagegraph/syncretic_relationships>, <https://cair-nepal.org/heritagegraph/techniques>, <https://cair-nepal.org/heritagegraph/time_spans>)) }" .

hg:AgeCriterion a sh:NodeShape ;
    sh:description "Candidate must be within the prescribed pre-pubescent age range." ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 6 ;
            sh:path hg:accessProtocol ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:AgeCriterion .

hg:ArchivalRecord a sh:NodeShape ;
    sh:description "Government or institutional administrative record" ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Entity responsible for making the source available" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:sourcePublisher ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 13 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Formal citation of source" ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 7 ;
            sh:path hg:sourceCitation ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or organization primarily responsible for creating the source" ;
            sh:name "source creator" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path hg:sourceCreator ],
        [ sh:datatype xsd:string ;
            sh:description "Language of the source material" ;
            sh:minLength 1 ;
            sh:name "Source language"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path schema:inLanguage ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 12 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:string ;
            sh:description "URL or digital identifier for source" ;
            sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 8 ;
            sh:path hg:sourceUrl ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 10 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 14 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 16 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:string ;
            sh:description "High-level DataCite resource type (Dataset, Text, Image, Audio, Interview)" ;
            sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path hg:resourceType ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "When source was published" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path hg:publicationTimespan ],
        [ sh:datatype xsd:string ;
            sh:description "Persistent identifier for the source (DOI, archive ID, catalog number)" ;
            sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path hg:persistentIdentifier ],
        [ sh:datatype xsd:string ;
            sh:description "Type of identifier (DOI, ISBN, Handle, LocalArchiveID)" ;
            sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path hg:identifierScheme ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 17 ;
            sh:path hg:accessProtocol ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:ArchivalRecord .

hg:AssertionSubject a sh:NodeShape ;
    sh:description "Any HeritageGraph entity or event that may be the subject of an assertion." ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:AssertionSubject .

hg:Chaitya a sh:NodeShape ;
    sh:description "Buddhist votive shrine (chaitya); votive stupa form found across the Kathmandu Valley. In Newar usage chaitya (Newar chibhah) also names great stupas (Swayambhu Mahachaitya), so a monument may be both a Stupa and a Chaitya." ;
    sh:or ( [ sh:not [ sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> ) ] ;
                sh:path hg:existenceStatus ] [ sh:minCount 1 ;
                sh:path crm:P55_has_current_location ] ) ;
    sh:property [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:StructureType ;
            sh:description "Type of the structure from a controlled vocabulary or a local term list (e.g. bahah, dyochhen), finer than its class; a subproperty of crm:P2_has_type." ;
            sh:name "has structure type" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path hg:structureType ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 20 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path hg:documentedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path hg:lastKnownExistenceDate ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 22 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 21 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path hg:hasAssertion ],
        [ sh:class hg:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path hg:participatesInRitual ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:name "Was produced by event"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 25 ;
            sh:path hg:accessProtocol ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path hg:managedByGuthi ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path hg:hypothesizedLocation ],
        [ sh:description "Current physical status of the structure" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
            sh:maxCount 1 ;
            sh:name "has existence status" ;
            sh:order 9 ;
            sh:path hg:existenceStatus ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 24 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P55_has_current_location ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:name "has destruction event" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path hg:destructionEvent ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:name "Has custody event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:class hg:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this structure (a temple, or a pavilion, rest house or water spout with a shrine)" ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:hasReligiousTradition ],
        [ sh:class hg:DataSource ;
            sh:description "Source(s) that mention/document this entity: the normative way to cite a source for a description of a heritage thing, event, actor or relationship. Distinct from was_derived_from, which is used only on assertions (I2 Belief) with was_attributed_to for the claimant. A source's own bibliographic data uses source_citation, datacite_creator, source_url and datacite_identifier. Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:mentionedInSource ],
        [ sh:class hg:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:name "Has component"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:order 7 ;
            sh:path hg:hasArchitecturalStyle ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:Chaitya .

hg:ChariotFestival a sh:NodeShape ;
    sh:description "Festival involving ceremonial chariot procession (e.g., Rato Machhindranath Jatra)" ;
    sh:property [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path hg:endPlace ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 28 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:hasAssertion ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 3 ;
            sh:path hg:ritualType ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path hg:invokesDeity ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 29 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 26 ;
            sh:path prov:used ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 12 ;
            sh:path hg:performedByGroup ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:startPlace ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path hg:routePlaces ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 4 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path prov:endedAtTime ],
        [ sh:class hg:RitualEvent ;
            sh:description "A ritual that follows this one in the canonical sequence (strict precedence, CRM P183; not necessarily the immediately next one)." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the Kumari in a chariot procession). The holder of a tenure is given with tenure_holder." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:hadParticipant ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 8 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Text description of the procession route" ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 23 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path prov:startedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 30 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path hg:managedByGuthi ],
        [ sh:class hg:RitualEvent ;
            sh:description "Component rituals of festival" ;
