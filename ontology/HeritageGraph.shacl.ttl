hg:Temple a sh:NodeShape ;
    sh:description "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion." ;
    sh:or ( [ sh:not [ sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> ) ] ;
                sh:path hg:existenceStatus ] [ sh:minCount 1 ;
                sh:path crm:P55_has_current_location ] ) ;
    sh:property [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path hg:managedByGuthi ],
        [ sh:class hg:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:name "Has component"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:name "Was produced by event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class hg:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:mentionedInSource ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path hg:hasAssertion ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path hg:hypothesizedLocation ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path hg:hasArchitecturalStyle ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:name "Has custody event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 23 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 21 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 22 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P55_has_current_location ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 25 ;
            sh:path dcterms:accessRights ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path hg:lastKnownExistenceDate ],
        [ sh:class hg:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path hg:participatesInRitual ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 24 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Current physical status of the structure" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
            sh:maxCount 1 ;
            sh:name "has existence status" ;
            sh:order 9 ;
            sh:path hg:existenceStatus ],
        [ sh:class hg:Enshrinement ;
            sh:description "Enshrinement event that installed deity in temple" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path hg:enshrinesDeityThroughEvent ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:name "has destruction event" ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path hg:destructionEvent ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path hg:documentedBy ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 20 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class hg:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this structure (a temple, or a pavilion, rest house or water spout with a shrine)" ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:hasReligiousTradition ] ;
    sh:targetClass hg:Temple .

hg:KumariSelectionEvent a sh:NodeShape ;
    sh:description "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana) and horoscope matching with the city and ruling authority, performed by Vajracharya priests and astrologers. Accounts of a fearlessness test are disputed and are recorded as such with FearlessnessAssessment, not stated here." ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path prov:endedAtTime ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 32 ;
            sh:path prov:generated ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 31 ;
            sh:path prov:used ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:class hg:KumariTenure ;
            sh:description "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path hg:boundsTenure ],
        [ sh:description "Text description of the procession route" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 28 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class hg:KumariTenure ;
            sh:description "Living Goddess tenure that this selection event initiated" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:initiatedTenure ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this ritual is essential for the festival's completion" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path hg:isCriticalForFestival ],
        [ sh:class crm:E21_Person ;
            sh:description "Girl selected to become Living Goddess" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path hg:selectedPerson ],
        [ sh:class hg:SelectionCriterion ;
            sh:description "Eligibility criterion applied in this selection." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path hg:hasCriterion ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:managedByGuthi ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 33 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 14 ;
            sh:path hg:ritualType ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 35 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class hg:KumariRole ;
            sh:description "KumariRole conferred by this selection or enthronement event." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path hg:confersRole ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 5 ;
            sh:path hg:performedByGroup ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 17 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path prov:startedAtTime ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path hg:startPlace ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 15 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:hadParticipant ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path hg:endPlace ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Name of selection event" ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 34 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 13 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:documentedBy ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 36 ;
            sh:path dcterms:accessRights ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:hasAssertion ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path hg:routePlaces ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 18 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path hg:invokesDeity ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P7_took_place_at ] ;
    sh:targetClass hg:KumariSelectionEvent .

hg:Office a sh:NodeShape ;
    sh:description "An office, role or duty that persons or groups hold for a period (a CIDOC-CRM E55 Type): the office is the type, a Tenure is the dated holding of it, the holder is the actor." ;
    sh:property [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 5 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 8 ;
            sh:path dcterms:accessRights ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 7 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 3 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 4 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass hg:Office .

hg:Festival a sh:NodeShape ;
    sh:description "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
    sh:property [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path hg:invokesDeity ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 9 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path prov:startedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class hg:RitualEvent ;
            sh:description "Component rituals of festival" ;
            sh:name "Includes ritual event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path crm:P9_consists_of ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 3 ;
            sh:path hg:ritualType ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path hg:managedByGuthi ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 26 ;
            sh:path prov:used ],
        [ sh:description "Text description of the procession route" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 23 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 29 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 28 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path prov:endedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:hadParticipant ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 31 ;
            sh:path dcterms:accessRights ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:identifier ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 8 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 27 ;
            sh:path prov:generated ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path hg:routePlaces ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:hasAssertion ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path hg:documentedBy ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 4 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 12 ;
            sh:path hg:performedByGroup ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 30 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path hg:endPlace ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:startPlace ] ;
    sh:targetClass hg:Festival .

hg:CasteGroup a sh:NodeShape ;
    sh:description "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    sh:property [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:description "Hereditary occupation or ritual duty" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path hg:traditionalRole ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Agent on whose behalf this agent acted." ;
            sh:name "Acted on behalf of"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 4 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:targetClass hg:CasteGroup .

hg:CustodyPeriod a sh:NodeShape ;
    sh:description "Dated period during which an actor (typically a Guthi) holds custody of a heritage structure or object, opened and closed by transfer-of-custody events. Unlike the untimed crm:P50i_is_current_keeper_of, it answers who held custody at a given date." ;
    sh:property [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Transfer of custody that ended the period." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:custodyClosedBy ],
        [ sh:description "Structure or object in custody during the period." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 3 ;
            sh:path hg:custodyObject ],
        [ sh:description "Event that closed the tenure (e.g. a retirement, a death, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class hg:ArchitecturalElement ] [ sh:class hg:Deity ] [ sh:class hg:ReligiousTradition ] [ sh:class hg:HistoricalEvent ] [ sh:class hg:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class hg:Consecration ] [ sh:class hg:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class hg:DataSource ] [ sh:class hg:DocumentationActivity ] [ sh:class hg:SyncreticRelationship ] [ sh:class hg:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class hg:KumariRole ] [ sh:class hg:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class hg:CalendarSystem ] [ sh:class hg:Endowment ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:HereditaryRoleTenure ] [ sh:class hg:CustodyPeriod ] ) ;
            sh:order 11 ;
            sh:path hg:tenureClosedBy ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 18 ;
            sh:path dcterms:accessRights ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 14 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor holding the office, duty or custody during the tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:tenureHolder ],
        [ sh:description "Event that opened the tenure (e.g. an enthronement, an appointment, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class hg:ArchitecturalElement ] [ sh:class hg:Deity ] [ sh:class hg:ReligiousTradition ] [ sh:class hg:HistoricalEvent ] [ sh:class hg:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class hg:Consecration ] [ sh:class hg:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class hg:DataSource ] [ sh:class hg:DocumentationActivity ] [ sh:class hg:SyncreticRelationship ] [ sh:class hg:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class hg:KumariRole ] [ sh:class hg:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class hg:CalendarSystem ] [ sh:class hg:Endowment ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:HereditaryRoleTenure ] [ sh:class hg:CustodyPeriod ] ) ;
            sh:order 10 ;
            sh:path hg:tenureOpenedBy ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Transfer of custody that began the period." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:custodyOpenedBy ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 17 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 13 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 15 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor (typically a Guthi) holding custody during the period." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:custodyHolder ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:Office ;
            sh:description "Office, role or duty held during the tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path hg:tenureOffice ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:hasAssertion ] ;
    sh:targetClass hg:CustodyPeriod .

hg:EndowmentEvent a sh:NodeShape ;
    sh:description "Event that founds, augments, nationalises or alienates a Guthi endowment, with its donor or recipient and its date." ;
    sh:property [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 11 ;
            sh:path prov:generated ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 15 ;
            sh:path dcterms:accessRights ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or group who gave the property (the donor in a founding or augmentation)." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:endowmentDonor ],
        [ sh:class hg:Endowment ;
            sh:description "Endowment founded, augmented, nationalised or alienated by this event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:concernsEndowment ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 12 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path prov:endedAtTime ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:hasAssertion ],
        [ sh:class crm:E39_Actor ;
            sh:description "Guthi or state body that received the property (e.g. the Guthi Sansthan in a nationalisation)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:endowmentRecipient ],
        [ sh:description "Kind of endowment event (founding, augmentation, nationalisation, alienation)." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/EndowmentEventType#Founding> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Augmentation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Nationalisation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Alienation> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:order 3 ;
            sh:path hg:endowmentEventType ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 14 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:startedAtTime ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 10 ;
            sh:path prov:used ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 13 ;
            sh:path prov:wasInformedBy ] ;
    sh:targetClass hg:EndowmentEvent .

hg:SyncreticRelationship a sh:NodeShape ;
    sh:description "The act of identifying one deity with another across theological frameworks (a CIDOC-CRM E13 Attribute Assignment: P140 the deity identified, P141 the deity it is identified with), recorded with the source that reports it (documented_in_source)." ;
    sh:property [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 11 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:endedAtTime ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 9 ;
            sh:path prov:generated ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 13 ;
            sh:path dcterms:accessRights ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 10 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class hg:Deity ;
            sh:description "The deity instance that is the subject of the syncretic claim." ;
            sh:minCount 1 ;
            sh:name "Assigned to deity"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P140_assigned_attribute_to ],
        [ sh:class hg:Deity ;
            sh:description "The deity or sacred figure being identified as equivalent to the primary deity." ;
            sh:minCount 1 ;
            sh:name "Assigned equivalent"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P141_assigned ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:documentedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:DataSource ;
            sh:description "Source(s) that mention/document this entity. Distinct from was_derived_from (which is prov:wasDerivedFrom for assertions). Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:mentionedInSource ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:startedAtTime ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:description "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> <https://cair-nepal.org/heritagegraph/SyncreticType#Appropriation> <https://cair-nepal.org/heritagegraph/SyncreticType#Fusion> <https://cair-nepal.org/heritagegraph/SyncreticType#Historical> ) ;
            sh:maxCount 1 ;
            sh:name "has syncretic type" ;
            sh:order 4 ;
            sh:path hg:syncreticType ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:targetClass hg:SyncreticRelationship .

hg:CalendarSystem a sh:NodeShape ;
    sh:description "Calendar reckoning system with conversion rules for multi-calendar temporal reasoning" ;
    sh:property [ sh:class hg:ReligiousTradition ;
            sh:description "Religious tradition(s) that primarily use this calendar system (e.g., Bikram Sambat for Hindu, Nepal Sambat for Newar Buddhist)" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:isPrimaryForTradition ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of years this calendar runs ahead of the Gregorian (Common Era) year at the start of its year (e.g. 57 for Bikram Sambat, -879 for Nepal Sambat). Because the calendar's new year does not fall on 1 January (see epoch_date_gregorian), a year-precision date Y converts to the two-year interval [Y - offset, Y - offset + 1] CE; the single year Y - offset is correct only for dates between the calendar's new year and 31 December. A calendar whose new year is 1 January converts to Y - offset exactly." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path hg:yearOffsetFromGregorian ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 4 ;
            sh:path crm:P3_has_note ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 11 ;
            sh:path dcterms:accessRights ],
        [ sh:datatype xsd:string ;
            sh:description "Proleptic Gregorian (ISO 8601, astronomical year numbering) date on which the era began, in the era's own reckoning (Bikram Sambat counts from year 1, e.g. -0056-04-14; Nepal Sambat counts elapsed years from year 0, 0879-10-24 = 20 October 879 Julian). Its month and day only indicate the approximate new-year season: the actual new year varies (Bikram Sambat 13-15 April, solar; Nepal Sambat late October to November, lunisolar), so it must not be used for day-level conversion. A value ending in -01-01 marks a calendar whose new year is 1 January, for which year conversion is exact." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path hg:epochDateGregorian ;
            sh:pattern "^-?[0-9]{4}-[0-9]{2}-[0-9]{2}$" ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 8 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 6 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 7 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path prov:generatedAtTime ] ;
    sh:targetClass hg:CalendarSystem .

hg:Consecration a sh:NodeShape ;
    sh:description "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)" ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 12 ;
            sh:path dcterms:accessRights ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path hg:hasAssertion ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 16 ;
            sh:path hg:ritualType ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 17 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 19 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:invokesDeity ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path hg:routePlaces ],
        [ sh:class hg:Murti ;
            sh:description "Murti employed in (and transformed by) the consecration ritual" ;
            sh:name "Consecrated object"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path crm:P16_used_specific_object ],
        [ sh:description "Text description of the procession route" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 33 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:startedAtTime ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 20 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path hg:startPlace ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path hg:hadParticipant ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path hg:endPlace ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path hg:documentedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 15 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 22 ;
            sh:path hg:performedByGroup ],
        [ sh:class hg:Deity ;
            sh:description "Deity made present through consecration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:makesDeityPresent ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:endedAtTime ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path hg:managedByGuthi ] ;
    sh:targetClass hg:Consecration .

hg:Endowment a sh:NodeShape ;
    sh:description "Land, income or other property permanently dedicated to sustain a structure, a ritual or festival, or a sacred office, and held by a Guthi. The endowment, not the membership, is what makes a Guthi a trust." ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 12 ;
            sh:path dcterms:accessRights ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:hasAssertion ],
        [ sh:class crm:E53_Place ;
            sh:description "Land (plots, fields) dedicated to the endowment." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path hg:endowedLand ],
        [ sh:description "Structure, ritual or festival, or sacred office whose upkeep or performance the endowment funds." ;
            sh:minCount 1 ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:RitualEvent ] [ sh:class hg:Office ] ) ;
            sh:order 4 ;
            sh:path hg:sustains ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E74_Group ;
            sh:description "Guthi or state body (e.g. the Guthi Sansthan, holding nationalised guthi land) that holds the endowment." ;
            sh:minCount 1 ;
            sh:name "Endowment holder"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P105_right_held_by ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 7 ;
            sh:path prov:wasDerivedFrom ] ;
    sh:targetClass hg:Endowment .

hg:HereditaryRoleTenure a sh:NodeShape ;
    sh:description "Time-bounded holding of a hereditary ritual duty by a person or caste group, under the mandate of a Guthi, with the rule by which the duty passes on. The same period pattern as KumariTenure, applied to hereditary offices (priests, chariot builders, musicians)." ;
    sh:property [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 17 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor holding the office, duty or custody during the tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:tenureHolder ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path hg:hasAssertion ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E74_Group ;
            sh:description "Guthi or state body that mandates (and usually funds) the hereditary duty." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:mandatedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path prov:generatedAtTime ],
        [ sh:class hg:HereditaryRoleTenure ;
            sh:description "Earlier tenure of the same hereditary office that this tenure succeeds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:succeeds ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 19 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "The ritual duty held (e.g. building the festival chariot, performing the daily worship)." ;
            sh:minCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path hg:roleDuty ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:RitualEvent ;
            sh:description "Ritual or festival the hereditary duty serves." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:dutyFor ],
        [ sh:description "Event that opened the tenure (e.g. an enthronement, an appointment, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class hg:ArchitecturalElement ] [ sh:class hg:Deity ] [ sh:class hg:ReligiousTradition ] [ sh:class hg:HistoricalEvent ] [ sh:class hg:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class hg:Consecration ] [ sh:class hg:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class hg:DataSource ] [ sh:class hg:DocumentationActivity ] [ sh:class hg:SyncreticRelationship ] [ sh:class hg:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class hg:KumariRole ] [ sh:class hg:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class hg:CalendarSystem ] [ sh:class hg:Endowment ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:HereditaryRoleTenure ] [ sh:class hg:CustodyPeriod ] ) ;
            sh:order 9 ;
            sh:path hg:tenureOpenedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:RitualOffice ;
            sh:description "The hereditary ritual office held (e.g. chariot builder, Rajopadhyaya priest)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:tenureOffice ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 15 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 20 ;
            sh:path dcterms:accessRights ],
        [ sh:description "Person or caste group holding the hereditary duty during this tenure." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:class crm:E21_Person ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 2 ;
            sh:path hg:roleHolder ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 16 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Event that closed the tenure (e.g. a retirement, a death, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class crm:E22_Human-Made_Object ] [ sh:class hg:ArchitecturalElement ] [ sh:class hg:Deity ] [ sh:class hg:ReligiousTradition ] [ sh:class hg:HistoricalEvent ] [ sh:class hg:RitualEvent ] [ sh:class crm:E12_Production ] [ sh:class hg:Consecration ] [ sh:class hg:Enshrinement ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E39_Actor ] [ sh:class crm:E53_Place ] [ sh:class crm:E52_Time-Span ] [ sh:class hg:DataSource ] [ sh:class hg:DocumentationActivity ] [ sh:class hg:SyncreticRelationship ] [ sh:class hg:KumariTenure ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E57_Material ] [ sh:class hg:KumariRole ] [ sh:class hg:SelectionCriterion ] [ sh:class crminf:I2_Belief ] [ sh:class hg:CalendarSystem ] [ sh:class hg:Endowment ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:HereditaryRoleTenure ] [ sh:class hg:CustodyPeriod ] ) ;
            sh:order 10 ;
            sh:path hg:tenureClosedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Rule by which the duty passes on (e.g. eldest son of the lineage; within the caste group)." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 6 ;
            sh:path hg:successionRule ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ] ;
    sh:targetClass hg:HereditaryRoleTenure .

hg:SelectionCriterion a sh:NodeShape ;
    sh:description "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text. Ethics: candidates are children. Criteria describe the tradition; data about how a named or identifiable child met them (bodily marks, health, horoscope) must not be recorded." ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 6 ;
            sh:path dcterms:accessRights ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ] ;
    sh:targetClass hg:SelectionCriterion .

hg:Enshrinement a sh:NodeShape ;
    sh:description "Event of installing a deity's murti or symbol within a temple sanctum" ;
    sh:property [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses heritageGraph:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path hg:documentedBy ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the girl holding a Kumari tenure, or the Kumari in a chariot procession)." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path hg:hadParticipant ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 16 ;
            sh:path hg:ritualType ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path hg:managedByGuthi ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path hg:startPlace ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "Access rights"@en ;
            sh:order 12 ;
            sh:path dcterms:accessRights ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the next ritual in the canonical sequence." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path hg:hasAssertion ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 22 ;
            sh:path hg:performedByGroup ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P4_has_time-span ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:startedAtTime ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 20 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E21_Person ] [ sh:class crm:E39_Actor ] [ sh:class crm:E74_Group ] ) ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class hg:Temple ;
            sh:description "Temple where deity was enshrined" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:enshrinedInStructure ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 17 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 19 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path hg:endPlace ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 15 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class crm:E12_Production ] [ sh:class crm:E14_Condition_Assessment ] [ sh:class crm:E6_Destruction ] ) ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Text description of the procession route" ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 33 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path hg:routePlaces ],
        [ sh:class hg:Deity ;
            sh:description "Deity installed through enshrinement" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path hg:enshrinedDeity ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:endedAtTime ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:invokesDeity ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E22_Human-Made_Object ] [ sh:class crm:E29_Design_or_Procedure ] [ sh:class crm:E3_Condition_State ] [ sh:class crm:E52_Time-Span ] [ sh:class crm:E53_Place ] [ sh:class crm:E57_Material ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:generated ] ;
    sh:targetClass hg:Enshrinement .

hg:IconographicObject a sh:NodeShape ;
    sh:description "Sacred visual art objects that depict or embody deities through iconographic conventions" ;
    sh:property [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
