            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype geo:wktLiteral ;
            sh:description "Coordinates as WKT literal" ;
            sh:maxCount 1 ;
            sh:name "Place coordinates"@en ;
