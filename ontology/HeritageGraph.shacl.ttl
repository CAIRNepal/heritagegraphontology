hg:Guthi a sh:NodeShape ;
    sh:description "Endowed trust organization unique to Nepal, managing temples, rituals, and land through hereditary or voluntary membership" ;
    sh:property [ sh:class hg:RitualEvent ;
            sh:description "Rituals performed by this Guthi" ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path hg:performsRitual ],
        [ sh:class crm:E21_Person ;
            sh:description "Members of Guthi organization" ;
            sh:name "Has membership"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P107_has_current_or_former_member ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:description "Primary name or label" ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
