hg:Temple a sh:NodeShape ;
    sh:description "Religious structure characterized by deity enshrinement and ritual activation. Legal designation (e.g. 'Ancient Monument' under Nepal law) is recorded per-instance via a governance assertion, not as a class criterion." ;
    sh:or ( [ sh:not [ sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> ) ] ;
                sh:path hg:existenceStatus ] [ sh:minCount 1 ;
                sh:path crm:P55_has_current_location ] ) ;
    sh:property [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E12_Production ;
            sh:description "Event that created this object or structure" ;
            sh:maxCount 1 ;
            sh:name "Was produced by event"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path crm:P108i_was_produced_by ],
        [ sh:class hg:ArchitecturalElement ;
            sh:description "Architectural elements composing structure" ;
            sh:name "Has component"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path crm:P46_is_composed_of ],
        [ sh:class hg:Enshrinement ;
            sh:description "Enshrinement event that installed deity in temple" ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path hg:enshrinesDeityThroughEvent ],
        [ sh:class hg:StructureType ;
            sh:description "Type of the structure from a controlled vocabulary or a local term list (e.g. bahah, dyochhen), finer than its class; a subproperty of crm:P2_has_type." ;
            sh:name "has structure type" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:structureType ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 21 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 22 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:hasAssertion ],
        [ sh:class hg:ReligiousTradition ;
            sh:description "Religious tradition(s) within which this deity is venerated, or which use this structure (a temple, or a pavilion, rest house or water spout with a shrine)" ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path hg:hasReligiousTradition ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E53_Place ;
            sh:description "Possible locations if the structure is lost" ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:hypothesizedLocation ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 23 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 4 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P55_has_current_location ],
        [ sh:description "Current physical status of the structure" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ExistenceStatus#Extant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#PartiallyExtant> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Destroyed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Lost> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Hypothetical> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Reconstructed> <https://cair-nepal.org/heritagegraph/ExistenceStatus#Unknown> ) ;
            sh:maxCount 1 ;
            sh:name "has existence status" ;
            sh:order 10 ;
            sh:path hg:existenceStatus ],
        [ sh:class hg:RitualEvent ;
            sh:description "Rituals in which this structure participates" ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path hg:participatesInRitual ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Custody transfer events for this structure" ;
            sh:name "Has custody event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path crm:P30i_custody_transferred_through ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 24 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Architectural style classification" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Pagoda> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Shikhara> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Dome> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Chaitya> <https://cair-nepal.org/heritagegraph/ArchitecturalStyle#Stupa> ) ;
            sh:maxCount 1 ;
            sh:order 1 ;
            sh:path hg:hasArchitecturalStyle ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 26 ;
            sh:path hg:accessProtocol ],
        [ sh:class hg:DataSource ;
            sh:description "Source(s) that mention/document this entity: the normative way to cite a source for a description of a heritage thing, event, actor or relationship. Distinct from was_derived_from, which is used only on assertions (I2 Belief) with was_attributed_to for the claimant. A source's own bibliographic data uses source_citation, datacite_creator, source_url and datacite_identifier. Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path hg:mentionedInSource ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest date when this structure is documented as existing (ISO 8601)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 11 ;
            sh:path hg:lastKnownExistenceDate ],
        [ sh:class crm:E6_Destruction ;
            sh:description "Event that destroyed this structure (if known)" ;
            sh:maxCount 1 ;
            sh:name "has destruction event" ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path hg:destructionEvent ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 25 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path hg:managedByGuthi ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path hg:documentedBy ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:Temple .

hg:KumariSelectionEvent a sh:NodeShape ;
    sh:description "Tantric ritual process of selecting a new Living Goddess from eligible candidates. Involves examination of 32 auspicious physical marks (lakshana) and horoscope matching with the city and ruling authority, carried out, in published accounts, by the priests of Taleju and the Buddhist Vajracharya priests with an astrologer. Accounts of a fearlessness test are disputed and are recorded as such with FearlessnessAssessment, not stated here." ;
    sh:property [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 18 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:hasAssertion ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 15 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 34 ;
            sh:path prov:wasInformedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 30 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:KumariTenure ;
            sh:description "The KumariTenure period that this lifecycle event bounds (initiates or terminates). Specialized by initiated_tenure (selection) and ended_tenure_of (retirement)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path hg:boundsTenure ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:class hg:SelectionCriterion ;
            sh:description "Eligibility criterion applied in this selection." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path hg:hasCriterion ],
        [ sh:class crm:E21_Person ;
            sh:description "Girl selected to become Living Goddess" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path hg:selectedPerson ],
        [ sh:datatype xsd:boolean ;
            sh:description "Whether this ritual is essential for the festival's completion" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path hg:isCriticalForFestival ],
        [ sh:description "Text description of the procession route" ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 28 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path hg:endPlace ],
        [ sh:class hg:KumariRole ;
            sh:description "KumariRole conferred by this selection or enthronement event." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path hg:confersRole ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 33 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 14 ;
            sh:path hg:ritualType ],
        [ sh:class hg:KumariTenure ;
            sh:description "Living Goddess tenure that this selection event led to (the tenure itself opens at the enthronement, enthroned_through)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:initiatedTenure ],
        [ sh:class hg:RitualEvent ;
            sh:description "A ritual that follows this one in the canonical sequence (strict precedence, CRM P183; not necessarily the immediately next one)." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 32 ;
            sh:path prov:generated ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:managedByGuthi ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:documentedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 13 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 5 ;
            sh:path hg:performedByGroup ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 36 ;
            sh:path hg:accessProtocol ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path hg:invokesDeity ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 37 ;
            sh:path prov:startedAtTime ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 17 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Name of selection event" ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the Kumari in a chariot procession). The holder of a tenure is given with tenure_holder." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:hadParticipant ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 3 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path hg:startPlace ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 35 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 31 ;
            sh:path prov:used ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path hg:routePlaces ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 38 ;
            sh:path prov:endedAtTime ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:KumariSelectionEvent .

hg:Office a sh:NodeShape ;
    sh:description "An office, role or duty that persons or groups hold for a period (a CIDOC-CRM E55 Type): the office is the type, a Tenure is the dated holding of it, the holder is the actor." ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 8 ;
            sh:path hg:accessProtocol ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 3 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 5 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 7 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 4 ;
            sh:path prov:wasAttributedTo ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:Office .

hg:CustodyPeriod a sh:NodeShape ;
    sh:description "Dated period during which an actor (typically a Guthi) holds custody of a heritage structure or object, opened and closed by transfer-of-custody events. Unlike the untimed crm:P50i_is_current_keeper_of, it answers who held custody at a given date." ;
    sh:property [ sh:class hg:Office ;
            sh:description "Office, role or duty held during the tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path hg:tenureOffice ],
        [ sh:description "Event that closed the tenure (e.g. a retirement, a death, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class hg:RitualEvent ] [ sh:class hg:HistoricalEvent ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:DocumentationActivity ] [ sh:class crm:E7_Activity ] [ sh:class crm:E69_Death ] ) ;
            sh:order 11 ;
            sh:path hg:tenureClosedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Transfer of custody that began the period." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:custodyOpenedBy ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:hasAssertion ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 12 ;
            sh:path dcterms:identifier ],
        [ sh:description "Event that opened the tenure (e.g. an enthronement, an appointment, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class hg:RitualEvent ] [ sh:class hg:HistoricalEvent ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:DocumentationActivity ] [ sh:class crm:E7_Activity ] [ sh:class crm:E69_Death ] ) ;
            sh:order 10 ;
            sh:path hg:tenureOpenedBy ],
        [ sh:class crm:E10_Transfer_of_Custody ;
            sh:description "Transfer of custody that ended the period." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:custodyClosedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor (typically a Guthi) holding custody during the period." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:custodyHolder ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 13 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 14 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 18 ;
            sh:path hg:accessProtocol ],
        [ sh:description "Structure or object in custody during the period (any heritage structure, element or human-made object, e.g. a museum object)." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ] [ sh:class crm:E22_Human-Made_Object ] ) ;
            sh:order 3 ;
            sh:path hg:custodyObject ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 15 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 17 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor holding the office, duty or custody during the tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:tenureHolder ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:CustodyPeriod .

hg:SyncreticRelationship a sh:NodeShape ;
    sh:description "The act of identifying one deity with another across theological frameworks (a CIDOC-CRM E13 Attribute Assignment: P140 the deity identified, P141 the deity it is identified with), recorded with the source that reports it (documented_in_source)." ;
    sh:property [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 11 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:documentedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 12 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class hg:DataSource ;
            sh:description "Source(s) that mention/document this entity: the normative way to cite a source for a description of a heritage thing, event, actor or relationship. Distinct from was_derived_from, which is used only on assertions (I2 Belief) with was_attributed_to for the claimant. A source's own bibliographic data uses source_citation, datacite_creator, source_url and datacite_identifier. Entity-mention is not logical derivation." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:mentionedInSource ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 13 ;
            sh:path hg:accessProtocol ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:used ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:Deity ;
            sh:description "The deity instance that is the subject of the syncretic claim." ;
            sh:minCount 1 ;
            sh:name "Assigned to deity"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P140_assigned_attribute_to ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 15 ;
            sh:path prov:endedAtTime ],
        [ sh:description "The typological nature of the syncretism (e.g., Ontological Identity, Functional Overlap, Iconographic Similarity)." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/SyncreticType#Equivalence> <https://cair-nepal.org/heritagegraph/SyncreticType#Appropriation> <https://cair-nepal.org/heritagegraph/SyncreticType#Fusion> <https://cair-nepal.org/heritagegraph/SyncreticType#Historical> ) ;
            sh:maxCount 1 ;
            sh:name "has syncretic type" ;
            sh:order 4 ;
            sh:path hg:syncreticType ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:startedAtTime ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 10 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class hg:Deity ;
            sh:description "The deity or sacred figure being identified as equivalent to the primary deity." ;
            sh:minCount 1 ;
            sh:name "Assigned equivalent"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P141_assigned ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 9 ;
            sh:path prov:generated ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:SyncreticRelationship .

hg:CalendarSystem a sh:NodeShape ;
    sh:description "Calendar reckoning system with conversion rules for multi-calendar temporal reasoning" ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 11 ;
            sh:path hg:accessProtocol ],
        [ sh:class hg:ReligiousTradition ;
            sh:description "Religious tradition(s) that use this calendar system for their rites. Calendars are not divided by religion in Nepal: Nepal Sambat is the era of the Newar ritual calendar, used by Newar Hindus and Buddhists alike, and Bikram Sambat is the official civil era" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:isPrimaryForTradition ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:integer ;
            sh:description "Number of years this calendar runs ahead of the Gregorian (Common Era) year at the start of its year (e.g. 57 for Bikram Sambat, -879 for Nepal Sambat). Because the calendar's new year does not fall on 1 January (see epoch_date_gregorian), a year-precision date Y converts to the two-year interval [Y - offset, Y - offset + 1] CE; the single year Y - offset is correct only for dates between the calendar's new year and 31 December. A calendar whose new year is 1 January converts to Y - offset exactly." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path hg:yearOffsetFromGregorian ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 7 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 4 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 8 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 6 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:string ;
            sh:description "Proleptic Gregorian (ISO 8601, astronomical year numbering) date on which the era began, in the era's own reckoning (Bikram Sambat counts from year 1, e.g. -0056-04-14, a nominal back-projection of the modern solar reckoning rather than an attested date; Nepal Sambat counts elapsed years from year 0, 0879-10-24 = 20 October 879 Julian). Its month and day only indicate the approximate new-year season: the actual new year varies (Bikram Sambat 13-15 April, solar; Nepal Sambat late October to November, lunisolar), so it must not be used for day-level conversion. A value ending in -01-01 marks a calendar whose new year is 1 January, for which year conversion is exact." ;
            sh:maxCount 1 ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path hg:epochDateGregorian ;
            sh:pattern "^-?[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:CalendarSystem .

hg:Consecration a sh:NodeShape ;
    sh:description "Ritual event that transforms an object into a sacred vessel (e.g., Prana Pratistha for Murti)" ;
    sh:property [ sh:description "Text description of the procession route" ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 33 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 20 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path hg:documentedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class hg:RitualEvent ;
            sh:description "A ritual that follows this one in the canonical sequence (strict precedence, CRM P183; not necessarily the immediately next one)." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:startedAtTime ],
        [ sh:class hg:Deity ;
            sh:description "Deity made present through consecration" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:makesDeityPresent ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 17 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path hg:startPlace ],
        [ sh:class hg:Murti ;
            sh:description "Murti employed in (and transformed by) the consecration ritual" ;
            sh:name "Consecrated object"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path crm:P16_used_specific_object ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 22 ;
            sh:path hg:performedByGroup ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 19 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 12 ;
            sh:path hg:accessProtocol ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path hg:routePlaces ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:invokesDeity ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 15 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path hg:endPlace ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path hg:hasAssertion ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the Kumari in a chariot procession). The holder of a tenure is given with tenure_holder." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path hg:hadParticipant ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 16 ;
            sh:path hg:ritualType ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:endedAtTime ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path hg:managedByGuthi ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P7_took_place_at ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 4 ;
            sh:path crm:P4_has_time-span ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:Consecration .

hg:Endowment a sh:NodeShape ;
    sh:description "Land, income or other property permanently dedicated to sustain a structure, a ritual or festival, or a sacred office, and held by a Guthi. The endowment, not the membership, is what makes a Guthi a trust." ;
    sh:property [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 7 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 10 ;
            sh:path prov:generatedAtTime ],
        [ sh:class crm:E53_Place ;
            sh:description "Land (plots, fields) dedicated to the endowment." ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path hg:endowedLand ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 8 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:hasAssertion ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 12 ;
            sh:path hg:accessProtocol ],
        [ sh:class crm:E74_Group ;
            sh:description "Guthi or state body (e.g. the Guthi Sansthan, holding nationalised guthi land) that holds the endowment." ;
            sh:minCount 1 ;
            sh:name "Endowment holder"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path crm:P105_right_held_by ],
        [ sh:description "Primary name or label" ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 9 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Structure, ritual or festival, or sacred office whose upkeep or performance the endowment funds." ;
            sh:minCount 1 ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:RitualEvent ] [ sh:class hg:Office ] ) ;
            sh:order 4 ;
            sh:path hg:sustains ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:Endowment .

hg:HereditaryRoleTenure a sh:NodeShape ;
    sh:description "Time-bounded holding of a hereditary ritual duty by a person or caste group, under the mandate of a Guthi, with the rule by which the duty passes on. The same period pattern as KumariTenure, applied to hereditary offices (priests, chariot builders, musicians)." ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 20 ;
            sh:path hg:accessProtocol ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 18 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 12 ;
            sh:path hg:hasAssertion ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 11 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class hg:HereditaryRoleTenure ;
            sh:description "Earlier tenure of the same hereditary office that this tenure succeeds." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:succeeds ],
        [ sh:description "Person or caste group holding the hereditary duty during this tenure." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:or ( [ sh:class crm:E21_Person ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 2 ;
            sh:path hg:roleHolder ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 16 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Event that opened the tenure (e.g. an enthronement, an appointment, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class hg:RitualEvent ] [ sh:class hg:HistoricalEvent ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:DocumentationActivity ] [ sh:class crm:E7_Activity ] [ sh:class crm:E69_Death ] ) ;
            sh:order 9 ;
            sh:path hg:tenureOpenedBy ],
        [ sh:class hg:RitualOffice ;
            sh:description "The hereditary ritual office held (e.g. chariot builder, Rajopadhyaya priest)" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:tenureOffice ],
        [ sh:description "The ritual duty held (e.g. building the festival chariot, performing the daily worship)." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 3 ;
            sh:path hg:roleDuty ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor holding the office, duty or custody during the tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:tenureHolder ],
        [ sh:description "Rule by which the duty passes on (e.g. eldest son of the lineage; within the caste group)." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 6 ;
            sh:path hg:successionRule ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:RitualEvent ;
            sh:description "Ritual or festival the hereditary duty serves." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:dutyFor ],
        [ sh:description "Event that closed the tenure (e.g. a retirement, a death, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class hg:RitualEvent ] [ sh:class hg:HistoricalEvent ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:DocumentationActivity ] [ sh:class crm:E7_Activity ] [ sh:class crm:E69_Death ] ) ;
            sh:order 10 ;
            sh:path hg:tenureClosedBy ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 17 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 19 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 15 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crm:E74_Group ;
            sh:description "Guthi or state body that mandates (and usually funds) the hereditary duty." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:mandatedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path dcterms:identifier ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:HereditaryRoleTenure .

hg:SelectionCriterion a sh:NodeShape ;
    sh:description "An eligibility criterion a candidate must satisfy to assume the Kumari role. Modelled as explicit subclasses so 'what are the eligibility criteria?' is a subclass query, not free text. Ethics: candidates are children. Criteria describe the tradition; data about how a named or identifiable child met them (bodily marks, health, horoscope) must not be recorded." ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 6 ;
            sh:path hg:accessProtocol ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 2 ;
            sh:path prov:wasAttributedTo ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path dcterms:identifier ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 1 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 3 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:SelectionCriterion .

hg:Enshrinement a sh:NodeShape ;
    sh:description "Event of installing a deity's murti or symbol within a temple sanctum" ;
    sh:property [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 32 ;
            sh:path hg:endPlace ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 19 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 17 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:invokesDeity ],
        [ sh:class hg:Temple ;
            sh:description "Temple where deity was enshrined" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:enshrinedInStructure ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 31 ;
            sh:path hg:startPlace ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 28 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 7 ;
            sh:path prov:used ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 29 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 23 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 16 ;
            sh:path hg:ritualType ],
        [ sh:description "Text description of the procession route" ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 33 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path hg:managedByGuthi ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the Kumari in a chariot procession). The holder of a tenure is given with tenure_holder." ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path hg:hadParticipant ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 15 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class hg:Deity ;
            sh:description "Deity installed through enshrinement" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path hg:enshrinedDeity ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 11 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path dcterms:identifier ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 30 ;
            sh:path hg:routePlaces ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 9 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:class hg:RitualEvent ;
            sh:description "A ritual that follows this one in the canonical sequence (strict precedence, CRM P183; not necessarily the immediately next one)." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 27 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 26 ;
            sh:path hg:hasAssertion ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 20 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 12 ;
            sh:path hg:accessProtocol ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 14 ;
            sh:path prov:endedAtTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 13 ;
            sh:path prov:startedAtTime ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 8 ;
            sh:path prov:generated ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 22 ;
            sh:path hg:performedByGroup ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 34 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 25 ;
            sh:path hg:documentedBy ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 10 ;
            sh:path prov:wasInformedBy ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:Enshrinement .

hg:KumariRole a sh:NodeShape ;
    sh:description "The role/office of Kumari (living-goddess embodiment) that a person assumes for the duration of a KumariTenure. The role is the type; the tenure is the time-bounded holding of it; the person is the holder." ;
    sh:property [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:Deity ;
            sh:description "Deity embodied by whoever holds this role (e.g., Taleju)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path hg:roleDeity ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 7 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 8 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 4 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 5 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 9 ;
            sh:path hg:accessProtocol ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 6 ;
            sh:path prov:wasGeneratedBy ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:KumariRole .

hg:Festival a sh:NodeShape ;
    sh:description "Large-scale community ritual event (Jatra) involving processions, music, and collective participation" ;
    sh:property [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Ordered list of places visited during movement ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 20 ;
            sh:path hg:routePlaces ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 31 ;
            sh:path hg:accessProtocol ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 27 ;
            sh:path prov:generated ],
        [ sh:class hg:Guthi ;
            sh:description "Guthi organization managing this structure or ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 14 ;
            sh:path hg:managedByGuthi ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 7 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 26 ;
            sh:path prov:used ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:RitualEvent ;
            sh:description "Component rituals of festival" ;
            sh:name "Includes ritual event"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 0 ;
            sh:path crm:P9_consists_of ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:hasAssertion ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 15 ;
            sh:path hg:documentedBy ],
        [ sh:class hg:Deity ;
            sh:description "Deity invoked or made present through ritual" ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path hg:invokesDeity ],
        [ sh:class hg:RitualEvent ;
            sh:description "A ritual that follows this one in the canonical sequence (strict precedence, CRM P183; not necessarily the immediately next one)." ;
            sh:name "Occurs before"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 17 ;
            sh:path crm:P183_ends_before_the_start_of ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 25 ;
            sh:path dcterms:identifier ],
        [ sh:class hg:Festival ;
            sh:description "Larger festival this ritual is part of" ;
            sh:name "Is part of festival"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path crm:P9i_forms_part_of ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) participating in this period, situation or ritual without carrying it out (e.g. the Kumari in a chariot procession). The holder of a tenure is given with tenure_holder." ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:hadParticipant ],
        [ sh:class crm:E39_Actor ;
            sh:description "Actor(s) who performed this event" ;
            sh:name "Carried out by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path crm:P14_carried_out_by ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 30 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Text description of the procession route" ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 23 ;
            sh:path hg:routeDescription ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Classification of ritual (puja, jatra, consecration)" ;
            sh:in ( <https://cair-nepal.org/heritagegraph/RitualType#NityaPuja> <https://cair-nepal.org/heritagegraph/RitualType#NaimittikaPuja> <https://cair-nepal.org/heritagegraph/RitualType#KamyaPuja> <https://cair-nepal.org/heritagegraph/RitualType#Abhisheka> <https://cair-nepal.org/heritagegraph/RitualType#Homa> <https://cair-nepal.org/heritagegraph/RitualType#Bhajan> <https://cair-nepal.org/heritagegraph/RitualType#Yagna> <https://cair-nepal.org/heritagegraph/RitualType#Vrata> <https://cair-nepal.org/heritagegraph/RitualType#Jatra> <https://cair-nepal.org/heritagegraph/RitualType#ChariotProcession> <https://cair-nepal.org/heritagegraph/RitualType#MaskedPerformance> <https://cair-nepal.org/heritagegraph/RitualType#RitualConsecration> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionRitual> <https://cair-nepal.org/heritagegraph/RitualType#InstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#DeinstallationRitual> <https://cair-nepal.org/heritagegraph/RitualType#ReturningRitual> <https://cair-nepal.org/heritagegraph/RitualType#Circumambulation> <https://cair-nepal.org/heritagegraph/RitualType#RelicTour> <https://cair-nepal.org/heritagegraph/RitualType#ProcessionalMovement> ) ;
            sh:maxCount 1 ;
            sh:name "has ritual type" ;
            sh:order 3 ;
            sh:path hg:ritualType ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 28 ;
            sh:path prov:wasAssociatedWith ],
        [ sh:description "Group (Guthi, caste) responsible for ritual" ;
            sh:or ( [ sh:class hg:Guthi ] [ sh:class hg:CasteGroup ] ) ;
            sh:order 12 ;
            sh:path hg:performedByGroup ],
        [ sh:class crm:E53_Place ;
            sh:description "Starting location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 21 ;
            sh:path hg:startPlace ],
        [ sh:class hg:RitualEvent ;
            sh:description "Points to the prerequisite ritual." ;
            sh:name "Occurs after"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 18 ;
            sh:path crm:P183i_starts_after_the_end_of ],
        [ sh:description "Ritual occurs at specific temple or monument" ;
            sh:name "Ritual on structure"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class hg:ArchitecturalStructure ] [ sh:class hg:IconographicObject ] [ sh:class hg:ArchitecturalElement ] ) ;
            sh:order 4 ;
            sh:path crm:P8_took_place_on_or_within ],
        [ sh:class hg:HistoricalEvent ;
            sh:description "Event that prompted this ritual, e.g. an earthquake prompting a propitiation (CIDOC-CRM P17). A crisis ritual is motivated by the crisis, not part of it (not crm:P9)." ;
            sh:name "Motivated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 24 ;
            sh:path crm:P17_was_motivated_by ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 33 ;
            sh:path prov:endedAtTime ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 29 ;
            sh:path prov:wasInformedBy ],
        [ sh:class crm:E57_Material ;
            sh:description "Ephemeral materials consumed during the ritual (e.g., oil, rice)." ;
            sh:name "Used materials"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 19 ;
            sh:path crm:P125_used_object_of_type ],
        [ sh:description "How the practice this occurrence belongs to recurs (e.g. annual, monthly), in free text. It describes the practice, not the occurrence: each occurrence is its own RitualEvent with its own time-span." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 9 ;
            sh:path hg:recurrencePattern ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Lunar day (tithi) by which the practice is timed, in free text (e.g. 'Bhadra Shukla Chaturdashi')." ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 8 ;
            sh:path hg:lunarDateTithi ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:class crm:E53_Place ;
            sh:description "Ending location of movement ritual" ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 22 ;
            sh:path hg:endPlace ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 32 ;
            sh:path prov:startedAtTime ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:Festival .

hg:CasteGroup a sh:NodeShape ;
    sh:description "Hereditary social group (Jati) with specific ritual roles and occupational duties" ;
    sh:property [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 5 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Agent on whose behalf this agent acted." ;
            sh:name "Acted on behalf of"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 4 ;
            sh:path prov:actedOnBehalfOf ],
        [ sh:description "Hereditary occupation or ritual duty" ;
            sh:minLength 1 ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 2 ;
            sh:path hg:traditionalRole ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 3 ;
            sh:path dcterms:identifier ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:CasteGroup .

hg:StructureType a sh:NodeShape ;
    sh:description "A type of heritage structure from a controlled vocabulary or a community's own term list (a CIDOC-CRM E55 Type), e.g. the Newar bahah or bahi (Buddhist monastic courtyard), dyochhen (god-house), agam chhen (esoteric shrine house) or pitha (seat of a goddess). Link each term to AAT or Wikidata with SKOS mappings where an equivalent exists; local types need no new ontology class." ;
    sh:property [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 8 ;
            sh:path hg:accessProtocol ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 6 ;
            sh:path prov:generatedAtTime ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 7 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 4 ;
            sh:path prov:wasAttributedTo ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 3 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 5 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 2 ;
            sh:path dcterms:identifier ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:StructureType .

hg:KumariTenure a sh:NodeShape ;
    sh:description "Time-bounded role where a person embodies a deity as Living Goddess (Kumari), residing at a specific god-house and supported by religious institutions. This class captures the unique Nepali tradition of living deity embodiment in young girls selected from Buddhist Shakya/Vajracharya families." ;
    sh:property [ sh:class crm:E21_Person ;
            sh:description "The girl serving as Living Goddess during this period" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path hg:tenureHolder ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 22 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:description "Event that closed the tenure (e.g. a retirement, a death, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class hg:RitualEvent ] [ sh:class hg:HistoricalEvent ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:DocumentationActivity ] [ sh:class crm:E7_Activity ] [ sh:class crm:E69_Death ] ) ;
            sh:order 15 ;
            sh:path hg:tenureClosedBy ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Duration of Living Goddess tenure (from selection to retirement)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 5 ;
            sh:path crm:P4_has_time-span ],
        [ sh:class crm:E74_Group ;
            sh:description "Guthi or state body (e.g. the Guthi Sansthan) providing economic or ritual support during the tenure" ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path hg:supportedByInstitution ],
        [ sh:class crm:E39_Actor ;
            sh:description "Other actors taking part in the tenure without holding it (1.0.x data gave the holder here; use tenure_holder)" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:hadParticipant ],
        [ sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 18 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 16 ;
            sh:path hg:hasAssertion ],
        [ sh:class hg:KumariSelectionEvent ;
            sh:description "Selection event that preceded this tenure. Not a tenure-opening event: the tenure opens with the enthronement (enthroned_through, a subproperty of tenure_opened_by)." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 9 ;
            sh:path hg:selectedThrough ],
        [ sh:class hg:KumariEnthronementEvent ;
            sh:description "Enthronement event that activated this tenure." ;
            sh:nodeKind sh:IRI ;
            sh:order 10 ;
            sh:path hg:enthronedThrough ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 23 ;
            sh:path hg:accessProtocol ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 12 ;
            sh:path crm:P3_has_note ],
        [ sh:class hg:KumariRole ;
            sh:description "KumariRole held during this tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:assumesRole ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 19 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class hg:KumariRetirementEvent ;
            sh:description "Retirement/desanctification event that ended this tenure." ;
            sh:nodeKind sh:IRI ;
            sh:order 11 ;
            sh:path hg:retiredThrough ],
        [ sh:class hg:Office ;
            sh:description "Office, role or duty held during the tenure." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 13 ;
            sh:path hg:tenureOffice ],
        [ sh:class hg:Deity ;
            sh:description "Deity believed to be present in this person (e.g., Taleju, Kumari Devi)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 3 ;
            sh:path hg:embodiedDeity ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 21 ;
            sh:path prov:generatedAtTime ],
        [ sh:class hg:DocumentationActivity ;
            sh:description "Documentation event that recorded this (pre-existing) entity or event. Uses hg:documentedBy (aligned to prov:wasInfluencedBy). NOTE: prov:wasGeneratedBy was incorrect: a stupa is not *generated by* the survey that records it." ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path hg:documentedBy ],
        [ sh:description "Event that opened the tenure (e.g. an enthronement, an appointment, a transfer of custody)." ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:or ( [ sh:class hg:RitualEvent ] [ sh:class hg:HistoricalEvent ] [ sh:class crm:E10_Transfer_of_Custody ] [ sh:class hg:EndowmentEvent ] [ sh:class hg:DocumentationActivity ] [ sh:class crm:E7_Activity ] [ sh:class crm:E69_Death ] ) ;
            sh:order 14 ;
            sh:path hg:tenureOpenedBy ],
        [ sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 20 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:class hg:ArchitecturalStructure ;
            sh:description "God-house where Living Goddess resides (e.g., Kumari Ghar)" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:residenceStructure ],
        [ sh:description "Name of this tenure period (e.g. 'Royal Kumari tenure, 2017-2025'). Kumari are children: prefer the office and period to the person's name unless the name is public and its use is appropriate." ;
            sh:minCount 1 ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path dcterms:identifier ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:KumariTenure .

hg:EndowmentEvent a sh:NodeShape ;
    sh:description "Event that founds, augments, nationalises or alienates a Guthi endowment, with its donor or recipient and its date." ;
    sh:property [ sh:class crminf:I2_Belief ;
            sh:description "Provenance-bearing assertion made about this entity or event." ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path hg:hasAssertion ],
        [ sh:class crm:E52_Time-Span ;
            sh:description "Links event to its temporal extent" ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "Has timespan"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 6 ;
            sh:path crm:P4_has_time-span ],
        [ sh:description "Activity that informed this activity; PROV-O uses this when the intervening generated and used entity is unknown or omitted." ;
            sh:name "Was informed by"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ;
            sh:order 13 ;
            sh:path prov:wasInformedBy ],
        [ sh:description "Cultural access protocol for the thing or its record (e.g. restricted to initiates, secret or sacred, seasonal), set with the community concerned; a subproperty of dcterms:accessRights. Data under a restriction should not be published." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/AccessProtocol#Open> <https://cair-nepal.org/heritagegraph/AccessProtocol#CommunityUseOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#InitiatesOnly> <https://cair-nepal.org/heritagegraph/AccessProtocol#SecretSacred> <https://cair-nepal.org/heritagegraph/AccessProtocol#Seasonal> ) ;
            sh:name "has access protocol" ;
            sh:order 15 ;
            sh:path hg:accessProtocol ],
        [ sh:class crm:E39_Actor ;
            sh:description "Person or group who gave the property (the donor in a founding or augmentation)." ;
            sh:nodeKind sh:IRI ;
            sh:order 4 ;
            sh:path hg:endowmentDonor ],
        [ sh:description "Entity generated by this activity." ;
            sh:name "generated"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 11 ;
            sh:path prov:generated ],
        [ sh:class hg:Endowment ;
            sh:description "Endowment founded, augmented, nationalised or alienated by this event." ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path hg:concernsEndowment ],
        [ sh:description "Kind of endowment event (founding, augmentation, nationalisation, alienation)." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/EndowmentEventType#Founding> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Augmentation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Nationalisation> <https://cair-nepal.org/heritagegraph/EndowmentEventType#Alienation> ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:name "has endowment event type" ;
            sh:order 3 ;
            sh:path hg:endowmentEventType ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity started." ;
            sh:maxCount 1 ;
            sh:name "Started at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 16 ;
            sh:path prov:startedAtTime ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 14 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class crm:E39_Actor ;
            sh:description "Guthi or state body that received the property (e.g. the Guthi Sansthan in a nationalisation)." ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path hg:endowmentRecipient ],
        [ sh:description "Primary name or label" ;
            sh:minLength 1 ;
            sh:name "name"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 0 ;
            sh:path rdfs:label ;
            sh:qualifiedMaxCount 1 ;
            sh:qualifiedValueShape [ sh:datatype xsd:string ] ;
            sh:uniqueLang true ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this activity ended." ;
            sh:maxCount 1 ;
            sh:name "Ended at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 17 ;
            sh:path prov:endedAtTime ],
        [ sh:description "Entity used by this activity." ;
            sh:name "used"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ;
            sh:order 10 ;
            sh:path prov:used ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path dcterms:identifier ],
        [ sh:description "Free-text note (description, reason, verification notes)" ;
            sh:minLength 1 ;
            sh:name "note"@en ;
            sh:nodeKind sh:Literal ;
            sh:or ( [ sh:datatype xsd:string ] [ sh:datatype rdf:langString ] ) ;
            sh:order 1 ;
            sh:path crm:P3_has_note ],
        [ sh:class crm:E53_Place ;
            sh:description "Place where the event occurred" ;
            sh:name "Took place at"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path crm:P7_took_place_at ],
        [ sh:description "Agent associated with responsibility for this activity." ;
            sh:name "Was associated with"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 12 ;
            sh:path prov:wasAssociatedWith ] ;
    sh:sparql <https://cair-nepal.org/heritagegraph/shapes/UndeclaredProperty> ;
    sh:targetClass hg:EndowmentEvent .

hg:IconographicObject a sh:NodeShape ;
    sh:description "Sacred visual art objects that depict or embody deities through iconographic conventions" ;
    sh:property [ sh:class crm:E53_Place ;
            sh:description "Current location of object or structure" ;
            sh:name "Has current location"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 5 ;
            sh:path crm:P55_has_current_location ],
        [ sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ;
            sh:order 12 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class crm:E14_Condition_Assessment ;
            sh:description "Condition assessment events for this structure" ;
            sh:name "Has condition assessment"@en ;
            sh:nodeKind sh:BlankNodeOrIRI ;
            sh:order 8 ;
            sh:path crm:P34i_was_assessed_by ],
        [ sh:datatype xsd:anyURI ;
