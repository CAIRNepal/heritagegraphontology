heritageGraph:TimeSpanShape a sh:NodeShape ;
    sh:description "Temporal extent of an event or period" ;
    sh:name "Time Span"@en ;
    sh:property [ sh:datatype xsd:string ;
            sh:description "The date as written in the source, in the calendar given by calendar_system (e.g. '2072' for a Bikram Sambat year, 'NS 1135 Kaulaathwa', 'VS 2021'). It is never put into an xsd:dateTime: the converted Gregorian bounds go in date_earliest / date_latest." ;
            sh:maxCount 1 ;
            sh:nodeKind sh:Literal ;
            sh:order 4 ;
            sh:path heritageGraph:recordedDate ],
        [ sh:class heritageGraph:CalendarSystem ;
            sh:description "Calendar system used for date representation" ;
            sh:maxCount 1 ;
            sh:name "has calendar system" ;
            sh:nodeKind sh:IRI ;
            sh:order 2 ;
            sh:path heritageGraph:calendarSystem ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Earliest possible date, always in the proleptic Gregorian calendar (xsd:dateTime); for a date recorded in another calendar, the start of its converted Gregorian interval (see recorded_date)." ;
            sh:maxCount 1 ;
            sh:name "Date earliest"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 0 ;
            sh:path crm:P82a_begin_of_the_begin ],
        [ sh:description "The level of precision for a recorded date." ;
            sh:in ( <https://cair-nepal.org/heritagegraph/DatePrecision#Exact> <https://cair-nepal.org/heritagegraph/DatePrecision#Year> <https://cair-nepal.org/heritagegraph/DatePrecision#Decade> <https://cair-nepal.org/heritagegraph/DatePrecision#Century> <https://cair-nepal.org/heritagegraph/DatePrecision#Circa> ) ;
            sh:maxCount 1 ;
            sh:name "has date precision" ;
            sh:order 3 ;
            sh:path heritageGraph:datePrecision ],
        [ sh:class prov:Entity ;
            sh:description "Entity from which this entity was derived." ;
            sh:name "Was derived from"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 6 ;
            sh:path prov:wasDerivedFrom ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Time at which this entity was generated (ISO 8601)." ;
            sh:maxCount 1 ;
            sh:name "Generated at time"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 9 ;
            sh:path prov:generatedAtTime ],
        [ sh:datatype xsd:dateTime ;
            sh:description "Latest possible date, always in the proleptic Gregorian calendar (xsd:dateTime); for a date recorded in another calendar, the end of its converted Gregorian interval (see recorded_date)." ;
            sh:maxCount 1 ;
            sh:name "Date latest"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 1 ;
            sh:path crm:P82b_end_of_the_end ],
        [ sh:datatype xsd:anyURI ;
            sh:description "Globally unique URI identifier" ;
            sh:maxCount 1 ;
            sh:name "ID"@en ;
            sh:nodeKind sh:Literal ;
            sh:order 5 ;
            sh:path dcterms:identifier ],
        [ sh:class prov:Agent ;
            sh:description "Agent to whom responsibility for this entity is attributed." ;
            sh:name "Was attributed to"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 7 ;
            sh:path prov:wasAttributedTo ],
        [ sh:class prov:Activity ;
            sh:description "Activity that generated this entity." ;
            sh:maxCount 1 ;
            sh:name "Was generated by"@en ;
            sh:nodeKind sh:IRI ;
            sh:order 8 ;
            sh:path prov:wasGeneratedBy ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:class prov:Entity ] [ sh:class prov:Activity ] [ sh:class prov:Agent ] ) ;
            sh:order 10 ;
            sh:path prov:wasInfluencedBy ] ;
    sh:targetClass crm:E52_Time-Span .

heritageGraph:TransferOfCustodyShape a sh:NodeShape ;
