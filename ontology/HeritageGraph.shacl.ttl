            sh:path hg:hasAssertion ],
        [ sh:description "General PROV-O influence relation. Prefer a more specific PROV relation whenever one applies." ;
            sh:name "Was influenced by"@en ;
            sh:or ( [ sh:or ( [ sh:class prov:Entity ] [ sh:class crm:E73_Information_Object ] [ sh:class crminf:I2_Belief ] ) ] [ sh:or ( [ sh:class prov:Activity ] [ sh:class crm:E7_Activity ] ) ] [ sh:or ( [ sh:class prov:Agent ] [ sh:class crm:E39_Actor ] ) ] ) ;
            sh:order 30 ;
            sh:path prov:wasInfluencedBy ],
        [ sh:class hg:KumariTenure ;
