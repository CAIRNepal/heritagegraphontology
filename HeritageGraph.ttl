heritageGraph:ExistenceStatusEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ExistenceStatusEnum" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/ExistenceStatusEnum#Extant> <https://w3id.org/heritagegraph/ExistenceStatusEnum#PartiallyExtant> <https://w3id.org/heritagegraph/ExistenceStatusEnum#Destroyed> <https://w3id.org/heritagegraph/ExistenceStatusEnum#Lost> <https://w3id.org/heritagegraph/ExistenceStatusEnum#Hypothetical> <https://w3id.org/heritagegraph/ExistenceStatusEnum#Unknown> ) ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values <https://w3id.org/heritagegraph/ExistenceStatusEnum#Destroyed>,
        <https://w3id.org/heritagegraph/ExistenceStatusEnum#Extant>,
        <https://w3id.org/heritagegraph/ExistenceStatusEnum#Hypothetical>,
        <https://w3id.org/heritagegraph/ExistenceStatusEnum#Lost>,
        <https://w3id.org/heritagegraph/ExistenceStatusEnum#PartiallyExtant>,
        <https://w3id.org/heritagegraph/ExistenceStatusEnum#Unknown> .

heritageGraph:DocumentationActivity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "DocumentationActivity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:produced_information_object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:generated_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:InformationObject ;
            owl:onProperty heritageGraph:produced_information_object ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:subject_entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:produced_information_object ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:HeritageAssertion ;
            owl:onProperty heritageGraph:generated_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used_equipment ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertableEntity ;
            owl:onProperty heritageGraph:subject_entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:used_equipment ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performed_by_agent ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:subject_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:used_method ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:used_method ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Event ;
            owl:onProperty heritageGraph:subject_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:performed_by_agent ],
        heritageGraph:Activity ;
    skos:broadMatch prov:Activity ;
    skos:definition "The intellectual or technical process of recording information about a heritage entity, aligning CIDOC E13 (Attribute Assignment) with PROV-O Activity." ;
    skos:exactMatch crm:E7_Activity ;
    skos:inScheme <HeritageGraph> .

heritageGraph:was_documented_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "was_documented_by" ;
    rdfs:range heritageGraph:DocumentationActivity ;
    skos:definition "Documentation event that recorded this entity or event" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Deity a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Deity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_religious_tradition ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:is_invoked_in_ritual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_invoked_in_ritual ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_depicted_in ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ReligiousTradition ;
            owl:onProperty heritageGraph:has_religious_tradition ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:IconographicObject ;
            owl:onProperty heritageGraph:is_depicted_in ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_enshrined_through_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Enshrinement ;
            owl:onProperty heritageGraph:is_enshrined_through_event ] ;
    skos:definition "Divine conceptual entity in Hindu, Buddhist, or syncretic traditions. Distinct from physical representations (Murti) and ritual presences." ;
    skos:exactMatch dbo:Deity,
        <http://schema.org/Deity>,
        aat:300343156,
        crm:E28_Conceptual_Object ;
    skos:inScheme <HeritageGraph> .

heritageGraph:GuthiTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "GuthiTypeEnum" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/GuthiTypeEnum#SiGuthi> <https://w3id.org/heritagegraph/GuthiTypeEnum#JatraGuthi> <https://w3id.org/heritagegraph/GuthiTypeEnum#PujaGuthi> <https://w3id.org/heritagegraph/GuthiTypeEnum#TempleGuthi> <https://w3id.org/heritagegraph/GuthiTypeEnum#NashaGuthi> <https://w3id.org/heritagegraph/GuthiTypeEnum#SanaGuthi> <https://w3id.org/heritagegraph/GuthiTypeEnum#SanGuthi> <https://w3id.org/heritagegraph/GuthiTypeEnum#RajGuthi> ) ;
    skos:definition "Controlled vocabulary of Guthi functional types (CRM E55_Type)" ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values <https://w3id.org/heritagegraph/GuthiTypeEnum#JatraGuthi>,
        <https://w3id.org/heritagegraph/GuthiTypeEnum#NashaGuthi>,
        <https://w3id.org/heritagegraph/GuthiTypeEnum#PujaGuthi>,
        <https://w3id.org/heritagegraph/GuthiTypeEnum#RajGuthi>,
        <https://w3id.org/heritagegraph/GuthiTypeEnum#SanGuthi>,
        <https://w3id.org/heritagegraph/GuthiTypeEnum#SanaGuthi>,
        <https://w3id.org/heritagegraph/GuthiTypeEnum#SiGuthi>,
        <https://w3id.org/heritagegraph/GuthiTypeEnum#TempleGuthi> .

heritageGraph:carried_out_by a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "carried_out_by" ;
    rdfs:range heritageGraph:Actor ;
    skos:definition "Actor(s) who performed this event" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:RitualEvent a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "RitualEvent" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:used_materials ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:ritual_on_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performed_by_group ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_part_of_festival ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:ritual_on_structure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:occurs_before ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Material ;
            owl:onProperty heritageGraph:used_materials ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:PhysicalHeritageThing ;
            owl:onProperty heritageGraph:ritual_on_structure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:occurs_before ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_part_of_festival ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:managed_by_guthi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualEvent ;
            owl:onProperty heritageGraph:occurs_after ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:occurs_before ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Guthi ;
            owl:onProperty heritageGraph:managed_by_guthi ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:RitualTypeEnum ;
            owl:onProperty heritageGraph:ritual_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:occurs_after ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] ;
            owl:onProperty heritageGraph:performed_by_group ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:lunar_date_tithi ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:ritual_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:recurrence_pattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Deity ;
            owl:onProperty heritageGraph:invokes_deity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:invokes_deity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:HeritageAssertion ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Actor ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:occurs_after ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Festival ;
            owl:onProperty heritageGraph:is_part_of_festival ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:lunar_date_tithi ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:recurrence_pattern ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:lunar_date_tithi ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:ritual_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:recurrence_pattern ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        heritageGraph:Activity ;
    skos:definition "Intentional ritual activity that activates sacred space, invokes deities, and binds social groups" ;
    skos:exactMatch aat:300055603,
        crm:E7_Activity ;
    skos:inScheme <HeritageGraph> .

heritageGraph:TimeSpan a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "TimeSpan" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty heritageGraph:date_earliest ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:date ;
            owl:onProperty heritageGraph:date_latest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:date_earliest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:date_latest ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:date_earliest ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:date_precision ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:date_latest ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:date_precision ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:calendar_system ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:calendar_system ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DatePrecisionEnum ;
            owl:onProperty heritageGraph:date_precision ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:CalendarSystem ;
            owl:onProperty heritageGraph:calendar_system ] ;
    skos:definition "Temporal extent of an event or period" ;
    skos:exactMatch crm:E52_Time-Span ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Place a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Place" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom geo:wktLiteral ;
            owl:onProperty heritageGraph:place_coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:place_coordinates ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:place_coordinates ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:contains_structure ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:contains_structure ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:place_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:place_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:place_type ] ;
    skos:definition "Defined geographic location where events occur and structures exist" ;
    skos:exactMatch crm:E53_Place ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Actor a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Actor" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ] ;
    skos:definition "General actor (person or group) responsible for events" ;
    skos:exactMatch crm:E39_Actor ;
    skos:inScheme <HeritageGraph> .

heritageGraph:took_place_at a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "took_place_at" ;
    rdfs:range heritageGraph:Place ;
    skos:definition "Place Where event occurred" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:has_timespan a owl:ObjectProperty,
        linkml:SlotDefinition ;
    rdfs:label "has_timespan" ;
    rdfs:range heritageGraph:TimeSpan ;
    skos:definition "Links event to its temporal extent" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:RitualTypeEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "RitualTypeEnum" ;
    owl:unionOf ( heritageGraph:NityaPuja heritageGraph:NaimittikaPuja heritageGraph:KamyaPuja heritageGraph:Abhisheka heritageGraph:Homa heritageGraph:Bhajan heritageGraph:Yagna heritageGraph:Vrata heritageGraph:Jatra heritageGraph:ChariotProcession heritageGraph:MaskedPerformance heritageGraph:RitualConsecration heritageGraph:ProcessionRitual heritageGraph:InstallationRitual heritageGraph:DeinstallationRitual heritageGraph:ReturningRitual heritageGraph:Circumambulation heritageGraph:RelicTour heritageGraph:ProcessionalMovement ) ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values heritageGraph:Abhisheka,
        heritageGraph:Bhajan,
        heritageGraph:ChariotProcession,
        heritageGraph:Circumambulation,
        heritageGraph:DeinstallationRitual,
        heritageGraph:Homa,
        heritageGraph:InstallationRitual,
        heritageGraph:Jatra,
        heritageGraph:KamyaPuja,
        heritageGraph:MaskedPerformance,
        heritageGraph:NaimittikaPuja,
        heritageGraph:NityaPuja,
        heritageGraph:ProcessionRitual,
        heritageGraph:ProcessionalMovement,
        heritageGraph:RelicTour,
        heritageGraph:ReturningRitual,
        heritageGraph:RitualConsecration,
        heritageGraph:Vrata,
        heritageGraph:Yagna .

heritageGraph:note a owl:DatatypeProperty,
        linkml:SlotDefinition ;
    rdfs:label "note" ;
    rdfs:range xsd:string ;
    skos:definition "Free-text note (description, reason, verification notes" ;
    skos:inScheme <HeritageGraph> .

heritageGraph:name a owl:DatatypeProperty,
        linkml:SlotDefinition ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    skos:definition "Primary name or label" ;
    skos:inScheme <HeritageGraph> .

<HeritageGraph> a owl:Ontology ;
    rdfs:label "HeritageGraph" ;
    dct:creator "CAIR-Nepal" ;
    dct:license "CC-BY-4.0",
        "https://creativecommons.org/licenses/by/4.0/" ;
    dct:publisher "CAIR-Nepal" ;
    pav:version "0.1.0-alpha.2" ;
    owl:imports "['http://www.cidoc-crm.org/cidoc-crm/', 'http://www.w3.org/ns/prov#']" ;
    owl:ontologyIRI "https://w3id.org/heritagegraph/ontology" ;
    owl:versionIRI "https://w3id.org/heritagegraph/ontology/0.1.0-alpha.2" ;
    skos:definition "An event-centric LinkML schema for representing cultural heritage information that fully aligns with CIDOC-CRM and PROV-O, enabling provenance tracking and ritual-spatial-temporal reasoning." .

