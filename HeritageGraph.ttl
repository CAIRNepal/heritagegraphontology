        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:HeritageAssertion ;
            owl:onProperty heritageGraph:supersedes_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty heritageGraph:generated_at_time ],
        [ a owl:Restriction ;
