    skos:exactMatch crm:E73_Information_Object ;
    skos:inScheme <HeritageGraph> .

heritageGraph:DatePrecisionEnum a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "DatePrecisionEnum" ;
    owl:unionOf ( <https://w3id.org/heritagegraph/DatePrecisionEnum#Exact> <https://w3id.org/heritagegraph/DatePrecisionEnum#Year> <https://w3id.org/heritagegraph/DatePrecisionEnum#Decade> <https://w3id.org/heritagegraph/DatePrecisionEnum#Century> <https://w3id.org/heritagegraph/DatePrecisionEnum#Circa> ) ;
