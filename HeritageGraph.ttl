crm:E55_Type a owl:Class,
        linkml:EnumDefinition ;
    rdfs:label "ArchitecturalStyleEnum" ;
    owl:unionOf ( aat:300004829 aat:300446671 aat:300001285 aat:300007562 aat:300007576 ) ;
    skos:definition "A vocabulary of architectural styles for South Asian heritage, mapped to CIDOC E55 Type." ;
    skos:inScheme <HeritageGraph> ;
    linkml:permissible_values aat:300001285,
        aat:300004829,
        aat:300007562,
        aat:300007576,
        aat:300446671 .

heritageGraph:ArchitecturalStructure a owl:Class,
