            owl:allValuesFrom heritageGraph:Consecration ;
            owl:onProperty heritageGraph:consecrated_by_event ],
        heritageGraph:IconographicObject ;
    skos:definition "Consecrated statue of a deity, ritually activated to serve as divine presence (not merely depiction)" ;
    skos:exactMatch aat:300264383,
        wikidata:Q2594295,
        heritageGraph:Murti ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Temple a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "Temple" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:enshrines_deity_through_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom crm:E55_Type ;
            owl:onProperty heritageGraph:has_architectural_style ],
