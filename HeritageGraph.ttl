            owl:onProperty heritageGraph:asserted_property ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:confidence_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty heritageGraph:confidence_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:asserts_about_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DataSource ;
            owl:onProperty heritageGraph:was_derived_from_source ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertableEntity ;
            owl:onProperty heritageGraph:asserts_about_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:was_attributed_to_agent ] ;
    skos:definition "A single factual claim about a heritage entity, with explicit source, author, date, and confidence" ;
    skos:exactMatch <http://schema.org/Claim>,
        crminf:I2_Belief,
        prov:Entity ;
    skos:inScheme <HeritageGraph> .

heritageGraph:Person a owl:Class,
