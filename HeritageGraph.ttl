heritageGraph:InformationObject a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "InformationObject" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_about_entity ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:is_about_event ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_about_entity ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_about_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Event ;
            owl:onProperty heritageGraph:is_about_event ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:AssertableEntity ;
            owl:onProperty heritageGraph:is_about_entity ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:created_by_documentation ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:created_by_documentation ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^[a-zA-Z]{2,3}(-[a-zA-Z0-9]{2,8})*$" ] ) ] ) ] ;
            owl:onProperty heritageGraph:source_language ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:created_by_documentation ],
        heritageGraph:DataSource ;
    skos:definition "A recorded piece of information about heritage" ;
    skos:exactMatch crm:E73_Information_Object ;
    skos:inScheme <HeritageGraph> .

heritageGraph:LivingGoddessRetirement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "LivingGoddessRetirement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:performed_by_group ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:DocumentationActivity ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:was_documented_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Place ;
            owl:onProperty heritageGraph:took_place_at ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:HeritageAssertion ;
            owl:onProperty heritageGraph:has_provenance_assertion ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:LivingGoddessTenure ;
            owl:onProperty heritageGraph:ended_tenure_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
            owl:onProperty heritageGraph:has_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:ended_tenure_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:Person ;
            owl:onProperty heritageGraph:carried_out_by ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:ended_tenure_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:unionOf ( heritageGraph:Guthi heritageGraph:CasteGroup ) ] ;
            owl:onProperty heritageGraph:performed_by_group ],
        heritageGraph:RitualEvent ;
    skos:definition " Ritual or administrative event that formally ends a Living Goddess tenure, marking the person's return to secular status. Common triggers include first menstruation, injury causing blood loss, or serious illness. This event terminates the divine embodiment and restores the girl to ordinary status." ;
    skos:exactMatch crm:E7_Activity,
        heritageGraph:LivingGoddessRetirement ;
    skos:inScheme <HeritageGraph> .

