heritageGraph:ArchitecturalElement a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "ArchitecturalElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:note ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:ArchitecturalStructure ;
            owl:onProperty heritageGraph:is_component_of ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:is_component_of ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:is_component_of ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty heritageGraph:name ] ;
    skos:definition "Carved or constructed component of a architectural strucuture (e.g., Gajur, Torana, Tundal)" ;
    skos:exactMatch aat:300001819,
        crm:E25_Architectural_Element ;
    skos:inScheme <HeritageGraph> .

heritageGraph:BuddhistMonument a owl:Class,
        linkml:ClassDefinition ;
    rdfs:label "BuddhistMonument" ;
    rdfs:subClassOf heritageGraph:ArchitecturalStructure ;
    skos:definition "Buddhist sacred structure (Stupa, Chaitya) with circumambulation and ritual activation patterns" ;
    skos:exactMatch aat:300007576,
        wikidata:Q177980,
        heritageGraph:BuddhistMonument ;
    skos:inScheme <HeritageGraph> .

heritageGraph:CalendarSystem a owl:Class,
