            owl:onProperty heritageGraph:name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:birth_timespan ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty heritageGraph:id ],
        [ a owl:Restriction ;
            owl:allValuesFrom heritageGraph:TimeSpan ;
